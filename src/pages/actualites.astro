---
/**
 * Archive des actualités.
 *
 * Page volontairement absente de la navigation globale : on n'y accède que par
 * le bouton « Voir les actualités passées » du tableau de bord. Comme toutes
 * les pages du site, elle est derrière l'écran de connexion (gabarit « Base »).
 */
import Base from '../layouts/Base.astro';
---

<Base titre="Actualités">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <a
        id="retour"
        href="./"
        class="inline-flex min-h-11 items-center text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
        >← Tableau de bord</a
      >
      <h1 class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">Actualités passées</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Veille hebdomadaire, bilans mensuels, synthèses trimestrielles et annuelles.
      </p>
    </div>

    <!--
      PAS DES ONGLETS NON PLUS (prompt 43, E7).

      Ce conteneur annonçait `role="tablist"`, et ses cinq boutons portaient
      `aria-selected` sans jamais porter `role="tab"` : l'attribut n'a aucun
      sens hors d'un onglet, et le rôle promettait une structure — onglets,
      panneaux, flèches — qui n'existait pas.

      J'ai écarté d'en faire de VRAIS onglets, et la raison tient à ce que
      ces boutons gouvernent : la liste d'en bas est aussi changée par la
      recherche, par les filtres de domaine et par la barre de période. Un
      panneau d'onglet appartient à son onglet ; celui-ci appartient à
      quatre commandes. L'annoncer comme un panneau d'onglet serait un
      second mensonge, plus poli que le premier.

      Ce sont donc cinq boutons à deux états, dans un groupe nommé —
      exactement comme les filtres de domaine juste en dessous, qui, eux,
      étaient déjà justes. Deux rangées de chevrons qui se ressemblent se
      comportent désormais pareil.
    -->
    <div class="flex w-full flex-wrap gap-1 rounded-xl bg-slate-100 p-1 sm:w-auto dark:bg-slate-800" role="group" aria-label="Périodicité">
      <button type="button" data-vue="semaines" class="onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium">Semaines</button>
      <button type="button" data-vue="mois" class="onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium">Mois</button>
      <button type="button" data-vue="trimestres" class="onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium">Trimestres</button>
      <button type="button" data-vue="annees" class="onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium">Années</button>
      <button type="button" data-vue="syntheses" class="onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium">Synthèses</button>
    </div>
  </div>

  <div id="filtres" class="mb-6 flex flex-wrap items-center gap-2">
    <span class="text-sm text-slate-500 dark:text-slate-400">Domaine :</span>
    <button type="button" data-domaine="" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">Tous</button>
    <button type="button" data-domaine="economie" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">Économie</button>
    <button type="button" data-domaine="finance" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">Finances publiques</button>
    <button type="button" data-domaine="social" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">Social</button>
    <button type="button" data-domaine="juridique" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">Juridique</button>
    <button type="button" data-domaine="international" class="filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium">International</button>

    {/*
       Un marqueur de lecture sans moyen de s'en servir serait une décoration.
       La bascule vit avec les filtres de domaine, parce qu'elle en est un.
    */}
    <label class="ms-auto flex min-h-11 cursor-pointer items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
      <input id="non-lues" type="checkbox" class="size-5 rounded" />
      Non lues seulement
    </label>
  </div>

  {/*
     La recherche traverse toutes les périodes de la vue, et pas seulement
     celle qui est affichée : chercher « inflation » dans la seule semaine
     ouverte ne servirait à rien. Tant qu'elle est remplie, la navigation
     période par période s'efface — on ne peut pas être à la fois sur une
     semaine et sur quarante.
  */}
  <input
    id="recherche-actu"
    type="search"
    aria-label="Rechercher dans les actualités"
    placeholder="Rechercher un titre, un résumé, un mot-clé…"
    class="mb-4 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:focus:ring-indigo-900"
  />

  {/*
     Une période à la fois. « Précédente » recule dans le temps : les
     périodes sont rangées de la plus récente à la plus ancienne, et c'est
     l'ordre dans lequel on les lit, pas l'ordre des index.
  */}
  <nav id="barre-periode" class="mb-5 hidden flex-wrap items-center gap-2" aria-label="Période affichée">
    <!--
      Le choix de la période vient en premier, et prend toute la ligne tant
      que l'écran est étroit (D-043).

      Il était glissé entre « Précédente » et « Suivante », en « flex-1 » :
      les deux boutons et le compteur prenaient 266 px des 358 disponibles
      sur un téléphone, et le menu héritait des 69 restants. L'option
      choisie en demandait 414 — on lisait « 202 », et rien ne disait quelle
      période on regardait. Le défaut était antérieur au passage du texte à
      16 px, qui n'a fait que l'aggraver : à 14 px, 96 px pour 363 demandés.

      En tête, il se lit avant les flèches qui le font avancer, et la
      tabulation suit le même ordre. « basis-full » lui donne la ligne
      entière sous 640 px ; au-dessus, il reprend la largeur de son contenu
      et ne se laisse plus comprimer.
    -->
    <label for="choix-periode" class="sr-only">Période affichée</label>
    <select
      id="choix-periode"
      class="min-h-11 max-w-full shrink-0 basis-full rounded-lg border border-slate-300 bg-white px-2 text-sm font-medium text-slate-700 sm:basis-auto dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
    >
    </select>
    <button
      id="periode-precedente"
      type="button"
      class="cible-tactile-pleine rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      ‹ Précédente
    </button>
    <button
      id="periode-suivante"
      type="button"
      class="cible-tactile-pleine rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      Suivante ›
    </button>
    <span id="position-periode" role="status" class="text-sm text-slate-500 dark:text-slate-400"></span>
  </nav>

  <div id="chargement-actu" class="py-16 text-center text-slate-400">Chargement des actualités…</div>
  <div id="archive" class="hidden space-y-8"></div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import {
    chargerSemaines,
    chargerMois,
    chargerTrimestres,
    chargerAnnees,
    domaineDe,
    friseDe,
    idPeriode,
    titrePeriode,
    type PeriodeActu,
  } from '../lib/actualites';
  import {
    blocTendances,
    carteItem,
    definirIndexTexte,
    friseChronologique,
    legendeDomaines,
    messageVide,
  } from '../lib/actualites-rendu';
  import { aplatirFiches, chargerIndexRecherche, chargerManifeste, type FicheAplatie } from '../lib/contenu';
  import { construireIndexTexte } from '../lib/rattachement';
  import { cleActualite, lues, marquer } from '../lib/actualites-lues';
  import { lien, normaliser, parametreUrl, pluriel } from '../lib/ui';

  const ACTIF_ONGLET = 'bg-white text-indigo-700 shadow-sm dark:bg-slate-900 dark:text-indigo-300';
  const INACTIF_ONGLET = 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white';
  const ACTIF_FILTRE = 'bg-indigo-600 text-white';
  const INACTIF_FILTRE =
    'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700';

  const archive = document.getElementById('archive')!;
  const chargement = document.getElementById('chargement-actu')!;
  const onglets = [...document.querySelectorAll<HTMLButtonElement>('.onglet-vue')];
  const filtres = [...document.querySelectorAll<HTMLButtonElement>('.filtre-domaine')];
  const zoneFiltres = document.getElementById('filtres')!;

  document.getElementById('retour')!.setAttribute('href', lien('/revisions/'));

  const champRecherche = document.getElementById('recherche-actu') as HTMLInputElement;
  const barrePeriode = document.getElementById('barre-periode')!;
  const choixPeriode = document.getElementById('choix-periode') as HTMLSelectElement;
  const precedente = document.getElementById('periode-precedente') as HTMLButtonElement;
  const suivante = document.getElementById('periode-suivante') as HTMLButtonElement;
  const position = document.getElementById('position-periode')!;

  const donnees: Record<string, PeriodeActu[] | undefined> = {};
  /** Les clefs des actualités déjà lues (D-039), lues une fois au démarrage. */
  let dejaLues = new Set<string>();
  let nonLuesSeules = false;
  let fichesCours: FicheAplatie[] = [];
  let vue = 'semaines';
  let domaine = '';
  /** Identifiant de la période affichée ; vide = la plus récente. */
  let periodeChoisie = '';
  let recherche = '';

  const MOT = { semaines: 'semaine', mois: 'mois', trimestres: 'trimestre', annees: 'année' } as const;
  const motDe = (v: string) => MOT[v as keyof typeof MOT] ?? 'période';

  /**
   * L'adresse porte l'état de l'écran.
   *
   * Une archive sans adresse n'est pas partageable et ne se recharge pas :
   * revenir d'une fiche de cours ramenait à la semaine la plus récente, quelle
   * que soit celle qu'on lisait. « replaceState » et non « pushState » : ces
   * changements ne sont pas des pages, et vingt retours en arrière pour
   * défaire vingt clics de filtre seraient un piège.
   */
  function majAdresse() {
    const p = new URLSearchParams();
    if (vue !== 'semaines') p.set('vue', vue);
    if (domaine) p.set('domaine', domaine);
    if (periodeChoisie) p.set('periode', periodeChoisie);
    if (recherche) p.set('q', recherche);
    const suite = p.toString();
    history.replaceState(null, '', suite ? `?${suite}` : location.pathname);
  }

  /** Le texte d'un item, tel qu'on le cherche : titre, résumé, mots-clés, sources. */
  function texteDe(item: { titre?: string; resume?: string; mots_cles?: string[]; sources?: { nom?: string }[] }) {
    return normaliser(
      [item.titre ?? '', item.resume ?? '', ...(item.mots_cles ?? []), ...(item.sources ?? []).map((x) => x.nom ?? '')].join(' '),
    );
  }

  function peindreBoutons() {
    for (const bouton of onglets) {
      const actif = bouton.dataset.vue === vue;
      bouton.className = `onglet-vue min-h-11 rounded-lg px-3.5 py-2 text-sm font-medium transition ${actif ? ACTIF_ONGLET : INACTIF_ONGLET}`;
      bouton.setAttribute('aria-pressed', String(actif));
    }
    for (const bouton of filtres) {
      const actif = (bouton.dataset.domaine ?? '') === domaine;
      bouton.className = `filtre-domaine min-h-11 rounded-full px-4 py-2 text-sm font-medium transition ${actif ? ACTIF_FILTRE : INACTIF_FILTRE}`;
      bouton.setAttribute('aria-pressed', String(actif));
    }
    // Les frises se lisent par période, pas par domaine : le filtre n'y a pas
    // de sens, la légende de couleurs le remplace. La recherche non plus : une
    // frise n'a pas de texte à chercher.
    zoneFiltres.classList.toggle('hidden', vue === 'syntheses');
    champRecherche.classList.toggle('hidden', vue === 'syntheses');
    champRecherche.placeholder = `Rechercher dans toutes les ${vue === 'annees' ? 'années' : vue}…`;
  }

  /**
   * Rubrique « Synthèses » : les frises chronologiques de toutes les périodes
   * disponibles, de la plus large à la plus fine. Elles répondent à une autre
   * question que l'archive — « qu'est-ce qui s'est passé, et dans quel ordre »
   * plutôt que « qu'est-ce qu'il faut retenir ».
   */
  function peindreSyntheses() {
    const groupes: { titre: string; entrees: PeriodeActu[] }[] = [
      { titre: 'Années', entrees: donnees.annees ?? [] },
      { titre: 'Trimestres', entrees: donnees.trimestres ?? [] },
      { titre: 'Mois', entrees: donnees.mois ?? [] },
      { titre: 'Semaines', entrees: donnees.semaines ?? [] },
    ];

    let affichees = 0;
    for (const groupe of groupes) {
      const avecFrise = groupe.entrees
        .map((entree) => ({ entree, points: friseDe(entree) }))
        .filter(({ points }) => points.length);
      if (!avecFrise.length) continue;
      affichees += avecFrise.length;

      const section = document.createElement('section');
      const titre = document.createElement('h2');
      titre.className =
        'mb-3 border-b border-slate-200 pb-2 text-lg font-semibold text-slate-900 dark:border-slate-800 dark:text-white';
      titre.textContent = groupe.titre;
      section.appendChild(titre);

      const grille = document.createElement('div');
      // Une frise seule occupe toute la largeur ; à partir de deux, elles se
      // comparent mieux côte à côte.
      grille.className = avecFrise.length > 1 ? 'grid gap-4 lg:grid-cols-2' : 'grid gap-4';
      for (const { entree, points } of avecFrise) {
        const carte = document.createElement('article');
        carte.className =
          'rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900';
        const entete = document.createElement('div');
        entete.className = 'mb-3 flex flex-wrap items-baseline justify-between gap-2';
        const nom = document.createElement('h3');
        nom.className = 'texte-secable font-semibold text-slate-900 dark:text-white';
        nom.textContent = titrePeriode(entree);
        const nombre = document.createElement('span');
        nombre.className = 'text-xs text-slate-500 dark:text-slate-400';
        nombre.textContent = `${points.length} repère(s)`;
        entete.append(nom, nombre);
        carte.append(entete, legendeDomaines(new Set(points.map((p) => p.domaine ?? ''))));
        if (entree.tendances?.length) carte.appendChild(blocTendances(entree.tendances));
        const frise = friseChronologique(points);
        frise.classList.add('mt-4');
        carte.appendChild(frise);
        grille.appendChild(carte);
      }
      section.appendChild(grille);
      archive.appendChild(section);
    }

    if (!affichees) {
      archive.appendChild(
        messageVide(
          "Aucune frise chronologique n'est encore disponible : elles sont construites par les bilans mensuels, trimestriels et annuels.",
        ),
      );
    }
  }

  /** Une section de période : titre, tendances, cartes, lien vers la frise. */
  function sectionDePeriode(entree: PeriodeActu, items: ReturnType<typeof itemsDe>, tendances: unknown[]) {
    const section = document.createElement('section');
    // Rendu différé : sur une recherche qui traverse quarante semaines, le
    // navigateur n'a pas à mettre en page ce qui est hors de l'écran.
    section.className = 'differe';
    section.style.containIntrinsicSize = `auto ${240 + items.length * 230}px`;
    const titre = document.createElement('h2');
    titre.className =
      'mb-3 border-b border-slate-200 pb-2 text-lg font-semibold text-slate-900 dark:border-slate-800 dark:text-white';
    titre.textContent = titrePeriode(entree);
    section.appendChild(titre);

    // Les tendances de fond ouvrent le bilan : elles en donnent la lecture
    // d'ensemble, avant la liste des actualités retenues.
    if (tendances.length) {
      const bloc = blocTendances(tendances as never);
      bloc.classList.add('mb-4');
      section.appendChild(bloc);
    }

    if (items.length) {
      const grille = document.createElement('div');
      grille.className = 'grid gap-3 md:grid-cols-2';
      const periode = idPeriode(entree);
      for (const item of items) {
        const cle = cleActualite(periode, item.titre ?? '');
        grille.appendChild(
          carteItem(item, fichesCours, {
            replie: true,
            lecture: {
              lu: dejaLues.has(cle),
              /*
                 L'écriture ne redessine pas la liste : une carte qui
                 disparaîtrait sous le doigt au moment où on la marque lue
                 ferait perdre sa place. Le filtre « non lues seulement » ne
                 s'applique qu'au rendu suivant, et c'est voulu.
              */
              basculer: async (lu) => {
                if (lu) dejaLues.add(cle);
                else dejaLues.delete(cle);
                try {
                  await marquer(cle, lu);
                } catch (e) {
                  console.warn('Marquage de lecture non enregistré :', e);
                }
              },
            },
          }),
        );
      }
      section.appendChild(grille);
    }

    // Lien vers la frise de cette période, qui vit dans l'onglet Synthèses.
    if (friseDe(entree).length) {
      const vers = document.createElement('button');
      vers.type = 'button';
      vers.className =
        'mt-3 inline-flex min-h-11 items-center text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400';
      vers.textContent = `Voir la frise chronologique de ${idPeriode(entree)} →`;
      vers.addEventListener('click', () => void basculer('syntheses'));
      section.appendChild(vers);
    }
    return section;
  }

  /** Les items d'une période, filtrés par domaine, par la recherche, par l'état de lecture. */
  function itemsDe(entree: PeriodeActu) {
    const requete = normaliser(recherche.trim());
    const periode = idPeriode(entree);
    return (entree.items ?? [])
      .filter((i) => !domaine || domaineDe(i) === domaine)
      .filter((i) => !requete || texteDe(i).includes(requete))
      .filter((i) => !nonLuesSeules || !dejaLues.has(cleActualite(periode, i.titre ?? '')));
  }

  /** Le nombre d'actualités non lues d'une période, filtres de domaine inclus. */
  function nonLues(entree: PeriodeActu) {
    const periode = idPeriode(entree);
    return (entree.items ?? [])
      .filter((i) => !domaine || domaineDe(i) === domaine)
      .filter((i) => !dejaLues.has(cleActualite(periode, i.titre ?? ''))).length;
  }

  /**
   * Les périodes qui ont quelque chose à montrer, de la plus récente à la
   * plus ancienne.
   *
   * Le tri explicite, et non l'ordre de chargement : les quatre chargeurs ne
   * le garantissent pas de la même façon, et une liste à l'envers ferait
   * reculer « Suivante ».
   */
  function periodesVisibles() {
    return [...(donnees[vue] ?? [])]
      .sort((a, b) => idPeriode(b).localeCompare(idPeriode(a)))
      .map((entree) => ({
        entree,
        items: itemsDe(entree),
        tendances: domaine || recherche.trim() ? [] : (entree.tendances ?? []),
      }))
      .filter(({ items, tendances }) => items.length || tendances.length);
  }

  function peindreArchive() {
    peindreBoutons();
    archive.innerHTML = '';

    if (vue === 'syntheses') {
      barrePeriode.classList.add('hidden');
      barrePeriode.classList.remove('flex');
      peindreSyntheses();
      return;
    }

    if (!(donnees[vue] ?? []).length) {
      barrePeriode.classList.add('hidden');
      barrePeriode.classList.remove('flex');
      archive.appendChild(
        messageVide(
          "Aucune actualité n'a encore été publiée pour cette période. Les routines de veille alimenteront cette page automatiquement.",
        ),
      );
      return;
    }

    const visibles = periodesVisibles();

    /*
       En recherche, toutes les périodes qui répondent sont montrées d'un
       coup, avec leur nombre : « dans quelle semaine en a-t-on parlé » est
       justement la question qu'on pose, et une réponse période par période
       obligerait à les visiter une à une.
    */
    if (recherche.trim()) {
      barrePeriode.classList.add('hidden');
      barrePeriode.classList.remove('flex');
      const total = visibles.reduce((n, v) => n + v.items.length, 0);
      const compte = document.createElement('p');
      compte.setAttribute('role', 'status');
      compte.className = 'mb-4 text-sm text-slate-500 dark:text-slate-400';
      compte.textContent = total
        ? `${pluriel(total, 'résultat')} dans ${pluriel(visibles.length, motDe(vue), vue === 'mois' ? 'mois' : undefined)}.`
        : '';
      if (total) archive.appendChild(compte);
      for (const { entree, items, tendances } of visibles) {
        archive.appendChild(sectionDePeriode(entree, items, tendances));
      }
      if (!total) {
        archive.appendChild(messageVide(`Aucune actualité ne correspond à « ${recherche.trim()} »${domaine ? ' dans ce domaine' : ''}.`));
      }
      void repecher();
      return;
    }

    if (!visibles.length) {
      barrePeriode.classList.add('hidden');
      barrePeriode.classList.remove('flex');
      archive.appendChild(messageVide('Aucune actualité ne correspond à ce domaine sur la période disponible.'));
      return;
    }

    // La période retenue : celle de l'adresse si elle existe encore après
    // filtrage, la plus récente sinon.
    let index = visibles.findIndex(({ entree }) => idPeriode(entree) === periodeChoisie);
    if (index === -1) index = 0;
    const courante = visibles[index];
    periodeChoisie = idPeriode(courante.entree);

    choixPeriode.innerHTML = '';
    for (const { entree, items } of visibles) {
      const option = document.createElement('option');
      option.value = idPeriode(entree);
      const reste = nonLues(entree);
      /*
         Le libellé tient dans la largeur d'un téléphone (D-043).

         Un « option » ne se replie pas et ne s'abrège pas : ce qui dépasse
         disparaît, sans que rien ne le signale. Le format d'origine —
         « 2026-W40 · semaine en cours — 5 actualités, 5 non lues » —
         demandait 414 px pour 334 disponibles à 390 px de large.

         Deux coupes, mesurées plutôt que devinées. Le qualificatif de la
         période (« semaine en cours ») part : il reste sous les yeux, dans
         le titre de la section juste en dessous, qui lui emploie
         « titrePeriode » en entier. Et lorsqu'il reste des actualités à
         lire, le compte à lire remplace le compte total, qu'il porte déjà.

         Le pire cas devient « 2026-W40 — 128 à lire sur 128 », 226 px :
         il passe à 320 px de large, sous les 360 px que la documentation
         retient comme écran le plus étroit.
      */
      option.textContent = reste
        ? `${idPeriode(entree)} — ${reste} à lire sur ${items.length}`
        : `${idPeriode(entree)} — ${pluriel(items.length, 'actualité')}`;
      choixPeriode.appendChild(option);
    }
    choixPeriode.value = periodeChoisie;
    precedente.disabled = index >= visibles.length - 1;
    suivante.disabled = index <= 0;
    position.textContent = `${index + 1} sur ${visibles.length}`;
    barrePeriode.classList.remove('hidden');
    barrePeriode.classList.add('flex');

    archive.appendChild(sectionDePeriode(courante.entree, courante.items, courante.tendances));
    majAdresse();
    void repecher();
  }

  /**
   * Si des actualités sont restées sans fiche de cours rattachée, charge
   * l'index de recherche (plus d'un mégaoctet, d'où le chargement différé) et
   * redessine une fois.
   */
  let repechageFait = false;
  async function repecher() {
    if (repechageFait || !fichesCours.length) return;
    if (!archive.querySelector('[data-rattachements="0"]')) return;
    repechageFait = true;
    try {
      definirIndexTexte(construireIndexTexte(await chargerIndexRecherche()));
      peindreArchive();
    } catch (e) {
      console.warn('Index de recherche indisponible pour le rattachement :', e);
    }
  }

  async function charger(cible: string) {
    // Les frises réunissent toutes les périodes : l'onglet Synthèses a besoin
    // des quatre jeux de données, pas d'un seul.
    if (cible === 'syntheses') {
      await Promise.all(['annees', 'trimestres', 'mois', 'semaines'].map(charger));
      return;
    }
    if (donnees[cible]) return;
    if (cible === 'semaines') donnees[cible] = await chargerSemaines();
    else if (cible === 'mois') donnees[cible] = await chargerMois();
    else if (cible === 'trimestres') donnees[cible] = await chargerTrimestres();
    else donnees[cible] = await chargerAnnees();
  }

  async function basculer(cible: string) {
    // Les identifiants de période ne se ressemblent pas d'une vue à l'autre
    // (« 2026-W38 », « 2026-10 ») : garder le choix en changeant de vue ferait
    // chercher une semaine parmi des mois, et retomberait sur la plus récente
    // sans le dire. On repart donc de la plus récente, explicitement.
    if (cible !== vue) periodeChoisie = '';
    vue = cible;
    peindreBoutons();
    if (cible === 'syntheses' || !donnees[cible]) {
      archive.classList.add('hidden');
      chargement.classList.remove('hidden');
      chargement.textContent = 'Chargement des actualités…';
      await charger(cible);
      chargement.classList.add('hidden');
      archive.classList.remove('hidden');
    }
    peindreArchive();
  }

  for (const bouton of onglets) {
    bouton.addEventListener('click', () => void basculer(bouton.dataset.vue!));
  }
  for (const bouton of filtres) {
    bouton.addEventListener('click', () => {
      domaine = bouton.dataset.domaine ?? '';
      peindreArchive();
      majAdresse();
    });
  }

  (document.getElementById('non-lues') as HTMLInputElement).addEventListener('change', (e) => {
    nonLuesSeules = (e.target as HTMLInputElement).checked;
    peindreArchive();
  });

  choixPeriode.addEventListener('change', () => {
    periodeChoisie = choixPeriode.value;
    peindreArchive();
    window.scrollTo({ top: 0 });
  });

  /*
     « Précédente » recule dans le temps, donc avance dans la liste, qui est
     rangée de la plus récente à la plus ancienne. Écrire l'inverse aurait
     donné deux boutons qui font le contraire de ce qu'ils disent.
  */
  const deplacer = (pas: number) => {
    const visibles = periodesVisibles();
    const index = visibles.findIndex(({ entree }) => idPeriode(entree) === periodeChoisie);
    const vise = visibles[(index === -1 ? 0 : index) + pas];
    if (!vise) return;
    periodeChoisie = idPeriode(vise.entree);
    peindreArchive();
    window.scrollTo({ top: 0 });
  };
  precedente.addEventListener('click', () => deplacer(1));
  suivante.addEventListener('click', () => deplacer(-1));

  /*
     La recherche attend deux cent cinquante millisecondes avant de redessiner :
     redessiner à chaque touche sur quarante semaines rendrait la frappe
     saccadée, et le rendu différé n'y changerait rien — c'est la construction
     des cartes qui coûte, pas leur mise en page.
  */
  let minuterie = 0;
  champRecherche.addEventListener('input', () => {
    window.clearTimeout(minuterie);
    minuterie = window.setTimeout(() => {
      recherche = champRecherche.value;
      peindreArchive();
      majAdresse();
    }, 250);
  });

  // « auDeverrouillage » : barre de progression, garde-fou de 5 secondes et
  // exécution même si ce script arrive après l'ouverture de la session.
  auDeverrouillage(async () => {
    domaine = parametreUrl('domaine') ?? parametreUrl('theme') ?? '';
    periodeChoisie = parametreUrl('periode') ?? '';
    recherche = parametreUrl('q') ?? '';
    champRecherche.value = recherche;
    // L'état de lecture d'abord : les cartes en ont besoin dès le premier rendu.
    dejaLues = await lues();
    // Le manifeste alimente le rattachement des actualités aux fiches de cours ;
    // son absence ne doit pas empêcher l'affichage des actualités.
    chargerManifeste()
      .then((m) => {
        fichesCours = aplatirFiches(m);
        if (!archive.classList.contains('hidden')) peindreArchive();
      })
      .catch((e) => console.warn('Rattachement aux fiches indisponible :', e));
    await basculer(parametreUrl('vue') ?? 'semaines');
  });
</script>
