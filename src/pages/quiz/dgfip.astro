---
import Base from '../../layouts/Base.astro';
import LienReglages from '../../components/LienReglages.astro';
import { base } from '../../lib/ui';
---

<Base titre="QCM — DGFiP" actif="quiz">
  <div id="chargement" class="py-20 text-center text-slate-400">Préparation de la banque…</div>

  <!-- ====================== Accueil de la rubrique ====================== -->
  <section id="accueil-dgfip" class="hidden">
    <p class="etiquette text-indigo-600 dark:text-indigo-400">
      <a href={`${base}/quiz/`} class="cible-tactile pr-2 hover:underline">Quiz</a> · rubrique
    </p>
    <h1 class="mt-1 mb-1 text-2xl font-bold text-slate-900 dark:text-white">QCM — DGFiP</h1>
    <p class="mb-6 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Épreuve blanche dans les conditions du concours : les rubriques mêlées en
      une seule série, aucune correction avant la fin, et un barème qui rend
      l'abstention préférable au hasard. Deux formats reproduisent la structure
      des sujets 2026, rubrique par rubrique.
    </p>

    {/*
       L'épreuve gardée pour plus tard (C3 du prompt 43).

       En tête de l'accueil, parce que c'est la seule chose de cet écran qui
       attend quelque chose de la personne. Caché tant qu'il n'y a rien à
       reprendre : un bloc vide qui dit « aucune épreuve gardée » occuperait
       l'écran pour ne rien apprendre.

       Aucune couleur d'alerte, aucun compte à rebours : une épreuve gardée
       n'expire pas, et rien ne presse de la reprendre.
    */}
    <div
      id="reprise-dgfip"
      class="mb-6 hidden rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900"
    >
      <p id="reprise-texte" class="text-sm text-slate-700 dark:text-slate-200"></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button
          id="reprendre-dgfip"
          type="button"
          class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
          >Reprendre l’épreuve</button
        >
        <button
          id="jeter-dgfip"
          type="button"
          class="cible-tactile rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >Ne pas la reprendre</button
        >
      </div>
    </div>

    <div class="mb-6 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 dark:border-emerald-900 dark:bg-emerald-950/40">
        <p class="text-lg font-bold text-emerald-700 tabular-nums dark:text-emerald-400">+1</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">par bonne réponse</p>
      </div>
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 dark:border-red-900 dark:bg-red-950/40">
        <p class="text-lg font-bold text-red-700 tabular-nums dark:text-red-400">−0,5</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">par mauvaise réponse</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-lg font-bold text-slate-700 tabular-nums dark:text-slate-200">0</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">en l'absence de réponse</p>
      </div>
    </div>

    <h2 class="mb-2 text-sm font-semibold text-slate-900 dark:text-white">Banque de questions</h2>
    <div id="rubriques-dgfip" class="mb-6 space-y-2"></div>

    <div class="flex flex-wrap items-end gap-3">
      <!--
        LA PRÉSENTATION, à côté du format et non à sa place : les deux choix
        sont indépendants. Le format dit combien de questions et de quelles
        rubriques ; la présentation dit à quoi ressemble la page.

        « Copie de concours » est proposée par défaut (décision 1 du prompt
        49), et ce défaut se règle dans Paramètres > Révisions.
      -->
      <div>
        <label for="presentation-dgfip" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">
          Présentation
        </label>
        <select
          id="presentation-dgfip"
          class="w-full max-w-[22rem] rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
        >
          <option value="copie">Copie de concours</option>
          <option value="une-a-la-fois">Une question à la fois</option>
        </select>
      </div>
      <div>
        <label for="format-dgfip" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">
          Format
        </label>
        <!-- Rempli au chargement : seuls les formats que la banque peut
             réellement tirer sont proposés. -->
        <!--
          « w-full » avant le plafond : 22 rem valent 352 px, et un écran de
          360 px n'offre que 328 px de colonne une fois ses marges prises. La
          liste débordait donc de 6 px, et toute la page avec elle. Le plafond
          reste utile au-delà : sans lui, la liste s'étirerait sur la largeur
          d'une tablette pour afficher « Catégorie B — 30 questions ».

          Le bouton « Plus » de la barre du bas ressortait lui aussi à 366 px.
          Il n'y était pour rien : une barre fixe s'étire à la largeur du
          document une fois qu'autre chose l'a élargi. Corriger ce qu'on voit
          dépasser en premier aurait traité le symptôme — c'est la leçon du
          14 octobre, et elle a resservi.
        -->
        <select
          id="format-dgfip"
          class="w-full max-w-[22rem] rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
        ></select>
      </div>
      <button
        id="lancer-dgfip"
        class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700"
      >
        Commencer
      </button>
      <p class="w-full text-xs text-slate-500 dark:text-slate-400">
        Les questions sont tirées au hasard, en ramenant plus souvent celles que
        vous avez ratées ou laissées de côté.
      </p>

      <!--
        CE QUE LA COPIE PEUT SERVIR, dit avant de commencer et non découvert
        en route. Deux annonces distinctes :

        - le stock : une zone de la feuille porte quatre cases, donc la copie
          ne tire que les questions à quatre propositions ;
        - la composition : les formats 2026 promettent une structure, et si
          une rubrique n'a pas de quoi la tenir, il faut le dire plutôt que
          de laisser croire.
      -->
      <p id="copie-disponibles" class="w-full hidden text-xs text-slate-500 dark:text-slate-400"></p>
      <div
        id="copie-composition"
        class="w-full hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950/30 dark:text-amber-100"
      ></div>
    </div>

    <p
      id="dgfip-vide"
      class="mt-6 hidden rounded-xl bg-slate-100 px-4 py-3 text-sm text-slate-600 dark:bg-slate-900 dark:text-slate-300"
    >
      La banque « QCM - DGFiP » est vide : ajoutez des questions dans{' '}
      <code>content/qcm-dgfip/</code>, puis republiez le site.
    </p>

    <!--
      Le réglage de la présentation par défaut vit dans Paramètres >
      Révisions, et cet écran y mène. `essais:reglages-orphelins` vérifie
      que tout écran cité par le catalogue porte ce lien — il l'a d'ailleurs
      réclamé dès que le réglage a été déclaré.
    -->
    <LienReglages section="revisions" class="mt-8" />

    <div id="historique-dgfip" class="mt-10"></div>
  </section>

  <!-- ========================== Épreuve en cours ========================= -->
  <section id="epreuve" class="hidden">
    <div class="mb-4 flex items-center gap-3">
      <button
        id="quitter-dgfip"
        class="cible-tactile text-sm text-slate-600 hover:underline dark:text-slate-300"
      >
        ← Quitter
      </button>
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
        <div id="barre-dgfip" class="h-full rounded-full bg-indigo-500 jauge-remplissage jauge-seance" style="transform:scaleX(0)"></div>
      </div>
      <span
        id="compteur-dgfip"
        role="status"
        aria-live="polite"
        class="text-sm font-medium text-slate-500 tabular-nums dark:text-slate-400"
      ></span>
    </div>

    <div class="mx-auto max-w-2xl">
      <p id="rubrique-courante" class="etiquette mb-2 text-indigo-600 dark:text-indigo-400"></p>
      <h2 id="enonce-dgfip" class="mb-2 text-lg leading-relaxed font-medium text-slate-900 sm:text-xl dark:text-white"></h2>
      <p id="consigne-dgfip" class="mb-5 text-xs text-slate-400"></p>
      <div id="options-dgfip" class="space-y-2"></div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button
          id="precedent-dgfip"
          class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium transition hover:bg-slate-100 disabled:opacity-40 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Précédent
        </button>
        <button
          id="suivant-dgfip"
          class="flex-1 rounded-lg bg-slate-900 px-5 py-2.5 font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900"
        >
          Suivant
        </button>
      </div>
      <p class="mt-3 text-center text-xs text-slate-400">
        Passer sans rien cocher ne coûte rien ; une case décochée redevient une
        abstention.
      </p>
    </div>
  </section>

  <!-- ========================== Copie de concours ======================= -->
  <section id="copie" class="hidden">
    <!--
      LA BARRE DU HAUT, toujours visible (C3).

      Le compte à rebours et les deux boutons restent sous les yeux, et les
      boutons sont HORS de la zone d'écriture : à portée du pouce mais pas là
      où l'on coche, pour qu'on ne rende pas sa copie en visant une case.

      « role=timer » sans région vive : annoncer le temps restant chaque
      seconde noierait un lecteur d'écran. Le ramassage, lui, est annoncé.
    -->
    <!--
      UNE SEULE RANGÉE, et le repère hors de la barre.

      Première version : le compte à rebours, sa phrase d'explication et les
      deux boutons empilés prenaient 215 px à 360 — près de 30 % de l'écran,
      en permanence. C'est ce que le critère M5 interdit ailleurs, et la
      capture l'a montré tout de suite.

      Deux corrections. La phrase du repère se lit une fois : elle descend
      dans le sujet, où elle ne coûte rien. Et les boutons passent sur la
      même rangée que le chronomètre, leur libellé se repliant sur deux
      lignes plutôt que de pousser une rangée de plus. Les libellés eux-mêmes
      ne bougent pas : ils disent l'action, et le prompt les nomme.
    -->
    <div
      class="sticky top-0 z-10 mb-4 flex items-center gap-2 border-b border-slate-200 bg-slate-50 py-2 dark:border-slate-800 dark:bg-slate-950"
    >
      <p
        id="rebours"
        role="timer"
        aria-live="off"
        class="shrink-0 text-lg font-semibold text-slate-900 tabular-nums dark:text-white"
      >
        —
      </p>
      <div class="ml-auto flex min-w-0 gap-2">
        <button
          id="nouvelle-feuille"
          class="cible-tactile-pleine rounded-lg border border-slate-300 px-2 text-xs leading-tight transition hover:bg-slate-100 sm:px-3 sm:text-sm dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Demander une nouvelle feuille
        </button>
        <button
          id="rendre-copie"
          class="cible-tactile-pleine shrink-0 rounded-lg bg-slate-900 px-3 text-xs leading-tight font-medium text-white transition hover:bg-slate-700 sm:px-4 sm:text-sm dark:bg-white dark:text-slate-900"
        >
          Rendre la copie
        </button>
      </div>
    </div>

    <!--
      LA LARGEUR D'UNE FEUILLE, une seule colonne centrée (C3). Sur
      ordinateur, une ligne de texte qui traverse un écran de 1 280 px ne se
      lit pas : le sujet garde la largeur d'un A4.
    -->
    <p id="rebours-repere" class="mx-auto mb-2 max-w-[46rem] text-xs text-slate-500 dark:text-slate-400"></p>
    <div
      id="copie-sujet"
      class="mx-auto max-w-[46rem] border border-slate-200 bg-slate-50 px-4 py-5 dark:border-slate-800 dark:bg-slate-950 sm:px-6"
    ></div>
  </section>

  <!-- ============================= Résultat ============================= -->
  <section id="resultat-dgfip" class="hidden">
    <div class="text-center">
      <p id="resultat-emoji-dgfip" class="text-5xl"></p>
      <h2 class="mt-4 text-3xl font-bold text-slate-900 tabular-nums dark:text-white">
        <span id="resultat-points"></span>
      </h2>
      <p id="resultat-resume" class="mt-2 text-slate-500 dark:text-slate-400"></p>
      <p id="resultat-temps" class="mt-1 hidden text-sm text-slate-500 dark:text-slate-400"></p>
    </div>

    <!--
      LES DEUX PANNEAUX DE LA COPIE (C4), en tête et repliables.

      Repliés par défaut : ce qu'on vient chercher d'abord est sa note, et
      déplier soixante zones avant de l'avoir lue serait un mur. Ils
      n'apparaissent que pour une épreuve rendue sur copie.
    -->
    <div id="panneaux-copie" class="mt-8 hidden space-y-3">
      <details id="panneau-themes" class="rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-800">
        <summary class="cible-tactile cursor-pointer text-sm font-semibold text-slate-900 dark:text-white">
          Thèmes et questions
        </summary>
        <div id="themes-copie" class="mt-2"></div>
      </details>
      <details id="panneau-feuille" class="rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-800">
        <summary class="cible-tactile cursor-pointer text-sm font-semibold text-slate-900 dark:text-white">
          Feuille de réponse
        </summary>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          Le formulaire compte 60 zones quel que soit le nombre de questions. Les zones au-delà de
          la dernière question restent vides, comme sur la feuille remise le jour de l’épreuve.
        </p>
        <div id="feuille-copie" class="mt-3"></div>
      </details>
    </div>

    <h3 class="mt-10 mb-2 text-sm font-semibold text-slate-900 dark:text-white">Détail par rubrique</h3>
    <div class="defilement-fin overflow-x-auto">
      <table class="w-full min-w-[34rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
            <th class="py-2 pr-3 font-medium">Rubrique</th>
            <th class="py-2 pr-3 text-right font-medium">Posées</th>
            <th class="py-2 pr-3 text-right font-medium">Bonnes</th>
            <th class="py-2 pr-3 text-right font-medium">Fausses</th>
            <th class="py-2 pr-3 text-right font-medium">Sans réponse</th>
            <th class="py-2 text-right font-medium">Points</th>
          </tr>
        </thead>
        <tbody id="tableau-rubriques"></tbody>
      </table>
    </div>

    <h3 id="titre-revoir" class="mt-10 mb-2 hidden text-sm font-semibold text-slate-900 dark:text-white">
      À revoir
    </h3>
    <div id="revoir-dgfip" class="space-y-3"></div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <button id="rejouer-dgfip" class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700">
        Nouvelle épreuve
      </button>
      <a
        href={`${base}/quiz/`}
        class="rounded-lg border border-slate-300 px-5 py-2.5 font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
      >
        Retour aux quiz
      </a>
    </div>
  </section>
</Base>

<script>
  import { choisirUneIssue, confirmer } from '../../lib/boite';
  import { unSeulGeste } from '../../lib/geste';
  import {
    PHRASE_DE_REFUS,
    questionsDeLEpreuve,
    refusDeReprise,
  } from '../../lib/noyau/epreuve-en-cours';
  import { auDeverrouillage } from '../../lib/chargement';
  import { chargerBanqueDgfip, chargerManifeste, type BanqueDgfip } from '../../lib/contenu';
  import {
    effacerEpreuveEnCours,
    ecrireEpreuveEnCours,
    enregistrerSessionDgfip,
    etatsQuestionsDgfip,
    lireEpreuveEnCours,
    toutesLesSessionsDgfip,
    type SessionDgfip,
  } from '../../lib/db';
  import { gagnerXp, xpQuiz } from '../../lib/gamification';
  import {
    composerSession,
    dureeEnClair,
    evaluer,
    FORMATS,
    formaterPoints,
    noter,
    questionsServables,
    secondesDuFormat,
    tailleReelle,
    type FormatEpreuve,
    type QuestionTiree,
    type ReponseSession,
  } from '../../lib/qcm';
  import {
    cocher,
    cocherAnn,
    estPosableSurUneCopie,
    issueDeLaZone,
    raisonDuRetrait,
    LIBELLE_DU_MOTIF,
    ligneRetenue,
    lireLaZone,
    zoneVide,
    type Zone,
  } from '../../lib/qcm-copie';
  import {
    monterLaFeuille,
    monterLeSujet,
    monterLesThemes,
    zoneDeReponse,
    type LigneDeTheme,
  } from '../../features/copie/monter';
  import {
    presentationReglee,
    type PresentationDgfip,
  } from '../../lib/presentation-dgfip';
  import {
    compositionAdaptee,
    compositionDeLaCopie,
    rubriquesEnManque,
  } from '../../lib/qcm-composition';
  import { echapper, formaterDate, notifier, pluriel } from '../../lib/ui';
  import { jourISO } from '../../lib/db';
  import { idParcoursCourant } from '../../lib/parcours/courant';
  import { MATIERE_DGFIP, signalerErreur } from '../../lib/journal';
  import { enregistrerReponse } from '../../lib/niveau';
  import { insecables } from '../../lib/typographie';
  import { demonterCorrection, monterCorrection } from '../../features/correction/qcm/monter';
  import { boutonAssistant } from '../../features/assistant/monter';
  import { contexteDgfip } from '../../features/assistant/fournisseurs';

  let banque: BanqueDgfip | null = null;
  /** Formats effectivement proposés, la banque étant ce qu'elle est. */
  let formats: FormatEpreuve[] = [];
  let questions: QuestionTiree[] = [];
  /** Indices cochés pour chaque question, dans l'ordre du tirage. */
  let choix: number[][] = [];
  let position = 0;
  /** Quand l'épreuve en cours a été commencée, pour la garder telle quelle. */
  let debutDeLEpreuve = '';
  /** Le format tiré, pour que la reprise le retrouve. */
  let formatCourant = '';

  /* ── L'état propre à la copie ──────────────────────────────────────────── */

  let presentation: PresentationDgfip = 'copie';
  /** Une zone par question, dans l'ordre du sujet. */
  let zones: Zone[] = [];
  /** Le compte à rebours : secondes restantes, et le battement qui les décompte. */
  let restantes = 0;
  let battement: number | undefined;
  /** La durée accordée, pour pouvoir dire le temps utilisé à la fin. */
  let accordees = 0;

  const $ = (id: string) => document.getElementById(id)!;

  function afficherVue(nom: 'accueil-dgfip' | 'epreuve' | 'copie' | 'resultat-dgfip') {
    for (const section of ['accueil-dgfip', 'epreuve', 'copie', 'resultat-dgfip']) {
      $(section).classList.toggle('hidden', section !== nom);
    }
    window.scrollTo({ top: 0 });
  }

  // --- Accueil ---------------------------------------------------------------

  function afficherRubriques() {
    const zone = $('rubriques-dgfip');
    zone.innerHTML = '';
    for (const r of banque?.rubriques ?? []) {
      const ligne = document.createElement('div');
      ligne.className =
        'flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm dark:border-slate-800 dark:bg-slate-900';
      ligne.innerHTML =
        `<span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-200">${echapper(r.nom)}</span>` +
        `<span class="shrink-0 text-xs text-slate-400 tabular-nums">${pluriel(r.total, 'question')}</span>`;
      zone.appendChild(ligne);
    }
  }

  async function afficherHistorique() {
    const sessions = (await toutesLesSessionsDgfip()).slice(-5).reverse();
    const zone = $('historique-dgfip');
    zone.innerHTML = '';
    if (!sessions.length) return;

    const titre = document.createElement('h2');
    titre.className = 'mb-3 text-lg font-semibold text-slate-900 dark:text-white';
    titre.textContent = 'Dernières épreuves';
    zone.appendChild(titre);

    const liste = document.createElement('div');
    liste.className = 'space-y-2';
    for (const s of sessions) {
      // Le barème pouvant faire descendre sous zéro, on situe le score sur
      // l'échelle réelle plutôt qu'en pourcentage de bonnes réponses.
      const taux = s.maximum ? s.points / s.maximum : 0;
      const couleur =
        taux >= 0.7
          ? 'text-emerald-600 dark:text-emerald-400'
          : taux >= 0.4
            ? 'text-amber-600 dark:text-amber-400'
            : 'text-red-600 dark:text-red-400';
      /*
         Une épreuve rendue sur copie se ROUVRE : son écran de fin porte la
         feuille remplie et le bilan par thème, et c'est là qu'on revient
         chercher ce qu'on a raté. Les autres restent des lignes de bilan,
         comme avant — on n'a pas de quoi reconstituer leur déroulé.
      */
      const surCopie = s.format === 'copie';
      const ligne = document.createElement(surCopie ? 'button' : 'div');
      if (surCopie) {
        (ligne as HTMLButtonElement).type = 'button';
        ligne.setAttribute(
          'aria-label',
          `Rouvrir la copie du ${formaterDate(s.le)}, ${formaterPoints(s.points)} sur ${s.maximum}`,
        );
        ligne.addEventListener('click', () => void rouvrirUneCopie(s));
      }
      ligne.className =
        'flex w-full items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-left text-sm dark:border-slate-800 dark:bg-slate-900' +
        (surCopie ? ' cible-tactile-pleine transition hover:bg-slate-50 dark:hover:bg-slate-800' : '');
      ligne.innerHTML =
        `<span class="min-w-0 flex-1 text-slate-700 dark:text-slate-200">` +
        (surCopie
          ? '<span class="mr-2 rounded border border-slate-300 px-1.5 py-0.5 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300">Copie</span>'
          : '') +
        `${pluriel(s.bonnes, 'bonne')} · ${pluriel(s.mauvaises, 'erreur')} · ${s.abstentions} sans réponse</span>` +
        `<span class="shrink-0 text-xs text-slate-400">${formaterDate(s.le)}</span>` +
        `<span class="shrink-0 font-semibold tabular-nums ${couleur}">${formaterPoints(s.points)}/${s.maximum}</span>`;
      liste.appendChild(ligne);
    }
    zone.appendChild(liste);
  }

  // --- L'épreuve gardée pour plus tard (C3 du 43) -----------------------------

  /**
   * Montre, ou non, le bloc de reprise.
   *
   * Trois sorts, et ils ne se confondent pas : aucune épreuve gardée, et le
   * bloc n'existe pas ; une épreuve reprenable, et il propose les deux
   * gestes ; une épreuve que la banque ne permet plus de reprendre, et il le
   * dit, efface le brouillon, et laisse « Commencer » juste en dessous.
   *
   * L'effacement d'un brouillon refusé est immédiat, et c'est voulu : le
   * garder reviendrait à reposer la même question à chaque visite, avec la
   * même réponse.
   */
  async function afficherReprise() {
    const bloc = $('reprise-dgfip');
    const gardee = await lireEpreuveEnCours();
    bloc.classList.add('hidden');
    if (!gardee || !banque) return;

    /*
       « Servables » se calcule avec la MÊME fonction qui compose une épreuve
       neuve : si les deux divergeaient, on pourrait refuser une reprise que
       le tirage aurait pourtant acceptée, ou l'inverse.
    */
    const connues = new Set(banque.questions.map((q) => q.id));
    const servables = new Set(
      questionsServables(banque, idParcoursCourant(), jourISO()).map((q) => q.id),
    );
    const refus = refusDeReprise(gardee, connues, servables);

    for (const id of ['reprendre-dgfip', 'jeter-dgfip']) {
      $(id).classList.toggle('hidden', refus !== null);
    }
    if (refus !== null) {
      $('reprise-texte').textContent = PHRASE_DE_REFUS;
      await effacerEpreuveEnCours();
    } else {
      const debut = new Date(gardee.le).toLocaleDateString('fr-FR', {
        day: 'numeric',
        month: 'long',
      });
      $('reprise-texte').textContent =
        `Vous avez gardé une épreuve commencée le ${debut}, à la question ` +
        `${gardee.position + 1} sur ${gardee.questionIds.length}.`;
    }
    bloc.classList.remove('hidden');
  }

  /** Reprend l'épreuve gardée, exactement où elle était. */
  async function reprendre() {
    const gardee = await lireEpreuveEnCours();
    if (!gardee || !banque) return;
    const parId = new Map(banque.questions.map((q) => [q.id, q]));
    const reprises = questionsDeLEpreuve(gardee, parId);
    if (!reprises) {
      await afficherReprise();
      return;
    }
    questions = reprises;
    choix = gardee.choix.map((c) => [...c]);
    position = gardee.position;
    /* Le brouillon est consommé : on ne garde pas une épreuve qu'on est en
       train de passer. Quitter à nouveau en écrira un neuf. */
    await effacerEpreuveEnCours();
    $('reprise-dgfip').classList.add('hidden');
    afficherVue('epreuve');
    afficherQuestion();
  }

  /** Garde l'épreuve en cours pour plus tard. */
  async function garderPourPlusTard() {
    await ecrireEpreuveEnCours({
      le: debutDeLEpreuve,
      formatId: formatCourant,
      parcoursId: idParcoursCourant(),
      questionIds: questions.map((q) => q.id),
      /* L'ordre des propositions, sans quoi la reprise les remélangerait :
         mêmes questions, autre écran, et des cases cochées qui sembleraient
         avoir bougé toutes seules. */
      ordres: questions.map((q) => [...q.ordre]),
      choix: choix.map((c) => [...c]),
      position,
    });
  }

  /**
   * Rouvre une copie rendue : le même écran de fin, reconstruit.
   *
   * ## Pourquoi reconstruire, et non enregistrer l'écran
   *
   * L'historique garde les zones et l'ordre d'affichage de chaque question,
   * mais pas leur texte : il vit dans la banque, et le recopier l'y aurait
   * figé — une correction améliorée ne serait jamais parvenue aux épreuves
   * passées. On relit donc la banque, et l'on recalcule la note par le même
   * `noter` que le jour de l'épreuve.
   *
   * ## Ce qui arrive quand une question a disparu
   *
   * La banque est republiée à chaque mise en ligne, et une question peut en
   * sortir. On refuse alors d'ouvrir plutôt que de montrer une feuille
   * décalée d'une ligne : renuméroter en silence ferait correspondre une
   * réponse à la mauvaise question, ce qui est exactement le piège que la
   * feuille pré-imprimée apprend à éviter.
   */
  async function rouvrirUneCopie(session: SessionDgfip) {
    const enregistrees = session.zones ?? [];
    if (!banque || !enregistrees.length) {
      notifier('Cette épreuve n’a pas gardé sa feuille de réponse.', 'badge');
      return;
    }
    const parId = new Map(banque.questions.map((q) => [q.id, q]));
    const introuvables = enregistrees.filter((z) => !parId.has(z.id)).length;
    if (introuvables > 0) {
      notifier(
        `Cette copie ne peut plus être rouverte : ${introuvables} de ses questions ` +
          'ne sont plus dans la banque.',
        'badge',
      );
      return;
    }

    questions = enregistrees.map((z) => ({ ...parId.get(z.id)!, ordre: z.ordre }));
    zones = enregistrees.map((z) => ({
      premiere: { cases: [...z.premiere.cases], ann: z.premiere.ann },
      seconde: { cases: [...z.seconde.cases], ann: z.seconde.ann },
    }));
    accordees = 0;

    const reponses: ReponseSession[] = questions.map((question, i) => {
      const lecture = lireLaZone(zones[i]);
      const ligne = zones[i][ligneRetenue(zones[i])];
      return {
        question,
        choisis:
          lecture.motif === 'reponse-multiple'
            ? [...ligne.cases]
            : lecture.retenue === null
              ? []
              : [lecture.retenue],
        issue: issueDeLaZone(lecture, question.bonnes),
      };
    });
    /*
       Rien n'est réenregistré : rouvrir n'est pas repasser l'épreuve. Ni
       journal d'erreurs, ni estimation de niveau, ni points d'expérience —
       sans quoi relire ses résultats ferait monter son niveau.
    */
    afficherResultat(noter(reponses, banque.rubriques), reponses, session);
  }

  // --- Déroulé de l'épreuve --------------------------------------------------

  async function demarrer() {
    if (!banque?.questions.length) return;
    const choisi = ($('format-dgfip') as HTMLSelectElement).value;
    const format = formats.find((f) => f.id === choisi) ?? formats[0];
    if (!format) return;
    presentation = (($('presentation-dgfip') as HTMLSelectElement).value ||
      'copie') as PresentationDgfip;
    const surUneCopie = presentation === 'copie';
    questions = composerSession(
      banque,
      await etatsQuestionsDgfip(),
      format,
      idParcoursCourant(),
      { surUneCopie },
    );
    if (!questions.length) return;
    choix = questions.map(() => []);
    zones = questions.map(() => zoneVide());
    position = 0;
    debutDeLEpreuve = new Date().toISOString();
    formatCourant = format.id;
    if (surUneCopie) {
      demarrerLaCopie(format);
      return;
    }
    afficherVue('epreuve');
    afficherQuestion();
  }

  /* ── La copie de concours ──────────────────────────────────────────────── */

  function demarrerLaCopie(format: FormatEpreuve) {
    accordees = secondesDuFormat(format);
    restantes = accordees;
    afficherVue('copie');
    /*
       La formulation est celle que le pilote a arrêtée le 19 octobre : le
       chiffre vient du guide ENFiP, et aucun arrêté ne découpe l'épreuve
       entre le QCM et les QRC. Le dire est ce qui distingue un repère d'une
       règle.
    */
    $('rebours-repere').textContent =
      `${dureeEnClair(accordees)} au total. Repère du guide ENFiP ` +
      '(2 min par question), pas une durée réglementaire.';
    peindreLaCopie();
    peindreLeRebours();
    lancerLeRebours();
  }

  function peindreLaCopie() {
    monterLeSujet($('copie-sujet'), {
      questions,
      zones,
      surCocher: (indice, ligne, option) => {
        /*
           Cocher ne décoche jamais, et `cocher` rend la même zone si la case
           l'était déjà : deux appuis rapides sur la même case ne font donc
           qu'un trait de stylo. Deux cases différentes sur une ligne, en
           revanche, font bien une réponse multiple — c'est permis, et la
           directive 4 s'en occupe à la correction.
        */
        zones[indice] = cocher(zones[indice], ligne, option);
        rafraichirLaZone(indice);
      },
      surAnnuler: (indice, ligne) => {
        zones[indice] = cocherAnn(zones[indice], ligne);
        rafraichirLaZone(indice);
      },
    });
  }

  /**
   * Redessine une seule zone.
   *
   * Et non le sujet entier : à quarante-cinq questions, chaque case cochée
   * referait quatre cents éléments et replierait l'aide ouverte. La zone
   * remplacée garde sa place dans le document.
   */
  function rafraichirLaZone(indice: number) {
    const ancienne = $('copie-sujet').querySelector(`[data-zone="${indice + 1}"]`);
    if (!ancienne) return;
    const neuve = zoneDeReponse({
      numeroDeQuestion: indice + 1,
      question: questions[indice],
      zone: zones[indice],
      surCocher: (ligne, option) => {
        zones[indice] = cocher(zones[indice], ligne, option);
        rafraichirLaZone(indice);
      },
      surAnnuler: (ligne) => {
        zones[indice] = cocherAnn(zones[indice], ligne);
        rafraichirLaZone(indice);
      },
    });
    ancienne.replaceWith(neuve);
  }

  function peindreLeRebours() {
    const minutes = Math.floor(restantes / 60);
    const secondes = restantes % 60;
    $('rebours').textContent = `${minutes} min ${String(secondes).padStart(2, '0')} s`;
    /*
       Les dix dernières minutes se signalent par la couleur ET par le mot :
       un compte à rebours qui ne change que de teinte ne dit rien à qui ne
       distingue pas les teintes.
    */
    const presse = restantes <= 600;
    $('rebours').className = presse
      ? 'text-xl font-semibold text-red-700 tabular-nums dark:text-red-300'
      : 'text-xl font-semibold text-slate-900 tabular-nums dark:text-white';
    $('rebours').setAttribute(
      'aria-label',
      `Temps restant : ${minutes} minutes et ${secondes} secondes${presse ? ', dernière demi-heure' : ''}`,
    );
  }

  /**
   * Lance le compte à rebours. Rien ne l'arrête avant zéro.
   *
   * **Aucune pause**, c'est la décision d'Alexis du 18 octobre et l'interdit
   * n° 3 : le chronomètre d'un concours ne s'arrête pas. Il n'y a donc ni
   * bouton de pause, ni mise en veille sur changement d'onglet — et c'est
   * exprès, parce qu'un chronomètre qu'on peut arrêter ne mesure plus rien.
   */
  function lancerLeRebours() {
    arreterLeRebours();
    battement = window.setInterval(() => {
      restantes -= 1;
      if (restantes <= 0) {
        restantes = 0;
        peindreLeRebours();
        /*
           À zéro, LA COPIE EST RAMASSÉE. Pas de délai de grâce, pas de
           question posée : c'est ce qui arrive le jour de l'épreuve.
        */
        notifier('Temps écoulé : votre copie est ramassée.', 'badge');
        void ramasserLaCopie();
        return;
      }
      peindreLeRebours();
    }, 1000);
  }

  function arreterLeRebours() {
    if (battement !== undefined) window.clearInterval(battement);
    battement = undefined;
  }

  /** Vide toutes les zones, et laisse le chronomètre courir. */
  async function nouvelleFeuille() {
    if (
      !(await confirmer({
        titre: 'Demander une nouvelle feuille ?',
        texte:
          'Toutes vos réponses seront effacées. Le sujet et le chronomètre ' +
          'continuent : le temps ne vous est pas rendu, comme au concours.',
        action: 'Demander une nouvelle feuille',
        annuler: 'Garder ma copie',
        destructrice: true,
      }))
    ) {
      return;
    }
    zones = questions.map(() => zoneVide());
    peindreLaCopie();
  }

  async function rendreLaCopie() {
    if (
      !(await confirmer({
        titre: 'Rendre la copie ?',
        texte:
          'Votre copie sera corrigée et enregistrée. Vous ne pourrez plus la ' +
          'modifier.',
        action: 'Rendre la copie',
        annuler: 'Continuer l’épreuve',
      }))
    ) {
      return;
    }
    await ramasserLaCopie();
  }

  /**
   * Dépouille la copie : une zone donne une réponse, et un motif.
   *
   * Pour une réponse multiple, on garde les cases réellement cochées plutôt
   * que rien : l'écran de fin doit pouvoir montrer la faute, et « votre
   * réponse : — » ne l'apprendrait pas.
   */
  async function ramasserLaCopie() {
    arreterLeRebours();
    const reponses: ReponseSession[] = questions.map((question, i) => {
      const lecture = lireLaZone(zones[i]);
      const ligne = zones[i][ligneRetenue(zones[i])];
      return {
        question,
        choisis:
          lecture.motif === 'reponse-multiple'
            ? [...ligne.cases]
            : lecture.retenue === null
              ? []
              : [lecture.retenue],
        issue: issueDeLaZone(lecture, question.bonnes),
      };
    });
    await conclure(reponses, {
      format: 'copie',
      secondes: accordees - restantes,
      zones: questions.map((question, i) => ({
        id: question.id,
        ordre: question.ordre,
        premiere: { cases: [...zones[i].premiere.cases], ann: zones[i].premiere.ann },
        seconde: { cases: [...zones[i].seconde.cases], ann: zones[i].seconde.ann },
      })),
    });
  }

  function afficherQuestion() {
    const q = questions[position];
    const multiple = q.bonnes.length > 1;

    $('rubrique-courante').textContent = q.rubrique;
    $('enonce-dgfip').textContent = insecables(q.question);
    $('consigne-dgfip').textContent = multiple
      ? 'Plusieurs réponses attendues — le point n’est acquis que si la sélection est exacte.'
      : 'Une seule réponse attendue.';
    $('compteur-dgfip').textContent = `Question ${position + 1} sur ${questions.length}`;
    $('barre-dgfip').style.transform = `scaleX(${Math.round((position / questions.length) * 100) / 100})`;
    ($('precedent-dgfip') as HTMLButtonElement).disabled = position === 0;
    $('suivant-dgfip').textContent =
      position === questions.length - 1 ? 'Terminer l’épreuve' : 'Suivant';

    const zone = $('options-dgfip');
    zone.innerHTML = '';
    for (const index of q.ordre) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.dataset.index = String(index);
      bouton.setAttribute('role', multiple ? 'checkbox' : 'radio');
      bouton.textContent = insecables(q.options[index]);
      bouton.addEventListener('click', () => basculer(index, multiple));
      zone.appendChild(bouton);
    }
    peindreOptions();
  }

  /** Coche ou décoche une option ; décocher revient à s'abstenir. */
  function basculer(index: number, multiple: boolean) {
    const actuels = choix[position];
    if (multiple) {
      choix[position] = actuels.includes(index)
        ? actuels.filter((i) => i !== index)
        : [...actuels, index];
    } else {
      choix[position] = actuels.includes(index) ? [] : [index];
    }
    peindreOptions();
  }

  function peindreOptions() {
    const coches = new Set(choix[position]);
    for (const bouton of $('options-dgfip').querySelectorAll<HTMLButtonElement>('button')) {
      const actif = coches.has(Number(bouton.dataset.index));
      bouton.setAttribute('aria-checked', String(actif));
      bouton.className = actif
        ? 'w-full rounded-xl border-2 border-indigo-500 bg-indigo-50 px-4 py-3 text-left font-medium text-indigo-900 transition dark:bg-indigo-950/60 dark:text-indigo-100'
        : 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-left transition hover:border-indigo-400 hover:bg-indigo-50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-600 dark:hover:bg-indigo-950/50';
    }
  }

  function avancer() {
    if (position < questions.length - 1) {
      position += 1;
      afficherQuestion();
    } else {
      void terminer();
    }
  }

  function reculer() {
    if (position === 0) return;
    position -= 1;
    afficherQuestion();
  }

  // --- Résultat --------------------------------------------------------------

  async function terminer() {
    /*
       Le brouillon est consommé par la fin de l'épreuve : elle devient une
       `SessionDgfip`, et garder les deux laisserait une épreuve « en cours »
       qu'on a pourtant finie. Effacé en premier, avant l'écriture du
       résultat : si l'écriture échouait, mieux vaut avoir perdu un brouillon
       qu'en garder un qui ne correspond plus à rien.
    */
    await effacerEpreuveEnCours();
    const reponses: ReponseSession[] = questions.map((question, i) => ({
      question,
      choisis: choix[i],
      issue: evaluer(question, choix[i]),
    }));
    await conclure(reponses, {});
  }

  /**
   * Ce qui suit la remise, quelle que soit la présentation.
   *
   * Les deux formats se séparent sur la façon de RECUEILLIR les réponses — un
   * écran par question, ou une feuille entière — et pas d'un pouce sur ce
   * qu'on en fait : même barème, même journal d'erreurs, même estimation de
   * niveau, même historique, mêmes points d'expérience. Deux copies de cette
   * fonction auraient divergé au premier ajustement, et c'est la note qui
   * aurait divergé avec elles.
   */
  async function conclure(reponses: ReponseSession[], extra: Partial<SessionDgfip>) {
    const score = noter(reponses, banque?.rubriques ?? []);

    const session: SessionDgfip = {
      le: new Date().toISOString(),
      posees: score.posees,
      bonnes: score.bonnes,
      mauvaises: score.mauvaises,
      abstentions: score.abstentions,
      points: score.points,
      maximum: score.maximum,
      parRubrique: score.parRubrique,
      ...extra,
    };
    // Les réponses fausses ouvrent une entrée au journal d'erreurs. Les
    // abstentions n'en ouvrent pas : ne pas répondre n'est pas se tromper, et
    // le barème sanctionne déjà le remplissage au hasard.
    for (const r of reponses) {
      // L'abstention ne dit rien du niveau : elle n'alimente pas l'estimation.
      if (r.issue !== 'abstention') {
        await enregistrerReponse({
          itemId: r.question.id,
          resultat: r.issue === 'bonne' ? 1 : 0,
          matiere: MATIERE_DGFIP,
          fascicule: r.question.rubrique,
          source: 'dgfip',
        });
      }
      if (r.issue !== 'mauvaise') continue;
      await signalerErreur({
        id: r.question.id,
        genre: 'dgfip',
        matiere: MATIERE_DGFIP,
        rubriqueId: r.question.rubriqueId,
      });
    }

    await enregistrerSessionDgfip(
      session,
      reponses.map((r) => ({
        id: r.question.id,
        rubriqueId: r.question.rubriqueId,
        issue: r.issue,
      })),
    );

    // Les XP récompensent les bonnes réponses, jamais le remplissage au hasard :
    // le barème s'en charge déjà pour la note, autant rester cohérent.
    const gain = await gagnerXp(xpQuiz(score.bonnes), {
      quiz: 1,
      bonnes: score.bonnes,
      reponses: score.bonnes + score.mauvaises,
    });
    if (gain.monteeDeNiveau) notifier(`Niveau ${gain.niveau.niveau} atteint !`, 'badge');
    for (const badge of gain.nouveauxBadges) notifier(`Badge obtenu : ${badge.nom}`, 'badge');

    afficherResultat(score, reponses, session);
  }

  /**
   * Les deux panneaux de l'écran de fin : les thèmes, et la feuille.
   *
   * Les deux se construisent à partir des **zones enregistrées**, et non des
   * zones encore en mémoire : c'est le même chemin pour une épreuve qu'on
   * vient de rendre et pour une épreuve qu'on rouvre depuis l'historique. Deux
   * chemins auraient fini par montrer deux choses.
   */
  function remplirLesPanneaux(
    score: ReturnType<typeof noter>,
    reponses: ReponseSession[],
    session: SessionDgfip,
  ) {
    const enregistrees = session.zones ?? [];
    const questionsDuSujet = reponses.map((r) => r.question);
    const zonesRelues: Zone[] = enregistrees.map((z) => ({
      premiere: { cases: [...z.premiere.cases], ann: z.premiere.ann },
      seconde: { cases: [...z.seconde.cases], ann: z.seconde.ann },
    }));

    /* ── Thèmes et questions ──────────────────────────────────────────────── */
    const pointsParRubrique = new Map(
      score.parRubrique.map((r) => [r.rubriqueId, formaterPoints(r.points)]),
    );
    const parRubrique = new Map<string, LigneDeTheme>();
    reponses.forEach((reponse, indice) => {
      const clef = reponse.question.rubriqueId;
      const ligne =
        parRubrique.get(clef) ??
        {
          rubrique: reponse.question.rubrique,
          numeros: [],
          issues: [],
          points: `${pointsParRubrique.get(clef) ?? '0'} point${
            (score.parRubrique.find((r) => r.rubriqueId === clef)?.points ?? 0) > 1 ? 's' : ''
          }`,
        };
      ligne.numeros.push(indice + 1);
      ligne.issues.push(reponse.issue);
      parRubrique.set(clef, ligne);
    });

    monterLesThemes($('themes-copie'), [...parRubrique.values()], (numero) => {
      /*
         Toucher un numéro mène à sa correction — et quand il n'y en a pas,
         parce que la réponse était juste, il mène à sa zone sur la feuille.
         Un bouton qui ne fait rien serait pire que pas de bouton.
      */
      const carte = document.getElementById(`revoir-q${numero}`);
      if (carte) {
        carte.scrollIntoView({ block: 'center' });
        return;
      }
      ($('panneau-feuille') as HTMLDetailsElement).open = true;
      $('feuille-copie')
        .querySelector(`[data-zone-finale="${numero}"]`)
        ?.scrollIntoView({ block: 'center' });
    });

    /* ── La feuille de réponse, ses soixante zones ────────────────────────── */
    monterLaFeuille($('feuille-copie'), {
      questions: questionsDuSujet,
      zones: zonesRelues,
      bonnes: questionsDuSujet.map((q) => q.bonnes),
    });
  }

  function afficherResultat(
    score: ReturnType<typeof noter>,
    reponses: ReponseSession[],
    session: SessionDgfip,
  ) {
    const taux = score.maximum ? score.points / score.maximum : 0;
    $('resultat-emoji-dgfip').textContent = taux >= 0.7 ? '🎯' : taux >= 0.4 ? '💪' : '📚';
    $('resultat-points').textContent = `${formaterPoints(score.points)} / ${score.maximum}`;
    $('resultat-resume').textContent =
      `${pluriel(score.bonnes, 'bonne réponse', 'bonnes réponses')}, ` +
      `${pluriel(score.mauvaises, 'erreur')} ` +
      `(${formaterPoints(score.mauvaises * -0.5)} ${score.mauvaises > 1 ? 'points' : 'point'}), ` +
      `${score.abstentions} sans réponse.`;

    /* ── Le temps utilisé, et les deux panneaux de la copie (C4) ────────── */
    const surCopie = session.format === 'copie';
    $('panneaux-copie').classList.toggle('hidden', !surCopie);
    $('resultat-temps').classList.toggle('hidden', session.secondes === undefined);
    if (session.secondes !== undefined) {
      $('resultat-temps').textContent =
        `Temps utilisé : ${dureeEnClair(session.secondes)} sur ${dureeEnClair(accordees || session.secondes)}.`;
    }
    if (surCopie) {
      remplirLesPanneaux(score, reponses, session);
    }

    const corps = $('tableau-rubriques');
    corps.innerHTML = '';
    for (const ligne of score.parRubrique) {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 dark:border-slate-800';
      tr.innerHTML =
        `<td class="py-2 pr-3 text-slate-700 dark:text-slate-200">${echapper(ligne.rubrique)}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-slate-500 dark:text-slate-400">${ligne.posees}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-emerald-600 dark:text-emerald-400">${ligne.bonnes}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-red-600 dark:text-red-400">${ligne.mauvaises}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-slate-500 dark:text-slate-400">${ligne.abstentions}</td>` +
        `<td class="py-2 text-right font-semibold tabular-nums text-slate-900 dark:text-white">${formaterPoints(ligne.points)}</td>`;
      corps.appendChild(tr);
    }

    /*
       Le motif de chaque question, lu dans les zones enregistrées. Absent
       pour « une question à la fois », où la notion n'a pas de sens.
    */
    const motifParQuestion = new Map<string, string>();
    for (const enregistree of session.zones ?? []) {
      const lecture = lireLaZone({
        premiere: { ...enregistree.premiere },
        seconde: { ...enregistree.seconde },
      });
      motifParQuestion.set(enregistree.id, LIBELLE_DU_MOTIF[lecture.motif]);
    }

    // Les abstentions figurent à revoir au même titre que les erreurs : ne pas
    // savoir et se tromper sont deux lacunes, seule la note les distingue.
    const aRevoir = reponses.filter((r) => r.issue !== 'bonne');
    $('titre-revoir').classList.toggle('hidden', aRevoir.length === 0);
    const zone = $('revoir-dgfip');
    zone.innerHTML = '';
    for (const r of aRevoir) {
      const bonnes = r.question.bonnes.map((i) => r.question.options[i]).join(' · ');
      const donnee = r.choisis.length
        ? r.choisis.map((i) => r.question.options[i]).join(' · ')
        : null;
      // La provenance n'est utile que lorsqu'elle renvoie à une annale : la
      // mentionner pour les questions rédigées ici n'apprendrait rien.
      const annale = r.question.source && !r.question.source.startsWith('RevINSP')
        ? r.question.source
        : null;
      const carte = document.createElement('article');
      /*
         L'identifiant porte le NUMÉRO DE LA QUESTION dans le sujet, pour que
         le bilan par thème puisse y conduire. Il est posé pour les deux
         présentations : le coût est nul, et un identifiant conditionnel est
         un identifiant qu'on oublie.
      */
      carte.id = `revoir-q${questions.indexOf(r.question) + 1}`;
      carte.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm dark:border-slate-800 dark:bg-slate-900';
      carte.innerHTML =
        `<p class="etiquette text-slate-400">${echapper(r.question.rubrique)}` +
        (annale ? ` · ${echapper(annale)}` : '') +
        `</p>` +
        `<p class="mt-1 font-medium text-slate-900 dark:text-white">${echapper(r.question.question)}</p>` +
        (donnee
          ? `<p class="mt-2 text-red-600 dark:text-red-400">Votre réponse : ${echapper(donnee)}</p>`
          : `<p class="mt-2 text-slate-500 dark:text-slate-400">Sans réponse.</p>`) +
        /*
           D'OÙ VIENT LA RÉPONSE RETENUE, sur une copie. « 2ᵉ ligne » et
           « réponse multiple » ne s'apprennent pas de la même façon : la
           première est une correction réussie, la seconde une faute de
           remplissage qui a coûté un demi-point sans que la connaissance soit
           en cause.
        */
        (motifParQuestion.get(r.question.id)
          ? `<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Ligne retenue : ` +
            `${echapper(motifParQuestion.get(r.question.id)!)}</p>`
          : '') +
        `<p class="mt-1 text-emerald-700 dark:text-emerald-400">Réponse attendue : ${echapper(bonnes)}</p>` +
        `<p class="mt-2 text-slate-600 dark:text-slate-300">${echapper(r.question.explication)}</p>` +
        (r.question.incertain
          ? `<p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300">` +
            `⚠ ${echapper(r.question.incertain)}</p>`
          : '');

      /*
       * La correction détaillée n'existe **que sur cet écran**, et c'est une
       * règle de l'épreuve, non une limite technique.
       *
       * Une session de QCM DGFiP est chronométrée et se joue au barème du
       * concours. Y glisser une correction après chaque question changerait la
       * nature de l'exercice : on ne mesurerait plus ce qu'on sait sous
       * contrainte de temps, mais ce qu'on apprend en chemin. Les deux sont
       * utiles ; les mélanger ne mesure plus rien.
       */
      const actions = document.createElement('div');
      actions.className = 'mt-3 flex flex-wrap gap-2';
      carte.appendChild(actions);

      if (r.question.correction) {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className =
          'rounded-lg border border-indigo-300 bg-white px-3 py-1.5 text-xs font-medium ' +
          'text-indigo-700 hover:bg-indigo-50 dark:border-indigo-700 dark:bg-slate-900 ' +
          'dark:text-indigo-300 dark:hover:bg-indigo-950/40';
        bouton.textContent = 'Correction détaillée';
        bouton.setAttribute('aria-expanded', 'false');
        const panneau = document.createElement('div');
        bouton.addEventListener('click', () => {
          const ouvert = panneau.childElementCount === 0;
          if (!ouvert) {
            demonterCorrection(panneau);
            bouton.setAttribute('aria-expanded', 'false');
            bouton.textContent = 'Correction détaillée';
            return;
          }
          bouton.setAttribute('aria-expanded', 'true');
          bouton.textContent = 'Replier la correction détaillée';
          monterCorrection(panneau, {
            correction: r.question.correction!,
            options: r.question.options,
            bonnes: r.question.bonnes,
            choisies: r.choisis,
            fermer: () => bouton.click(),
          });
        });
        actions.appendChild(bouton);
        carte.appendChild(panneau);
      }

      /*
       * « Demander à l'IA » suit la même règle que la correction détaillée :
       * seulement ici, sur l'écran de résultats. Une session de QCM DGFiP se
       * joue au barème du concours, et ouvrir un assistant entre deux questions
       * ne mesurerait plus rien.
       *
       * Pas d'extrait de cours dans ce contexte, et ce n'est pas un oubli :
       * Français, Logique et Maths ne correspondent à aucune fiche du
       * programme. Le fournisseur omet le bloc plutôt que d'en inventer un.
       */
      actions.appendChild(
        boutonAssistant({
          titre: 'Préparer une question pour une IA — question de QCM',
          itemId: r.question.id,
          matiere: r.question.rubrique,
          construireContexte: async (options) =>
            contexteDgfip({ question: r.question, choisies: r.choisis }, options),
        }),
      );

      zone.appendChild(carte);
    }

    afficherVue('resultat-dgfip');
  }

  // --- Mise en route ---------------------------------------------------------

  auDeverrouillage(async () => {
    const manifeste = await chargerManifeste();
    $('chargement').classList.add('hidden');
    afficherVue('accueil-dgfip');

    if (!manifeste.totaux.qcmDgfip) {
      $('dgfip-vide').classList.remove('hidden');
      ($('lancer-dgfip') as HTMLButtonElement).disabled = true;
      return;
    }

    banque = await chargerBanqueDgfip();
    afficherRubriques();
    /* La reprise se propose dès l'ouverture, et avant l'historique : c'est la
       seule chose de cet écran qui attend quelque chose de la personne. */
    await afficherReprise();
    await afficherHistorique();

    /*
       LES FORMATS DÉPENDENT DE LA PRÉSENTATION, et c'est pourquoi la liste se
       repeint quand on change de présentation.

       Un format dont les rubriques manquent ne doit pas être proposé, et un
       format que la banque ne remplit qu'à moitié le dit franchement. Sur une
       copie, le tirage est plus étroit — seules les questions à quatre
       propositions et réponse unique y entrent —, donc le compte change.
       Garder la liste de « une question à la fois » annoncerait 45 questions
       pour une copie qui n'en servirait que 30.
    */
    const peindreLesFormats = (): boolean => {
      const select = $('format-dgfip') as HTMLSelectElement;
      const surUneCopie =
        ($('presentation-dgfip') as HTMLSelectElement).value === 'copie';
      const avant = select.value;
      select.innerHTML = '';
      formats = [];
      for (const format of FORMATS) {
        const reelle = tailleReelle(banque!, format, idParcoursCourant(), undefined, {
          surUneCopie,
        });
        if (reelle === 0) continue;
        formats.push(format);
        const libelle =
          reelle < format.total
            ? `${format.libelle} — ${reelle} disponibles`
            : format.libelle;
        select.add(new Option(libelle, format.id));
      }
      /* On garde le format choisi s'il survit au changement de présentation. */
      if (formats.some((f) => f.id === avant)) select.value = avant;
      const possible = formats.length > 0;
      $('dgfip-vide').classList.toggle('hidden', possible);
      ($('lancer-dgfip') as HTMLButtonElement).disabled = !possible;
      direLesAnnoncesDeLaCopie(surUneCopie);
      return possible;
    };

    /**
     * Ce que la copie peut servir, dit avant de commencer.
     *
     * Deux annonces, et la seconde est la moins évidente. Le stock total ne
     * suffit pas à juger : une banque de trois cents questions conformes peut
     * très bien n'en avoir que trois en anglais, là où le sujet en prévoit
     * cinq. La longueur de l'épreuve serait préservée — `repartir` prend les
     * manquantes ailleurs —, mais sa structure ne le serait plus, et le titre
     * « sujet 2026 » deviendrait une promesse non tenue.
     */
    function direLesAnnoncesDeLaCopie(surUneCopie: boolean) {
      const stock = $('copie-disponibles');
      const compo = $('copie-composition');
      stock.classList.toggle('hidden', !surUneCopie);
      compo.classList.add('hidden');
      compo.innerHTML = '';
      if (!surUneCopie || !banque) return;

      /*
         Le nombre est CALCULÉ, jamais écrit en dur : la banque change à
         chaque publication, et un chiffre figé deviendrait faux en silence.
      */
      const servables = questionsServables(banque, idParcoursCourant());
      const posables = servables.filter(estPosableSurUneCopie).length;
      /*
         LE DÉTAIL DES ÉCARTS, et non un total. « 201 questions écartées »
         n'apprend rien ; « 201 n'ont pas quatre propositions » dit quoi
         corriger dans la banque. Et deux motifs existent : une zone porte
         quatre cases — ni trois, ni six —, et une seule réponse par ligne y
         est autorisée. Dire « plus de quatre propositions » serait faux pour
         les deux autres cas.
      */
      const motifs = servables.map(raisonDuRetrait);
      const horsGabarit = motifs.filter((m) => m === 'propositions').length;
      const aPlusieursReponses = motifs.filter((m) => m === 'reponses-multiples').length;
      const motifsDits = [
        horsGabarit > 0 ? `${horsGabarit} n’ont pas quatre propositions` : '',
        aPlusieursReponses > 0 ? `${aPlusieursReponses} ont plusieurs bonnes réponses` : '',
      ].filter(Boolean);
      stock.textContent =
        `${posables} questions disponibles pour la copie, sur ${servables.length}. ` +
        (motifsDits.length
          ? 'Une zone de la feuille porte quatre cases et une seule réponse par ligne : ' +
            `${motifsDits.join(' et ')}. Elles restent posées par « une question à la fois ».`
          : '');

      const format = formats.find((f) => f.id === ($('format-dgfip') as HTMLSelectElement).value);
      if (!format) return;

      /* La composition : on compare rubrique par rubrique, sur le stock posable. */
      const parRubrique = new Map<string, number>();
      for (const q of servables) {
        if (!estPosableSurUneCopie(q)) continue;
        parRubrique.set(q.rubriqueId, (parRubrique.get(q.rubriqueId) ?? 0) + 1);
      }
      const lignes = compositionDeLaCopie(
        banque.rubriques.map((r) => ({ ...r, total: parRubrique.get(r.id) ?? 0 })),
        format,
      );
      if (!compositionAdaptee(lignes)) return;

      compo.classList.remove('hidden');
      const titre = document.createElement('p');
      titre.className = 'font-medium';
      titre.textContent = 'Composition adaptée : ce format ne pourra pas suivre la structure du sujet.';
      const detail = document.createElement('ul');
      detail.className = 'mt-1 list-disc space-y-0.5 pl-5';
      for (const ligne of rubriquesEnManque(lignes)) {
        const li = document.createElement('li');
        li.textContent =
          `${ligne.rubrique} : ${ligne.servies} question${ligne.servies === 1 ? '' : 's'} ` +
          `sur les ${ligne.prevu} du sujet.`;
        detail.appendChild(li);
      }
      const fin = document.createElement('p');
      fin.className = 'mt-1';
      fin.textContent =
        'Les questions manquantes sont prises sur les autres rubriques du format : ' +
        'l’épreuve garde sa longueur, mais pas sa structure.';
      compo.append(titre, detail, fin);
    }

    $('reprendre-dgfip').addEventListener('click', () => void reprendre());
    $('jeter-dgfip').addEventListener('click', async () => {
      await effacerEpreuveEnCours();
      await afficherReprise();
    });
    /*
       Le défaut vient du réglage, et le réglage vaut « copie » tant qu'on n'y
       a pas touché (décision 1).
    */
    ($('presentation-dgfip') as HTMLSelectElement).value = presentationReglee();
    $('presentation-dgfip').addEventListener('change', () => void peindreLesFormats());
    /*
       La composition dépend du format autant que de la présentation : changer
       de format sans réévaluer laisserait l'annonce du précédent à l'écran.
    */
    $('format-dgfip').addEventListener('change', () => {
      direLesAnnoncesDeLaCopie(($('presentation-dgfip') as HTMLSelectElement).value === 'copie');
    });
    /*
       LA PREMIÈRE PEINTURE NE DÉCIDE PLUS DU RESTE DE L'ÉCRAN.

       Elle écrivait `if (!peindreLesFormats()) return;`, et c'était sans
       conséquence tant qu'aucun réglage ne pouvait changer ce qu'elle trouve :
       aucun format servable, aucun bouton utile, on s'arrêtait là.

       La présentation du 49 a rendu ce retour nuisible, et le train l'a
       montré. Son défaut vaut « copie » (décision 1), et une banque qui ne
       peut pas servir de copie ne propose alors aucun format : on sortait
       AVANT de brancher « Commencer ». La personne basculait sur « Une
       question à la fois », les formats paraissaient, le bouton s'activait —
       et l'appui ne faisait rien. Un bouton actif qui n'agit pas est pire
       qu'un bouton désactivé, qui au moins dit la vérité.

       La peinture ne fait donc plus que ce que son nom dit : elle remplit la
       liste et active ou désactive « Commencer ». `demarrer()` garde sa propre
       porte — pas de banque, pas de format, rien ne part.
    */
    peindreLesFormats();

    $('lancer-dgfip').addEventListener('click', () => void demarrer());
    /*
       `unSeulGeste` sur les deux boutons de la copie : ils ouvrent une
       fenêtre de confirmation, et deux appuis rapides en ouvraient deux.
    */
    $('nouvelle-feuille').addEventListener('click', (evenement) => {
      void unSeulGeste(evenement.currentTarget as Element, nouvelleFeuille);
    });
    $('rendre-copie').addEventListener('click', (evenement) => {
      void unSeulGeste(evenement.currentTarget as Element, rendreLaCopie);
    });
    $('rejouer-dgfip').addEventListener('click', () => void demarrer());
    $('suivant-dgfip').addEventListener('click', avancer);
    $('precedent-dgfip').addEventListener('click', reculer);
    $('quitter-dgfip').addEventListener('click', async () => {
      /*
         Rien n'est enregistré avant « terminer() » : quitter en cours
         d'épreuve perd les trente à quarante-cinq réponses déjà données. La
         demande dit donc ce qui se perd, et non « êtes-vous sûr ? », qui ne
         renseigne personne. Elle n'est posée que si l'épreuve a commencé —
         confirmer la sortie d'un écran où l'on n'a rien fait serait une
         friction sans objet.
      */
      const commencee = choix.some((c) => c.length > 0);
      /*
         TROIS ISSUES, depuis C3 du prompt 43.

         Le lot 1 n'en posait que deux, et sa note disait pourquoi : la
         troisième n'est pas un habillage mais une fonction, et aucun magasin
         ne savait garder une épreuve inachevée. Le magasin existe maintenant
         (schéma 41), et la question cesse d'être « rester ou tout perdre ».
      */
      if (commencee) {
        const issue = await choisirUneIssue({
          titre: 'Quitter l’épreuve ?',
          texte:
            'Vous êtes à la question ' +
            `${position + 1} sur ${questions.length}. Une épreuve n’est notée ` +
            'qu’une fois terminée ; gardée, elle vous attendra ici telle quelle.',
          issues: [
            { texte: 'Continuer l’épreuve', valeur: 'continuer', sorte: 'annuler' },
            { texte: 'Garder pour plus tard', valeur: 'garder', sorte: 'principale' },
            { texte: 'Abandonner', valeur: 'abandonner', sorte: 'destructrice' },
          ],
        });
        /* Fermer la feuille sans choisir, c'est ne rien décider : on reste
           dans l'épreuve, et surtout on n'efface rien. */
        if (issue === null || issue === 'continuer') return;
        if (issue === 'garder') await garderPourPlusTard();
        else await effacerEpreuveEnCours();
      }
      afficherVue('accueil-dgfip');
      await afficherReprise();
      await afficherHistorique();
    });
  });
</script>
