---
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/ui';
---

<Base titre="QCM — DGFiP" actif="quiz">
  <div id="chargement" class="py-20 text-center text-slate-400">Préparation de la banque…</div>

  <!-- ====================== Accueil de la rubrique ====================== -->
  <section id="accueil-dgfip" class="hidden">
    <p class="etiquette text-indigo-600 dark:text-indigo-400">
      <a href={`${base}/quiz/`} class="cible-tactile pr-2 hover:underline">Quiz</a> · rubrique
    </p>
    <h1 class="mt-1 mb-1 text-2xl font-bold text-slate-900 dark:text-white">QCM — DGFiP</h1>
    <p class="mb-6 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Épreuve blanche dans les conditions du concours : les rubriques mêlées en
      une seule série, aucune correction avant la fin, et un barème qui rend
      l'abstention préférable au hasard. Deux formats reproduisent la structure
      des sujets 2026, rubrique par rubrique.
    </p>

    {/*
       L'épreuve gardée pour plus tard (C3 du prompt 43).

       En tête de l'accueil, parce que c'est la seule chose de cet écran qui
       attend quelque chose de la personne. Caché tant qu'il n'y a rien à
       reprendre : un bloc vide qui dit « aucune épreuve gardée » occuperait
       l'écran pour ne rien apprendre.

       Aucune couleur d'alerte, aucun compte à rebours : une épreuve gardée
       n'expire pas, et rien ne presse de la reprendre.
    */}
    <div
      id="reprise-dgfip"
      class="mb-6 hidden rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900"
    >
      <p id="reprise-texte" class="text-sm text-slate-700 dark:text-slate-200"></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button
          id="reprendre-dgfip"
          type="button"
          class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
          >Reprendre l’épreuve</button
        >
        <button
          id="jeter-dgfip"
          type="button"
          class="cible-tactile rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >Ne pas la reprendre</button
        >
      </div>
    </div>

    <div class="mb-6 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 dark:border-emerald-900 dark:bg-emerald-950/40">
        <p class="text-lg font-bold text-emerald-700 tabular-nums dark:text-emerald-400">+1</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">par bonne réponse</p>
      </div>
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 dark:border-red-900 dark:bg-red-950/40">
        <p class="text-lg font-bold text-red-700 tabular-nums dark:text-red-400">−0,5</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">par mauvaise réponse</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-lg font-bold text-slate-700 tabular-nums dark:text-slate-200">0</p>
        <p class="text-xs text-slate-600 dark:text-slate-300">en l'absence de réponse</p>
      </div>
    </div>

    <h2 class="mb-2 text-sm font-semibold text-slate-900 dark:text-white">Banque de questions</h2>
    <div id="rubriques-dgfip" class="mb-6 space-y-2"></div>

    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="format-dgfip" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">
          Format
        </label>
        <!-- Rempli au chargement : seuls les formats que la banque peut
             réellement tirer sont proposés. -->
        <!--
          « w-full » avant le plafond : 22 rem valent 352 px, et un écran de
          360 px n'offre que 328 px de colonne une fois ses marges prises. La
          liste débordait donc de 6 px, et toute la page avec elle. Le plafond
          reste utile au-delà : sans lui, la liste s'étirerait sur la largeur
          d'une tablette pour afficher « Catégorie B — 30 questions ».

          Le bouton « Plus » de la barre du bas ressortait lui aussi à 366 px.
          Il n'y était pour rien : une barre fixe s'étire à la largeur du
          document une fois qu'autre chose l'a élargi. Corriger ce qu'on voit
          dépasser en premier aurait traité le symptôme — c'est la leçon du
          14 octobre, et elle a resservi.
        -->
        <select
          id="format-dgfip"
          class="w-full max-w-[22rem] rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
        ></select>
      </div>
      <button
        id="lancer-dgfip"
        class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700"
      >
        Commencer
      </button>
      <p class="w-full text-xs text-slate-500 dark:text-slate-400">
        Les questions sont tirées au hasard, en ramenant plus souvent celles que
        vous avez ratées ou laissées de côté.
      </p>
    </div>

    <p
      id="dgfip-vide"
      class="mt-6 hidden rounded-xl bg-slate-100 px-4 py-3 text-sm text-slate-600 dark:bg-slate-900 dark:text-slate-300"
    >
      La banque « QCM - DGFiP » est vide : ajoutez des questions dans{' '}
      <code>content/qcm-dgfip/</code>, puis republiez le site.
    </p>

    <div id="historique-dgfip" class="mt-10"></div>
  </section>

  <!-- ========================== Épreuve en cours ========================= -->
  <section id="epreuve" class="hidden">
    <div class="mb-4 flex items-center gap-3">
      <button
        id="quitter-dgfip"
        class="cible-tactile text-sm text-slate-600 hover:underline dark:text-slate-300"
      >
        ← Quitter
      </button>
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
        <div id="barre-dgfip" class="h-full rounded-full bg-indigo-500 jauge-remplissage jauge-seance" style="transform:scaleX(0)"></div>
      </div>
      <span
        id="compteur-dgfip"
        role="status"
        aria-live="polite"
        class="text-sm font-medium text-slate-500 tabular-nums dark:text-slate-400"
      ></span>
    </div>

    <div class="mx-auto max-w-2xl">
      <p id="rubrique-courante" class="etiquette mb-2 text-indigo-600 dark:text-indigo-400"></p>
      <h2 id="enonce-dgfip" class="mb-2 text-lg leading-relaxed font-medium text-slate-900 sm:text-xl dark:text-white"></h2>
      <p id="consigne-dgfip" class="mb-5 text-xs text-slate-400"></p>
      <div id="options-dgfip" class="space-y-2"></div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button
          id="precedent-dgfip"
          class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium transition hover:bg-slate-100 disabled:opacity-40 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Précédent
        </button>
        <button
          id="suivant-dgfip"
          class="flex-1 rounded-lg bg-slate-900 px-5 py-2.5 font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900"
        >
          Suivant
        </button>
      </div>
      <p class="mt-3 text-center text-xs text-slate-400">
        Passer sans rien cocher ne coûte rien ; une case décochée redevient une
        abstention.
      </p>
    </div>
  </section>

  <!-- ============================= Résultat ============================= -->
  <section id="resultat-dgfip" class="hidden">
    <div class="text-center">
      <p id="resultat-emoji-dgfip" class="text-5xl"></p>
      <h2 class="mt-4 text-3xl font-bold text-slate-900 tabular-nums dark:text-white">
        <span id="resultat-points"></span>
      </h2>
      <p id="resultat-resume" class="mt-2 text-slate-500 dark:text-slate-400"></p>
    </div>

    <h3 class="mt-10 mb-2 text-sm font-semibold text-slate-900 dark:text-white">Détail par rubrique</h3>
    <div class="defilement-fin overflow-x-auto">
      <table class="w-full min-w-[34rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
            <th class="py-2 pr-3 font-medium">Rubrique</th>
            <th class="py-2 pr-3 text-right font-medium">Posées</th>
            <th class="py-2 pr-3 text-right font-medium">Bonnes</th>
            <th class="py-2 pr-3 text-right font-medium">Fausses</th>
            <th class="py-2 pr-3 text-right font-medium">Sans réponse</th>
            <th class="py-2 text-right font-medium">Points</th>
          </tr>
        </thead>
        <tbody id="tableau-rubriques"></tbody>
      </table>
    </div>

    <h3 id="titre-revoir" class="mt-10 mb-2 hidden text-sm font-semibold text-slate-900 dark:text-white">
      À revoir
    </h3>
    <div id="revoir-dgfip" class="space-y-3"></div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <button id="rejouer-dgfip" class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700">
        Nouvelle épreuve
      </button>
      <a
        href={`${base}/quiz/`}
        class="rounded-lg border border-slate-300 px-5 py-2.5 font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
      >
        Retour aux quiz
      </a>
    </div>
  </section>
</Base>

<script>
  import { choisirUneIssue } from '../../lib/boite';
  import {
    PHRASE_DE_REFUS,
    questionsDeLEpreuve,
    refusDeReprise,
  } from '../../lib/noyau/epreuve-en-cours';
  import { auDeverrouillage } from '../../lib/chargement';
  import { chargerBanqueDgfip, chargerManifeste, type BanqueDgfip } from '../../lib/contenu';
  import {
    effacerEpreuveEnCours,
    ecrireEpreuveEnCours,
    enregistrerSessionDgfip,
    etatsQuestionsDgfip,
    lireEpreuveEnCours,
    toutesLesSessionsDgfip,
    type SessionDgfip,
  } from '../../lib/db';
  import { gagnerXp, xpQuiz } from '../../lib/gamification';
  import {
    composerSession,
    evaluer,
    FORMATS,
    questionsServables,
    formaterPoints,
    noter,
    tailleReelle,
    type FormatEpreuve,
    type QuestionTiree,
    type ReponseSession,
  } from '../../lib/qcm';
  import { echapper, formaterDate, notifier, pluriel } from '../../lib/ui';
  import { jourISO } from '../../lib/db';
  import { idParcoursCourant } from '../../lib/parcours/courant';
  import { MATIERE_DGFIP, signalerErreur } from '../../lib/journal';
  import { enregistrerReponse } from '../../lib/niveau';
  import { insecables } from '../../lib/typographie';
  import { demonterCorrection, monterCorrection } from '../../features/correction/qcm/monter';
  import { boutonAssistant } from '../../features/assistant/monter';
  import { contexteDgfip } from '../../features/assistant/fournisseurs';

  let banque: BanqueDgfip | null = null;
  /** Formats effectivement proposés, la banque étant ce qu'elle est. */
  let formats: FormatEpreuve[] = [];
  let questions: QuestionTiree[] = [];
  /** Indices cochés pour chaque question, dans l'ordre du tirage. */
  let choix: number[][] = [];
  let position = 0;
  /** Quand l'épreuve en cours a été commencée, pour la garder telle quelle. */
  let debutDeLEpreuve = '';
  /** Le format tiré, pour que la reprise le retrouve. */
  let formatCourant = '';

  const $ = (id: string) => document.getElementById(id)!;

  function afficherVue(nom: 'accueil-dgfip' | 'epreuve' | 'resultat-dgfip') {
    for (const section of ['accueil-dgfip', 'epreuve', 'resultat-dgfip']) {
      $(section).classList.toggle('hidden', section !== nom);
    }
    window.scrollTo({ top: 0 });
  }

  // --- Accueil ---------------------------------------------------------------

  function afficherRubriques() {
    const zone = $('rubriques-dgfip');
    zone.innerHTML = '';
    for (const r of banque?.rubriques ?? []) {
      const ligne = document.createElement('div');
      ligne.className =
        'flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm dark:border-slate-800 dark:bg-slate-900';
      ligne.innerHTML =
        `<span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-200">${echapper(r.nom)}</span>` +
        `<span class="shrink-0 text-xs text-slate-400 tabular-nums">${pluriel(r.total, 'question')}</span>`;
      zone.appendChild(ligne);
    }
  }

  async function afficherHistorique() {
    const sessions = (await toutesLesSessionsDgfip()).slice(-5).reverse();
    const zone = $('historique-dgfip');
    zone.innerHTML = '';
    if (!sessions.length) return;

    const titre = document.createElement('h2');
    titre.className = 'mb-3 text-lg font-semibold text-slate-900 dark:text-white';
    titre.textContent = 'Dernières épreuves';
    zone.appendChild(titre);

    const liste = document.createElement('div');
    liste.className = 'space-y-2';
    for (const s of sessions) {
      // Le barème pouvant faire descendre sous zéro, on situe le score sur
      // l'échelle réelle plutôt qu'en pourcentage de bonnes réponses.
      const taux = s.maximum ? s.points / s.maximum : 0;
      const couleur =
        taux >= 0.7
          ? 'text-emerald-600 dark:text-emerald-400'
          : taux >= 0.4
            ? 'text-amber-600 dark:text-amber-400'
            : 'text-red-600 dark:text-red-400';
      const ligne = document.createElement('div');
      ligne.className =
        'flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm dark:border-slate-800 dark:bg-slate-900';
      ligne.innerHTML =
        `<span class="min-w-0 flex-1 text-slate-700 dark:text-slate-200">` +
        `${pluriel(s.bonnes, 'bonne')} · ${pluriel(s.mauvaises, 'erreur')} · ${s.abstentions} sans réponse</span>` +
        `<span class="shrink-0 text-xs text-slate-400">${formaterDate(s.le)}</span>` +
        `<span class="shrink-0 font-semibold tabular-nums ${couleur}">${formaterPoints(s.points)}/${s.maximum}</span>`;
      liste.appendChild(ligne);
    }
    zone.appendChild(liste);
  }

  // --- L'épreuve gardée pour plus tard (C3 du 43) -----------------------------

  /**
   * Montre, ou non, le bloc de reprise.
   *
   * Trois sorts, et ils ne se confondent pas : aucune épreuve gardée, et le
   * bloc n'existe pas ; une épreuve reprenable, et il propose les deux
   * gestes ; une épreuve que la banque ne permet plus de reprendre, et il le
   * dit, efface le brouillon, et laisse « Commencer » juste en dessous.
   *
   * L'effacement d'un brouillon refusé est immédiat, et c'est voulu : le
   * garder reviendrait à reposer la même question à chaque visite, avec la
   * même réponse.
   */
  async function afficherReprise() {
    const bloc = $('reprise-dgfip');
    const gardee = await lireEpreuveEnCours();
    bloc.classList.add('hidden');
    if (!gardee || !banque) return;

    /*
       « Servables » se calcule avec la MÊME fonction qui compose une épreuve
       neuve : si les deux divergeaient, on pourrait refuser une reprise que
       le tirage aurait pourtant acceptée, ou l'inverse.
    */
    const connues = new Set(banque.questions.map((q) => q.id));
    const servables = new Set(
      questionsServables(banque, idParcoursCourant(), jourISO()).map((q) => q.id),
    );
    const refus = refusDeReprise(gardee, connues, servables);

    for (const id of ['reprendre-dgfip', 'jeter-dgfip']) {
      $(id).classList.toggle('hidden', refus !== null);
    }
    if (refus !== null) {
      $('reprise-texte').textContent = PHRASE_DE_REFUS;
      await effacerEpreuveEnCours();
    } else {
      const debut = new Date(gardee.le).toLocaleDateString('fr-FR', {
        day: 'numeric',
        month: 'long',
      });
      $('reprise-texte').textContent =
        `Vous avez gardé une épreuve commencée le ${debut}, à la question ` +
        `${gardee.position + 1} sur ${gardee.questionIds.length}.`;
    }
    bloc.classList.remove('hidden');
  }

  /** Reprend l'épreuve gardée, exactement où elle était. */
  async function reprendre() {
    const gardee = await lireEpreuveEnCours();
    if (!gardee || !banque) return;
    const parId = new Map(banque.questions.map((q) => [q.id, q]));
    const reprises = questionsDeLEpreuve(gardee, parId);
    if (!reprises) {
      await afficherReprise();
      return;
    }
    questions = reprises;
    choix = gardee.choix.map((c) => [...c]);
    position = gardee.position;
    /* Le brouillon est consommé : on ne garde pas une épreuve qu'on est en
       train de passer. Quitter à nouveau en écrira un neuf. */
    await effacerEpreuveEnCours();
    $('reprise-dgfip').classList.add('hidden');
    afficherVue('epreuve');
    afficherQuestion();
  }

  /** Garde l'épreuve en cours pour plus tard. */
  async function garderPourPlusTard() {
    await ecrireEpreuveEnCours({
      le: debutDeLEpreuve,
      formatId: formatCourant,
      parcoursId: idParcoursCourant(),
      questionIds: questions.map((q) => q.id),
      /* L'ordre des propositions, sans quoi la reprise les remélangerait :
         mêmes questions, autre écran, et des cases cochées qui sembleraient
         avoir bougé toutes seules. */
      ordres: questions.map((q) => [...q.ordre]),
      choix: choix.map((c) => [...c]),
      position,
    });
  }

  // --- Déroulé de l'épreuve --------------------------------------------------

  async function demarrer() {
    if (!banque?.questions.length) return;
    const choisi = ($('format-dgfip') as HTMLSelectElement).value;
    const format = formats.find((f) => f.id === choisi) ?? formats[0];
    if (!format) return;
    questions = composerSession(
      banque,
      await etatsQuestionsDgfip(),
      format,
      idParcoursCourant(),
    );
    if (!questions.length) return;
    choix = questions.map(() => []);
    position = 0;
    debutDeLEpreuve = new Date().toISOString();
    formatCourant = format.id;
    afficherVue('epreuve');
    afficherQuestion();
  }

  function afficherQuestion() {
    const q = questions[position];
    const multiple = q.bonnes.length > 1;

    $('rubrique-courante').textContent = q.rubrique;
    $('enonce-dgfip').textContent = insecables(q.question);
    $('consigne-dgfip').textContent = multiple
      ? 'Plusieurs réponses attendues — le point n’est acquis que si la sélection est exacte.'
      : 'Une seule réponse attendue.';
    $('compteur-dgfip').textContent = `Question ${position + 1} sur ${questions.length}`;
    $('barre-dgfip').style.transform = `scaleX(${Math.round((position / questions.length) * 100) / 100})`;
    ($('precedent-dgfip') as HTMLButtonElement).disabled = position === 0;
    $('suivant-dgfip').textContent =
      position === questions.length - 1 ? 'Terminer l’épreuve' : 'Suivant';

    const zone = $('options-dgfip');
    zone.innerHTML = '';
    for (const index of q.ordre) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.dataset.index = String(index);
      bouton.setAttribute('role', multiple ? 'checkbox' : 'radio');
      bouton.textContent = insecables(q.options[index]);
      bouton.addEventListener('click', () => basculer(index, multiple));
      zone.appendChild(bouton);
    }
    peindreOptions();
  }

  /** Coche ou décoche une option ; décocher revient à s'abstenir. */
  function basculer(index: number, multiple: boolean) {
    const actuels = choix[position];
    if (multiple) {
      choix[position] = actuels.includes(index)
        ? actuels.filter((i) => i !== index)
        : [...actuels, index];
    } else {
      choix[position] = actuels.includes(index) ? [] : [index];
    }
    peindreOptions();
  }

  function peindreOptions() {
    const coches = new Set(choix[position]);
    for (const bouton of $('options-dgfip').querySelectorAll<HTMLButtonElement>('button')) {
      const actif = coches.has(Number(bouton.dataset.index));
      bouton.setAttribute('aria-checked', String(actif));
      bouton.className = actif
        ? 'w-full rounded-xl border-2 border-indigo-500 bg-indigo-50 px-4 py-3 text-left font-medium text-indigo-900 transition dark:bg-indigo-950/60 dark:text-indigo-100'
        : 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-left transition hover:border-indigo-400 hover:bg-indigo-50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-indigo-600 dark:hover:bg-indigo-950/50';
    }
  }

  function avancer() {
    if (position < questions.length - 1) {
      position += 1;
      afficherQuestion();
    } else {
      void terminer();
    }
  }

  function reculer() {
    if (position === 0) return;
    position -= 1;
    afficherQuestion();
  }

  // --- Résultat --------------------------------------------------------------

  async function terminer() {
    /*
       Le brouillon est consommé par la fin de l'épreuve : elle devient une
       `SessionDgfip`, et garder les deux laisserait une épreuve « en cours »
       qu'on a pourtant finie. Effacé en premier, avant l'écriture du
       résultat : si l'écriture échouait, mieux vaut avoir perdu un brouillon
       qu'en garder un qui ne correspond plus à rien.
    */
    await effacerEpreuveEnCours();
    const reponses: ReponseSession[] = questions.map((question, i) => ({
      question,
      choisis: choix[i],
      issue: evaluer(question, choix[i]),
    }));
    const score = noter(reponses, banque?.rubriques ?? []);

    const session: SessionDgfip = {
      le: new Date().toISOString(),
      posees: score.posees,
      bonnes: score.bonnes,
      mauvaises: score.mauvaises,
      abstentions: score.abstentions,
      points: score.points,
      maximum: score.maximum,
      parRubrique: score.parRubrique,
    };
    // Les réponses fausses ouvrent une entrée au journal d'erreurs. Les
    // abstentions n'en ouvrent pas : ne pas répondre n'est pas se tromper, et
    // le barème sanctionne déjà le remplissage au hasard.
    for (const r of reponses) {
      // L'abstention ne dit rien du niveau : elle n'alimente pas l'estimation.
      if (r.issue !== 'abstention') {
        await enregistrerReponse({
          itemId: r.question.id,
          resultat: r.issue === 'bonne' ? 1 : 0,
          matiere: MATIERE_DGFIP,
          fascicule: r.question.rubrique,
          source: 'dgfip',
        });
      }
      if (r.issue !== 'mauvaise') continue;
      await signalerErreur({
        id: r.question.id,
        genre: 'dgfip',
        matiere: MATIERE_DGFIP,
        rubriqueId: r.question.rubriqueId,
      });
    }

    await enregistrerSessionDgfip(
      session,
      reponses.map((r) => ({
        id: r.question.id,
        rubriqueId: r.question.rubriqueId,
        issue: r.issue,
      })),
    );

    // Les XP récompensent les bonnes réponses, jamais le remplissage au hasard :
    // le barème s'en charge déjà pour la note, autant rester cohérent.
    const gain = await gagnerXp(xpQuiz(score.bonnes), {
      quiz: 1,
      bonnes: score.bonnes,
      reponses: score.bonnes + score.mauvaises,
    });
    if (gain.monteeDeNiveau) notifier(`Niveau ${gain.niveau.niveau} atteint !`, 'badge');
    for (const badge of gain.nouveauxBadges) notifier(`Badge obtenu : ${badge.nom}`, 'badge');

    afficherResultat(score, reponses);
  }

  function afficherResultat(score: ReturnType<typeof noter>, reponses: ReponseSession[]) {
    const taux = score.maximum ? score.points / score.maximum : 0;
    $('resultat-emoji-dgfip').textContent = taux >= 0.7 ? '🎯' : taux >= 0.4 ? '💪' : '📚';
    $('resultat-points').textContent = `${formaterPoints(score.points)} / ${score.maximum}`;
    $('resultat-resume').textContent =
      `${pluriel(score.bonnes, 'bonne réponse', 'bonnes réponses')}, ` +
      `${pluriel(score.mauvaises, 'erreur')} ` +
      `(${formaterPoints(score.mauvaises * -0.5)} ${score.mauvaises > 1 ? 'points' : 'point'}), ` +
      `${score.abstentions} sans réponse.`;

    const corps = $('tableau-rubriques');
    corps.innerHTML = '';
    for (const ligne of score.parRubrique) {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 dark:border-slate-800';
      tr.innerHTML =
        `<td class="py-2 pr-3 text-slate-700 dark:text-slate-200">${echapper(ligne.rubrique)}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-slate-500 dark:text-slate-400">${ligne.posees}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-emerald-600 dark:text-emerald-400">${ligne.bonnes}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-red-600 dark:text-red-400">${ligne.mauvaises}</td>` +
        `<td class="py-2 pr-3 text-right tabular-nums text-slate-500 dark:text-slate-400">${ligne.abstentions}</td>` +
        `<td class="py-2 text-right font-semibold tabular-nums text-slate-900 dark:text-white">${formaterPoints(ligne.points)}</td>`;
      corps.appendChild(tr);
    }

    // Les abstentions figurent à revoir au même titre que les erreurs : ne pas
    // savoir et se tromper sont deux lacunes, seule la note les distingue.
    const aRevoir = reponses.filter((r) => r.issue !== 'bonne');
    $('titre-revoir').classList.toggle('hidden', aRevoir.length === 0);
    const zone = $('revoir-dgfip');
    zone.innerHTML = '';
    for (const r of aRevoir) {
      const bonnes = r.question.bonnes.map((i) => r.question.options[i]).join(' · ');
      const donnee = r.choisis.length
        ? r.choisis.map((i) => r.question.options[i]).join(' · ')
        : null;
      // La provenance n'est utile que lorsqu'elle renvoie à une annale : la
      // mentionner pour les questions rédigées ici n'apprendrait rien.
      const annale = r.question.source && !r.question.source.startsWith('RevINSP')
        ? r.question.source
        : null;
      const carte = document.createElement('article');
      carte.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm dark:border-slate-800 dark:bg-slate-900';
      carte.innerHTML =
        `<p class="etiquette text-slate-400">${echapper(r.question.rubrique)}` +
        (annale ? ` · ${echapper(annale)}` : '') +
        `</p>` +
        `<p class="mt-1 font-medium text-slate-900 dark:text-white">${echapper(r.question.question)}</p>` +
        (donnee
          ? `<p class="mt-2 text-red-600 dark:text-red-400">Votre réponse : ${echapper(donnee)}</p>`
          : `<p class="mt-2 text-slate-500 dark:text-slate-400">Sans réponse.</p>`) +
        `<p class="mt-1 text-emerald-700 dark:text-emerald-400">Réponse attendue : ${echapper(bonnes)}</p>` +
        `<p class="mt-2 text-slate-600 dark:text-slate-300">${echapper(r.question.explication)}</p>` +
        (r.question.incertain
          ? `<p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300">` +
            `⚠ ${echapper(r.question.incertain)}</p>`
          : '');

      /*
       * La correction détaillée n'existe **que sur cet écran**, et c'est une
       * règle de l'épreuve, non une limite technique.
       *
       * Une session de QCM DGFiP est chronométrée et se joue au barème du
       * concours. Y glisser une correction après chaque question changerait la
       * nature de l'exercice : on ne mesurerait plus ce qu'on sait sous
       * contrainte de temps, mais ce qu'on apprend en chemin. Les deux sont
       * utiles ; les mélanger ne mesure plus rien.
       */
      const actions = document.createElement('div');
      actions.className = 'mt-3 flex flex-wrap gap-2';
      carte.appendChild(actions);

      if (r.question.correction) {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className =
          'rounded-lg border border-indigo-300 bg-white px-3 py-1.5 text-xs font-medium ' +
          'text-indigo-700 hover:bg-indigo-50 dark:border-indigo-700 dark:bg-slate-900 ' +
          'dark:text-indigo-300 dark:hover:bg-indigo-950/40';
        bouton.textContent = 'Correction détaillée';
        bouton.setAttribute('aria-expanded', 'false');
        const panneau = document.createElement('div');
        bouton.addEventListener('click', () => {
          const ouvert = panneau.childElementCount === 0;
          if (!ouvert) {
            demonterCorrection(panneau);
            bouton.setAttribute('aria-expanded', 'false');
            bouton.textContent = 'Correction détaillée';
            return;
          }
          bouton.setAttribute('aria-expanded', 'true');
          bouton.textContent = 'Replier la correction détaillée';
          monterCorrection(panneau, {
            correction: r.question.correction!,
            options: r.question.options,
            bonnes: r.question.bonnes,
            choisies: r.choisis,
            fermer: () => bouton.click(),
          });
        });
        actions.appendChild(bouton);
        carte.appendChild(panneau);
      }

      /*
       * « Demander à l'IA » suit la même règle que la correction détaillée :
       * seulement ici, sur l'écran de résultats. Une session de QCM DGFiP se
       * joue au barème du concours, et ouvrir un assistant entre deux questions
       * ne mesurerait plus rien.
       *
       * Pas d'extrait de cours dans ce contexte, et ce n'est pas un oubli :
       * Français, Logique et Maths ne correspondent à aucune fiche du
       * programme. Le fournisseur omet le bloc plutôt que d'en inventer un.
       */
      actions.appendChild(
        boutonAssistant({
          titre: 'Préparer une question pour une IA — question de QCM',
          itemId: r.question.id,
          matiere: r.question.rubrique,
          construireContexte: async (options) =>
            contexteDgfip({ question: r.question, choisies: r.choisis }, options),
        }),
      );

      zone.appendChild(carte);
    }

    afficherVue('resultat-dgfip');
  }

  // --- Mise en route ---------------------------------------------------------

  auDeverrouillage(async () => {
    const manifeste = await chargerManifeste();
    $('chargement').classList.add('hidden');
    afficherVue('accueil-dgfip');

    if (!manifeste.totaux.qcmDgfip) {
      $('dgfip-vide').classList.remove('hidden');
      ($('lancer-dgfip') as HTMLButtonElement).disabled = true;
      return;
    }

    banque = await chargerBanqueDgfip();
    afficherRubriques();
    /* La reprise se propose dès l'ouverture, et avant l'historique : c'est la
       seule chose de cet écran qui attend quelque chose de la personne. */
    await afficherReprise();
    await afficherHistorique();

    // Un format dont les rubriques manquent encore ne doit pas être proposé ;
    // un format que la banque ne peut remplir qu'à moitié le dit franchement.
    const select = $('format-dgfip') as HTMLSelectElement;
    select.innerHTML = '';
    formats = [];
    for (const format of FORMATS) {
      const reelle = tailleReelle(banque, format, idParcoursCourant());
      if (reelle === 0) continue;
      formats.push(format);
      const libelle =
        reelle < format.total
          ? `${format.libelle} — ${reelle} disponibles`
          : format.libelle;
      select.add(new Option(libelle, format.id));
    }
    if (!formats.length) {
      $('dgfip-vide').classList.remove('hidden');
      ($('lancer-dgfip') as HTMLButtonElement).disabled = true;
      return;
    }

    $('reprendre-dgfip').addEventListener('click', () => void reprendre());
    $('jeter-dgfip').addEventListener('click', async () => {
      await effacerEpreuveEnCours();
      await afficherReprise();
    });
    $('lancer-dgfip').addEventListener('click', () => void demarrer());
    $('rejouer-dgfip').addEventListener('click', () => void demarrer());
    $('suivant-dgfip').addEventListener('click', avancer);
    $('precedent-dgfip').addEventListener('click', reculer);
    $('quitter-dgfip').addEventListener('click', async () => {
      /*
         Rien n'est enregistré avant « terminer() » : quitter en cours
         d'épreuve perd les trente à quarante-cinq réponses déjà données. La
         demande dit donc ce qui se perd, et non « êtes-vous sûr ? », qui ne
         renseigne personne. Elle n'est posée que si l'épreuve a commencé —
         confirmer la sortie d'un écran où l'on n'a rien fait serait une
         friction sans objet.
      */
      const commencee = choix.some((c) => c.length > 0);
      /*
         TROIS ISSUES, depuis C3 du prompt 43.

         Le lot 1 n'en posait que deux, et sa note disait pourquoi : la
         troisième n'est pas un habillage mais une fonction, et aucun magasin
         ne savait garder une épreuve inachevée. Le magasin existe maintenant
         (schéma 41), et la question cesse d'être « rester ou tout perdre ».
      */
      if (commencee) {
        const issue = await choisirUneIssue({
          titre: 'Quitter l’épreuve ?',
          texte:
            'Vous êtes à la question ' +
            `${position + 1} sur ${questions.length}. Une épreuve n’est notée ` +
            'qu’une fois terminée ; gardée, elle vous attendra ici telle quelle.',
          issues: [
            { texte: 'Continuer l’épreuve', valeur: 'continuer', sorte: 'annuler' },
            { texte: 'Garder pour plus tard', valeur: 'garder', sorte: 'principale' },
            { texte: 'Abandonner', valeur: 'abandonner', sorte: 'destructrice' },
          ],
        });
        /* Fermer la feuille sans choisir, c'est ne rien décider : on reste
           dans l'épreuve, et surtout on n'efface rien. */
        if (issue === null || issue === 'continuer') return;
        if (issue === 'garder') await garderPourPlusTard();
        else await effacerEpreuveEnCours();
      }
      afficherVue('accueil-dgfip');
      await afficherReprise();
      await afficherHistorique();
    });
  });
</script>
