---
import Base from '../layouts/Base.astro';
---

<Base titre="Flashcards" actif="flashcards">
  <div id="chargement" class="py-20 text-center text-slate-400">Préparation de la session…</div>

  <!-- Choix de la session -->
  <section id="accueil-session" class="hidden">
    <h1 class="mb-1 text-2xl font-bold text-slate-900 dark:text-white">Session de flashcards</h1>
    <p class="mb-6 text-sm text-slate-500 dark:text-slate-400">
      La file du jour est construite automatiquement par répétition espacée (SM-2).
    </p>

    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-3xl font-bold text-indigo-600 dark:text-indigo-400" id="nb-dues">0</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">cartes dues aujourd'hui</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-3xl font-bold text-slate-900 dark:text-white" id="nb-neuves">0</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">jamais révisées</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-3xl font-bold text-emerald-600 dark:text-emerald-400" id="nb-acquises">0</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">acquises (&gt; 21 jours)</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-end gap-3">
      <div>
        <label for="choix-matiere" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">Matière</label>
        <select id="choix-matiere" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
          <option value="">Toutes</option>
        </select>
      </div>
      <div>
        <label for="choix-taille" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">Longueur</label>
        <select id="choix-taille" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
          <option value="20">20 cartes</option>
          <option value="40">40 cartes</option>
          <option value="0">Toute la file</option>
        </select>
      </div>
      <button id="lancer" class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700">
        Commencer
      </button>
      <button id="lancer-libre" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">
        Réviser hors échéance
      </button>
    </div>

    <p id="rien-a-faire" class="mt-6 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200">
      ✅ Rien à réviser aujourd'hui pour cette sélection. Vous pouvez tout de même réviser hors échéance.
    </p>
  </section>

  <!-- Session en cours -->
  <section id="session" class="hidden">
    <div class="mb-4 flex items-center gap-3">
      <button id="quitter" class="text-sm text-slate-500 hover:underline dark:text-slate-400">← Quitter</button>
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
        <div id="barre-session" class="h-full rounded-full bg-indigo-500 transition-all duration-300" style="width:0%"></div>
      </div>
      <span id="compteur" class="text-sm font-medium text-slate-500 tabular-nums dark:text-slate-400">0/0</span>
    </div>

    <p id="source-carte" class="mb-2 text-center text-xs text-slate-400"></p>

    <div class="carte-3d mx-auto max-w-2xl">
      <div id="carte" class="min-h-[16rem] cursor-pointer rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md sm:min-h-[20rem] sm:p-10 dark:border-slate-800 dark:bg-slate-900">
        <p class="mb-3 text-xs font-semibold tracking-wide text-slate-400 uppercase">Question</p>
        <p id="question" class="text-lg leading-relaxed font-medium text-slate-900 sm:text-xl dark:text-white"></p>

        <div id="zone-reponse" class="mt-6 hidden border-t border-slate-200 pt-5 dark:border-slate-800">
          <p class="mb-3 text-xs font-semibold tracking-wide text-slate-400 uppercase">Réponse</p>
          <p id="reponse" class="text-base leading-relaxed whitespace-pre-line text-slate-700 dark:text-slate-200"></p>
        </div>

        <p id="indice-retourner" class="mt-8 text-center text-sm text-slate-400">
          Cliquez sur la carte ou appuyez sur <kbd class="rounded border px-1.5 py-0.5 text-xs">Espace</kbd> pour voir la réponse
        </p>
      </div>
    </div>

    <div id="notation" class="mx-auto mt-5 hidden max-w-2xl">
      <p class="mb-2 text-center text-sm text-slate-500 dark:text-slate-400">Avez-vous su répondre ?</p>
      <div class="grid grid-cols-3 gap-2">
        <button data-note="difficile" class="rounded-xl bg-red-100 px-3 py-4 font-medium text-red-700 transition hover:bg-red-200 dark:bg-red-950 dark:text-red-300 dark:hover:bg-red-900">
          Difficile<span class="mt-1 block text-xs font-normal opacity-70">à revoir aujourd'hui</span>
        </button>
        <button data-note="moyen" class="rounded-xl bg-amber-100 px-3 py-4 font-medium text-amber-700 transition hover:bg-amber-200 dark:bg-amber-950 dark:text-amber-300 dark:hover:bg-amber-900">
          Moyen<span class="mt-1 block text-xs font-normal opacity-70" data-delai-moyen></span>
        </button>
        <button data-note="facile" class="rounded-xl bg-emerald-100 px-3 py-4 font-medium text-emerald-700 transition hover:bg-emerald-200 dark:bg-emerald-950 dark:text-emerald-300 dark:hover:bg-emerald-900">
          Facile<span class="mt-1 block text-xs font-normal opacity-70" data-delai-facile></span>
        </button>
      </div>
      <p class="mt-2 text-center text-xs text-slate-400">Raccourcis : 1 · 2 · 3</p>
    </div>
  </section>

  <!-- Bilan -->
  <section id="bilan" class="hidden py-10 text-center">
    <p class="text-5xl">🎉</p>
    <h2 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">Session terminée</h2>
    <p id="bilan-detail" class="mt-2 text-slate-500 dark:text-slate-400"></p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <button id="rejouer" class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white transition hover:bg-indigo-700">
        Nouvelle session
      </button>
      <a id="retour-accueil" href="#" class="rounded-lg border border-slate-300 px-5 py-2.5 font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">
        Tableau de bord
      </a>
    </div>
  </section>
</Base>

<script>
  import { fileDuJour, type CarteAReviser } from '../lib/agregats';
  import { chargerManifeste } from '../lib/contenu';
  import { jourISO, lireCarte, toutesLesCartes, type Difficulte } from '../lib/db';
  import { gagnerXp, xpFlashcard } from '../lib/gamification';
  import { noter, noterEtEnregistrer } from '../lib/srs';
  import { lien, melanger, notifier, parametreUrl, pluriel } from '../lib/ui';

  let file: CarteAReviser[] = [];
  let position = 0;
  let reponseVisible = false;
  let notees = 0;
  let xpSession = 0;
  const compte = { difficile: 0, moyen: 0, facile: 0 };

  const $ = (id: string) => document.getElementById(id)!;

  function afficherVue(nom: 'accueil-session' | 'session' | 'bilan') {
    for (const section of ['accueil-session', 'session', 'bilan']) {
      $(section).classList.toggle('hidden', section !== nom);
    }
  }

  /** Aperçu du prochain intervalle, affiché sur les boutons de notation. */
  async function majDelais(carteId: string) {
    const etat = await lireCarte(carteId);
    const base = etat ?? {
      id: carteId,
      ficheId: '',
      matiere: '',
      repetitions: 0,
      intervalle: 0,
      facilite: 2.5,
      du: jourISO(),
      derniereRevision: null,
      oublis: 0,
      revisions: 0,
    };
    const texte = (jours: number) => (jours <= 1 ? 'demain' : `dans ${jours} j`);
    document.querySelector('[data-delai-moyen]')!.textContent = texte(noter(base, 'moyen').intervalle);
    document.querySelector('[data-delai-facile]')!.textContent = texte(noter(base, 'facile').intervalle);
  }

  async function afficherCarte() {
    if (position >= file.length) return terminer();
    const carte = file[position];

    reponseVisible = false;
    $('zone-reponse').classList.add('hidden');
    $('notation').classList.add('hidden');
    $('indice-retourner').classList.remove('hidden');
    $('question').textContent = carte.question;
    $('reponse').textContent = carte.reponse;
    $('source-carte').textContent = `${carte.matiere} · ${carte.ficheTitre}${carte.neuve ? ' · nouvelle carte' : ''}`;
    $('compteur').textContent = `${position + 1}/${file.length}`;
    $('barre-session').style.width = `${Math.round((position / file.length) * 100)}%`;
    await majDelais(carte.id);
  }

  function retourner() {
    if (reponseVisible) return;
    reponseVisible = true;
    $('zone-reponse').classList.remove('hidden');
    $('indice-retourner').classList.add('hidden');
    $('notation').classList.remove('hidden');
  }

  async function annoter(difficulte: Difficulte) {
    if (!reponseVisible) return;
    const carte = file[position];
    await noterEtEnregistrer(carte.id, carte.ficheId, carte.matiere, difficulte);

    const xp = xpFlashcard(difficulte);
    xpSession += xp;
    notees += 1;
    compte[difficulte] += 1;

    const gain = await gagnerXp(xp, { cartes: 1 });
    for (const badge of gain.nouveauxBadges) notifier(`${badge.icone} Succès : ${badge.nom}`, 'badge');
    if (gain.monteeDeNiveau) notifier(`🎉 Niveau ${gain.niveau.niveau} !`, 'succes');

    // Une carte « difficile » revient en fin de session.
    if (difficulte === 'difficile') file.push({ ...carte, neuve: false });

    position += 1;
    await afficherCarte();
  }

  function terminer() {
    $('barre-session').style.width = '100%';
    afficherVue('bilan');
    $('bilan-detail').textContent =
      `${pluriel(notees, 'carte révisée', 'cartes révisées')} · +${xpSession} XP · ` +
      `${compte.facile} facile(s), ${compte.moyen} moyen(s), ${compte.difficile} difficile(s)`;
  }

  async function demarrer(inclureNonDues: boolean) {
    const matiere = ($('choix-matiere') as HTMLSelectElement).value || null;
    const taille = Number(($('choix-taille') as HTMLSelectElement).value);
    const ficheId = parametreUrl('fiche');

    file = melanger(await fileDuJour({ matiere, ficheId, limite: taille, inclureNonDues }));
    if (!file.length) {
      $('rien-a-faire').classList.remove('hidden');
      return;
    }
    position = 0;
    notees = 0;
    xpSession = 0;
    compte.difficile = compte.moyen = compte.facile = 0;
    afficherVue('session');
    await afficherCarte();
  }

  /** Recalcule les compteurs de l'écran d'accueil de session. */
  async function rafraichirCompteurs() {
    const ficheId = parametreUrl('fiche');
    const cartes = await toutesLesCartes();
    const dues = await fileDuJour({ ficheId });
    $('nb-dues').textContent = String(dues.length);
    $('nb-neuves').textContent = String(dues.filter((c) => c.neuve).length);
    $('nb-acquises').textContent = String(cartes.filter((c) => c.intervalle >= 21).length);
    $('rien-a-faire').classList.toggle('hidden', dues.length > 0);
  }

  async function initialiser() {
    const manifeste = await chargerManifeste();
    const select = $('choix-matiere') as HTMLSelectElement;
    for (const matiere of manifeste.matieres) {
      const option = document.createElement('option');
      option.value = matiere.nom;
      option.textContent = matiere.nom;
      select.appendChild(option);
    }

    await rafraichirCompteurs();

    $('lancer').addEventListener('click', () => void demarrer(false));
    $('lancer-libre').addEventListener('click', () => void demarrer(true));
    $('rejouer').addEventListener('click', () => {
      afficherVue('accueil-session');
      void rafraichirCompteurs();
    });
    $('quitter').addEventListener('click', () => {
      afficherVue('accueil-session');
      void rafraichirCompteurs();
    });
    $('retour-accueil').setAttribute('href', lien('/'));
    $('carte').addEventListener('click', retourner);

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('#notation [data-note]')) {
      bouton.addEventListener('click', () => void annoter(bouton.dataset.note as Difficulte));
    }

    // Raccourcis clavier : Espace pour retourner, 1/2/3 pour noter.
    document.addEventListener('keydown', (e) => {
      if ($('session').classList.contains('hidden')) return;
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        retourner();
      } else if (reponseVisible && ['1', '2', '3'].includes(e.key)) {
        e.preventDefault();
        void annoter((['difficile', 'moyen', 'facile'] as const)[Number(e.key) - 1]);
      }
    });

    $('chargement').classList.add('hidden');
    afficherVue('accueil-session');
  }

  document.addEventListener('revinsp:deverrouille', () => {
    initialiser().catch((e) => {
      $('chargement').textContent = `Erreur : ${e.message}`;
    });
  });
</script>
