---
/**
 * Sport : les programmes, et le volume par muscle.
 *
 * L'écran répond à une seule question — « ce que je fais correspond-il à ce
 * que je prévois ? » — et il y répond en montrant les deux côte à côte. Le
 * volume réalisé seul ne dit pas s'il suffit ; le prévu seul ne dit pas s'il
 * a été tenu.
 *
 * Le tableau montre **tous** les muscles, y compris ceux à zéro partout : la
 * ligne vide est l'information. Un muscle oublié ne se voit pas dans une
 * liste de ce qu'on a fait.
 */
import Base from '../../layouts/Base.astro';
import { MUSCLES } from '../../lib/sport/modele';
---

<Base titre="Programmes" actif="programmes">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mes programmes</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Un programme est une <strong>intention</strong> : il ne crée aucune séance. C’est la saisie en
      direct qui enregistre ce qui a eu lieu, et le tableau de volume compare les deux.
    </p>

    <div id="chargement-programmes" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture des programmes…</p>
    </div>

    <div id="vue" class="mt-6 hidden space-y-8">
      <section>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes programmes</h2>
          <button id="nouveau" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Nouveau programme</button>
        </div>
        <div id="liste" class="mt-3 space-y-3"></div>
        <p id="aucun" class="hidden text-sm text-slate-500 dark:text-slate-400">
          Aucun programme. Un entraînement sans programme reste un entraînement — celui-ci sert à
          voir les trous, pas à autoriser les séances.
        </p>
      </section>

      <!-- L'éditeur, caché tant qu'on n'édite rien -->
      <section id="editeur" class="hidden rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900">
        <h2 id="titre-editeur" class="text-base font-semibold text-slate-900 dark:text-white"></h2>

        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="min-w-48 flex-1 text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Nom</span>
            <input id="nom" type="text" maxlength="120"
              class="mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Séances par semaine</span>
            <input id="par-semaine" type="number" min="1" max="14" value="3"
              class="mt-1 min-h-11 w-28 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <label class="flex min-h-11 items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
            <input id="actif" type="checkbox" class="size-5 rounded" />
            C’est celui que je suis
          </label>
        </div>

        <label class="mt-3 block text-sm">
          <span class="block text-slate-700 dark:text-slate-200">Description</span>
          <textarea id="description" rows="2" maxlength="500"
            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"></textarea>
        </label>

        <h3 class="mt-5 text-sm font-semibold text-slate-900 dark:text-white">Séances types</h3>
        <div id="seances" class="mt-2 space-y-4"></div>
        <button id="ajouter-seance" type="button"
          class="mt-3 min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700"
          >Ajouter une séance type</button>

        <h3 class="mt-6 text-sm font-semibold text-slate-900 dark:text-white">
          Cibles hebdomadaires, en séries par muscle
        </h3>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Facultatives, et seulement pour les muscles que vous surveillez. Laisser vide veut dire
          « aucun jugement », ce qui n’est pas la même chose que zéro.
        </p>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          {MUSCLES.map((m) => (
            <label class="flex items-center justify-between gap-2 text-xs">
              <span class="text-slate-700 dark:text-slate-200">{m.libelle}</span>
              <input type="number" min="0" max="40" step="0.5" data-cible={m.id} placeholder="—"
                class="min-h-11 w-20 rounded-lg border border-slate-300 bg-white px-2 text-xs dark:border-slate-700 dark:bg-slate-950" />
            </label>
          ))}
        </div>

        <p id="absents" class="mt-4 hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950/30 dark:text-amber-100"></p>
        <p id="erreur" class="mt-3 hidden text-sm text-rose-700 dark:text-rose-300"></p>

        <div class="mt-4 flex flex-wrap gap-3">
          <button id="enregistrer" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Enregistrer</button>
          <button id="annuler" type="button"
            class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm dark:border-slate-700"
            >Annuler</button>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
          Mon volume, muscle par muscle
        </h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Compté en <strong>séries</strong>, jamais en tonnage : cent kilos au soulevé de terre et
          cent kilos au curl ne demandent pas le même effort.
        </p>
        {/*
           Trois corrections pour une seule cause : à 390 px, l'étiquette et la
           liste côte à côte poussaient le document à 400 px, et la barre fixe
           du bas s'étirait avec lui.

           « inline-flex » mettait les deux sur une ligne que l'écran n'a pas ;
           l'étiquette passe donc au-dessus. Le libellé le plus long perdait
           « (moyenne hebdo) », qui se répétait sur deux options et ne disait
           rien de plus que la colonne du tableau. Et « max-w-full » empêche
           une liste déroulante de dépasser son parent, ce qu'elle fait
           volontiers quand son option la plus large l'y pousse.
        */}
        <label class="mt-2 block text-sm">
          <span class="block text-slate-700 dark:text-slate-200">Réalisé sur</span>
          <select id="fenetre"
            class="mt-1 min-h-11 max-w-full rounded-lg border border-slate-300 bg-white px-2 text-sm dark:border-slate-700 dark:bg-slate-950">
            <option value="7">7 derniers jours</option>
            <option value="14">14 derniers jours</option>
            <option value="28" selected>28 derniers jours</option>
          </select>
        </label>
        {/*
           Le tableau ne s'affiche qu'une fois qu'il a quelque chose à dire.

           Sans programme et sans séance, il dessinait dix-huit lignes de
           tirets et répétait dix-huit fois « aucune cible ». Ce n'est pas une
           information : c'est la forme d'une information, remplie de rien, et
           il faut la lire en entier pour s'en apercevoir.
        */}
        <p id="volumes-vides" class="mt-3 hidden rounded-xl border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
          <span id="volumes-vides-texte"></span>
          <button
            id="volumes-vides-action"
            type="button"
            class="cible-tactile-pleine mt-3 block w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-500 sm:mx-auto sm:w-auto"
          >
            Créer un programme
          </button>
        </p>
        <div id="volumes-tableau" class="mt-3 overflow-x-auto">
          <table class="table-aeree w-full text-sm">
            <caption class="sr-only">
              Volume hebdomadaire par muscle : prévu par le programme actif, réalisé, et cible.
            </caption>
            <thead>
              <tr class="border-b border-slate-200 text-left text-xs uppercase text-slate-500 dark:border-slate-800 dark:text-slate-400">
                <th scope="col" class="py-2">Muscle</th>
                <th scope="col" class="py-2 text-right">Prévu</th>
                <th scope="col" class="py-2 text-right">Réalisé</th>
                <th scope="col" class="py-2 text-right">Cible</th>
                <th scope="col" class="py-2">Écart</th>
              </tr>
            </thead>
            <tbody id="volumes"></tbody>
          </table>
        </div>
        <p id="coefficient" class="mt-2 text-xs text-slate-400 dark:text-slate-500"></p>
      </section>
    </div>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { messageDUneErreur } from '../../lib/agir';
  import { unSeulGeste } from '../../lib/geste';
  import { jourLogique } from '../../lib/noyau/jour-logique';
  import { reglagesJourLogiqueLocaux } from '../../lib/adaptation';
  import {
    ecrireProgramme,
    supprimerProgramme,
    tousLesExercices,
    tousLesProgrammes,
    toutesLesSeancesSport,
  } from '../../lib/sport/donnees';
  import { libelleDuMuscle, volumeParMuscle, type Exercice, type Serie } from '../../lib/sport/modele';
  import {
    comparerVolumes,
    musclesAbsents,
    volumePrevu,
    type BlocPrevu,
    type Programme,
    type SeanceType,
  } from '../../lib/sport/programmes';

  const $ = (id: string) => document.getElementById(id)!;
  const nombre = (x: number) => (Math.round(x * 10) / 10).toLocaleString('fr-FR');

  let exercices: Exercice[] = [];
  let programmes: Programme[] = [];
  /** Le programme en cours d'édition, ou `null` si l'éditeur est fermé. */
  let brouillon: Programme | null = null;

  const identifiant = () =>
    `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;

  const blocNeuf = (): BlocPrevu => ({
    exerciceId: exercices[0]?.id ?? '',
    series: 3,
    repetitionsMin: 8,
    repetitionsMax: 12,
    repos: 120,
    chargeIndicative: null,
    note: '',
  });

  const seanceNeuve = (rang: number): SeanceType => ({
    id: identifiant(),
    nom: `Séance ${rang}`,
    blocs: [blocNeuf()],
  });

  /* ── L'éditeur ─────────────────────────────────────────────────────────── */

  function ouvrirEditeur(programme: Programme | null) {
    brouillon = programme ?? {
      id: identifiant(),
      nom: '',
      description: '',
      seances: [seanceNeuve(1)],
      parSemaine: 3,
      actif: programmes.length === 0,
      ciblesParMuscle: {},
      majLe: new Date().toISOString(),
    };
    $('titre-editeur').textContent = programme ? `Modifier « ${programme.nom} »` : 'Nouveau programme';
    ($('nom') as HTMLInputElement).value = brouillon.nom;
    ($('description') as HTMLTextAreaElement).value = brouillon.description;
    ($('par-semaine') as HTMLInputElement).value = String(brouillon.parSemaine);
    ($('actif') as HTMLInputElement).checked = brouillon.actif;
    for (const champ of document.querySelectorAll<HTMLInputElement>('[data-cible]')) {
      const cible = brouillon.ciblesParMuscle[champ.dataset.cible!];
      champ.value = cible === undefined ? '' : String(cible);
    }
    $('editeur').classList.remove('hidden');
    $('erreur').classList.add('hidden');
    peindreSeances();
    $('nom').focus();
  }

  function fermerEditeur() {
    brouillon = null;
    $('editeur').classList.add('hidden');
  }

  function choixExercice(selectionne: string): HTMLSelectElement {
    const select = document.createElement('select');
    select.className =
      'min-h-11 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-sm dark:border-slate-700 dark:bg-slate-950';
    select.setAttribute('aria-label', 'Exercice');
    for (const e of [...exercices].sort((a, b) => a.nom.localeCompare(b.nom, 'fr'))) {
      const option = document.createElement('option');
      option.value = e.id;
      option.textContent = [e.nom, e.equipement, e.variante].filter(Boolean).join(' · ');
      if (e.id === selectionne) option.selected = true;
      select.appendChild(option);
    }
    return select;
  }

  function champNombre(
    valeur: number | null,
    etiquette: string,
    largeur: string,
    poser: (v: number | null) => void,
    options: { min?: number; pas?: number } = {},
  ): HTMLLabelElement {
    const label = document.createElement('label');
    label.className = 'text-xs text-slate-500 dark:text-slate-400';
    const texte = document.createElement('span');
    texte.className = 'block';
    texte.textContent = etiquette;
    const champ = document.createElement('input');
    champ.type = 'number';
    champ.min = String(options.min ?? 0);
    if (options.pas) champ.step = String(options.pas);
    champ.value = valeur === null ? '' : String(valeur);
    champ.className = `mt-0.5 min-h-11 ${largeur} rounded-lg border border-slate-300 bg-white px-2 text-sm dark:border-slate-700 dark:bg-slate-950`;
    champ.addEventListener('input', () => {
      poser(champ.value === '' ? null : Number(champ.value));
      direLesAbsents();
    });
    label.append(texte, champ);
    return label;
  }

  function peindreSeances() {
    if (!brouillon) return;
    const zone = $('seances');
    zone.innerHTML = '';

    brouillon.seances.forEach((seance, rangSeance) => {
      const carte = document.createElement('div');
      carte.className =
        'rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-950';

      const entete = document.createElement('div');
      entete.className = 'flex flex-wrap items-center gap-2';
      const nom = document.createElement('input');
      nom.type = 'text';
      nom.value = seance.nom;
      nom.setAttribute('aria-label', 'Nom de la séance type');
      nom.className =
        'min-h-11 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-950';
      nom.addEventListener('input', () => {
        seance.nom = nom.value;
      });
      const retirer = document.createElement('button');
      retirer.type = 'button';
      retirer.className = 'text-xs text-rose-700 underline dark:text-rose-300';
      retirer.textContent = 'Retirer la séance';
      retirer.addEventListener('click', () => {
        brouillon!.seances = brouillon!.seances.filter((s) => s.id !== seance.id);
        peindreSeances();
      });
      entete.append(nom, retirer);
      carte.appendChild(entete);

      seance.blocs.forEach((bloc, rangBloc) => {
        const ligne = document.createElement('div');
        ligne.className = 'mt-2 flex flex-wrap items-end gap-2';

        const select = choixExercice(bloc.exerciceId);
        select.addEventListener('change', () => {
          bloc.exerciceId = select.value;
          direLesAbsents();
        });
        ligne.appendChild(select);

        ligne.appendChild(
          champNombre(bloc.series, 'Séries', 'w-20', (v) => {
            bloc.series = v ?? 1;
          }, { min: 1 }),
        );
        ligne.appendChild(
          champNombre(bloc.repetitionsMin, 'Rép. min', 'w-24', (v) => {
            bloc.repetitionsMin = v ?? 1;
          }, { min: 1 }),
        );
        ligne.appendChild(
          champNombre(bloc.repetitionsMax, 'Rép. max', 'w-24', (v) => {
            bloc.repetitionsMax = v ?? 1;
          }, { min: 1 }),
        );
        ligne.appendChild(
          champNombre(bloc.repos, 'Repos (s)', 'w-24', (v) => {
            bloc.repos = v;
          }),
        );
        ligne.appendChild(
          champNombre(bloc.chargeIndicative, 'Charge', 'w-24', (v) => {
            bloc.chargeIndicative = v;
          }, { pas: 0.5 }),
        );

        const retirerBloc = document.createElement('button');
        retirerBloc.type = 'button';
        retirerBloc.className = 'min-h-11 text-xs text-rose-700 underline dark:text-rose-300';
        retirerBloc.textContent = 'Retirer';
        retirerBloc.setAttribute('aria-label', `Retirer l’exercice ${rangBloc + 1}`);
        retirerBloc.addEventListener('click', () => {
          seance.blocs.splice(rangBloc, 1);
          peindreSeances();
          direLesAbsents();
        });
        ligne.appendChild(retirerBloc);
        carte.appendChild(ligne);
      });

      const ajouter = document.createElement('button');
      ajouter.type = 'button';
      ajouter.className = 'mt-2 text-xs text-indigo-700 underline dark:text-indigo-300';
      ajouter.textContent = 'Ajouter un exercice';
      ajouter.setAttribute('aria-label', `Ajouter un exercice à la séance ${rangSeance + 1}`);
      ajouter.addEventListener('click', () => {
        seance.blocs.push(blocNeuf());
        peindreSeances();
        direLesAbsents();
      });
      carte.appendChild(ajouter);
      zone.appendChild(carte);
    });
    direLesAbsents();
  }

  /** Les muscles qu'aucun exercice du brouillon ne touche. Une alerte, pas un refus. */
  function direLesAbsents() {
    if (!brouillon) return;
    const absents = musclesAbsents(brouillon, exercices);
    $('absents').classList.toggle('hidden', absents.length === 0);
    if (absents.length) {
      $('absents').textContent =
        `Aucun exercice de ce programme ne travaille : ${absents.map(libelleDuMuscle).join(', ')}. ` +
        'C’est peut-être voulu — un programme du haut du corps est un programme.';
    }
  }

  function lireBrouillon(): Programme {
    const cibles: Record<string, number> = {};
    for (const champ of document.querySelectorAll<HTMLInputElement>('[data-cible]')) {
      if (champ.value.trim() === '') continue;
      cibles[champ.dataset.cible!] = Number(champ.value);
    }
    return {
      ...brouillon!,
      nom: ($('nom') as HTMLInputElement).value.trim(),
      description: ($('description') as HTMLTextAreaElement).value.trim(),
      parSemaine: Number(($('par-semaine') as HTMLInputElement).value),
      actif: ($('actif') as HTMLInputElement).checked,
      ciblesParMuscle: cibles,
      majLe: new Date().toISOString(),
    };
  }

  /* ── La liste ──────────────────────────────────────────────────────────── */

  function peindreListe() {
    const zone = $('liste');
    zone.innerHTML = '';
    $('aucun').classList.toggle('hidden', programmes.length > 0);
    for (const programme of programmes) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950';
      carte.dataset.programme = programme.id;

      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = programme.nom;
      if (programme.actif) {
        const marque = document.createElement('span');
        marque.className =
          'ml-2 rounded-full bg-indigo-100 px-2 py-0.5 text-xs text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200';
        marque.textContent = 'suivi';
        titre.appendChild(marque);
      }
      carte.appendChild(titre);

      const detail = document.createElement('p');
      detail.className = 'mt-0.5 text-xs text-slate-500 dark:text-slate-400';
      const seances = programme.seances.length;
      detail.textContent =
        `${seances} séance${seances > 1 ? 's' : ''} type${seances > 1 ? 's' : ''} · ` +
        `${programme.parSemaine} par semaine` +
        (programme.description ? ` · ${programme.description}` : '');
      carte.appendChild(detail);

      const actions = document.createElement('div');
      actions.className = 'mt-2 flex gap-4';
      const modifier = document.createElement('button');
      modifier.type = 'button';
      modifier.className = 'text-xs text-indigo-700 underline dark:text-indigo-300';
      modifier.textContent = 'Modifier';
      modifier.addEventListener('click', () => ouvrirEditeur(structuredClone(programme)));
      const effacer = document.createElement('button');
      effacer.type = 'button';
      effacer.className = 'text-xs text-rose-700 underline dark:text-rose-300';
      effacer.textContent = 'Supprimer';
      effacer.addEventListener('click', () => {
        void supprimerProgramme(programme.id).then(recharger);
      });
      actions.append(modifier, effacer);
      carte.appendChild(actions);
      zone.appendChild(carte);
    }
  }

  /* ── Le volume ─────────────────────────────────────────────────────────── */

  async function peindreVolumes() {
    const jours = Number(($('fenetre') as HTMLSelectElement).value);
    const reglages = await reglagesJourLogiqueLocaux();
    const seances = await toutesLesSeancesSport();

    const limite = new Date(Date.now() - jours * 86_400_000);
    const depuis = jourLogique(limite, reglages);
    const series: Serie[] = seances
      .filter((s) => s.statut === 'terminee' && s.jour >= depuis)
      .flatMap((s) => s.series);

    /*
       Ramené à la semaine : sur 28 jours, le réalisé brut vaut quatre
       semaines, et le comparer tel quel à un prévu hebdomadaire ferait croire
       à un excédent de 300 %.
    */
    const brut = volumeParMuscle(series, exercices);
    const semaines = jours / 7;
    const realise: Record<string, number> = {};
    for (const [muscle, compte] of Object.entries(brut.series)) {
      realise[muscle] = Math.round((compte / semaines) * 100) / 100;
    }

    const actif = programmes.find((p) => p.actif);
    const prevu = actif ? volumePrevu(actif, exercices).series : {};
    const lignes = comparerVolumes({
      prevu,
      realise,
      cibles: actif?.ciblesParMuscle ?? {},
    });

    const couleur: Record<string, string> = {
      'sans-cible': 'text-slate-400 dark:text-slate-500',
      dans: 'text-emerald-700 dark:text-emerald-300',
      sous: 'text-amber-700 dark:text-amber-300',
      'au-dela': 'text-rose-700 dark:text-rose-300',
    };
    const mot: Record<string, string> = {
      'sans-cible': 'aucune cible',
      dans: 'dans la cible',
      sous: 'sous la cible',
      'au-dela': 'au-delà de la cible',
    };

    /*
       « Vide » veut dire : rien de prévu, rien de réalisé, aucune cible. Une
       seule valeur quelque part suffit à rendre le tableau utile — y compris
       un réalisé sans programme, qui est justement ce qu'on veut voir avant
       d'en écrire un.
    */
    const rienADire = lignes.every((l) => !l.prevu && !l.realise && l.cible === null);
    $('volumes-tableau').classList.toggle('hidden', rienADire);
    $('volumes-vides').classList.toggle('hidden', !rienADire);
    if (rienADire) {
      $('volumes-vides-texte').textContent = actif
        ? `« ${actif.nom} » ne fixe aucune cible et aucune séance n'a été tenue sur la période. Le tableau s'affichera dès la première série enregistrée.`
        : "Aucun programme suivi et aucune séance tenue sur la période : il n'y a encore rien à comparer.";
      $('volumes-vides-action').textContent = actif ? 'Modifier le programme' : 'Créer un programme';
    }

    const corps = $('volumes');
    corps.innerHTML = '';
    for (const ligne of lignes) {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 dark:border-slate-900';
      tr.dataset.muscle = ligne.muscle;
      tr.dataset.etat = ligne.etat;

      const nom = document.createElement('th');
      nom.scope = 'row';
      nom.className = 'py-1.5 text-left font-normal text-slate-700 dark:text-slate-200';
      nom.textContent = libelleDuMuscle(ligne.muscle);
      tr.appendChild(nom);

      for (const valeur of [ligne.prevu, ligne.realise]) {
        const td = document.createElement('td');
        td.className = 'py-1.5 text-right tabular-nums text-slate-700 dark:text-slate-200';
        td.textContent = valeur ? nombre(valeur) : '—';
        tr.appendChild(td);
      }
      const cible = document.createElement('td');
      cible.className = 'py-1.5 text-right tabular-nums text-slate-500 dark:text-slate-400';
      cible.textContent = ligne.cible === null ? '—' : nombre(ligne.cible);
      tr.appendChild(cible);

      const etat = document.createElement('td');
      etat.className = `py-1.5 pl-3 text-xs ${couleur[ligne.etat]}`;
      etat.textContent = mot[ligne.etat];
      tr.appendChild(etat);

      corps.appendChild(tr);
    }

    $('coefficient').textContent = actif
      ? `Les muscles secondaires comptent pour ${brut.coefficient.toLocaleString('fr-FR')} série. ` +
        `Prévu d’après « ${actif.nom} ».`
      : `Les muscles secondaires comptent pour ${brut.coefficient.toLocaleString('fr-FR')} série. ` +
        'Aucun programme suivi : la colonne « prévu » reste vide.';
  }

  async function recharger() {
    [exercices, programmes] = await Promise.all([tousLesExercices(), tousLesProgrammes()]);
    programmes.sort((a, b) => Number(b.actif) - Number(a.actif) || a.nom.localeCompare(b.nom, 'fr'));
    peindreListe();
    await peindreVolumes();
  }

  auDeverrouillage(
    async () => {
      $('nouveau').addEventListener('click', () => ouvrirEditeur(null));
      $('volumes-vides-action').addEventListener('click', () => {
        const actif = programmes.find((p) => p.actif);
        ouvrirEditeur(actif ?? null);
      });
      $('annuler').addEventListener('click', fermerEditeur);
      $('ajouter-seance').addEventListener('click', () => {
        if (!brouillon) return;
        brouillon.seances.push(seanceNeuve(brouillon.seances.length + 1));
        peindreSeances();
      });
      $('fenetre').addEventListener('change', () => void peindreVolumes());
      /*
         Un appui, une écriture — M6. « Enregistrer » un programme neuf frappe
         un identifiant neuf : deux appuis rapprochés en créaient deux copies,
         et l'éditeur ne se referme qu'une fois l'écriture finie.
      */
      $('enregistrer').addEventListener('click', (evenement) => {
        void unSeulGeste(evenement.currentTarget as Element, async () => {
          try {
            await ecrireProgramme(lireBrouillon());
            $('erreur').classList.add('hidden');
            fermerEditeur();
            await recharger();
          } catch (erreur) {
            $('erreur').textContent = messageDUneErreur(erreur);
            $('erreur').classList.remove('hidden');
          }
        });
      });

      await recharger();
      $('vue').classList.remove('hidden');
    },
    { zoneChargement: '#chargement-programmes' },
  );
</script>
