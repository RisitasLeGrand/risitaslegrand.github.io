---
/**
 * Sport : la bibliothèque d'exercices.
 *
 * ## Le schéma et les cases disent la même chose, toujours
 *
 * Les deux sont affichés **en même temps**, et non l'un en repli de l'autre.
 * Un schéma cliquable n'est pas utilisable au lecteur d'écran, quoi qu'on
 * fasse des rôles ARIA ; une liste de cases l'est, et elle est moins rapide à
 * la souris. Les deux écrivent le même état, et cocher d'un côté met l'autre à
 * jour — c'est ce qui en fait une alternative et non un mode dégradé.
 *
 * Chaque zone du schéma est un `<button>` réel, avec son nom accessible et son
 * `aria-pressed` : au clavier seul, on peut donc parcourir le corps et cycler
 * les états sans jamais toucher les cases. Les deux chemins marchent ; c'est
 * l'exigence, pas la coquetterie.
 *
 * ## L'identité de comparaison est montrée
 *
 * Le nom, l'équipement et la variante forment l'identité : deux exercices qui
 * la partagent sont le même, et changer d'équipement repart de zéro pour le
 * suivi de force. L'écran le dit au moment de la saisie, parce que c'est là
 * que la décision se prend — et il signale les doublons plutôt que de les
 * fusionner, ce qui serait irréversible.
 */
import Base from '../../layouts/Base.astro';
import {
  FORME_PAR_DEFAUT,
  HAUTEUR,
  LARGEUR,
  LIBELLE_FORME,
  formesDuCorps,
  musclesDeLaFace,
  silhouetteDuCorps,
} from '../../lib/sport/schema-corps';

/*
   Les deux jeux sont rendus dans le MÊME balisage : chaque chemin porte sa
   forme simplifiée dans « d » et sa forme complète dans « data-complete ».
   Changer de réglage réécrit « d », sans toucher aux zones, aux noms
   accessibles ni à l'ordre de tabulation. Rendre deux arbres et en cacher un
   doublerait les cibles et les étiquettes pour les technologies d'assistance.
*/
const SIMPLE = formesDuCorps('simplifiee');
const DETAIL = formesDuCorps('complete');
const SILHOUETTE_SIMPLE = silhouetteDuCorps('simplifiee');
const SILHOUETTE_DETAIL = silhouetteDuCorps('complete');
import { MUSCLES, UNITES_DE_CHARGE, libelleDuMuscle } from '../../lib/sport/modele';

/*
   La nature et la latéralité sont demandées à la saisie et non devinées : un
   exercice unilatéral dont on croit la charge bilatérale compterait le double,
   et un étirement rangé en force polluerait le suivi de la force.
*/
const NATURES = [
  ['force', 'Force'],
  ['cardio', 'Cardio'],
  ['mobilite', 'Mobilité'],
  ['gainage', 'Gainage'],
] as const;

const faces = [
  { id: 'avant' as const, libelle: 'De face', muscles: musclesDeLaFace('avant') },
  { id: 'arriere' as const, libelle: 'De dos', muscles: musclesDeLaFace('arriere') },
];

/** Les muscles groupés, pour la liste de cases. */
const groupes = [...new Set(MUSCLES.map((m) => m.groupe))].map((groupe) => ({
  groupe,
  muscles: MUSCLES.filter((m) => m.groupe === groupe),
}));
---

<Base titre="Exercices" actif="exercices">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mes exercices</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Le <strong>nom</strong>, l’<strong>équipement</strong> et la <strong>variante</strong> font
      l’identité d’un exercice : deux charges à la barre et aux haltères ne se comparent pas, et
      changer d’équipement repart de zéro pour le suivi de force.
    </p>

    <div id="chargement-exercices" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture de la bibliothèque…</p>
    </div>

    <div id="vue" class="mt-6 hidden">
      <p id="doublons" class="mb-4 hidden rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950/30 dark:text-amber-100"></p>

      <section>
        {/*
           La liste d'abord, la création ensuite.

           Le formulaire — sept champs, un schéma et quinze listes de muscles —
           occupait le haut de l'écran, et il fallait le franchir en entier
           pour atteindre les trente exercices. On vient pourtant ici pour
           consulter bien plus souvent que pour créer. Le formulaire est donc
           dans une boîte de dialogue, ouverte par le bouton ci-dessous.
        */}
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">La bibliothèque</h2>
          <button
            id="ouvrir-ajout"
            type="button"
            class="cible-tactile-pleine rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
          >
            Ajouter un exercice
          </button>
        </div>
        <input id="filtre" aria-label="Filtrer les exercices" type="search" placeholder="Filtrer par nom, équipement ou muscle"
          class="mb-3 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
        <p id="compte-exercices" role="status" class="mb-2 text-xs text-slate-500 dark:text-slate-400"></p>
        <div id="liste" class="space-y-2"></div>
        <p id="liste-vide" class="hidden text-sm text-slate-500 dark:text-slate-400">Rien ici.</p>
      </section>

      <dialog
        id="fenetre-ajout"
        aria-labelledby="titre-ajout"
        class="w-[min(60rem,94vw)] max-w-full rounded-2xl border border-slate-200 bg-white p-5 text-slate-900 shadow-xl backdrop:bg-slate-900/50 dark:border-slate-800 dark:bg-slate-900 dark:text-white"
      >
        <form id="ajout">
        <div class="flex items-start justify-between gap-3">
          <h2 id="titre-ajout" class="text-base font-semibold text-slate-900 dark:text-white">Ajouter un exercice</h2>
          <button
            id="fermer-ajout"
            type="button"
            aria-label="Fermer sans ajouter"
            class="cible-tactile-pleine -mt-1 -mr-1 shrink-0 rounded-lg px-3 text-lg text-slate-500 transition hover:bg-slate-200 dark:text-slate-400 dark:hover:bg-slate-800"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="min-w-48 flex-1 text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Nom</span>
            <input id="nom" type="text" required maxlength="120"
              class="mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Équipement</span>
            <input id="equipement" type="text" maxlength="60"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Variante</span>
            <input id="variante" type="text" maxlength="60"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Nature</span>
            <select id="nature"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950">
              {NATURES.map(([id, libelle]) => <option value={id}>{libelle}</option>)}
            </select>
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Côtés</span>
            <select id="lateralite"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950">
              <option value="bilateral">Les deux à la fois</option>
              <option value="unilateral">Un côté à la fois</option>
            </select>
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Charge</span>
            <select id="unite"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950">
              {Object.entries(UNITES_DE_CHARGE).map(([id, libelle]) => (
                <option value={id}>{libelle}</option>
              ))}
            </select>
          </label>
        </div>

        <h3 class="mt-5 text-sm font-semibold text-slate-900 dark:text-white">
          Quels muscles travaillent&nbsp;?
        </h3>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Cliquez une zone pour la faire passer de <em>rien</em> à <em>principal</em>, puis à{' '}
          <em>secondaire</em>. Les cases en dessous font exactement la même chose, et restent
          synchronisées.
        </p>

        {/*
           Le choix de la forme.

           Une paire de boutons radio plutôt qu'une case à cocher : « complète »
           et « simplifiée » sont deux états nommés, pas une option qu'on
           active. Un libellé de case — « Schéma détaillé » — laisserait croire
           que la simplifiée est un défaut d'affichage, alors que c'est le
           réglage voulu par défaut (décision 6).
        */}
        {/*
           A7, cas 1 — les muscles sollicités s'allument, étape par étape.

           **À la demande, jamais en boucle** : rien ne bouge tant qu'on n'a pas
           appuyé. Deux étapes — principaux, puis secondaires —, avançables au
           clavier, rejouables, et interruptibles.

           **L'état final est lisible sans l'animation** : à la fin, le schéma
           montre exactement ce qu'il montrait avant qu'on lance, et le texte
           ci-dessous dit la même chose en toutes lettres. Qui n'appuie jamais
           ne perd rien ; qui n'y voit pas lit le commentaire.
        */}
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button
            id="voir-animation"
            type="button"
            class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200"
          >Voir l’animation</button>
          <button
            id="etape-animation"
            type="button"
            hidden
            class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 dark:border-slate-700 dark:text-slate-200"
          >Étape suivante</button>
          <p id="commentaire-animation" class="text-sm text-slate-600 dark:text-slate-300" aria-live="polite"></p>
        </div>

        <fieldset class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
          <legend class="text-xs font-medium text-slate-500 dark:text-slate-400">
            Forme du schéma
          </legend>
          {(['simplifiee', 'complete'] as const).map((forme) => (
            <label class="flex min-h-11 items-center gap-2 text-sm">
              <input
                type="radio"
                name="forme-corps"
                value={forme}
                checked={forme === FORME_PAR_DEFAUT}
                class="h-4 w-4"
              />
              {LIBELLE_FORME[forme]}
            </label>
          ))}
        </fieldset>

        <div class="mt-3 grid gap-6 lg:grid-cols-2">
          <!-- Le schéma -->
          <div class="flex flex-wrap justify-center gap-4">
            {faces.map((face) => (
              <figure class="text-center">
                <svg
                  viewBox={`0 0 ${LARGEUR} ${HAUTEUR}`}
                  class="h-72 w-auto"
                  role="group"
                  aria-label={`Schéma du corps, ${face.libelle.toLowerCase()}`}
                  data-face={face.id}
                >
                  <g aria-hidden="true" class="fill-slate-200 dark:fill-slate-800">
                    {SILHOUETTE_SIMPLE.map((f, i) => (
                      <path d={f.d} data-complete={SILHOUETTE_DETAIL[i]?.d ?? f.d} />
                    ))}
                  </g>
                  {face.muscles.map((id) => (
                    <g
                      role="button"
                      tabindex="0"
                      data-zone={id}
                      data-etat="aucun"
                      aria-pressed="false"
                      aria-label={libelleDuMuscle(id)}
                      class="zone"
                    >
                      <title>{libelleDuMuscle(id)}</title>
                      {(SIMPLE[id] ?? []).map((f, i) => (
                        <path d={f.d} data-complete={DETAIL[id]?.[i]?.d ?? f.d} />
                      ))}
                    </g>
                  ))}
                </svg>
                <figcaption class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  {face.libelle}
                </figcaption>
              </figure>
            ))}
          </div>

          {/*
             L'alternative, toujours présente — mais repliable.

             Les deux vues disent la même chose et restent synchronisées :
             c'est ce qui en fait une alternative et non un mode dégradé, et
             ça ne change pas ici. Ce qui change, c'est que les quinze listes
             n'occupent plus la moitié de la fenêtre avant qu'on ait choisi
             d'y aller.

             Le bloc est **ouvert dans le balisage** : sans script, les deux
             vues restent côte à côte comme avant. Le script ne le referme
             que là où il n'y a pas la place — en dessous de « lg », où le
             schéma et la liste s'empilent de toute façon.
          */}
          <details id="liste-muscles" open class="depliant-muscles">
            <summary class="cible-tactile-pleine cursor-pointer text-sm font-medium text-indigo-700 dark:text-indigo-300">
              Choisir les muscles dans une liste
            </summary>
            <div class="mt-3">
            <fieldset class="space-y-3">
              <legend class="text-sm font-medium text-slate-700 dark:text-slate-200">
                Ou choisissez dans la liste
              </legend>
              {groupes.map(({ groupe, muscles }) => (
                <div>
                  <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">{groupe}</p>
                  <div class="mt-1 grid gap-1 sm:grid-cols-2">
                    {muscles.map((m) => (
                      <label class="flex min-h-11 items-center gap-2 text-sm">
                        <select
                          data-case={m.id}
                          aria-label={m.libelle}
                          class="min-h-11 rounded-lg border border-slate-300 bg-white px-2 text-xs dark:border-slate-700 dark:bg-slate-950"
                        >
                          <option value="aucun">—</option>
                          <option value="principal">Principal</option>
                          <option value="secondaire">Secondaire</option>
                        </select>
                        <span class="text-slate-700 dark:text-slate-200">{m.libelle}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </fieldset>
            </div>
          </details>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="submit"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Ajouter</button>
          <span id="identite" class="font-mono text-xs text-slate-400 dark:text-slate-500"></span>
        </div>
        <p id="erreur" class="mt-2 hidden text-sm text-rose-700 dark:text-rose-300"></p>
        </form>
      </dialog>
    </div>
  </div>
</Base>

<style>
  /* Le « … » du menu d'actions : pas de triangle de dépliant. */
  .menu-actions > summary {
    list-style: none;
  }
  .menu-actions > summary::-webkit-details-marker {
    display: none;
  }
  .menu-actions > summary::marker {
    content: '';
  }

  .zone {
    fill: var(--color-slate-400, #94a3b8);
    cursor: pointer;
    transition: fill 120ms;
  }
  .zone:hover { fill: var(--color-indigo-400, #818cf8); }
  .zone:focus-visible {
    outline: 2px solid var(--color-indigo-600, #4f46e5);
    outline-offset: 2px;
  }
  .zone[data-etat='principal'] { fill: var(--color-indigo-600, #4f46e5); }
  .zone[data-etat='secondaire'] { fill: var(--color-indigo-300, #a5b4fc); }
</style>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import {
    ecrireExercice,
    installerBibliotheque,
    supprimerExercice,
    tousLesExercices,
  } from '../../lib/sport/donnees';
  import {
    UNITES_DE_CHARGE,
    identiteDeComparaison,
    libelleDuMuscle,
    type Exercice,
    type Lateralite,
    type NatureExercice,
    type UniteDeCharge,
  } from '../../lib/sport/modele';
  import { doublons } from '../../lib/sport/force';
  import { etatSuivant, type EtatMuscle } from '../../lib/sport/schema-corps';

  const $ = (id: string) => document.getElementById(id)!;

  /** L'état de chaque muscle dans le formulaire. Une seule source, deux vues. */
  const etats = new Map<string, EtatMuscle>();

  /**
   * Pose l'état d'un muscle et met **les deux vues** à jour.
   *
   * C'est ici que tient la promesse d'équivalence : il n'existe pas de chemin
   * qui change le schéma sans changer les cases, parce qu'il n'existe qu'une
   * fonction pour changer quoi que ce soit.
   */
  function poser(id: string, etat: EtatMuscle) {
    etats.set(id, etat);
    for (const zone of document.querySelectorAll<SVGGElement>(`[data-zone="${id}"]`)) {
      zone.dataset.etat = etat;
      zone.setAttribute('aria-pressed', String(etat !== 'aucun'));
      zone.setAttribute(
        'aria-label',
        etat === 'aucun'
          ? libelleDuMuscle(id)
          : `${libelleDuMuscle(id)} — ${etat === 'principal' ? 'principal' : 'secondaire'}`,
      );
    }
    const choix = document.querySelector<HTMLSelectElement>(`[data-case="${id}"]`);
    if (choix && choix.value !== etat) choix.value = etat;
  }

  const retenus = (etat: EtatMuscle) =>
    [...etats.entries()].filter(([, e]) => e === etat).map(([id]) => id);

  function direIdentite() {
    const nom = ($('nom') as HTMLInputElement).value;
    const equipement = ($('equipement') as HTMLInputElement).value;
    const variante = ($('variante') as HTMLInputElement).value;
    $('identite').textContent = nom
      ? `identité : ${identiteDeComparaison({ nom, equipement, variante })}`
      : '';
  }

  function ligne(texte: string, classe: string): HTMLParagraphElement {
    const p = document.createElement('p');
    p.className = classe;
    p.textContent = texte;
    return p;
  }

  let bibliotheque: Exercice[] = [];

  function peindreListe() {
    const filtre = ($('filtre') as HTMLInputElement).value.trim().toLowerCase();
    const visibles = bibliotheque.filter((e) => {
      if (!filtre) return true;
      const muscles = [...e.principaux, ...e.secondaires].map(libelleDuMuscle).join(' ');
      return `${e.nom} ${e.equipement} ${e.variante} ${muscles}`.toLowerCase().includes(filtre);
    });

    const zone = $('liste');
    zone.innerHTML = '';
    $('liste-vide').classList.toggle('hidden', visibles.length > 0);
    $('compte-exercices').textContent = filtre
      ? `${visibles.length} exercice${visibles.length > 1 ? 's' : ''} sur ${bibliotheque.length}`
      : `${bibliotheque.length} exercice${bibliotheque.length > 1 ? 's' : ''}`;
    for (const exercice of [...visibles].sort((a, b) => a.nom.localeCompare(b.nom, 'fr'))) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950';
      carte.dataset.exercice = exercice.id;

      const nomComplet = [exercice.nom, exercice.equipement, exercice.variante]
        .filter(Boolean)
        .join(' · ');

      const rangee = document.createElement('div');
      rangee.className = 'flex items-start justify-between gap-3';

      const texte = document.createElement('div');
      texte.className = 'min-w-0';
      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = nomComplet;
      texte.appendChild(titre);
      texte.appendChild(
        ligne(
          `${UNITES_DE_CHARGE[exercice.unite]} · ${exercice.principaux.map(libelleDuMuscle).join(', ')}` +
            (exercice.secondaires.length
              ? ` (+ ${exercice.secondaires.map(libelleDuMuscle).join(', ')})`
              : ''),
          'mt-0.5 text-xs text-slate-500 dark:text-slate-400',
        ),
      );
      rangee.appendChild(texte);

      /*
         « Supprimer » derrière un menu, et avec une question.

         Il était répété sur chacune des trente lignes, souligné en rouge, à
         un clic d'un geste irréversible — c'est trente occasions de se
         tromper pour une action qu'on fait trois fois par an. Il passe dans
         un menu, et la question dit ce que la suppression fait réellement :
         les séries déjà enregistrées ne sont pas effacées, mais la courbe de
         force de cet exercice cesse d'être consultable, puisque l'écran de
         force choisit dans la bibliothèque.
      */
      const menu = document.createElement('details');
      menu.className = 'menu-actions relative shrink-0';
      const bouton = document.createElement('summary');
      bouton.className =
        'cible-tactile-pleine cursor-pointer rounded-lg px-2 text-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800';
      bouton.setAttribute('aria-label', `Actions sur ${nomComplet}`);
      bouton.textContent = '…';
      const panneau = document.createElement('div');
      panneau.className =
        'absolute right-0 z-10 mt-1 min-w-48 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900';
      const supprimer = document.createElement('button');
      supprimer.type = 'button';
      supprimer.dataset.supprimer = exercice.id;
      supprimer.className =
        'cible-tactile-pleine w-full rounded-lg px-3 text-left text-sm text-rose-700 transition hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-950/40';
      supprimer.textContent = 'Supprimer…';
      supprimer.addEventListener('click', () => {
        menu.open = false;
        const sur = window.confirm(
          `Supprimer « ${nomComplet} » ?\n\n` +
            'Les séries déjà enregistrées ne sont pas effacées, mais l’exercice ' +
            'disparaît de la bibliothèque et sa courbe de force n’est plus consultable.',
        );
        if (sur) void supprimerExercice(exercice.id).then(recharger);
      });
      panneau.appendChild(supprimer);
      menu.append(bouton, panneau);
      // Un seul menu ouvert à la fois : deux panneaux superposés se recouvrent.
      menu.addEventListener('toggle', () => {
        if (!menu.open) return;
        for (const autre of document.querySelectorAll<HTMLDetailsElement>('.menu-actions[open]')) {
          if (autre !== menu) autre.open = false;
        }
      });
      rangee.appendChild(menu);

      carte.appendChild(rangee);
      zone.appendChild(carte);
    }

    /*
       Les doublons sont **signalés**, jamais fusionnés : fusionner deux
       exercices est irréversible, et la personne sait mieux que le code si
       « barre » et « barre olympique » sont la même chose.
    */
    const paquets = doublons(bibliotheque);
    $('doublons').classList.toggle('hidden', paquets.length === 0);
    if (paquets.length) {
      $('doublons').textContent =
        'Deux saisies partagent la même identité et leurs progressions sont séparées : ' +
        paquets.map((p) => p.map((e) => e.nom).join(' / ')).join(' ; ') +
        '. À vous de décider si c’est le même exercice.';
    }
  }

  async function recharger() {
    bibliotheque = await tousLesExercices();
    peindreListe();
  }

  auDeverrouillage(
    async () => {
      await installerBibliotheque();

      for (const zone of document.querySelectorAll<SVGGElement>('[data-zone]')) {
        const id = zone.dataset.zone!;
        etats.set(id, 'aucun');
        const cycler = () => poser(id, etatSuivant(etats.get(id) ?? 'aucun'));
        zone.addEventListener('click', cycler);
        /*
           Espace et Entrée : un `<g role="button">` n'a pas le comportement
           natif d'un `<button>`, et sans cela le parcours clavier mènerait à
           des zones qu'on ne peut pas activer — le pire des deux mondes.
        */
        zone.addEventListener('keydown', (evenement) => {
          if (evenement.key !== 'Enter' && evenement.key !== ' ') return;
          evenement.preventDefault();
          cycler();
        });
      }
      for (const choix of document.querySelectorAll<HTMLSelectElement>('[data-case]')) {
        const id = choix.dataset.case!;
        if (!etats.has(id)) etats.set(id, 'aucun');
        choix.addEventListener('change', () => poser(id, choix.value as EtatMuscle));
      }

      for (const champ of ['nom', 'equipement', 'variante']) {
        $(champ).addEventListener('input', direIdentite);
      }
      $('filtre').addEventListener('input', peindreListe);

      /*
         La boîte de dialogue : « showModal », et non une simple classe.

         Le piège du focus, la fermeture par Échap et l'inertie de la page
         derrière sont alors ceux du navigateur, et non une réimplémentation
         qui oublierait un cas. Le focus part sur le premier champ, et non sur
         le bouton de fermeture que le navigateur choisirait seul.
      */
      const fenetre = $('fenetre-ajout') as HTMLDialogElement;
      const etroit = window.matchMedia('(max-width: 1023px)');
      $('ouvrir-ajout').addEventListener('click', () => {
        // En dessous de « lg », le schéma et la liste s'empilent : la liste
        // part repliée pour que le schéma reste visible sans défiler.
        ($('liste-muscles') as HTMLDetailsElement).open = !etroit.matches;
        fenetre.showModal();
        ($('nom') as HTMLInputElement).focus();
      });
      $('fermer-ajout').addEventListener('click', () => fenetre.close());

      $('ajout').addEventListener('submit', (evenement) => {
        evenement.preventDefault();
        void (async () => {
          try {
            await ecrireExercice({
              nom: ($('nom') as HTMLInputElement).value.trim(),
              nature: ($('nature') as HTMLSelectElement).value as NatureExercice,
              lateralite: ($('lateralite') as HTMLSelectElement).value as Lateralite,
              equipement: ($('equipement') as HTMLInputElement).value.trim(),
              variante: ($('variante') as HTMLInputElement).value.trim(),
              unite: ($('unite') as HTMLSelectElement).value as UniteDeCharge,
              principaux: retenus('principal'),
              secondaires: retenus('secondaire'),
            });
            ($('nom') as HTMLInputElement).value = '';
            ($('variante') as HTMLInputElement).value = '';
            for (const id of [...etats.keys()]) poser(id, 'aucun');
            direIdentite();
            $('erreur').classList.add('hidden');
            ($('fenetre-ajout') as HTMLDialogElement).close();
            await recharger();
          } catch (erreur) {
            $('erreur').textContent =
              erreur instanceof Error ? erreur.message : String(erreur);
            $('erreur').classList.remove('hidden');
          }
        })();
      });

      await recharger();
      $('vue').classList.remove('hidden');
    },
    { zoneChargement: '#chargement-exercices' },
  );
</script>

<script>
  /*
     Le choix de la forme du schéma — décision 6 du prompt 34.

     **Pourquoi un script séparé.** Celui du dessus attend le déverrouillage ;
     le choix de la forme, lui, ne dépend d'aucune donnée chiffrée et doit
     s'appliquer dès que la page existe. L'attacher au déverrouillage ferait
     clignoter la forme au moment où le contenu arrive.

     **Pourquoi réécrire « d » plutôt que basculer deux arbres.** Les zones, les
     noms accessibles et l'ordre de tabulation restent exactement les mêmes :
     seul le tracé change. Deux arbres doubleraient les cibles pour les
     technologies d'assistance, et c'est précisément ce que l'alternative en
     cases à cocher cherche à éviter.
  */
  const CLEF = 'revinsp.forme-corps';

  function appliquer(forme: string) {
    for (const chemin of document.querySelectorAll<SVGPathElement>('svg[data-face] path')) {
      const complet = chemin.dataset.complete;
      if (!complet) continue;
      // La forme simplifiée est celle du balisage : on la garde en réserve au
      // premier passage, pour pouvoir y revenir sans rechargement.
      if (!chemin.dataset.simple) chemin.dataset.simple = chemin.getAttribute('d') ?? '';
      chemin.setAttribute('d', forme === 'complete' ? complet : chemin.dataset.simple);
    }
  }

  function lire(): string {
    try {
      return localStorage.getItem(CLEF) === 'complete' ? 'complete' : 'simplifiee';
    } catch {
      // Navigation privée, stockage refusé : on retombe sur le défaut, qui est
      // justement celui qu'Alexis a choisi.
      return 'simplifiee';
    }
  }

  const choix = lire();
  for (const bouton of document.querySelectorAll<HTMLInputElement>('input[name="forme-corps"]')) {
    bouton.checked = bouton.value === choix;
    bouton.addEventListener('change', () => {
      if (!bouton.checked) return;
      try {
        localStorage.setItem(CLEF, bouton.value);
      } catch {
        /* Le réglage vaudra pour cette page seulement : mieux que rien. */
      }
      appliquer(bouton.value);
    });
  }
  appliquer(choix);
</script>

<script>
  /*
     A7, cas 1 — les muscles sollicités s'allument sur le schéma.

     **Pourquoi ce script lit l'état du schéma plutôt qu'un exercice.** Les
     zones portent déjà `data-etat` (« aucun », « principal », « secondaire »),
     tenu à jour par les cases à cocher comme par les clics. L'animation
     emprunte donc exactement la même source que l'écran : elle ne peut pas
     montrer autre chose que ce qui est enregistré, et elle vaut pour les deux
     formes du schéma — simplifiée comme complète — puisqu'elle ne touche pas
     au dessin.

     **Elle est rendue, pas simulée.** On éteint, puis on rallume par étapes.
     L'état de départ est mémorisé et restitué à la fin : à aucun moment
     l'animation ne laisse l'écran dans un état faux. Si on quitte la boîte en
     cours de route, la restitution se fait quand même.
  */
  const VIDE = 'aucun';
  const ETAPES = [
    { etat: 'principal', dit: (n: number) => `Muscles principaux : ${n}.` },
    { etat: 'secondaire', dit: (n: number) => `Muscles secondaires : ${n}.` },
  ] as const;

  const zones = () => document.querySelectorAll<SVGGElement>('svg[data-face] [data-zone]');
  const bouton = document.getElementById('voir-animation') as HTMLButtonElement | null;
  const suivant = document.getElementById('etape-animation') as HTMLButtonElement | null;
  const commentaire = document.getElementById('commentaire-animation');

  if (bouton && suivant && commentaire) {
    /** L'état enregistré, avant que l'animation n'y touche. */
    let reel: Map<SVGGElement, string> | null = null;
    let etape = 0;

    const poser = (element: SVGGElement, etat: string) => {
      element.dataset.etat = etat;
      element.setAttribute('aria-pressed', String(etat !== VIDE));
    };

    const restituer = () => {
      if (!reel) return;
      for (const [element, etat] of reel) poser(element, etat);
      reel = null;
      etape = 0;
      suivant.hidden = true;
      bouton.textContent = 'Voir l’animation';
      commentaire.textContent = '';
    };

    const jouerEtape = () => {
      if (!reel) return;
      const { etat, dit } = ETAPES[etape];
      let compte = 0;
      for (const [element, voulu] of reel) {
        if (voulu !== etat) continue;
        poser(element, etat);
        compte += 1;
      }
      commentaire.textContent = `Étape ${etape + 1} sur ${ETAPES.length}. ${dit(compte)}`;
      etape += 1;
      if (etape >= ETAPES.length) {
        suivant.hidden = true;
        bouton.textContent = 'Rejouer';
        // L'état final EST l'état réel : rien à restituer, et c'est voulu.
        reel = null;
        etape = 0;
      }
    };

    bouton.addEventListener('click', () => {
      restituer();
      reel = new Map();
      for (const z of zones()) reel.set(z, z.dataset.etat ?? VIDE);
      // On éteint tout : sans cela, « s'allumer » n'aurait rien à montrer.
      for (const z of zones()) poser(z, VIDE);
      etape = 0;
      suivant.hidden = false;
      bouton.textContent = 'Interrompre';
      commentaire.textContent = 'Animation en cours. « Étape suivante » pour avancer.';
      jouerEtape();
    });

    suivant.addEventListener('click', jouerEtape);

    // Quitter la boîte en cours d'animation ne doit pas laisser l'écran faux.
    document.getElementById('fenetre-ajout')?.addEventListener('close', restituer);
  }
</script>
