---
/**
 * Sport : mon corps, mes phases, mes blessures.
 *
 * ## C'est ici que vit le garde-fou
 *
 * Déclarer une douleur est la seule action de toute la branche qui **empêche**
 * quelque chose : tant qu'une blessure est ouverte, Sport ne propose jamais
 * de progresser sur les muscles concernés, et ce n'est négociable par aucun
 * réglage. L'écran le dit en toutes lettres, parce qu'une protection qu'on ne
 * sait pas avoir ne rassure personne.
 *
 * Une blessure **sans muscle coché** est générale : elle couvre tout. C'est
 * le cas d'une grippe ou d'un épuisement, et c'est pour cela que le formulaire
 * accepte de n'avoir rien coché au lieu de l'exiger.
 *
 * ## Une seule phase à la fois
 *
 * Deux phases concurrentes rendraient les bandes du graphique de force
 * ininterprétables — on ne saurait pas laquelle colore un jour. Ouvrir une
 * phase referme donc la précédente, et l'écran le dit avant de le faire.
 */
import Base from '../../layouts/Base.astro';
import { MUSCLES, PHASES } from '../../lib/sport/modele';

const groupes = [...new Set(MUSCLES.map((m) => m.groupe))].map((groupe) => ({
  groupe,
  muscles: MUSCLES.filter((m) => m.groupe === groupe),
}));
---

<Base titre="Mon corps" actif="corps">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mon corps</h1>

    <div id="chargement-corps" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture…</p>
    </div>

    <div id="vue" class="mt-6 hidden space-y-10">
      <!-- Les blessures -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
          Mes douleurs et blessures
        </h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Tant qu’une blessure est ouverte, <strong>aucune progression n’est proposée</strong> sur
          les muscles concernés. C’est la seule règle de Sport qu’aucun réglage ne désactive.
        </p>

        <div id="ouvertes" class="mt-4 space-y-2"></div>
        <p id="aucune-ouverte" class="mt-4 text-sm text-emerald-700 dark:text-emerald-300">
          Rien de déclaré en ce moment.
        </p>

        <details class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer text-sm font-medium text-slate-900 dark:text-white">
            Déclarer une douleur
          </summary>

          <fieldset class="mt-3">
            <legend class="text-sm text-slate-700 dark:text-slate-200">
              Où ? Ne rien cocher veut dire « partout » — une grippe, un épuisement.
            </legend>
            <div class="mt-2 space-y-2">
              {groupes.map(({ groupe, muscles }) => (
                <div>
                  <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">{groupe}</p>
                  <div class="mt-1 grid gap-1 sm:grid-cols-3">
                    {muscles.map((m) => (
                      <label class="flex min-h-11 items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
                        <input type="checkbox" data-muscle={m.id} class="size-5 rounded" />
                        {m.libelle}
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </fieldset>

          <div class="mt-3 flex flex-wrap items-end gap-3">
            <label class="text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Depuis le</span>
              <input id="debut-blessure" type="date"
                class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
            </label>
            <label class="text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Intensité, de 1 à 10</span>
              <input id="intensite" type="range" min="1" max="10" step="1" value="4" class="mt-2 w-40" />
              <output id="intensite-valeur" for="intensite" class="ml-2 text-sm tabular-nums text-slate-700 dark:text-slate-200">4</output>
            </label>
          </div>
          <label class="mt-3 block text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Note</span>
            <textarea id="note-blessure" rows="2" maxlength="500"
              class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"></textarea>
          </label>
          <button id="declarer" type="button"
            class="mt-3 min-h-11 rounded-lg bg-rose-700 px-4 text-sm font-medium text-white transition hover:bg-rose-800"
            >Déclarer</button>
        </details>

        <details class="mt-3">
          <summary class="cursor-pointer text-sm text-slate-500 dark:text-slate-400">
            Les blessures refermées
          </summary>
          <div id="fermees" class="mt-2 space-y-2"></div>
          <p id="aucune-fermee" class="mt-2 text-sm text-slate-500 dark:text-slate-400">Aucune.</p>
        </details>
      </section>

      <!-- Les phases -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes phases</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Une phase ne change rien aux chiffres : elle les <strong>situe</strong>. Une baisse
          pendant une sèche n’est pas un échec, et le suivi de la force s’en sert pour ne comparer
          que ce qui se compare.
        </p>

        <p id="phase-courante" class="mt-3 text-sm text-slate-700 dark:text-slate-200"></p>

        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Nouvelle phase</span>
            <select id="type-phase"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950">
              {Object.entries(PHASES).map(([id, libelle]) => <option value={id}>{libelle}</option>)}
            </select>
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">À partir du</span>
            <input id="debut-phase" type="date"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <button id="ouvrir-phase" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Ouvrir</button>
          <button id="clore-phase" type="button"
            class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm dark:border-slate-700"
            >Clore la phase en cours</button>
        </div>
        <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
          Ouvrir une phase referme celle qui court : une seule à la fois, sans quoi les bandes du
          graphique ne voudraient plus rien dire.
        </p>

        <ul id="phases" class="mt-4 space-y-1 text-sm"></ul>
      </section>
    </div>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import {
    cloreLaPhaseEnCours,
    ecrireBlessure,
    ecrirePhase,
    refermerBlessure,
    rouvrirBlessure,
    supprimerBlessure,
    supprimerPhase,
    toutesLesBlessures,
    toutesLesPhases,
  } from '../../lib/sport/donnees';
  import {
    PHASES,
    libelleDuMuscle,
    type Blessure,
    type Phase,
    type TypeDePhase,
  } from '../../lib/sport/modele';

  const $ = (id: string) => document.getElementById(id)!;
  const jourISO = (iso: string) =>
    new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const aujourdhui = () => new Date().toISOString().slice(0, 10);

  let blessures: Blessure[] = [];
  let phases: Phase[] = [];

  function carteBlessure(blessure: Blessure): HTMLDivElement {
    const carte = document.createElement('div');
    carte.className = blessure.fin
      ? 'rounded-xl border border-slate-200 px-4 py-2 text-sm dark:border-slate-800'
      : 'rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm dark:border-rose-900 dark:bg-rose-950/30';
    carte.dataset.blessure = blessure.id;
    carte.dataset.ouverte = String(blessure.fin === null);

    const titre = document.createElement('p');
    titre.className = 'font-medium text-slate-900 dark:text-white';
    titre.textContent = blessure.muscles.length
      ? blessure.muscles.map(libelleDuMuscle).join(', ')
      : 'Général — tout le corps';
    carte.appendChild(titre);

    const detail = document.createElement('p');
    detail.className = 'mt-0.5 text-xs text-slate-600 dark:text-slate-300';
    detail.textContent =
      `Intensité ${blessure.intensite}/10 · depuis le ${jourISO(blessure.debut)}` +
      (blessure.fin ? ` · refermée le ${jourISO(blessure.fin)}` : '') +
      (blessure.note ? ` · ${blessure.note}` : '');
    carte.appendChild(detail);

    const actions = document.createElement('div');
    actions.className = 'mt-2 flex gap-4 text-xs';

    const bascule = document.createElement('button');
    bascule.type = 'button';
    bascule.className = 'text-indigo-700 underline dark:text-indigo-300';
    bascule.textContent = blessure.fin ? 'La rouvrir' : 'C’est passé';
    bascule.dataset.action = blessure.fin ? 'rouvrir' : 'refermer';
    bascule.addEventListener('click', () => {
      void (blessure.fin ? rouvrirBlessure(blessure.id) : refermerBlessure(blessure.id)).then(
        recharger,
      );
    });

    const effacer = document.createElement('button');
    effacer.type = 'button';
    effacer.className = 'text-rose-700 underline dark:text-rose-300';
    effacer.textContent = 'Supprimer';
    effacer.addEventListener('click', () => void supprimerBlessure(blessure.id).then(recharger));

    actions.append(bascule, effacer);
    carte.appendChild(actions);
    return carte;
  }

  function peindre() {
    const ouvertes = blessures
      .filter((b) => b.fin === null)
      .sort((a, b) => b.debut.localeCompare(a.debut));
    const fermees = blessures
      .filter((b) => b.fin !== null)
      .sort((a, b) => (b.fin ?? '').localeCompare(a.fin ?? ''));

    const zoneOuvertes = $('ouvertes');
    zoneOuvertes.innerHTML = '';
    for (const b of ouvertes) zoneOuvertes.appendChild(carteBlessure(b));
    $('aucune-ouverte').classList.toggle('hidden', ouvertes.length > 0);

    const zoneFermees = $('fermees');
    zoneFermees.innerHTML = '';
    for (const b of fermees) zoneFermees.appendChild(carteBlessure(b));
    $('aucune-fermee').classList.toggle('hidden', fermees.length > 0);

    /* Les phases. */
    const triees = [...phases].sort((a, b) => b.debut.localeCompare(a.debut));
    const courante = triees.find((p) => p.fin === null);
    $('phase-courante').textContent = courante
      ? `En cours : ${PHASES[courante.type]}, depuis le ${jourISO(courante.debut)}.`
      : 'Aucune phase déclarée. Les points du suivi de force resteront sans bande de contexte.';

    const liste = $('phases');
    liste.innerHTML = '';
    for (const phase of triees) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.phase = phase.id;
      const texte = document.createElement('span');
      texte.textContent =
        `${PHASES[phase.type]} — du ${jourISO(phase.debut)} ` +
        (phase.fin ? `au ${jourISO(phase.fin)}` : '(en cours)');
      const effacer = document.createElement('button');
      effacer.type = 'button';
      effacer.className = 'text-xs text-rose-700 underline dark:text-rose-300';
      effacer.textContent = 'Supprimer';
      effacer.addEventListener('click', () => void supprimerPhase(phase.id).then(recharger));
      li.append(texte, effacer);
      liste.appendChild(li);
    }
  }

  async function recharger() {
    [blessures, phases] = await Promise.all([toutesLesBlessures(), toutesLesPhases()]);
    peindre();
  }

  auDeverrouillage(
    async () => {
      ($('debut-blessure') as HTMLInputElement).value = aujourdhui();
      ($('debut-phase') as HTMLInputElement).value = aujourdhui();
      $('intensite').addEventListener('input', () => {
        $('intensite-valeur').textContent = ($('intensite') as HTMLInputElement).value;
      });

      $('declarer').addEventListener('click', () => {
        void (async () => {
          const muscles = [...document.querySelectorAll<HTMLInputElement>('[data-muscle]')]
            .filter((c) => c.checked)
            .map((c) => c.dataset.muscle!);
          const debut = ($('debut-blessure') as HTMLInputElement).value || aujourdhui();
          await ecrireBlessure({
            muscles,
            intensite: Number(($('intensite') as HTMLInputElement).value),
            // Midi : une date sans heure prise à minuit UTC bascule de jour en France.
            debut: `${debut}T12:00:00.000Z`,
            fin: null,
            note: ($('note-blessure') as HTMLTextAreaElement).value.trim(),
          });
          for (const c of document.querySelectorAll<HTMLInputElement>('[data-muscle]')) {
            c.checked = false;
          }
          ($('note-blessure') as HTMLTextAreaElement).value = '';
          await recharger();
        })();
      });

      $('ouvrir-phase').addEventListener('click', () => {
        void (async () => {
          const debut = ($('debut-phase') as HTMLInputElement).value || aujourdhui();
          await cloreLaPhaseEnCours(new Date(`${debut}T12:00:00.000Z`));
          await ecrirePhase(
            ($('type-phase') as HTMLSelectElement).value as TypeDePhase,
            `${debut}T12:00:00.000Z`,
          );
          await recharger();
        })();
      });

      $('clore-phase').addEventListener('click', () => {
        void cloreLaPhaseEnCours().then(recharger);
      });

      await recharger();
      $('vue').classList.remove('hidden');
    },
    { zoneChargement: '#chargement-corps' },
  );
</script>
