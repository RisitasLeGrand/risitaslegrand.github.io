---
/**
 * « Mon profil » : ce que Cyclades sait, qui le lit, et comment l'effacer.
 *
 * A.3 fixe ce que l'écran doit dire pour chaque champ : sa valeur, **qui
 * l'utilise**, et de quoi restreindre sa portée. A.5 ajoute la suppression d'un
 * champ ou de tout le profil. Les trois sont ici, et rien d'autre : ce n'est pas
 * un tableau de bord, c'est un endroit où l'on vérifie et où l'on retire.
 *
 * Le détail qui fait la différence entre un écran honnête et un formulaire :
 * chaque champ dit **d'où il vient** — déclaré, ou observé — et ce qu'il
 * **règle** dans l'application. Un réglage dont on ne voit pas la cause se
 * change au hasard.
 */
import Base from '../layouts/Base.astro';
---

<Base titre="Mon profil" entete="leger">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mon profil</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Ces informations restent sur vos appareils, chiffrées, et se synchronisent avec eux. Elles
      sont <strong>exclues par défaut</strong> des exports destinés à une IA.
    </p>

    <p class="mt-3 text-sm">
      <a href="/qui-utilise-mon-age/" class="font-medium text-slate-800 underline dark:text-slate-100"
        >Qui utilise mon âge et mon sexe</a
      >
      <span class="text-slate-500 dark:text-slate-400">
        — la liste de ce qui peut les lire, avec un interrupteur par ligne.</span
      >
    </p>

    <p
      id="avancement"
      class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
    >
      Chargement…
    </p>

    <!-- ── Divergences entre appareils (A.6) ─────────────────────────── -->
    <section id="bloc-divergences" class="mt-6 hidden">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Deux appareils ne disent pas la même chose
      </h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        La valeur la plus récente est celle qui s’applique. Rien n’est perdu : choisissez celle qui
        est juste, ou laissez-la telle quelle.
      </p>
      <div id="divergences" class="space-y-3"></div>
    </section>

    <!-- ── Les champs ─────────────────────────────────────────────────── -->
    <section class="mt-6">
      <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">Ce qui est renseigné</h2>
      <div id="champs" class="space-y-3"></div>
      <p id="aucun-champ" class="hidden text-sm text-slate-500 dark:text-slate-400">
        Rien n’est renseigné pour l’instant.
      </p>
    </section>

    <!-- ── Ce qui reste à dire ────────────────────────────────────────── -->
    <section class="mt-8">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">
        Ce qui n’est pas renseigné
      </h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Tout est facultatif, sauf le prénom. Rien ici n’est un reproche : un champ vide ne change
        qu’une chose, c’est que Cyclades ne s’en sert pas.
      </p>
      <div id="restants" class="space-y-2"></div>
    </section>

    <!-- ── Ce que Cyclades en déduit (§3 de questions.md) ─────────────── -->
    <!-- ── Affichage : l'interrupteur d'animations (prompt 34, décision 4) ── -->
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">Affichage</h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Ce réglage s'ajoute à celui de votre appareil. Si l'un des deux demande moins de
        mouvement, c'est lui qui s'applique : désactiver ici ne peut pas réactiver ce que le
        système a coupé.
      </p>
      <label
        for="reduire-animations"
        class="flex min-h-11 w-full max-w-2xl cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-left transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800"
      >
        <input
          type="checkbox"
          id="reduire-animations"
          class="mt-0.5 h-5 w-5 shrink-0 rounded border-slate-400 text-indigo-600 dark:border-slate-500"
        />
        <span class="min-w-0">
          <span class="block font-medium text-slate-900 dark:text-white">
            Réduire les animations
          </span>
          <span class="block text-sm text-slate-500 dark:text-slate-400">
            Supprime les déplacements et les fondus. Le contenu et les commandes ne changent pas.
          </span>
        </span>
      </label>
    </section>

    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">
        Ce que Cyclades en déduit
      </h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Aucune de ces déductions ne modifie une donnée : elles changent des <strong>réglages</strong>.
        Chacune dit la réponse dont elle découle — un réglage dont on ne voit pas la cause se change
        au hasard.
      </p>
      <div id="reglages" class="space-y-2"></div>
    </section>

    <!-- ── L'apprentissage étendu, et son consentement (A-13) ──────────── -->
    <!--
      L'ÉCRAN QUI MANQUAIT.

      Le texte de `consentement.ts` existait depuis le 12 octobre et
      promettait « vous n'avez jamais à l'autoriser ». Personne ne
      l'autorisait, et l'observation tournait quand même. Cet écran est la
      moitié manquante.

      Les trois paragraphes sont **cités**, jamais reformulés : c'est la
      raison d'être du module, et un résumé écrit ici deviendrait une
      quatrième version du texte que personne n'a acceptée.
    -->
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">
        L’apprentissage étendu
      </h2>
      <p
        id="consentement-etat"
        class="mb-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Chargement…
      </p>

      <details id="consentement-texte" class="mt-3">
        <summary class="min-h-11 cursor-pointer text-sm text-indigo-700 underline underline-offset-4 dark:text-indigo-300">
          Lire ce que cela veut dire, en entier
        </summary>
        <div id="consentement-paragraphes" class="mt-3 space-y-3 text-sm text-slate-600 dark:text-slate-300"></div>
        <div
          id="consentement-manques"
          class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
        ></div>
      </details>

      <div class="mt-4 flex flex-wrap gap-2">
        <button
          id="consentement-accorder"
          type="button"
          class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Autoriser
        </button>
        <button
          id="consentement-revoquer"
          type="button"
          class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Révoquer
        </button>
      </div>
      <p id="consentement-message" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── L'adaptation (A.8) ─────────────────────────────────────────── -->
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">L’adaptation</h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Quand l’usage observé contredit ce que vous avez déclaré, Cyclades pose la question — une
        fois par semaine au plus, jamais en travers de votre chemin. Une question refusée ne revient
        pas.
      </p>
      <p
        id="adaptation-etat"
        class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Chargement…
      </p>
      <div id="ecarts" class="mt-3 space-y-2"></div>
      <div id="decisions" class="mt-3 space-y-2"></div>
      <button
        id="reinitialiser-adaptation"
        type="button"
        class="mt-4 min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
      >
        Réinitialiser l’adaptation
      </button>
      <p id="message-adaptation" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Effacement ─────────────────────────────────────────────────── -->
    <section
      class="mt-10 rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-900 dark:bg-amber-950/30"
    >
      <h2 class="font-semibold text-slate-900 dark:text-white">Tout effacer</h2>
      <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">
        Supprime <strong>tous</strong> les champs du profil. L’adaptation en tiendra compte : les
        réglages qui en découlaient reviennent à leur valeur par défaut, et les écrans cessent de
        vous appeler par votre prénom. Vos données de révision, de sport et d’Odyssée ne sont pas
        touchées.
      </p>
      <button
        id="effacer-profil"
        type="button"
        class="mt-3 min-h-11 rounded-lg bg-amber-600 px-4 font-medium text-white transition hover:bg-amber-700"
      >
        Supprimer tout le profil
      </button>
      <p id="message-effacement" class="mt-3 hidden text-sm"></p>
    </section>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import { echapper, pluriel } from '../lib/ui';
  import { redemanderLeMotDePasse } from '../lib/redemande';
  import { BRANCHES, branche } from '../lib/branches';
  import {
    avancementLocal,
    branchesConnues,
    divergencesLocales,
    ecrireChamp,
    profilLocal,
    restreindre,
    supprimerChamp,
    supprimerProfil,
  } from '../lib/profil';
  import type { Portee, ValeurDeChamp } from '../lib/noyau/profil';
  import { lecteurs, porteeInclut } from '../lib/noyau/profil';

  const $ = (id: string) => document.getElementById(id)!;

  const nomDeBranche = (id: string) => branche(id)?.libelle ?? id;

  /**
   * Les trois sources d'A.3, dites en français.
   *
   * « Observé, puis confirmé » n'est pas « déclaré », et l'écran ne les confond
   * pas : le jour où un réglage est faux, savoir si la personne l'a dit ou si
   * Cyclades l'a déduit est la première chose à regarder.
   */
  const LIBELLE_SOURCE: Record<string, string> = {
    declare: 'déclaré',
    observe: 'observé, non confirmé',
    confirme: 'observé, puis confirmé',
  };

  /**
   * La valeur, en français.
   *
   * Et **échappée**, parce que ces valeurs sont saisies : « Qu'est-ce que vous
   * faites dans la vie ? » accepte n'importe quel texte, et ce texte est ici
   * inséré dans du HTML.
   */
  function lisible(valeur: unknown): string {
    if (Array.isArray(valeur)) {
      return valeur.length ? valeur.map((x) => echapper(String(x))).join(', ') : '—';
    }
    if (valeur && typeof valeur === 'object') {
      const entrees = Object.entries(valeur as Record<string, unknown>);
      return entrees.length
        ? entrees.map(([c, v]) => `${echapper(c)} : ${echapper(String(v))}`).join(' · ')
        : '—';
    }
    if (typeof valeur === 'boolean') return valeur ? 'oui' : 'non';
    const texte = String(valeur ?? '').trim();
    return texte ? echapper(texte) : '—';
  }

  function peindreChamp(valeur: ValeurDeChamp): HTMLElement {
    const bloc = document.createElement('div');
    bloc.className =
      'rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900';
    bloc.dataset.champ = valeur.champ;

    const lus = lecteurs(valeur, branchesConnues());
    const entete = document.createElement('div');
    entete.className = 'flex flex-wrap items-baseline justify-between gap-2';
    entete.innerHTML =
      `<span class="font-medium text-slate-900 dark:text-white">${echapper(valeur.declare.libelle)}</span>` +
      `<span class="font-mono text-sm text-slate-700 dark:text-slate-200">${lisible(valeur.valeur)}</span>`;

    const meta = document.createElement('p');
    meta.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
    meta.textContent =
      `${LIBELLE_SOURCE[valeur.source]} · ` +
      `version ${valeur.version} · posé sur ${valeur.appareil}`;

    const portee = document.createElement('p');
    portee.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
    portee.textContent = lus.length
      ? `Utilisé par : ${lus.map(nomDeBranche).join(', ')}`
      : 'Utilisé par : aucune branche — ce champ ne sert qu’aux écrans communs.';

    bloc.append(entete, meta, portee);

    if (valeur.declare.regle) {
      const regle = document.createElement('p');
      regle.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
      regle.textContent = `ⓘ ${valeur.declare.regle}`;
      bloc.appendChild(regle);
    }

    /*
       La portée se change par des cases, une par branche. Cocher **étend** la
       portée, décocher la restreint : les deux sont offertes, parce qu'un champ
       trop restreint est aussi gênant qu'un champ trop ouvert — et c'est la
       personne qui sait lequel des deux la gêne.
    */
    const choix = document.createElement('div');
    choix.className = 'mt-3 flex flex-wrap items-center gap-3';
    const titre = document.createElement('span');
    titre.className = 'text-xs text-slate-500 dark:text-slate-400';
    titre.textContent = 'Lisible par :';
    choix.appendChild(titre);

    for (const b of BRANCHES) {
      const etiquette = document.createElement('label');
      etiquette.className = 'flex items-center gap-1.5 text-xs text-slate-700 dark:text-slate-200';
      const case_ = document.createElement('input');
      case_.type = 'checkbox';
      case_.checked = porteeInclut(valeur.portee, b.id);
      case_.className = 'h-4 w-4 rounded border-slate-300 dark:border-slate-700';
      case_.addEventListener('change', async () => {
        const voulues = BRANCHES.filter((autre) =>
          autre.id === b.id
            ? case_.checked
            : (
                choix.querySelector(
                  `input[data-branche="${autre.id}"]`,
                ) as HTMLInputElement | null
              )?.checked,
        ).map((autre) => autre.id);
        const portee: Portee = voulues.length === BRANCHES.length ? 'toutes' : voulues;
        await restreindre(valeur.champ, portee);
        await peindre();
      });
      case_.dataset.branche = b.id;
      etiquette.append(case_, document.createTextNode(b.libelle));
      choix.appendChild(etiquette);
    }
    bloc.appendChild(choix);

    const actions = document.createElement('div');
    actions.className = 'mt-3 flex flex-wrap gap-2';
    const modifier = document.createElement('button');
    modifier.type = 'button';
    modifier.className =
      'min-h-11 rounded-lg border border-slate-300 px-3 text-xs font-medium transition ' +
      'hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800';
    modifier.textContent = 'Modifier';
    modifier.addEventListener('click', () => void demander(valeur.champ, valeur.declare.question, valeur.valeur));

    const supprimer = document.createElement('button');
    supprimer.type = 'button';
    supprimer.className =
      'min-h-11 rounded-lg border border-slate-300 px-3 text-xs font-medium text-amber-900 transition ' +
      'hover:bg-amber-50 dark:border-slate-700 dark:text-amber-200 dark:hover:bg-amber-950/40';
    supprimer.textContent = 'Supprimer';
    supprimer.addEventListener('click', async () => {
      if (!window.confirm(`Supprimer « ${valeur.declare.libelle} » ?`)) return;
      await supprimerChamp(valeur.champ);
      await peindre();
    });

    actions.append(modifier, supprimer);
    bloc.appendChild(actions);
    return bloc;
  }

  /**
   * La saisie, par une invite du navigateur.
   *
   * Assumé, et provisoire : l'écran d'initialisation de la phase suivante
   * portera les vrais champs — molettes d'heure, boutons à bascule, curseurs.
   * Mettre ici un formulaire complet par nature de champ aurait dupliqué ce
   * travail pour le jeter ensuite, et laisser « Mon profil » en lecture seule
   * aurait été pire : A.3 demande qu'on puisse corriger **à tout moment**.
   */
  async function demander(champ: string, question: string, actuelle: unknown): Promise<void> {
    const { champDeclare } = await import('../lib/noyau/profil');
    const declare = champDeclare(champ)!;
    const depart =
      Array.isArray(actuelle)
        ? actuelle.join(', ')
        : actuelle && typeof actuelle === 'object'
          ? JSON.stringify(actuelle)
          : String(actuelle ?? '');
    const saisie = window.prompt(question, depart);
    if (saisie === null) return;
    let valeur: unknown = saisie.trim();
    if (declare.nature === 'nombre') valeur = Number(saisie.replace(',', '.'));
    else if (declare.nature === 'booleen') valeur = /^(oui|vrai|true|1)$/i.test(saisie.trim());
    else if (declare.nature === 'liste') {
      valeur = saisie
        .split(',')
        .map((x) => x.trim())
        .filter(Boolean);
    } else if (declare.nature === 'repartition') {
      try {
        valeur = JSON.parse(saisie);
      } catch {
        window.alert('Forme attendue : {"cognition": 10}');
        return;
      }
    }
    try {
      await ecrireChamp(champ, valeur);
    } catch (erreur) {
      window.alert((erreur as Error).message);
      return;
    }
    await peindre();
  }

  /** Les réglages déduits, chacun avec sa cause. */
  async function peindreReglages(): Promise<void> {
    const { reglagesLocaux } = await import('../lib/adaptation');
    const zone = $('reglages');
    zone.textContent = '';
    for (const reglage of await reglagesLocaux()) {
      const ligne = document.createElement('div');
      ligne.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900';
      const titre = document.createElement('p');
      titre.className = 'flex flex-wrap items-baseline gap-2';
      const nom = document.createElement('span');
      nom.className = 'font-medium text-slate-900 dark:text-white';
      nom.textContent = reglage.libelle;
      const origine = document.createElement('span');
      origine.className = 'text-xs text-slate-500 dark:text-slate-400';
      origine.textContent = reglage.deduit ? 'déduit de vos réponses' : 'réglage par défaut';
      titre.append(nom, origine);
      const cause = document.createElement('p');
      cause.className = 'mt-1 text-sm text-slate-600 dark:text-slate-300';
      cause.textContent = reglage.cause;
      ligne.append(titre, cause);
      zone.appendChild(ligne);
    }
  }

  const LIBELLE_ISSUE: Record<string, string> = {
    acceptee: 'acceptée',
    reportee: 'reportée',
    refusee: 'refusée — elle ne reviendra pas',
    remise: 'défaite par une réinitialisation',
  };

  /* ──────────────────────────────────────────────────────────────────────
     Le consentement à l'apprentissage étendu — A-13
     ────────────────────────────────────────────────────────────────────── */

  /**
   * Peint l'état, le texte cité, et ce qui n'existe pas.
   *
   * ## Le bouton « Autoriser » est refait à chaque peinture
   *
   * Et c'est nécessaire : `accorderLApprentissage` doit nommer la
   * révocation qu'elle lève, et cette révocation peut venir d'un autre
   * appareil entre deux affichages. Un gestionnaire posé une fois avec un
   * état figé écrirait un accord qui ne lèverait rien, et la personne
   * croirait avoir réautorisé.
   */
  async function peindreConsentement(): Promise<void> {
    const { consentementLocal } = await import('../lib/consentement-apprentissage');
    const { TEXTE_DE_CONSENTEMENT, DOMAINES_DU_CONSENTEMENT } = await import(
      '../lib/odyssee/consentement'
    );
    const etat = await consentementLocal();

    const quand = (iso: string) =>
      new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

    $('consentement-etat').textContent = etat.accorde
      ? `Autorisé depuis le ${quand(etat.depuis!)}. Cyclades observe vos révisions pour vous proposer des réglages.`
      : etat.depuis
        ? `Révoqué le ${quand(etat.depuis)}. Rien n’est observé, et le reste de Cyclades fonctionne.`
        : 'Jamais autorisé. Rien n’est observé, et le reste de Cyclades fonctionne.';

    /*
       Le centre de notifications — prompt 32, phase 4. « Jamais demandé »
       se lit `depuis === null` : ni accord, ni révocation. Un refus est
       une réponse, et reposer la question serait harceler.
    */
    void (async () => {
      try {
        const { signalerLApprentissage } = await import('../lib/notifications/alimentation');
        await signalerLApprentissage(etat.depuis === null);
      } catch {
        /* Le centre n'est jamais une raison de casser l'écran d'origine. */
      }
    })();

    /* Les trois paragraphes, cités tels quels. Aucun résumé. */
    const zone = $('consentement-paragraphes');
    zone.innerHTML = '';
    for (const cle of ['ceQueCycladesLit', 'ceQuiNeChangeJamais', 'commentArreter'] as const) {
      const p = document.createElement('p');
      p.dataset.paragraphe = cle;
      p.textContent = TEXTE_DE_CONSENTEMENT[cle];
      zone.appendChild(p);
    }

    /*
       CE QUI N'EXISTE PAS, à l'écran et pas seulement dans un commentaire.
       Le texte cité promet des interrupteurs par domaine et un journal
       d'accès ; ni l'un ni l'autre n'est construit. Taire l'écart ici
       reviendrait à faire accepter un texte plus large que ce qui est fait.
    */
    $('consentement-manques').textContent =
      'Ce qui n’existe pas encore, au 16 octobre 2026 : les interrupteurs par domaine et ' +
      `par source (le texte en annonce ${DOMAINES_DU_CONSENTEMENT.length} ; une seule branche, ` +
      'les Révisions, est réellement observée, et l’autorisation ci-dessus la couvre ' +
      'entièrement), le journal de ce qui a été lu, et le rappel périodique. ' +
      'Le choix d’effacer les observations à la révocation est sans objet : elles sont ' +
      'recalculées à chaque lecture et ne sont jamais stockées.';

    $('consentement-accorder').classList.toggle('hidden', etat.accorde);
    $('consentement-revoquer').classList.toggle('hidden', !etat.accorde);
  }

  async function changerLeConsentement(quoi: 'accorder' | 'revoquer'): Promise<void> {
    const message = $('consentement-message');
    try {
      const module = await import('../lib/consentement-apprentissage');
      const etat =
        quoi === 'accorder'
          ? await module.accorderLApprentissage()
          : await module.revoquerLApprentissage();
      message.textContent = etat.accorde
        ? 'Autorisé. Vous pouvez révoquer à tout moment, sans justification.'
        : 'Révoqué. Plus rien n’est observé.';
      message.className = 'mt-3 text-sm text-slate-600 dark:text-slate-300';
    } catch (erreur) {
      message.textContent = erreur instanceof Error ? erreur.message : String(erreur);
      message.className = 'mt-3 text-sm text-rose-700 dark:text-rose-300';
    }
    message.classList.remove('hidden');
    await peindreConsentement();
    /* L'adaptation suit : son silence change de raison. */
    await peindreAdaptation();
  }

  /** L'état de l'adaptation : l'écart connu, ou le silence et sa raison. */
  async function peindreAdaptation(): Promise<void> {
    const { decisionsLocales, propositionLocale } = await import('../lib/adaptation');
    const { regleAdaptation } = await import('../lib/noyau/adaptation');
    const [{ proposition, silence, ecarts }, decisions] = await Promise.all([
      propositionLocale(),
      decisionsLocales(),
    ]);

    /*
       Le centre — phase 4. La RÈGLE seule, jamais la valeur proposée, et
       seulement la proposition du jour : les écarts connus mais ajournés
       restent sur cet écran, où leur délai est dit. Les porter au centre
       contournerait le plafond d'une question par semaine.
    */
    void (async () => {
      try {
        const { signalerUneProposition } = await import('../lib/notifications/alimentation');
        await signalerUneProposition(proposition?.regle ?? null);
      } catch {
        /* Le centre n'est jamais une raison de casser l'écran d'origine. */
      }
    })();

    $('adaptation-etat').textContent = proposition
      ? 'Une question vous attend sur le menu.'
      : silence?.pourquoi === 'sans-consentement'
        ? 'L’apprentissage étendu n’est pas autorisé : rien n’est observé, donc aucun écart ne peut être trouvé.'
      : silence?.pourquoi === 'aucun-ecart'
        ? 'Rien à signaler : ce que vous avez déclaré et ce que l’usage montre se tiennent.'
        : silence?.pourquoi === 'trop-tot'
          ? `Un écart est connu, et il attendra ${silence.joursRestants} jour(s) : une question par semaine au plus.`
          : silence?.pourquoi === 'ajourne'
            ? `Un écart est connu, et vous l’avez reporté : on en reparlera dans ${silence.joursRestants} jour(s).`
            : 'Les écarts connus portent sur des questions que vous avez refusées. Elles ne reviendront pas.';

    /*
       Les écarts sont montrés **tous**, même ceux qui ne seront pas proposés
       aujourd'hui : quelqu'un qui ouvre cet écran a le droit de savoir ce que
       Cyclades a remarqué, plutôt que de l'apprendre dans trois jours.
    */
    const zone = $('ecarts');
    zone.textContent = '';
    for (const ecart of ecarts) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-xl border border-sky-200 bg-sky-50/60 px-4 py-3 text-sm dark:border-sky-900 dark:bg-sky-950/30';
      const constat = document.createElement('p');
      constat.className = 'text-slate-700 dark:text-slate-200';
      constat.textContent = ecart.constat;
      const question = document.createElement('p');
      question.className = 'mt-1 text-slate-500 dark:text-slate-400';
      question.textContent = ecart.question;
      carte.append(constat, question);
      zone.appendChild(carte);
    }

    const prises = $('decisions');
    prises.textContent = '';
    for (const decision of decisions.values()) {
      if (decision.issue === 'remise') continue;
      const regle = regleAdaptation(decision.regle);
      const ligne = document.createElement('p');
      ligne.className = 'text-xs text-slate-500 dark:text-slate-400';
      ligne.textContent =
        `${regle?.libelle ?? decision.regle} — ${LIBELLE_ISSUE[decision.issue] ?? decision.issue}` +
        (decision.le ? ` le ${new Date(decision.le).toLocaleDateString('fr-FR')}` : '');
      prises.appendChild(ligne);
    }
  }

  async function peindre(): Promise<void> {
    const [profil, etat, divergences] = await Promise.all([
      profilLocal(),
      avancementLocal(),
      divergencesLocales(),
    ]);

    $('avancement').textContent =
      `${etat.repondus} réponse(s) sur ${etat.total} au socle commun` +
      (etat.prenomPose ? '' : ' — le prénom, la seule réponse attendue, n’est pas encore donné') +
      (etat.initialisation
        ? `. Initialisation ${etat.initialisation.allegee ? 'allégée ' : ''}faite le ` +
          `${new Date(etat.initialisation.termineeLe).toLocaleDateString('fr-FR')}.`
        : '.');

    const liste = $('champs');
    liste.textContent = '';
    for (const valeur of [...profil.values()].sort((a, b) =>
      a.declare.libelle.localeCompare(b.declare.libelle),
    )) {
      liste.appendChild(peindreChamp(valeur));
    }
    $('aucun-champ').classList.toggle('hidden', profil.size > 0);

    const restants = $('restants');
    restants.textContent = '';
    for (const declare of etat.restants) {
      const ligne = document.createElement('div');
      ligne.className =
        'flex flex-wrap items-center justify-between gap-2 rounded-xl border border-dashed ' +
        'border-slate-300 px-4 py-2 text-sm dark:border-slate-700';
      const texte = document.createElement('span');
      texte.className = 'text-slate-600 dark:text-slate-300';
      texte.textContent = declare.libelle + (declare.obligatoire ? ' (attendu)' : '');
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.className =
        'min-h-11 rounded-lg border border-slate-300 px-3 text-xs font-medium transition ' +
        'hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800';
      bouton.textContent = 'Renseigner';
      bouton.addEventListener('click', () => void demander(declare.champ, declare.question, ''));
      ligne.append(texte, bouton);
      restants.appendChild(ligne);
    }

    const bloc = $('bloc-divergences');
    const zone = $('divergences');
    zone.textContent = '';
    bloc.classList.toggle('hidden', divergences.length === 0);
    for (const divergence of divergences) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-2xl border border-amber-300 bg-white p-4 dark:border-amber-800 dark:bg-slate-900';
      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = divergence.declare.libelle;
      carte.appendChild(titre);
      for (const version of divergence.versions) {
        const ligne = document.createElement('div');
        ligne.className = 'mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm';
        ligne.innerHTML =
          `<span class="font-mono text-slate-700 dark:text-slate-200">${lisible(version.valeur)}</span>` +
          `<span class="text-xs text-slate-500 dark:text-slate-400">sur ${echapper(version.appareil)}</span>`;
        const garder = document.createElement('button');
        garder.type = 'button';
        garder.className =
          'min-h-11 rounded-lg border border-amber-400 px-3 text-xs font-medium text-amber-900 ' +
          'transition hover:bg-amber-100 dark:border-amber-700 dark:text-amber-200';
        garder.textContent = 'Garder celle-ci';
        garder.addEventListener('click', async () => {
          await ecrireChamp(divergence.champ, version.valeur, { source: version.source });
          await peindre();
        });
        ligne.appendChild(garder);
        carte.appendChild(ligne);
      }
      zone.appendChild(carte);
    }
  }

  $('effacer-profil').addEventListener('click', async () => {
    /*
       Le mot de passe, et non plus un « confirm ». Celui-ci protégeait du
       clic à côté, et de rien d'autre : l'effacement part aussi vers les
       autres appareils à la prochaine synchronisation, et rien ne le
       rattrape de là-bas. Ce que la redemande vise, c'est l'ordinateur
       déverrouillé prêté deux minutes — le même cas que la décision 3.
    */
    if (
      !(await redemanderLeMotDePasse({
        titre: 'Supprimer tout le profil',
        consequence:
          'Tous les champs du profil seront effacés, sur cet appareil et sur les autres à la ' +
          'prochaine synchronisation. Vos données de révision, de sport et d’Odyssée ne sont ' +
          'pas touchées.',
        action: 'Supprimer tout le profil',
      }))
    ) {
      const message = $('message-effacement');
      message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
      message.textContent = 'Rien n’a été supprimé.';
      message.classList.remove('hidden');
      return;
    }
    const combien = await supprimerProfil();
    const message = $('message-effacement');
    message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
    message.textContent = `${pluriel(combien, 'champ')} supprimé(s).`;
    await peindre();
  });

  $('reinitialiser-adaptation').addEventListener('click', async () => {
    if (
      !window.confirm(
        'Réinitialiser l’adaptation ?\n\nLes réglages qu’une proposition acceptée avait changés ' +
          'reviennent à la valeur que vous aviez déclarée — pas à une valeur par défaut. Les ' +
          'questions que vous avez refusées restent refusées.',
      )
    ) {
      return;
    }
    const { reinitialiserAdaptation } = await import('../lib/adaptation');
    const remise = await reinitialiserAdaptation();
    const message = $('message-adaptation');
    message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
    const touches = remise.retablis.length + remise.supprimes.length;
    message.textContent = touches
      ? `${pluriel(remise.retablis.length, 'réglage')} remis à sa valeur déclarée` +
        (remise.supprimes.length
          ? `, et ${pluriel(remise.supprimes.length, 'champ')} supprimé(s) faute d’avoir eu une valeur avant.`
          : '.')
      : 'Rien à défaire : aucune proposition n’a été acceptée.';
    message.classList.remove('hidden');
    await peindre();
  });

  auDeverrouillage(async () => {
    await peindre();
    /*
       Les réglages et l'adaptation viennent **après** le profil : l'adaptation
       publie les faits pour observer l'usage, et cet écran doit s'afficher
       avant, pas après. Leur échec n'emporte pas la page.
    */
    await peindreReglages().catch((e) => console.warn('Réglages déduits indisponibles :', e));
    /*
       Le consentement AVANT l'adaptation : c'est lui qui décide si
       l'adaptation a quelque chose à dire, et l'afficher après donnerait
       un instant où l'écran annonce un silence dont il ne dit pas encore
       la cause.
    */
    $('consentement-accorder').addEventListener('click', () =>
      void changerLeConsentement('accorder'),
    );
    $('consentement-revoquer').addEventListener('click', () =>
      void changerLeConsentement('revoquer'),
    );
    await peindreConsentement().catch((e) => {
      console.warn('Consentement indisponible :', e);
      $('consentement-etat').textContent =
        'L’état du consentement n’a pas pu être lu. Rien n’est observé tant qu’il ne l’est pas.';
    });
    await peindreAdaptation().catch((e) => {
      console.warn('Adaptation indisponible :', e);
      $('adaptation-etat').textContent = 'L’adaptation n’a pas pu être calculée sur cet appareil.';
    });
  });
</script>

<script>
  /*
     Interrupteur « Réduire les animations » (prompt 34, décision 4).

     Il vit à part du reste de l'écran : il ne touche à aucune donnée, ne lit
     rien du coffre et ne dépend d'aucun chargement. Un profil qui échoue à se
     peindre ne doit pas emporter avec lui le réglage d'accessibilité.

     L'attribut est déjà posé avant le premier rendu par le script d'amorçage
     du gabarit ; ici on ne fait que refléter cet état dans la case et le
     mettre à jour quand elle change.
  */
  const CLE_ANIMATIONS = 'revinsp.animations';
  const case_ = document.getElementById('reduire-animations') as HTMLInputElement | null;

  if (case_) {
    const racine = document.documentElement;
    case_.checked = racine.getAttribute('data-animations') === 'reduites';

    case_.addEventListener('change', () => {
      const valeur = case_.checked ? 'reduites' : 'completes';
      racine.setAttribute('data-animations', valeur);
      try {
        localStorage.setItem(CLE_ANIMATIONS, valeur);
      } catch {
        /* navigation privée : le choix ne vaudra que pour cette page */
      }
    });
  }
</script>
