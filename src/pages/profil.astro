---
/**
 * « Mon profil » : ce que Cyclades sait, qui le lit, et comment l'effacer.
 *
 * A.3 fixe ce que l'écran doit dire pour chaque champ : sa valeur, **qui
 * l'utilise**, et de quoi restreindre sa portée. A.5 ajoute la suppression d'un
 * champ ou de tout le profil.
 *
 * ## Ce que le prompt 56 a changé, et pourquoi
 *
 * L'écran affichait sous chaque champ « Utilisé par : Révisions, Odyssée » et
 * 52 cases pour restreindre cette portée. Les deux étaient fausses :
 * `profilDeBranche` — la seule fonction qui applique la portée — n'avait aucun
 * appelant, et l'export ne la regardait pas davantage. Une promesse peut rester
 * vraie au sens du type et fausse au sens de la personne pendant des mois.
 *
 * Les cases sont parties (décision 1 d'Alexis). À leur place, une ligne « Lu
 * par » **dérivée** de deux déclarations : la table du catalogue pour la
 * plupart des champs, le registre des usages pour l'âge. `essais:lu-par`
 * confronte les deux au code, dans trois sens, et la ceinture des littéraux
 * attrape une lecture écrite sous une forme qu'il ne connaît pas encore.
 *
 * ## Le plan de page, et pourquoi il est déclaré ailleurs
 *
 * Les champs étaient triés par ordre alphabétique, socle et branches mêlés, sur
 * neuf écrans de long. Ils sont maintenant groupés — Vous, Votre journée, Vos
 * objectifs, puis un bloc repliable par branche — et le groupe de chaque champ
 * est **au catalogue**, à côté du champ. Un champ ajouté sans groupe fait
 * échouer le contrôle au lieu d'atterrir au hasard de son initiale.
 *
 * ## Les champs vides sont ici, et non dans une liste à part
 *
 * Ils portent « — » et un bouton « Renseigner », à leur place dans leur bloc.
 * La liste séparée « Ce qui n'est pas renseigné » ne montrait que le socle :
 * une date d'épreuve vide n'y figurait pas, et ne pouvait donc être renseignée
 * que par l'initialisation de branche, une seule fois dans la vie (B5).
 *
 * ## Ce que cet écran ne fait pas
 *
 * Il n'efface rien d'autre que le profil, et le bloc d'effacement est celui du
 * prompt 58 : il n'a pas bougé d'un octet, il est seulement passé en dernier,
 * ce que le plan de page demande.
 */
import Base from '../layouts/Base.astro';
import LienReglages from '../components/LienReglages.astro';
import { BRANCHES } from '../lib/branches';
import { CHAMPS } from '../lib/noyau/profil';

/**
 * Les trois blocs du socle, dans l'ordre du plan de page.
 *
 * Le propos de chacun est écrit ici et non deviné : un titre seul ne dit pas
 * pourquoi ces réponses sont ensemble.
 */
const BLOCS = [
  {
    id: 'vous',
    titre: 'Vous',
    propos: 'Votre nom, votre âge, et la façon dont Cyclades vous parle.',
  },
  {
    id: 'journee',
    titre: 'Votre journée',
    propos:
      'Vos heures et le moment de votre revue. C’est la même donnée que dans Paramètres, Ma journée : la changer ici la change là-bas.',
  },
  {
    id: 'objectifs',
    titre: 'Vos objectifs',
    propos: 'Ce que vous visez, le temps que vous pouvez y mettre, et les domaines que vous suivez.',
  },
] as const;

const champsDuBloc = (groupe: string) => CHAMPS.filter((c) => c.groupe === groupe);

/** Les branches qui ont des champs : une branche sans champ n'a pas de bloc. */
const branchesAvecChamps = BRANCHES.filter((b) =>
  CHAMPS.some((c) => c.brancheDOrigine === b.id),
);
---

<Base titre="Mon profil" entete="leger">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mon profil</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
      Ce que Cyclades sait de vous, à quoi cela sert, et comment le changer ou l’effacer. Tout
      est facultatif.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Ces informations restent sur vos appareils, chiffrées, et se synchronisent avec eux. Elles
      sont <strong>exclues par défaut</strong> des exports destinés à une IA.
    </p>

    <!-- ── Le sommaire ─────────────────────────────────────────────────────
         Cinq ancres, parce que la page reste longue : grouper les champs la
         raccourcit, mais « Confidentialité » et « Effacer mon profil » sont
         toujours en bas, et ce sont justement les deux qu'on vient chercher.
    -->
    <nav aria-label="Sommaire de la page" class="mt-4">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <li><a href="#vous" class="cible-tactile underline underline-offset-4">Vous</a></li>
        <li><a href="#journee" class="cible-tactile underline underline-offset-4">Votre journée</a></li>
        <li><a href="#objectifs" class="cible-tactile underline underline-offset-4">Vos objectifs</a></li>
        <li><a href="#deductions" class="cible-tactile underline underline-offset-4">Ce que Cyclades en déduit</a></li>
        <li><a href="#confidentialite" class="cible-tactile underline underline-offset-4">Confidentialité</a></li>
      </ul>
    </nav>

    <!--
      LA LIGNE NEUTRE QUI REMPLACE LE COMPTEUR (P9).

      « 10 réponse(s) sur 18 au socle commun » se lisait comme une complétude,
      et l'interdit 3 du prompt l'interdit : pas de pourcentage, pas de
      « profil incomplet ». La ligne dit quand l'initialisation a été faite, et
      que tout reste modifiable — rien de plus.
    -->
    <p
      id="avancement"
      class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
    >
      Chargement…
    </p>

    <!-- ── Divergences entre appareils (A.6) ─────────────────────────── -->
    <section id="bloc-divergences" class="mt-6 hidden">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Deux appareils ne disent pas la même chose
      </h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        La valeur la plus récente est celle qui s’applique. Rien n’est perdu : choisissez celle qui
        est juste, ou laissez-la telle quelle.
      </p>
      <div id="divergences" class="space-y-3"></div>
    </section>

    <!-- ── Les trois blocs du socle ───────────────────────────────────── -->
    {
      BLOCS.map((bloc) => (
        <section id={bloc.id} class="mt-10 scroll-mt-24">
          <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">{bloc.titre}</h2>
          <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">{bloc.propos}</p>
          {bloc.id === 'journee' && <LienReglages section="journee" class="mb-3" />}
          {/*
             D-041 : UN LIEN POSÉ AU FIL D'UNE PHRASE NE PORTE PAS
             « cible-tactile ».

             WCAG 2.5.8 exempte le lien en ligne du plancher de 24 px, et la
             classe étirerait la ligne autour de lui. `essais:mobile:navigateur`
             le refuse, et il a eu raison de le refuser ici : les deux liens
             vers « Qui utilise mon âge » sont suivis d'une phrase.
          */}
          {bloc.id === 'vous' && (
            <p class="mb-3 text-sm">
              <a
                href="/qui-utilise-mon-age/"
                data-ecran
                class="font-medium text-slate-800 underline dark:text-slate-100"
                >Qui utilise mon âge</a
              >
              <span class="text-slate-500 dark:text-slate-400">
                — la liste de ce qui peut le lire, avec un interrupteur par ligne.</span
              >
            </p>
          )}
          <div class="space-y-3" data-champs={bloc.id}>
            {champsDuBloc(bloc.id).map((c) => (
              <div data-carte={c.champ} />
            ))}
          </div>
        </section>
      ))
    }

    <!-- ── Un bloc repliable par branche (P1, P2) ─────────────────────── -->
    <section class="mt-10">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">Par branche</h2>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Les réponses propres à chaque branche. Elles n’étaient posées qu’à sa première ouverture,
        une seule fois : elles se renseignent maintenant d’ici, à tout moment.
      </p>
      <div class="space-y-3">
        {
          branchesAvecChamps.map((b) => (
            <details
              data-branche={b.id}
              class="rounded-2xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900"
            >
              <summary
                class="flex min-h-11 cursor-pointer items-center justify-between gap-2 font-medium text-slate-900 dark:text-white"
              >
                <span>{b.libelle}</span>
                <span data-compte={b.id} class="text-xs font-normal text-slate-500 dark:text-slate-400"
                ></span>
              </summary>
              <div class="mt-3 space-y-3" data-champs={`branche-${b.id}`}>
                {CHAMPS.filter((c) => c.brancheDOrigine === b.id).map((c) => (
                  <div data-carte={c.champ} />
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ── Ce que Cyclades en déduit (P4) ─────────────────────────────── -->
    <section id="deductions" class="mt-10 scroll-mt-24">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">
        Ce que Cyclades en déduit
      </h2>
      <!--
        P4 : SEULEMENT CE QUI EST APPLIQUÉ.

        Huit réglages étaient affichés comme des conséquences de vos réponses.
        Cinq ne sont appliqués nulle part — jours de repos, créneaux, parcours
        ouverts, avis, objectif hebdomadaire —, et l'un affirmait même « Un jour
        de repos ne casse pas votre série », que la gamification ne fait pas.
        `reglagesAppliques()` ne rend que les trois réels, et chaque réglage
        déclare qui l'applique ; `essais:reglages-appliques` le confronte au
        code dans les deux sens.
      -->
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Aucune de ces déductions ne modifie une donnée : elles changent des <strong>réglages</strong>.
        Chacune dit la réponse dont elle découle — un réglage dont on ne voit pas la cause se change
        au hasard. Seules celles qui sont réellement appliquées sont ici.
      </p>
      <div id="reglages" class="space-y-2"></div>
    </section>

    <!-- ── Confidentialité (P14) ──────────────────────────────────────── -->
    <section id="confidentialite" class="mt-10 scroll-mt-24">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">Confidentialité</h2>
      <div class="max-w-2xl space-y-2 text-sm text-slate-600 dark:text-slate-300">
        <p>
          <strong>Ce qui sort du coffre.</strong> Pour poser le thème clair ou sombre avant même
          que la base soit ouverte, vos heures de lever et de coucher sont copiées en clair sur
          cet appareil. Rien d’autre du profil ne l’est, et cette copie ne quitte pas l’appareil.
        </p>
        <p>
          <strong>Ce qui part dans un export pour une IA.</strong> Seulement si vous cochez la
          case correspondante, et jamais votre prénom, votre nom, votre année ou votre mois de
          naissance, ni votre majorité déclarée : ces cinq réponses ne sortent pas, quelle que
          soit la case. Votre prénom et votre nom sont même lus pour être <strong>retirés</strong>{' '}
          <!--
             L'ESPACE EST EXPLICITE, ET IL LE FAUT.

             Le compilateur mange le blanc entre une balise et le mot suivant :
             le texte rendu disait « retirésdes textes libres ». Attrapé par
             `essais:espaces` sur le site construit, avant la poussée — c'est
             exactement pour cela que le socle existe.
          -->
          des textes libres que l’export emporte.
        </p>
        <p id="confidentialite-export"></p>
        <p>
          <a
            href="/qui-utilise-mon-age/"
            data-ecran
            class="font-medium text-slate-800 underline dark:text-slate-100"
            >Qui utilise mon âge</a
          >
          <span class="text-slate-500 dark:text-slate-400">
            — chaque endroit qui peut le lire, avec un interrupteur par ligne.</span
          >
        </p>
      </div>
    </section>

    <!-- ── Ce que Cyclades observe (P1 : les deux réunis) ─────────────── -->
    <!--
      L'APPRENTISSAGE ÉTENDU ET L'ADAPTATION SOUS UN SEUL TITRE.

      Ils faisaient deux sections voisines, et c'est le même sujet vu de deux
      côtés : ce que Cyclades regarde, et ce qu'il en fait. Le plan de page du
      56 les réunit. Rien de leur contenu ne change — les trois paragraphes du
      consentement restent **cités**, jamais reformulés, parce qu'un résumé
      écrit ici deviendrait une quatrième version d'un texte que personne n'a
      accepté.
    -->
    <section id="observation" class="mt-10 scroll-mt-24">
      <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">
        Ce que Cyclades observe
      </h2>
      <p class="mb-4 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Ce qu’il regarde, et ce qu’il en fait. Les deux se coupent, et rien ne les rallume tout
        seul.
      </p>

      <h3 class="mb-1 font-medium text-slate-900 dark:text-white">L’apprentissage étendu</h3>
      <p
        id="consentement-etat"
        role="status"
        class="mb-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Chargement…
      </p>

      <details id="consentement-texte" class="mt-3">
        <summary class="min-h-11 cursor-pointer text-sm text-indigo-700 underline underline-offset-4 dark:text-indigo-300">
          Lire ce que cela veut dire, en entier
        </summary>
        <div id="consentement-paragraphes" class="mt-3 space-y-3 text-sm text-slate-600 dark:text-slate-300"></div>
        <div
          id="consentement-manques"
          class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
        ></div>
      </details>

      <div class="mt-4 flex flex-wrap gap-2">
        <button
          id="consentement-accorder"
          type="button"
          class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Autoriser
        </button>
        <button
          id="consentement-revoquer"
          type="button"
          class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Révoquer
        </button>
      </div>
      <!-- M2 : les trois zones de message portent « role=status », sans quoi
           un lecteur d'écran n'annonce pas ce qui vient d'être enregistré. -->
      <p id="consentement-message" role="status" class="mt-3 hidden text-sm"></p>

      <h3 class="mt-8 mb-1 font-medium text-slate-900 dark:text-white">L’adaptation</h3>
      <p class="mb-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Quand l’usage observé contredit ce que vous avez déclaré, Cyclades pose la question — une
        fois par semaine au plus, jamais en travers de votre chemin. Une question refusée ne revient
        pas.
      </p>
      <p
        id="adaptation-etat"
        role="status"
        class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300"
      >
        Chargement…
      </p>
      <div id="ecarts" class="mt-3 space-y-2"></div>
      <div id="decisions" class="mt-3 space-y-2"></div>
      <button
        id="reinitialiser-adaptation"
        type="button"
        class="mt-4 min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
      >
        Réinitialiser l’adaptation
      </button>
      <p id="message-adaptation" role="status" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Effacer mon profil, en dernier (plan de page du 56) ────────── -->
    <!--
      LE BLOC N'A PAS CHANGÉ, IL A CHANGÉ DE PLACE.

      Son comportement appartient au prompt 58, qui tourne ailleurs : la
      redemande du mot de passe, les noms des champs annoncés avant
      l'effacement, le compte rendu après. Le 56 ne demande qu'une chose à son
      sujet, et c'est une question d'ordre — qu'il soit le dernier de la page,
      et non au milieu.
    -->
    <section
      class="mt-10 rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-900 dark:bg-amber-950/30"
    >
      <h2 class="font-semibold text-slate-900 dark:text-white">Effacer mon profil</h2>
      <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">
        Supprime <strong>tous</strong> les champs du profil. L’adaptation en tiendra compte : les
        réglages qui en découlaient reviennent à leur valeur par défaut, et les écrans cessent de
        vous appeler par votre prénom. Vos données de révision, de sport et d’Odyssée ne sont pas
        touchées.
      </p>
      <button
        id="effacer-profil"
        type="button"
        class="mt-3 min-h-11 rounded-lg bg-amber-600 px-4 font-medium text-white transition hover:bg-amber-700"
      >
        Supprimer tout le profil
      </button>
      <p id="message-effacement" role="status" class="mt-3 hidden text-sm"></p>
    </section>
  </div>
</Base>

<script>
  import { avertir, confirmer, demanderUneSaisie } from '../lib/boite';
  import { messageDUneErreur } from '../lib/agir';
  import { auDeverrouillage } from '../lib/chargement';
  import { echapper, pluriel } from '../lib/ui';
  import { redemanderLeMotDePasse } from '../lib/redemande';
  import {
    avancementLocal,
    divergencesLocales,
    ecrireChamp,
    profilLocal,
    supprimerChamp,
    supprimerProfil,
  } from '../lib/profil';
  import {
    CHAMPS,
    CHAMPS_JAMAIS_EXPORTES,
    CHAMPS_OBJECTIF,
    CHAMPS_PLUS_DEMANDES,
    aUnUsage,
  } from '../lib/noyau/profil';
  import type { ChampDeclare, ValeurDeChamp } from '../lib/noyau/profil';
  import { lecteursDuChamp } from '../lib/profil-lecteurs';
  import { historiqueDit, valeurDite, type Libelles } from '../lib/profil-lisible';

  const $ = (id: string) => document.getElementById(id)!;

  /**
   * Les libellés des parcours et des domaines, chargés une fois.
   *
   * Par import dynamique : le registre des parcours porte les thèmes, les
   * rotations et les référentiels, et cette page n'en veut que les noms. Les
   * faire venir au chargement de l'écran les ferait payer à qui ne descend
   * jamais jusqu'aux blocs de branche.
   */
  let libelles: Libelles = { parcours: [], domaines: [] };
  async function chargerLesLibelles(): Promise<void> {
    if (libelles.parcours.length) return;
    const [{ PARCOURS }, { DOMAINES }] = await Promise.all([
      import('../lib/parcours/registre'),
      import('../lib/noyau/domaines'),
    ]);
    libelles = {
      parcours: PARCOURS.map((p) => ({ id: p.id, libelle: p.libelle })),
      domaines: DOMAINES.map((d) => ({ id: d.id, libelle: d.libelle })),
    };
  }

  /**
   * Ce qu'un champ devient dans un export, dit en une phrase.
   *
   * Dérivé du catalogue, et non écrit à la main : les trois sorts sont ceux de
   * `repartirProfilPourExport`, et c'est la même liste qui décide. Dire
   * l'export une fois par champ plutôt que de l'ajouter aux lecteurs est
   * l'arbitrage du pilote : trente champs portant « Lu par : l'export pour une
   * IA » auraient noyé les lecteurs réels.
   */
  function sortDeLExport(champ: string): string {
    if (CHAMPS_JAMAIS_EXPORTES.includes(champ)) return 'Ne sort jamais dans un export.';
    if (CHAMPS_OBJECTIF.includes(champ)) {
      return 'Part dans un export si vous cochez « Objectifs ».';
    }
    return 'Part dans un export si vous cochez « Profil ».';
  }

  /** L'appareil où l'on se trouve, pour dire « celui-ci » au lieu d'un code. */
  let appareilCourant = '';
  /*
     LES DOMAINES RETENUS, RANGÉS PAR « peindre » COMME L'APPAREIL COURANT.

     Une répartition par domaine montrait les domaines actifs PAR DÉFAUT. Un
     domaine coupé y réapparaissait donc, et demandait de répartir du temps
     sur ce qu'on venait justement de retirer.

     `null` tant que rien n'a été lu, ou quand la personne n'a pas répondu à
     la question des domaines : la saisie retombe alors sur les domaines par
     défaut, c'est-à-dire sur le comportement de l'initialisation. Une liste
     VIDE n'est pas la même chose — c'est « je n'en veux aucun », et elle est
     respectée.
  */
  let domainesRetenus: readonly string[] | null = null;

  /** Une ligne de métadonnée, en petit, sous la valeur. */
  function ligneFine(texte: string): HTMLElement {
    const p = document.createElement('p');
    p.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
    p.textContent = texte;
    return p;
  }

  /**
   * La carte d'un champ : sa valeur, qui la lit, ce qu'elle règle, et quoi en
   * faire.
   *
   * Un seul chemin pour les champs remplis et les champs vides. Ils étaient
   * peints par deux fonctions différentes, dans deux sections différentes, et
   * c'est ce qui a permis à « Ce qui n'est pas renseigné » de ne jamais
   * montrer un champ de branche (B5).
   */
  function peindreCarte(declare: ChampDeclare, valeur: ValeurDeChamp | undefined): HTMLElement {
    const bloc = document.createElement('div');
    bloc.className =
      'rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900';
    bloc.dataset.champ = declare.champ;
    if (!valeur) bloc.dataset.vide = 'oui';

    const entete = document.createElement('div');
    entete.className = 'flex flex-wrap items-baseline justify-between gap-2';
    const nom = document.createElement('span');
    nom.className = 'font-medium text-slate-900 dark:text-white';
    nom.textContent = declare.libelle;
    const dite = document.createElement('span');
    /* Plus de chasse fixe : ce sont des réponses, pas du code (G2). */
    dite.className = 'text-sm text-slate-700 dark:text-slate-200';
    dite.dataset.valeur = declare.champ;
    dite.textContent = valeur ? valeurDite(declare.champ, valeur.valeur, libelles) : '—';
    entete.append(nom, dite);
    bloc.appendChild(entete);

    /* ── La ligne « Lu par », dérivée des deux tables (P3) ──────────────── */
    const lus = lecteursDuChamp(declare);
    if (lus.length) {
      const lecteurs = ligneFine(`Lu par : ${lus.join(', ')}.`);
      lecteurs.dataset.luPar = declare.champ;
      bloc.appendChild(lecteurs);
    }

    /* ── Ce que le champ règle, quand quelque chose le lit ──────────────── */
    if (declare.regle) bloc.appendChild(ligneFine(`ⓘ ${declare.regle}`));

    /*
       QUAND LA QUESTION SE POSE, pour les champs demandés au besoin.

       Le mois de naissance, la majorité déclarée et les usages coupés ne sont
       pas posés à l'initialisation : ils se demandent au moment où une
       fonction en a besoin, et c'est de la minimisation rendue mécanique
       plutôt que promise. L'écran le dit, sinon leur absence se lit comme un
       oubli — et le bouton reste, parce que répondre d'avance est le droit de
       la personne, pas une fuite.
    */
    if (!valeur && declare.demandeAuBesoin) {
      const quand = ligneFine(`Demandé au besoin : ${declare.demandeAuBesoin}`);
      quand.dataset.auBesoin = declare.champ;
      bloc.appendChild(quand);
    }

    /* ── La mention des champs qu'on ne demande plus (décision 2) ───────── */
    if (CHAMPS_PLUS_DEMANDES.includes(declare.champ)) {
      const garde = ligneFine('Pas encore utilisé par Cyclades. Votre réponse est gardée.');
      garde.dataset.gardee = declare.champ;
      bloc.appendChild(garde);
    }

    bloc.appendChild(ligneFine(sortDeLExport(declare.champ)));

    /* ── L'historique, replié (P7) ──────────────────────────────────────── */
    if (valeur) {
      const histoire = document.createElement('details');
      histoire.className = 'mt-2';
      const resume = document.createElement('summary');
      resume.className =
        'flex min-h-11 cursor-pointer items-center text-xs text-slate-500 dark:text-slate-400';
      resume.textContent = 'Historique';
      const corps = ligneFine(
        historiqueDit({
          source: valeur.source,
          version: valeur.version,
          appareil: valeur.appareil,
          ...(appareilCourant ? { appareilCourant } : {}),
        }),
      );
      histoire.append(resume, corps);
      bloc.appendChild(histoire);
    }

    /* ── Les actions, toutes à 44 px de haut (P8) ───────────────────────── */
    const actions = document.createElement('div');
    actions.className = 'mt-3 flex flex-wrap gap-2';
    const SECONDAIRE =
      'min-h-11 rounded-lg border border-slate-300 px-3 text-xs font-medium transition ' +
      'hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800';

    const changer = document.createElement('button');
    changer.type = 'button';
    changer.className = SECONDAIRE;
    changer.textContent = valeur ? 'Modifier' : 'Renseigner';
    changer.setAttribute(
      'aria-label',
      `${valeur ? 'Modifier' : 'Renseigner'} « ${declare.libelle} »`,
    );
    changer.addEventListener('click', () =>
      void demander(declare.champ, declare.question, valeur ? valeur.valeur : ''),
    );
    actions.appendChild(changer);

    if (valeur) {
      /*
         M6 : « SUPPRIMER » N'EST PLUS AMBRÉ.

         La couleur d'alerte se répétait sur chaque carte — treize fois —, et
         une alerte répétée treize fois n'alerte plus. Elle n'apparaît
         maintenant que dans la boîte de confirmation, là où le geste se
         décide.
      */
      const supprimer = document.createElement('button');
      supprimer.type = 'button';
      supprimer.className = SECONDAIRE;
      supprimer.textContent = 'Supprimer';
      supprimer.setAttribute('aria-label', `Supprimer « ${declare.libelle} »`);
      supprimer.addEventListener('click', async () => {
        const sur = await confirmer({
          titre: `Supprimer « ${declare.libelle} » ?`,
          texte:
            'Ce champ est retiré de votre profil. Les écrans qui s’en servaient ' +
            'reviennent à leur valeur par défaut. Vous pouvez le renseigner à nouveau.',
          action: 'Supprimer ce champ',
          destructrice: true,
        });
        if (!sur) return;
        await supprimerChamp(declare.champ);
        await peindre();
      });
      actions.appendChild(supprimer);
    }
    bloc.appendChild(actions);
    return bloc;
  }

  /**
   * La saisie d'un champ, dans la boîte commune — et par la saisie qui
   * convient à ce champ.
   *
   * ## CE QU'ELLE DEMANDAIT AVANT, ET POURQUOI C'ÉTAIT UNE PORTE FERMÉE
   *
   * Un seul champ texte servait toutes les natures. Pour corriger ses heures
   * par domaine, il fallait donc taper « {"cognition": 10} » — du JSON, à la
   * main, dans une boîte de dialogue. Une virgule oubliée rendait « Cette
   * répartition n'a pas pu être lue », et c'était tout ce que la personne
   * apprenait.
   *
   * L'exemple affiché était en plus faux une fois sur deux : il parlait de
   * domaines jusque devant « Dates d'épreuves », dont les valeurs sont des
   * dates par parcours. On montrait une forme à recopier, et ce n'était pas
   * la bonne.
   *
   * ## CE QU'ELLE FAIT MAINTENANT
   *
   * `saisiePourChamp` rend la même saisie que l'initialisation : des curseurs
   * pour une répartition d'heures, un calendrier par parcours pour les dates,
   * des bascules pour une liste à choix, un champ heure pour une heure. Aucune
   * syntaxe à connaître, et aucune forme à recopier.
   *
   * ## LES TROIS ISSUES, QUI NE SE CONFONDENT PAS
   *
   * `null` est un renoncement : on a fermé ou annulé, et le champ reste tel
   * qu'il était. `undefined` est une réponse — celle d'un « Je ne sais pas
   * encore », ou d'une saisie que personne n'a touchée — et elle n'écrit rien
   * non plus, mais pour une autre raison. Les écrire toutes deux reviendrait
   * à effacer une valeur que la personne n'a pas demandé d'effacer.
   */
  async function demander(champ: string, question: string, actuelle: unknown): Promise<void> {
    const { champDeclare } = await import('../lib/noyau/profil');
    const { saisiePourChamp, domainesAMontrer } = await import('../lib/noyau/saisies');
    const declare = champDeclare(champ)!;

    const reponse = await demanderUneSaisie({
      titre: question,
      /* Les répartitions et les dates nomment chacune de leurs lignes :
         une étiquette de plus au-dessus répéterait le titre. */
      etiquette: declare.nature === 'repartition' ? undefined : declare.libelle,
      action: 'Enregistrer',
      construire: (fermer) =>
        saisiePourChamp(declare, actuelle, {
          valider: fermer,
          surInconnu: fermer,
          domaines: domainesAMontrer(domainesRetenus),
        }),
    });

    if (reponse === null) return;
    if (reponse.valeur === undefined) return;

    try {
      await ecrireChamp(champ, reponse.valeur);
    } catch (erreur) {
      await avertir({
        titre: 'Ce champ n’a pas été enregistré',
        texte: messageDUneErreur(erreur),
      });
      return;
    }
    await peindre();
  }

  /**
   * Les réglages déduits — **et appliqués** (P4).
   *
   * Cinq des huit ne sont appliqués nulle part, et la page les présentait
   * pourtant comme des conséquences de ce qui avait été répondu.
   * `reglagesAppliquesLocaux` ne rend que ceux dont le code déclare un
   * applicateur, et `essais:reglages-appliques` confronte la déclaration au
   * code dans les deux sens.
   */
  async function peindreReglages(): Promise<void> {
    const { reglagesAppliquesLocaux } = await import('../lib/adaptation');
    const zone = $('reglages');
    zone.textContent = '';
    for (const reglage of await reglagesAppliquesLocaux()) {
      const ligne = document.createElement('div');
      ligne.className =
        'rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900';
      ligne.dataset.reglage = reglage.id;
      const titre = document.createElement('p');
      titre.className = 'flex flex-wrap items-baseline gap-2';
      const nom = document.createElement('span');
      nom.className = 'font-medium text-slate-900 dark:text-white';
      nom.textContent = reglage.libelle;
      const origine = document.createElement('span');
      origine.className = 'text-xs text-slate-500 dark:text-slate-400';
      origine.textContent = reglage.deduit ? 'déduit de vos réponses' : 'réglage par défaut';
      titre.append(nom, origine);
      const cause = document.createElement('p');
      cause.className = 'mt-1 text-sm text-slate-600 dark:text-slate-300';
      cause.textContent = reglage.cause;
      ligne.append(titre, cause);
      zone.appendChild(ligne);
    }
  }

  const LIBELLE_ISSUE: Record<string, string> = {
    acceptee: 'acceptée',
    reportee: 'reportée',
    refusee: 'refusée — elle ne reviendra pas',
    remise: 'défaite par une réinitialisation',
  };

  /* ──────────────────────────────────────────────────────────────────────
     Le consentement à l'apprentissage étendu — A-13
     ────────────────────────────────────────────────────────────────────── */

  /**
   * Peint l'état, le texte cité, et ce qui n'existe pas.
   *
   * ## Le bouton « Autoriser » est refait à chaque peinture
   *
   * Et c'est nécessaire : `accorderLApprentissage` doit nommer la
   * révocation qu'elle lève, et cette révocation peut venir d'un autre
   * appareil entre deux affichages. Un gestionnaire posé une fois avec un
   * état figé écrirait un accord qui ne lèverait rien, et la personne
   * croirait avoir réautorisé.
   */
  async function peindreConsentement(): Promise<void> {
    const { consentementLocal } = await import('../lib/consentement-apprentissage');
    const { TEXTE_DE_CONSENTEMENT, DOMAINES_DU_CONSENTEMENT } = await import(
      '../lib/odyssee/consentement'
    );
    const etat = await consentementLocal();

    const quand = (iso: string) =>
      new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

    $('consentement-etat').textContent = etat.accorde
      ? `Autorisé depuis le ${quand(etat.depuis!)}. Cyclades observe vos révisions pour vous proposer des réglages.`
      : etat.depuis
        ? `Révoqué le ${quand(etat.depuis)}. Rien n’est observé, et le reste de Cyclades fonctionne.`
        : 'Jamais autorisé. Rien n’est observé, et le reste de Cyclades fonctionne.';

    /*
       Le centre de notifications — prompt 32, phase 4. « Jamais demandé »
       se lit `depuis === null` : ni accord, ni révocation. Un refus est
       une réponse, et reposer la question serait harceler.
    */
    void (async () => {
      try {
        const { signalerLApprentissage } = await import('../lib/notifications/alimentation');
        await signalerLApprentissage(etat.depuis === null);
      } catch {
        /* Le centre n'est jamais une raison de casser l'écran d'origine. */
      }
    })();

    /* Les trois paragraphes, cités tels quels. Aucun résumé. */
    const zone = $('consentement-paragraphes');
    zone.innerHTML = '';
    for (const cle of ['ceQueCycladesLit', 'ceQuiNeChangeJamais', 'commentArreter'] as const) {
      const p = document.createElement('p');
      p.dataset.paragraphe = cle;
      p.textContent = TEXTE_DE_CONSENTEMENT[cle];
      zone.appendChild(p);
    }

    /*
       CE QUI N'EXISTE PAS, à l'écran et pas seulement dans un commentaire.
       Le texte cité promet des interrupteurs par domaine et un journal
       d'accès ; ni l'un ni l'autre n'est construit. Taire l'écart ici
       reviendrait à faire accepter un texte plus large que ce qui est fait.

       M1 DU 56 : LA DATE EST PARTIE, et non calculée. Elle était écrite en
       dur — « au 16 octobre 2026 » — et se démodait en silence. La calculer
       sur « aujourd'hui » aurait été pire : la phrase aurait prétendu que la
       liste avait été revue ce matin. Ce qui la tient à jour, c'est le compte
       de domaines, qui vient du module, et l'essai qui constate qu'aucun
       interrupteur par domaine n'existe.
    */
    $('consentement-manques').textContent =
      'Ce qui n’existe pas encore : les interrupteurs par domaine et ' +
      `par source (le texte en annonce ${DOMAINES_DU_CONSENTEMENT.length} ; une seule branche, ` +
      'les Révisions, est réellement observée, et l’autorisation ci-dessus la couvre ' +
      'entièrement), le journal de ce qui a été lu, et le rappel périodique. ' +
      'Le choix d’effacer les observations à la révocation est sans objet : elles sont ' +
      'recalculées à chaque lecture et ne sont jamais stockées.';

    $('consentement-accorder').classList.toggle('hidden', etat.accorde);
    $('consentement-revoquer').classList.toggle('hidden', !etat.accorde);
  }

  async function changerLeConsentement(quoi: 'accorder' | 'revoquer'): Promise<void> {
    const message = $('consentement-message');
    try {
      const module = await import('../lib/consentement-apprentissage');
      const etat =
        quoi === 'accorder'
          ? await module.accorderLApprentissage()
          : await module.revoquerLApprentissage();
      message.textContent = etat.accorde
        ? 'Autorisé. Vous pouvez révoquer à tout moment, sans justification.'
        : 'Révoqué. Plus rien n’est observé.';
      message.className = 'mt-3 text-sm text-slate-600 dark:text-slate-300';
    } catch (erreur) {
      message.textContent = messageDUneErreur(erreur);
      message.className = 'mt-3 text-sm text-rose-700 dark:text-rose-300';
    }
    message.classList.remove('hidden');
    await peindreConsentement();
    /* L'adaptation suit : son silence change de raison. */
    await peindreAdaptation();
  }

  /** L'état de l'adaptation : l'écart connu, ou le silence et sa raison. */
  async function peindreAdaptation(): Promise<void> {
    const { decisionsLocales, propositionLocale } = await import('../lib/adaptation');
    const { regleAdaptation } = await import('../lib/noyau/adaptation');
    const [{ proposition, silence, ecarts }, decisions] = await Promise.all([
      propositionLocale(),
      decisionsLocales(),
    ]);

    /*
       Le centre — phase 4. La RÈGLE seule, jamais la valeur proposée, et
       seulement la proposition du jour : les écarts connus mais ajournés
       restent sur cet écran, où leur délai est dit. Les porter au centre
       contournerait le plafond d'une question par semaine.
    */
    void (async () => {
      try {
        const { signalerUneProposition } = await import('../lib/notifications/alimentation');
        await signalerUneProposition(proposition?.regle ?? null);
      } catch {
        /* Le centre n'est jamais une raison de casser l'écran d'origine. */
      }
    })();

    $('adaptation-etat').textContent = proposition
      ? 'Une question vous attend sur le menu.'
      : silence?.pourquoi === 'sans-consentement'
        ? 'L’apprentissage étendu n’est pas autorisé : rien n’est observé, donc aucun écart ne peut être trouvé.'
      : silence?.pourquoi === 'aucun-ecart'
        ? 'Rien à signaler : ce que vous avez déclaré et ce que l’usage montre se tiennent.'
        : silence?.pourquoi === 'trop-tot'
          ? `Un écart est connu, et il attendra ${pluriel(silence.joursRestants ?? 0, 'jour')} : une question par semaine au plus.`
          : silence?.pourquoi === 'ajourne'
            ? `Un écart est connu, et vous l’avez reporté : on en reparlera dans ${pluriel(silence.joursRestants ?? 0, 'jour')}.`
            : 'Les écarts connus portent sur des questions que vous avez refusées. Elles ne reviendront pas.';

    /*
       Les écarts sont montrés **tous**, même ceux qui ne seront pas proposés
       aujourd'hui : quelqu'un qui ouvre cet écran a le droit de savoir ce que
       Cyclades a remarqué, plutôt que de l'apprendre dans trois jours.
    */
    const zone = $('ecarts');
    zone.textContent = '';
    for (const ecart of ecarts) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-xl border border-sky-200 bg-sky-50/60 px-4 py-3 text-sm dark:border-sky-900 dark:bg-sky-950/30';
      const constat = document.createElement('p');
      constat.className = 'text-slate-700 dark:text-slate-200';
      constat.textContent = ecart.constat;
      const question = document.createElement('p');
      question.className = 'mt-1 text-slate-500 dark:text-slate-400';
      question.textContent = ecart.question;
      carte.append(constat, question);
      zone.appendChild(carte);
    }

    const prises = $('decisions');
    prises.textContent = '';
    for (const decision of decisions.values()) {
      if (decision.issue === 'remise') continue;
      const regle = regleAdaptation(decision.regle);
      const ligne = document.createElement('p');
      ligne.className = 'text-xs text-slate-500 dark:text-slate-400';
      ligne.textContent =
        `${regle?.libelle ?? decision.regle} — ${LIBELLE_ISSUE[decision.issue] ?? decision.issue}` +
        (decision.le ? ` le ${new Date(decision.le).toLocaleDateString('fr-FR')}` : '');
      prises.appendChild(ligne);
    }
  }

  /* ──────────────────────────────────────────────────────────────────────
     La peinture de la page
     ────────────────────────────────────────────────────────────────────── */

  async function peindre(): Promise<void> {
    await chargerLesLibelles();
    const { BRANCHES } = await import('../lib/branches');
    const { lireAppareil } = await import('../lib/db');
    const [profil, etat, divergences, appareil] = await Promise.all([
      profilLocal(),
      avancementLocal(),
      divergencesLocales(),
      lireAppareil().catch(() => ''),
    ]);
    appareilCourant = appareil;
    const ditDomaines = profil.get('domainesActifs')?.valeur;
    domainesRetenus = Array.isArray(ditDomaines) ? ditDomaines.map(String) : null;

    /*
       LA LIGNE NEUTRE (P9), et ce qu'elle ne dit pas.

       Pas de compte, pas de dénominateur, pas de pourcentage : l'interdit 3 du
       prompt les exclut tous les trois, et « 10 réponses sur 18 » se lisait
       comme une complétude. Elle dit quand l'initialisation a eu lieu, et que
       tout reste modifiable. Le prénom est nommé seulement s'il manque, parce
       que c'est la seule réponse que l'initialisation attend — un fait, et non
       un reproche.
    */
    const quand = (iso: string) =>
      new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    $('avancement').textContent =
      (etat.initialisation
        ? `Initialisation ${etat.initialisation.allegee ? 'allégée ' : ''}faite le ` +
          `${quand(etat.initialisation.termineeLe)}. `
        : 'L’initialisation n’a pas encore été faite. ') +
      'Vous pouvez compléter ou retirer ce que vous voulez, quand vous voulez.' +
      (etat.prenomPose ? '' : ' Le prénom est la seule réponse attendue.');

    /* ── Les cartes, une par champ, à leur place déclarée ──────────────── */
    for (const declare of CHAMPS) {
      const hote = document.querySelector<HTMLElement>(`[data-carte="${declare.champ}"]`);
      if (!hote) continue;
      hote.textContent = '';
      const valeur = profil.get(declare.champ);
      /*
         UN CHAMP VIDE QUE RIEN NE LIT N'EST PAS MONTRÉ.

         Décision 2 : il n'est plus demandé, ni à l'initialisation ni comme « à
         renseigner ». Lui faire une carte vide en ferait vingt-trois de plus,
         chacune invitant à renseigner une réponse que rien ne lirait — c'est
         l'inverse de ce que la décision demande. Rempli, il reste là, visible
         et modifiable, avec sa mention.
      */
      if (!valeur && !aUnUsage(declare)) continue;
      hote.appendChild(peindreCarte(declare, valeur));
    }

    /* ── Le compte de chaque branche, et le mot quand il n'y a rien ────── */
    for (const b of BRANCHES) {
      const zone = document.querySelector<HTMLElement>(`[data-champs="branche-${b.id}"]`);
      const compte = document.querySelector<HTMLElement>(`[data-compte="${b.id}"]`);
      if (!zone) continue;
      const cartes = zone.querySelectorAll('[data-champ]').length;
      const remplies = zone.querySelectorAll('[data-champ]:not([data-vide])').length;
      if (compte) {
        compte.textContent = cartes
          ? remplies
            ? pluriel(remplies, 'réponse')
            : 'rien de renseigné'
          : 'plus rien n’est demandé ici';
      }
      /*
         UN BLOC QUI PORTE DES RÉPONSES S'OUVRE, LA PREMIÈRE FOIS.

         Repliable ne veut pas dire caché : une réponse déjà donnée que
         personne ne voit est aussi perdue qu'une réponse effacée. On ouvre
         donc le bloc qui en porte, et **une seule fois** — refaire le geste à
         chaque peinture rouvrirait ce que la personne vient de replier.
      */
      const repli = zone.closest('details');
      if (repli && !repli.dataset.vu) {
        repli.dataset.vu = 'oui';
        if (remplies > 0) repli.open = true;
      }
      const dejaDit = zone.querySelector('[data-rien]');
      if (dejaDit) dejaDit.remove();
      if (!cartes) {
        const rien = ligneFine(
          'Aucune de ces réponses n’est lue par Cyclades aujourd’hui : elles ne sont plus ' +
            'demandées. Celles que vous avez données resteraient ici.',
        );
        rien.dataset.rien = b.id;
        zone.appendChild(rien);
      }
    }

    /*
       CE QUI SORTIRAIT, COMPTÉ SUR CE QUI EST RENSEIGNÉ (P14).

       Une phrase dérivée du catalogue, et non une promesse : les trois sorts
       sont ceux de `repartirProfilPourExport`, et c'est la même liste qui
       décide ici et là-bas.
    */
    const remplis = [...profil.keys()];
    const jamais = remplis.filter((c) => CHAMPS_JAMAIS_EXPORTES.includes(c)).length;
    const objectifs = remplis.filter(
      (c) => !CHAMPS_JAMAIS_EXPORTES.includes(c) && CHAMPS_OBJECTIF.includes(c),
    ).length;
    const profilCoche = remplis.length - jamais - objectifs;
    $('confidentialite-export').textContent = remplis.length
      ? `Aujourd’hui : ${pluriel(profilCoche, 'réponse')} avec la case « Profil », ` +
        `${pluriel(objectifs, 'réponse')} avec la case « Objectifs », et ` +
        `${pluriel(jamais, 'réponse')} qui ne sortent jamais.`
      : 'Rien n’est renseigné : un export n’emporterait aucune réponse de votre profil.';

    /* ── Les divergences entre appareils (A.6) ─────────────────────────── */
    const bloc = $('bloc-divergences');
    const zone = $('divergences');
    zone.textContent = '';
    bloc.classList.toggle('hidden', divergences.length === 0);
    for (const divergence of divergences) {
      const carte = document.createElement('div');
      carte.className =
        'rounded-2xl border border-amber-300 bg-white p-4 dark:border-amber-800 dark:bg-slate-900';
      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = divergence.declare.libelle;
      carte.appendChild(titre);
      for (const version of divergence.versions) {
        const ligne = document.createElement('div');
        ligne.className = 'mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm';
        ligne.innerHTML =
          `<span class="text-slate-700 dark:text-slate-200">${echapper(
            valeurDite(divergence.champ, version.valeur, libelles),
          )}</span>` +
          `<span class="text-xs text-slate-500 dark:text-slate-400">sur ${echapper(version.appareil)}</span>`;
        const garder = document.createElement('button');
        garder.type = 'button';
        garder.className =
          'min-h-11 rounded-lg border border-amber-400 px-3 text-xs font-medium text-amber-900 ' +
          'transition hover:bg-amber-100 dark:border-amber-700 dark:text-amber-200';
        garder.textContent = 'Garder celle-ci';
        garder.setAttribute(
          'aria-label',
          `Garder « ${valeurDite(divergence.champ, version.valeur, libelles)} » pour ${divergence.declare.libelle}`,
        );
        garder.addEventListener('click', async () => {
          await ecrireChamp(divergence.champ, version.valeur, { source: version.source });
          await peindre();
        });
        ligne.appendChild(garder);
        carte.appendChild(ligne);
      }
      zone.appendChild(carte);
    }
  }

  $('effacer-profil').addEventListener('click', async () => {
    /*
       Le mot de passe, et non plus un « confirm ». Celui-ci protégeait du
       clic à côté, et de rien d'autre : l'effacement part aussi vers les
       autres appareils à la prochaine synchronisation, et rien ne le
       rattrape de là-bas. Ce que la redemande vise, c'est l'ordinateur
       déverrouillé prêté deux minutes — le même cas que la décision 3.
    */
    /*
       A7 DU 43 — DIRE CE QU'ON EFFACE, AVEC DES NOMBRES ET DES NOMS.

       « Tous les champs du profil » est vrai et creux : on ne sait pas s'il
       y en a deux ou trente, ni lesquels. Le compte n'était donné qu'APRÈS
       — « 14 champ(s) supprimé(s) » — c'est-à-dire au moment où il ne sert
       plus à décider.

       On le lit donc avant, et on nomme les premiers champs : un libellé
       reconnu (« Prénom », « Année de naissance ») arrête la main mieux
       qu'un nombre seul.
    */
    const { champDeclare: libelleDuChamp } = await import('../lib/noyau/profil');
    const avantEffacement = await profilLocal();
    const nomsRemplis = [...avantEffacement.keys()]
      .map((nom) => libelleDuChamp(nom)?.libelle ?? nom)
      .sort((a, b) => a.localeCompare(b, 'fr'));
    const apercuDesNoms = nomsRemplis.slice(0, 6).join(', ');
    if (
      !(await redemanderLeMotDePasse({
        titre: 'Supprimer tout le profil',
        consequence:
          (nomsRemplis.length
            ? `${pluriel(nomsRemplis.length, 'champ')} renseignés seront effacés` +
              (apercuDesNoms
                ? ` — dont ${apercuDesNoms}${nomsRemplis.length > 6 ? `, et ${pluriel(nomsRemplis.length - 6, 'autre')}` : ''}`
                : '') +
              '. '
            : 'Aucun champ n’est renseigné : il n’y a rien à effacer. ') +
          'L’effacement part aussi vers vos autres appareils à la prochaine ' +
          'synchronisation. Vos données de révision, de sport et d’Odyssée ne sont ' +
          'pas touchées.',
        action: 'Supprimer tout le profil',
      }))
    ) {
      const message = $('message-effacement');
      message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
      message.textContent = 'Rien n’a été supprimé.';
      message.classList.remove('hidden');
      return;
    }
    const combien = await supprimerProfil();
    const message = $('message-effacement');
    message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
    message.textContent = `${pluriel(combien, 'champ')} supprimés.`;
    message.classList.remove('hidden');
    await peindre();
  });

  $('reinitialiser-adaptation').addEventListener('click', async () => {
    if (
      !(await confirmer({
        titre: 'Réinitialiser l’adaptation ?',
        texte:
          'Les réglages qu’une proposition acceptée avait changés reviennent à la ' +
          'valeur que vous aviez déclarée — pas à une valeur par défaut. Les ' +
          'questions que vous avez refusées restent refusées.',
        action: 'Réinitialiser l’adaptation',
      }))
    ) {
      return;
    }
    const { reinitialiserAdaptation } = await import('../lib/adaptation');
    const remise = await reinitialiserAdaptation();
    const message = $('message-adaptation');
    message.className = 'mt-3 text-sm text-slate-700 dark:text-slate-200';
    const touches = remise.retablis.length + remise.supprimes.length;
    message.textContent = touches
      ? `${pluriel(remise.retablis.length, 'réglage')} remis à sa valeur déclarée` +
        (remise.supprimes.length
          ? `, et ${pluriel(remise.supprimes.length, 'champ')} supprimés faute d’avoir eu une valeur avant.`
          : '.')
      : 'Rien à défaire : aucune proposition n’a été acceptée.';
    message.classList.remove('hidden');
    await peindre();
  });

  auDeverrouillage(async () => {
    await peindre();
    /*
       Les réglages et l'adaptation viennent **après** le profil : l'adaptation
       publie les faits pour observer l'usage, et cet écran doit s'afficher
       avant, pas après. Leur échec n'emporte pas la page.
    */
    await peindreReglages().catch((e) => console.warn('Réglages déduits indisponibles :', e));
    /*
       Le consentement AVANT l'adaptation : c'est lui qui décide si
       l'adaptation a quelque chose à dire, et l'afficher après donnerait
       un instant où l'écran annonce un silence dont il ne dit pas encore
       la cause.
    */
    $('consentement-accorder').addEventListener('click', () =>
      void changerLeConsentement('accorder'),
    );
    $('consentement-revoquer').addEventListener('click', () =>
      void changerLeConsentement('revoquer'),
    );
    await peindreConsentement().catch((e) => {
      console.warn('Consentement indisponible :', e);
      $('consentement-etat').textContent =
        'L’état du consentement n’a pas pu être lu. Rien n’est observé tant qu’il ne l’est pas.';
    });
    await peindreAdaptation().catch((e) => {
      console.warn('Adaptation indisponible :', e);
      $('adaptation-etat').textContent = 'L’adaptation n’a pas pu être calculée sur cet appareil.';
    });
  });
</script>
