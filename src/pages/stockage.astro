---
/**
 * Page « Stockage » : ce que la base contient, et ce qui la menace.
 *
 * Elle existe pour une raison précise, et ce n'est pas le quota. Les mesures
 * sont faites : cinq ans d'usage intensif occupent neuf mégaoctets, et les
 * quotas se comptent en gigaoctets. Le danger est la **perte** — données de site
 * effacées, appareil changé, éviction automatique —, et c'est de cela que cette
 * page parle d'abord.
 */
import Base from '../layouts/Base.astro';
import LienReglages from '../components/LienReglages.astro';
---

<Base titre="Stockage" actif="progression">
  <!-- Le titre vit hors des deux blocs : une page qui n'annonce son sujet
       qu'une fois la base lue n'a pas de titre pour qui arrive au clavier. -->
  <h1 class="mb-5 text-2xl font-bold text-slate-900 dark:text-white">Stockage</h1>
  <LienReglages section="donnees" class="mt-2" />

  <div id="chargement" class="py-20 text-center text-slate-400">Lecture de l’espace de stockage…</div>

  <div id="stockage" class="hidden space-y-8">
    <!-- ── Le risque, avant les chiffres ───────────────────────────────── -->
    <section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-950/40">
      <h2 class="mb-2 text-lg font-semibold text-amber-900 dark:text-amber-200">
        Ce qui menace vos données
      </h2>
      <p class="max-w-3xl text-sm leading-relaxed text-amber-900/90 dark:text-amber-200/90">
        Ce n’est pas le manque de place. Cinq ans d’usage intensif tiennent dans
        une dizaine de mégaoctets, et votre navigateur en accorde des milliers.
        Le risque réel est la <strong>disparition</strong> : effacer les données
        de site, changer d’appareil, laisser un nettoyeur passer, ou ne pas
        revenir assez longtemps pour qu’un navigateur décide de faire le ménage.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-amber-900/90 dark:text-amber-200/90">
        <strong>Une seule chose protège vraiment : la sauvegarde.</strong> Les
        réglages ci-dessous réduisent le risque, ils ne le suppriment pas.
      </p>
      <a
        id="lien-sauvegarde"
        class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-amber-600 px-4 text-sm font-medium text-white transition hover:bg-amber-700"
      >
        Aller sauvegarder
      </a>
    </section>

    <!-- ── Occupation ──────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">Occupation</h2>
      <dl id="occupation" class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3"></dl>
      <div
        id="alerte-quota"
        class="mt-4 hidden rounded-xl border p-4 text-sm"
        role="status"
      ></div>
    </section>

    <!-- ── Persistance ─────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Stockage persistant
      </h2>
      <p class="mb-3 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Quand il est accordé, le navigateur s’engage à ne pas effacer ces données
        de lui-même pour faire de la place. Il ne s’engage à rien d’autre :{' '}
        <strong>un effacement manuel, un nettoyeur ou un changement d’appareil
        emportent tout de même tout</strong>.
      </p>
      <p id="etat-persistance" class="mb-3 text-sm font-medium"></p>
      <button
        id="demander-persistance"
        class="hidden rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
      >
        Demander le stockage persistant
      </button>
      <p id="message-persistance" class="mt-3 hidden text-sm"></p>

      <!--
        Le cas de Safari est traité à part parce qu'il est le plus sévère, et
        parce que la documentation d'Apple ne le couvre pas : le texte dit donc
        ce qui est attesté et ce qui ne l'est pas.
      -->
      <details class="mt-4 rounded-lg bg-slate-50 p-3 text-sm dark:bg-slate-950/60">
        <summary class="cursor-pointer font-medium text-indigo-600 dark:text-indigo-400">
          Sur iPhone et iPad, et sur Safari : une règle plus sévère
        </summary>
        <div class="mt-3 space-y-2 text-slate-600 dark:text-slate-300">
          <p>
            WebKit — le moteur de Safari, et de tous les navigateurs sur iOS —
            applique un <strong>plafond de sept jours</strong> aux données
            écrites par un script, ce qui comprend la base de ce site. Le
            compteur se remet à zéro à chaque visite, et il compte des jours
            d’usage du navigateur plutôt que des jours calendaires : en venant
            régulièrement, on ne l’atteint jamais.
          </p>
          <p>
            Un site <strong>ajouté à l’écran d’accueil</strong> est décrit comme
            exempté de ce ménage. C’est la précaution la plus simple sur
            téléphone, et elle est recommandée ici.
          </p>
          <p class="text-slate-500 dark:text-slate-400">
            Ce paragraphe mérite une réserve : Apple ne documente pas cette
            exemption, et ce qu’on en sait vient d’analyses extérieures et de
            la page de prévention du pistage de WebKit, qui est ancienne. Le
            comportement exact peut donc différer selon la version. Raison de
            plus pour ne compter que sur la sauvegarde.
          </p>
        </div>
      </details>
    </section>

    <!-- ── Détail par magasin ──────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Détail par magasin
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        IndexedDB ne sait pas dire la taille d’un magasin : la seule mesure
        possible est de relire son contenu et de le mesurer, ce qui donne la
        taille des <em>données</em> et non celle qu’elles occupent sur le disque.
        L’opération relit toute la base, d’où le bouton.
      </p>
      <button
        id="peser"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
      >
        Peser les magasins
      </button>
      <div id="detail" class="mt-4 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            <tr>
              <th scope="col" class="py-2 pr-4">Magasin</th>
              <th scope="col" class="py-2 pr-4 text-right">Enregistrements</th>
              <th scope="col" class="py-2 text-right">Données</th>
            </tr>
          </thead>
          <tbody id="detail-lignes" class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
        </table>
        <p id="detail-rapport" class="mt-3 text-sm text-slate-500 dark:text-slate-400"></p>
      </div>
    </section>

    <!-- ── Intégrité ───────────────────────────────────────────────────── -->
    <!-- ── Dernière migration ─────────────────────────────────────────── -->
    <section
      id="migration"
      class="hidden rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
    >
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Dernière migration
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Un instantané de votre base a été pris <strong>avant</strong> la dernière
        mise à niveau du schéma, et il vit dans ce navigateur. Revenir en arrière
        remet la base dans l’état de cet instantané : <strong>tout ce que vous
        avez saisi depuis sera perdu</strong>. C’est un dernier recours, pas une
        réparation.
      </p>
      <dl id="migration-detail" class="mb-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4"></dl>
      <button
        id="revenir-migration"
        class="rounded-lg border border-red-300 bg-white px-4 py-2.5 text-sm font-medium text-red-700 transition hover:bg-red-100 dark:border-red-800 dark:bg-transparent dark:text-red-300"
      >
        Revenir avant la migration
      </button>
      <p id="message-migration" class="mt-3 hidden text-sm"></p>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">Intégrité</h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Un contrôle des liens que le modèle suppose : une note sans séance, une
        séance sans thème, une flashcard dont la fiche a disparu. Il{' '}
        <strong>ne répare rien et n’efface rien</strong> — réparer
        automatiquement une base qu’on ne comprend pas est le meilleur moyen de
        transformer une anomalie bénigne en perte.
      </p>
      <button
        id="controler"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
      >
        Contrôler l’intégrité
      </button>
      <div id="integrite" class="mt-4 hidden text-sm"></div>
    </section>

    <!-- ── Export lisible ─────────────────────────────────────────────── -->
    <section id="exporter-lisible" class="rounded-2xl border border-slate-200 bg-white p-5 target:ring-2 target:ring-indigo-400 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Exporter en clair
      </h2>
      <p class="mb-4 max-w-3xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        Pour emporter vos données ailleurs : les ouvrir dans un tableur, les
        donner à un autre outil. Le CSV suit les conventions françaises
        (point-virgule, virgule décimale, accents) et s'ouvre directement dans
        Excel ou LibreOffice.
      </p>
      <p class="mb-4 max-w-3xl rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200">
        <strong>Ce n'est pas une sauvegarde.</strong> Ces fichiers sont en clair
        et ne se réimportent pas. Pour pouvoir revenir en arrière, il faut une
        sauvegarde <code class="rounded bg-amber-100 px-1 dark:bg-amber-900/60">.cyclades</code>.
      </p>

      <fieldset class="mb-4">
        <legend class="mb-2 text-sm font-medium text-slate-700 dark:text-slate-200">
          Quel domaine ?
        </legend>
        <div id="groupes-export" class="space-y-2 text-sm"></div>
      </fieldset>

      <div class="flex flex-wrap gap-2">
        <button id="exporter-csv" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700">
          Exporter en CSV
        </button>
        <button id="exporter-json" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800">
          Exporter en JSON
        </button>
      </div>
      <p id="message-export" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Effacement ciblé ───────────────────────────────────────────── -->
    <section id="effacer-cible" class="rounded-2xl border border-red-200 bg-red-50/60 p-5 target:ring-2 target:ring-red-400 dark:border-red-900 dark:bg-red-950/30">
      <h2 class="mb-2 text-lg font-semibold text-red-900 dark:text-red-200">
        Effacer de façon ciblée
      </h2>
      <p class="mb-4 max-w-3xl text-sm leading-relaxed text-red-800/80 dark:text-red-300/80">
        Pour se débarrasser d'un historique devenu inutile sans tout perdre.
        Rien ne s'efface avant que vous ayez vu le compte exact de ce qui
        partirait : un effacement est la seule opération du site qui soit
        définitive sans recours.
      </p>
      {/*
         A7 DU 58 — DIRE QUE L'EFFACEMENT CIBLÉ SE PROPAGE.

         C'est l'écart le plus utile entre les deux effacements, et il n'était
         écrit nulle part. Celui-ci voyage : il pose une marque d'effacement
         qui gagne par l'horloge, donc les autres appareils liés effacent à
         leur tour. « Tout effacer sur cet appareil », à l'inverse, reste
         local, et les autres appareils renvoient ce qui vient de partir.

         Une personne qui veut retirer une donnée de PARTOUT doit donc passer
         par ici, et non par le bouton qui semble plus radical.
      */}
      <p class="mb-4 max-w-3xl rounded-xl border border-red-300 bg-white/70 p-3 text-sm leading-relaxed text-red-900 dark:border-red-800 dark:bg-slate-900/60 dark:text-red-200">
        <strong>Cet effacement se propage.</strong> Si cet appareil est lié à
        d'autres, ils effaceront les mêmes données à la prochaine
        synchronisation. C'est l'inverse de « Tout effacer sur cet appareil »,
        qui reste local et que les autres appareils défont en vous renvoyant
        leurs données.
      </p>

      <fieldset class="mb-4">
        <legend class="mb-2 text-sm font-medium text-red-900 dark:text-red-200">
          Quoi effacer ?
        </legend>
        <div id="groupes-effacement" class="space-y-2 text-sm"></div>
      </fieldset>

      <fieldset class="mb-4">
        <legend class="mb-2 text-sm font-medium text-red-900 dark:text-red-200">
          Sur quelle période ? (facultatif)
        </legend>
        <div class="flex flex-wrap items-end gap-3 text-sm">
          <label class="block">
            <span class="mb-1 block text-red-800/80 dark:text-red-300/80">Depuis</span>
            <input id="depuis" type="date"
              class="rounded-lg border border-red-300 bg-white px-3 py-2 text-sm dark:border-red-800 dark:bg-slate-950" />
          </label>
          <label class="block">
            <span class="mb-1 block text-red-800/80 dark:text-red-300/80">Jusqu'au</span>
            <input id="jusqua" type="date"
              class="rounded-lg border border-red-300 bg-white px-3 py-2 text-sm dark:border-red-800 dark:bg-slate-950" />
          </label>
        </div>
        <p class="mt-2 max-w-3xl text-xs text-red-800/70 dark:text-red-300/70">
          Sans période, tout le domaine part. Les domaines qui portent un état
          courant plutôt qu'un historique — les flashcards, le niveau estimé, les
          réglages — ne se découpent pas par période : ils seront laissés
          entiers, et le compte le dira.
        </p>
      </fieldset>

      <button id="compter" class="rounded-lg border border-red-300 bg-white px-4 py-2.5 text-sm font-medium text-red-700 transition hover:bg-red-100 dark:border-red-800 dark:bg-transparent dark:text-red-300">
        Compter ce qui partirait
      </button>
      <p id="message-effacement" class="mt-3 hidden text-sm"></p>

      <div id="decompte" class="mt-4 hidden rounded-xl border border-red-300 bg-white p-4 dark:border-red-800 dark:bg-slate-900">
        <p id="decompte-total" class="font-medium text-red-900 dark:text-red-200"></p>
        <ul id="decompte-detail" class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-700 dark:text-slate-300"></ul>
        <p id="decompte-refus" class="mt-3 hidden text-sm text-amber-700 dark:text-amber-300"></p>

        <p class="mt-4 text-sm font-medium text-slate-900 dark:text-white">
          Avant d'effacer, il faut choisir :
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button id="sauver-puis-effacer" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700">
            Sauvegarder d'abord, puis effacer
          </button>
          <button id="effacer-sans" class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-700">
            Effacer sans sauvegarder
          </button>
        </div>
        <label class="mt-3 block text-sm">
          <span class="mb-1 block text-slate-700 dark:text-slate-200">
            Mot de passe du site, pour chiffrer la sauvegarde
          </span>
          <input id="mdp-avant-effacement" type="password" autocomplete="current-password"
            class="w-full max-w-sm rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" />
        </label>
      </div>
    </section>

    <!-- ── Compaction du journal ───────────────────────────────────────── -->
    <section id="compaction" class="rounded-2xl border border-slate-200 bg-white p-5 target:ring-2 target:ring-indigo-400 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Compacter le journal de synchronisation
      </h2>
      <p class="mb-3 max-w-3xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        Une suppression n’est pas une absence : c’est une{' '}
        <strong>pierre tombale</strong> inscrite au journal, sans quoi un
        appareil resté hors ligne ressusciterait à chaque synchronisation ce que
        vous avez effacé ailleurs. Compacter, c’est retirer les faits des objets
        supprimés <em>et</em> leurs pierres tombales, une fois que tous vos
        appareils les ont vus.
      </p>
      <p class="mb-4 max-w-3xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        Jamais l’historique d’une carte vivante. Le résumer voudrait dire
        fabriquer un socle, et deux appareils qui en fabriqueraient chacun un
        pour la même carte ne pourraient plus fusionner du tout — la compaction
        serait alors ce qui sépare vos deux bases, exactement l’inverse de ce
        qu’on lui demande.
      </p>
      <button
        id="prevoir-compaction"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
      >
        Voir ce qui partirait
      </button>
      <div id="apercu-compaction" class="mt-4 hidden text-sm"></div>
      <button
        id="compacter"
        class="mt-3 hidden rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
      >
        Compacter maintenant
      </button>
      <p id="message-compaction" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Pourquoi il n'y a pas de bouton « Compacter » ───────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Pas de compactage, et c’est mesuré
      </h2>
      <p class="max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Une couche de compression ramènerait l’occupation d’environ neuf
        mégaoctets à un et demi. Le gain est réel et il ne sert à rien : il porte
        sur une ressource qui n’est pas rare. Ce qui pesait, c’était le{' '}
        <em>temps</em> — et il a été réglé autrement, en sortant les notes de
        séance de leur enregistrement, ce qui a fait passer le tableau de bord de
        2,25 s à 0,58 s. Un bouton « Compacter » n’aurait donc rien à compacter,
        et les conditions qui feraient revenir sur cette décision sont écrites
        dans la documentation du projet. À ne pas confondre avec le compactage
        du journal, juste au-dessus : celui-ci ne comprime rien, il retire des
        entrées devenues inutiles.
      </p>
    </section>
  </div>
</Base>

<script>
  import { confirmer } from '../lib/boite';
  import { auDeverrouillage } from '../lib/chargement';
  import { lien, notifier } from '../lib/ui';
  import {
    controlerIntegrite,
    demanderPersistance,
    detailStockage,
    lirePersistance,
    occupation,
    type Occupation,
  } from '../lib/stockage';
  import { GROUPES } from '../lib/sauvegarde/groupes';
  import {
    comptesParGroupe,
    exporterGroupeCsv,
    exporterGroupeJson,
    type FichierExporte,
  } from '../lib/sauvegarde/export-lisible';
  import { compter, effacer, type Cible, type Decompte } from '../lib/sauvegarde/effacement';
  import { fabriquer, noterSauvegardeReussie } from '../lib/sauvegarde/service';
  import { instantanes, type Instantane } from '../lib/noyau/instantane';
  import {
    compacter,
    CompactionRefusee,
    prevoirCompaction,
    type Prevision,
  } from '../lib/sync/service';
  import { revenirAvantMigration } from '../lib/db';
  import { redemanderLeMotDePasse, type Redemande } from '../lib/redemande';
  import { offrirLeFichier } from '../lib/telecharger';

  const $ = (id: string) => document.getElementById(id)!;

  /** La même question pour les deux formats : seul le nom du format change. */
  const QUESTION_EXPORT = (format: string): Redemande => ({
    titre: `Exporter en ${format}, en clair`,
    consequence:
      'Le fichier produit n’est pas chiffré : qui l’ouvre lit tout, sans mot de passe. ' +
      'Il reste dans vos téléchargements jusqu’à ce que vous l’en retiriez.',
    action: `Exporter en ${format}`,
    ton: 'sortie',
  });

  const octets = (n: number | null) => {
    if (n === null) return 'inconnu';
    if (n < 1024) return `${n} o`;
    if (n < 1048576) return `${(n / 1024).toFixed(1)} Ko`;
    if (n < 1073741824) return `${(n / 1048576).toFixed(2)} Mo`;
    return `${(n / 1073741824).toFixed(2)} Go`;
  };

  function definition(cible: string, paires: [string, string][]) {
    const e = $(cible);
    e.replaceChildren();
    for (const [clef, valeur] of paires) {
      const dt = document.createElement('dt');
      dt.className = 'text-slate-500 dark:text-slate-400';
      dt.textContent = clef;
      const dd = document.createElement('dd');
      dd.className = 'font-medium text-slate-900 dark:text-white';
      dd.textContent = valeur;
      e.append(dt, dd);
    }
  }

  function peindreOccupation(o: Occupation) {
    definition('occupation', [
      ['Occupé', octets(o.utilise)],
      ['Quota estimé', octets(o.quota)],
      ['Part utilisée', o.part === null ? 'inconnue' : `${(o.part * 100).toFixed(1)} %`],
    ]);

    const alerte = $('alerte-quota');
    if (o.alerte === 'aucune') {
      alerte.classList.add('hidden');
      return;
    }
    const critique = o.alerte === 'critique';
    alerte.className = `mt-4 rounded-xl border p-4 text-sm ${
      critique
        ? 'border-red-300 bg-red-50 text-red-900 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200'
        : 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200'
    }`;
    alerte.textContent = critique
      ? 'Plus de 90 % du quota estimé est occupé. Sauvegardez maintenant, puis effacez ce dont vous n’avez plus besoin : au-delà du quota, le navigateur refuse les écritures, et une écriture refusée se perd.'
      : 'Plus de 70 % du quota estimé est occupé. Rien d’urgent, mais c’est le moment de sauvegarder et de regarder le détail par magasin.';
    alerte.classList.remove('hidden');
  }

  async function peindrePersistance() {
    const p = await lirePersistance();
    const etat = $('etat-persistance');
    const bouton = $('demander-persistance');
    if (!p.disponible) {
      etat.textContent = 'Ce navigateur ne sait pas répondre sur la persistance.';
      etat.className = 'mb-3 text-sm font-medium text-slate-500 dark:text-slate-400';
      bouton.classList.add('hidden');
      return;
    }
    if (p.accorde) {
      etat.textContent = 'Accordé.';
      etat.className = 'mb-3 text-sm font-medium text-emerald-600 dark:text-emerald-400';
      bouton.classList.add('hidden');
      return;
    }
    etat.textContent = 'Non accordé.';
    etat.className = 'mb-3 text-sm font-medium text-amber-600 dark:text-amber-400';
    bouton.classList.remove('hidden');
  }

  function dire(id: string, texte: string, ton: 'succes' | 'echec' | 'neutre') {
    const e = $(id);
    e.textContent = texte;
    e.className = `mt-3 text-sm ${
      ton === 'succes'
        ? 'text-emerald-600 dark:text-emerald-400'
        : ton === 'echec'
          ? 'text-amber-600 dark:text-amber-400'
          : 'text-slate-500 dark:text-slate-400'
    }`;
    e.classList.remove('hidden');
  }

  /* ──────────────────────────────────────────────────────────────────────
     Téléchargement
     ────────────────────────────────────────────────────────────────────── */

  /**
   * Fait partir un fichier.
   *
   * Les navigateurs limitent les téléchargements déclenchés en rafale. Un export
   * CSV d'un groupe en produit plusieurs — un par magasin —, d'où la pause
   * entre deux : sans elle, seul le premier arrive, et rien ne le signale.
   */
  async function telecharger(fichiers: FichierExporte[]) {
    for (const [i, f] of fichiers.entries()) {
      offrirLeFichier(f.contenu, f.nom, f.type);
      if (i < fichiers.length - 1) await new Promise((ok) => setTimeout(ok, 350));
    }
  }

  /* ──────────────────────────────────────────────────────────────────────
     Choix d'un domaine
     ────────────────────────────────────────────────────────────────────── */

  /** Peint une liste de domaines, en boutons radio ou en cases à cocher. */
  function peindreGroupes(cible: string, nom: string, multiple: boolean, comptes: Map<string, number>) {
    const zone = $(cible);
    zone.replaceChildren();
    for (const [i, g] of GROUPES.entries()) {
      const combien = comptes.get(g.id) ?? 0;
      const label = document.createElement('label');
      label.className = 'flex items-start gap-2';
      const entree = document.createElement('input');
      entree.type = multiple ? 'checkbox' : 'radio';
      entree.name = nom;
      entree.value = g.id;
      entree.className = 'mt-1';
      entree.disabled = combien === 0;
      if (!multiple && i === 0) entree.checked = true;
      const texte = document.createElement('span');
      const titre = document.createElement('strong');
      titre.textContent = g.libelle;
      const compte = document.createElement('span');
      compte.className = 'text-slate-500 dark:text-slate-400';
      compte.textContent = ` — ${combien.toLocaleString('fr-FR')} enregistrement(s)`;
      const detail = document.createElement('span');
      detail.className = 'block text-xs text-slate-400';
      detail.textContent = g.description;
      texte.append(titre, compte, detail);
      label.append(entree, texte);
      zone.appendChild(label);
    }
  }

  const choisis = (nom: string) =>
    [...document.querySelectorAll<HTMLInputElement>(`input[name="${nom}"]:checked`)].map(
      (e) => e.value,
    );

  /* ──────────────────────────────────────────────────────────────────────
     Effacement : compter, puis choisir
     ────────────────────────────────────────────────────────────────────── */

  let cibleCourante: Cible | null = null;

  function cibleDesEcrans(): Cible {
    const depuis = ($('depuis') as HTMLInputElement).value || undefined;
    const jusqua = ($('jusqua') as HTMLInputElement).value || undefined;
    return { groupes: choisis('groupe-effacement'), depuis, jusqua };
  }

  function peindreDecompte(d: Decompte) {
    $('decompte-total').textContent =
      d.vises === 0
        ? 'Rien ne serait effacé avec ce choix.'
        : d.vises === 1
          ? 'Un enregistrement serait effacé, définitivement.'
          : `${d.vises.toLocaleString('fr-FR')} enregistrements seraient effacés, définitivement.`;

    const liste = $('decompte-detail');
    liste.replaceChildren();
    for (const m of d.parMagasin.filter((m) => !m.refus)) {
      const li = document.createElement('li');
      li.textContent = `${m.magasin} — ${m.vises.toLocaleString('fr-FR')} sur ${m.total.toLocaleString('fr-FR')}`;
      liste.appendChild(li);
    }

    const refus = $('decompte-refus');
    if (d.refuses.length) {
      /*
         Le motif de chaque magasin, et non une phrase unique pour tous.

         Cette ligne recopiait « ces magasins portent un état courant et non un
         historique », ce qui était vrai de tous les magasins refusés tant que
         c'était la seule raison de refuser. Le journal du suivi personnel en
         ajoute une autre — ses dates sont scellées —, et la phrase recopiée
         devenait fausse à l'écran, dite à la personne au moment où elle
         décide d'effacer. `compter` porte déjà le motif de chacun : il est
         affiché tel quel.
      */
      refus.replaceChildren();
      const titre = document.createElement('p');
      titre.textContent = 'Laissés entiers :';
      refus.appendChild(titre);
      const detail = document.createElement('ul');
      detail.className = 'mt-1 list-disc pl-5';
      for (const m of d.refuses) {
        const li = document.createElement('li');
        li.textContent = `${m.magasin} — ${m.refus ?? 'une période ne le découpe pas'}`;
        detail.appendChild(li);
      }
      refus.appendChild(detail);
      refus.classList.remove('hidden');
    } else {
      refus.classList.add('hidden');
    }

    $('decompte').classList.toggle('hidden', d.vises === 0 && d.refuses.length === 0);
  }

  async function appliquerEffacement(avecSauvegarde: boolean) {
    if (!cibleCourante) return;

    if (avecSauvegarde) {
      const mdp = ($('mdp-avant-effacement') as HTMLInputElement).value;
      if (!mdp) {
        dire('message-effacement', 'Saisissez le mot de passe du site pour chiffrer la sauvegarde.', 'echec');
        return;
      }
      dire('message-effacement', 'Sauvegarde en cours…', 'neutre');
      try {
        const { sauvegarde, nom } = await fabriquer(mdp);
        // La sauvegarde est binaire : elle ne passe pas par « telecharger »,
        // qui met en forme du texte.
        offrirLeFichier(sauvegarde.octets, `avant-effacement-${nom}`);
        ($('mdp-avant-effacement') as HTMLInputElement).value = '';
      } catch (e) {
        dire('message-effacement', `Sauvegarde impossible, rien n’a été effacé : ${(e as Error).message}`, 'echec');
        return;
      }

      /*
         B-5 DU 58 — « SAUVEGARDER D'ABORD » DOIT PASSER PAR LA PREUVE A3.

         Ce chemin demandait le téléchargement, notait aussitôt « sauvegarde
         réussie », puis effaçait. Or le web n'offre aucun moyen de savoir
         qu'un téléchargement a abouti : pas d'événement, pas de promesse,
         pas d'accès au dossier de destination. C'est précisément le constat
         A3 du 43, et l'écran de Progression le respecte déjà en demandant à
         la personne de retrouver le fichier.

         Ici, il ne le demandait pas — et le bouton s'appelle pourtant
         « Sauvegarder d'abord, puis effacer ». Sur un iPhone qui refuse le
         fichier, ou un disque plein, la sauvegarde n'existait pas et
         l'effacement avait lieu quand même. C'est le seul endroit du site
         où une promesse non tenue se paie par une perte sans recours : on
         efface en s'appuyant sur une sauvegarde qui n'est peut-être pas là.

         La preuve est donc demandée AVANT d'effacer, et un « je ne le
         trouve pas » n'efface rien. La date de dernière sauvegarde réussie
         n'est notée qu'à la confirmation, pour la même raison.
      */
      const retrouvee = await confirmer({
        titre: 'Avez-vous retrouvé le fichier de sauvegarde ?',
        texte:
          'Ouvrez vos téléchargements et vérifiez que le fichier y est, avec une taille ' +
          'qui n’est pas nulle. Rien ne sera effacé tant que vous ne l’aurez pas ' +
          'confirmé : un navigateur ne permet pas de savoir si un téléchargement a ' +
          'abouti, et votre réponse est la seule preuve disponible.',
        action: 'Je l’ai retrouvé, effacer',
        annuler: 'Je ne le trouve pas',
        destructrice: true,
      });
      if (!retrouvee) {
        dire(
          'message-effacement',
          'Rien n’a été effacé. La sauvegarde n’étant pas confirmée, Cyclades continue ' +
            'de compter les jours depuis la dernière sauvegarde confirmée. Réessayez, ou ' +
            'effacez sans sauvegarder si c’est bien ce que vous voulez.',
          'neutre',
        );
        return;
      }
      await noterSauvegardeReussie();
    } else if (
      /*
         Effacer sans sauvegarde demande le mot de passe, et non plus un
         « confirm ». Les deux branches sont ainsi à égalité : celle qui
         sauvegarde prouvait déjà la connaissance du mot de passe, puisqu'il
         chiffre la sauvegarde. Celle-ci ne prouvait rien, alors qu'elle est
         la plus définitive des deux.
      */
      !(await redemanderLeMotDePasse({
        titre: 'Effacer sans sauvegarder',
        consequence:
          `${cibleCourante.groupes.length} domaine(s) vont être effacés définitivement, sans ` +
          'aucun fichier pour revenir en arrière. Un effacement est la seule opération du ' +
          'site qui soit sans recours.',
        action: 'Effacer définitivement',
      }))
    ) {
      dire('message-effacement', 'Rien n’a été effacé.', 'neutre');
      return;
    }

    try {
      const r = await effacer(cibleCourante);
      const o = await occupation();
      peindreOccupation(o);
      dire(
        'message-effacement',
        `${r.total.toLocaleString('fr-FR')} enregistrement(s) effacés` +
          (r.refuses.length ? `, ${r.refuses.length} magasin(s) laissés entiers` : '') +
          '.',
        'succes',
      );
      notifier('Effacement terminé', 'info');
      $('decompte').classList.add('hidden');
      cibleCourante = null;
      await rafraichirComptes();
    } catch (e) {
      dire('message-effacement', `Effacement interrompu : ${(e as Error).message}`, 'echec');
    }
  }

  async function rafraichirComptes() {
    const comptes = await comptesParGroupe();
    peindreGroupes('groupes-export', 'groupe-export', false, comptes);
    peindreGroupes('groupes-effacement', 'groupe-effacement', true, comptes);
  }

  /**
   * La section « Dernière migration », cachée quand il n'y a rien à défaire.
   *
   * Elle ne s'ouvre pas d'elle-même et n'alerte pas : une migration réussie est
   * l'issue normale, et interrompre à chaque mise à niveau apprendrait à passer
   * outre l'avertissement du jour où il compte.
   */
  let instantaneCourant: Instantane | null = null;

  async function peindreMigration() {
    const liste = await instantanes();
    instantaneCourant = liste[0] ?? null;
    if (!instantaneCourant) return;

    const i = instantaneCourant;
    const lignes: [string, string][] = [
      ['Prise le', new Date(i.le).toLocaleString('fr-FR')],
      ['Version d’avant', String(i.deVersion)],
      ['Version actuelle', String(i.versVersion)],
      ['Taille', `${(i.octets / 1024 / 1024).toFixed(2)} Mio`],
    ];
    $('migration-detail').innerHTML = lignes
      .map(
        ([terme, valeur]) =>
          `<div><dt class="text-slate-500 dark:text-slate-400">${terme}</dt>` +
          `<dd class="font-medium text-slate-900 dark:text-white">${valeur}</dd></div>`,
      )
      .join('');
    $('migration').classList.remove('hidden');

    $('revenir-migration').addEventListener('click', async () => {
      const combien = Object.values(i.magasins).reduce((somme, m) => somme + m.length, 0);
      const confirme = await confirmer({
        titre: `Revenir à l’instantané du ${new Date(i.le).toLocaleString('fr-FR')} ?`,
        texte:
          `La base repassera en version ${i.deVersion} avec ses ${combien} ` +
          'enregistrements d’alors. Tout ce qui a été saisi depuis sera perdu, ' +
          'et cette opération ne s’annule pas.',
        action: 'Revenir à l’instantané',
        destructrice: true,
      });
      if (!confirme) return;
      const bouton = $('revenir-migration') as HTMLButtonElement;
      bouton.disabled = true;
      try {
        await revenirAvantMigration(i);
        dire(
          'message-migration',
          'Base revenue à l’instantané. Rechargez la page : l’application va de ' +
            'nouveau proposer la migration.',
          'succes',
        );
      } catch (erreur) {
        bouton.disabled = false;
        dire(
          'message-migration',
          `Le retour arrière a échoué : ${erreur instanceof Error ? erreur.message : erreur}. ` +
            'La base n’a pas été remplacée.',
          'echec',
        );
      }
    });
  }

  auDeverrouillage(async () => {
    $('lien-sauvegarde').setAttribute('href', `${lien('/progression/')}#sauvegarde`);

    const o = await occupation();
    peindreOccupation(o);
    await peindrePersistance();

    $('chargement').classList.add('hidden');
    $('stockage').classList.remove('hidden');

    await peindreMigration();

    $('demander-persistance').addEventListener('click', async () => {
      const accorde = await demanderPersistance();
      await peindrePersistance();
      dire(
        'message-persistance',
        accorde
          ? 'Accordé. Le navigateur n’effacera plus ces données de lui-même pour faire de la place.'
          : 'Refusé. C’est un cas ordinaire : les navigateurs accordent cette permission sur des critères qu’ils ne détaillent pas, et un refus n’empêche rien de fonctionner. La sauvegarde reste la vraie protection.',
        accorde ? 'succes' : 'neutre',
      );
    });

    $('peser').addEventListener('click', async () => {
      const bouton = $('peser') as HTMLButtonElement;
      bouton.disabled = true;
      bouton.textContent = 'Lecture en cours…';
      try {
        const d = await detailStockage(o.utilise);
        const corps = $('detail-lignes');
        corps.replaceChildren();
        for (const m of d.magasins) {
          const tr = document.createElement('tr');
          const nom = document.createElement('td');
          nom.className = 'py-2 pr-4 font-medium text-slate-900 dark:text-white';
          nom.textContent = m.nom;
          const n = document.createElement('td');
          n.className = 'py-2 pr-4 text-right tabular-nums text-slate-600 dark:text-slate-300';
          n.textContent = m.enregistrements.toLocaleString('fr-FR');
          const taille = document.createElement('td');
          taille.className = 'py-2 text-right tabular-nums text-slate-600 dark:text-slate-300';
          taille.textContent = octets(m.serialise);
          tr.append(nom, n, taille);
          corps.appendChild(tr);
        }
        $('detail-rapport').textContent =
          `${d.enregistrementsTotal.toLocaleString('fr-FR')} enregistrements, ` +
          `${octets(d.serialiseTotal)} de données` +
          (d.rapportReel !== null
            ? ` — soit ${d.rapportReel.toFixed(2)}× sur le disque. Moins de 1 : votre navigateur comprime les valeurs d’IndexedDB de lui-même.`
            : '.');
        $('detail').classList.remove('hidden');
      } finally {
        bouton.disabled = false;
        bouton.textContent = 'Peser les magasins';
      }
    });

    await rafraichirComptes();

    $('exporter-csv').addEventListener('click', async () => {
      const [id] = choisis('groupe-export');
      if (!id) return;
      /*
         Un export en clair écrit sur le disque, sans chiffrement et sans mot
         de passe, ce que tout le reste du site passe son temps à chiffrer.
         Il mérite donc la même redemande qu'un effacement : ce n'est pas la
         maladresse qu'on craint ici, c'est l'ordinateur déverrouillé prêté
         deux minutes avec le site déjà ouvert.
      */
      if (!(await redemanderLeMotDePasse(QUESTION_EXPORT('CSV')))) {
        dire('message-export', 'Rien n’a été exporté.', 'neutre');
        return;
      }
      dire('message-export', 'Lecture et mise en forme…', 'neutre');
      try {
        const fichiers = await exporterGroupeCsv(id);
        if (!fichiers.length) {
          dire('message-export', 'Ce domaine est vide : aucun fichier à produire.', 'neutre');
          return;
        }
        await telecharger(fichiers);
        dire(
          'message-export',
          `${fichiers.length} fichier(s) téléchargés, ` +
            `${fichiers.reduce((s, f) => s + f.enregistrements, 0).toLocaleString('fr-FR')} enregistrement(s). ` +
            'Rappel : ces fichiers ne se réimportent pas.',
          'succes',
        );
      } catch (e) {
        dire('message-export', `Export impossible : ${(e as Error).message}`, 'echec');
      }
    });

    $('exporter-json').addEventListener('click', async () => {
      const [id] = choisis('groupe-export');
      if (!id) return;
      if (!(await redemanderLeMotDePasse(QUESTION_EXPORT('JSON')))) {
        dire('message-export', 'Rien n’a été exporté.', 'neutre');
        return;
      }
      dire('message-export', 'Lecture et mise en forme…', 'neutre');
      try {
        const fichier = await exporterGroupeJson(id);
        await telecharger([fichier]);
        dire(
          'message-export',
          `${fichier.nom} téléchargé, ${fichier.enregistrements.toLocaleString('fr-FR')} enregistrement(s). ` +
            'Rappel : ce fichier ne se réimporte pas.',
          'succes',
        );
      } catch (e) {
        dire('message-export', `Export impossible : ${(e as Error).message}`, 'echec');
      }
    });

    $('compter').addEventListener('click', async () => {
      const cible = cibleDesEcrans();
      if (!cible.groupes.length) {
        dire('message-effacement', 'Choisissez au moins un domaine.', 'echec');
        $('decompte').classList.add('hidden');
        return;
      }
      if (cible.depuis && cible.jusqua && cible.depuis > cible.jusqua) {
        dire('message-effacement', 'La période est à l’envers : « depuis » est après « jusqu’au ».', 'echec');
        $('decompte').classList.add('hidden');
        return;
      }
      dire('message-effacement', 'Comptage… rien n’est touché.', 'neutre');
      const d = await compter(cible);
      cibleCourante = cible;
      peindreDecompte(d);
      dire('message-effacement', 'Compté. Rien n’a été effacé.', 'neutre');
    });

    $('sauver-puis-effacer').addEventListener('click', () => void appliquerEffacement(true));
    $('effacer-sans').addEventListener('click', () => void appliquerEffacement(false));

    /* ── Compaction du journal ─────────────────────────────────────── */

    function peindrePrevision(prevision: Prevision) {
      const zone = $('apercu-compaction');
      zone.replaceChildren();
      const bouton = $('compacter') as HTMLButtonElement;
      bouton.classList.add('hidden');

      if (!prevision.borne.possible) {
        const p = document.createElement('p');
        p.className = 'text-amber-700 dark:text-amber-300';
        const noms = prevision.borne.attendus.map((n) => `« ${n} »`).join(', ');
        p.textContent =
          `${noms} n’${prevision.borne.attendus.length > 1 ? 'ont' : 'a'} encore accusé ` +
          'réception de rien. Tant qu’un appareil n’a pas vu une suppression, l’effacer ' +
          'd’ici la ferait revenir de là-bas. Synchronisez-le une fois, puis revenez.';
        const quoi = document.createElement('p');
        quoi.className = 'mt-2 text-slate-600 dark:text-slate-300';
        quoi.textContent = prevision.supprimees
          ? `${prevision.supprimees} objet(s) supprimé(s) attendent dans le journal.`
          : 'Rien n’attend dans le journal : aucun objet supprimé.';
        const vers = document.createElement('a');
        vers.href = lien('/appareils/');
        vers.className =
          'mt-2 inline-block font-medium text-indigo-600 underline dark:text-indigo-400';
        vers.textContent = 'Voir mes appareils';
        zone.append(p, quoi, vers);
        zone.classList.remove('hidden');
        return;
      }

      const plan = prevision.plan!;
      const intro = document.createElement('p');
      if (!plan.cibles.length) {
        intro.className = 'text-emerald-600 dark:text-emerald-400';
        intro.textContent =
          prevision.supprimees === 0
            ? 'Rien à compacter : aucun objet supprimé dans le journal.'
            : 'Rien à compacter pour l’instant : les suppressions connues sont plus ' +
              'récentes que ce que tous vos appareils ont vu.';
        zone.append(intro);
      } else {
        intro.className = 'text-slate-700 dark:text-slate-200';
        intro.textContent =
          `${plan.cibles.length} objet(s) supprimé(s) seraient effacés du journal, ` +
          `soit ${plan.operations.length} opération(s) — dont ${plan.pierresTombales} ` +
          `pierre(s) tombale(s) — et ${plan.revisions.length} entrée(s) de journal de ` +
          'révision.';
        const liste = document.createElement('ul');
        liste.className = 'mt-2 list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-300';
        for (const texte of [
          prevision.borne.seul
            ? 'Cet appareil est seul au registre : rien à attendre de personne.'
            : 'Borné à ce que tous vos appareils ont accusé détenir.',
          plan.reportees.length
            ? `${plan.reportees.length} objet(s) supprimé(s) sont reportés : une de leurs ` +
              'entrées est plus récente que cette borne.'
            : 'Aucun objet reporté.',
          'Aucun historique de carte vivante n’est touché.',
        ]) {
          const li = document.createElement('li');
          li.textContent = texte;
          liste.appendChild(li);
        }
        zone.append(intro, liste);
        bouton.classList.remove('hidden');
      }
      zone.classList.remove('hidden');
    }

    $('prevoir-compaction').addEventListener('click', async () => {
      const bouton = $('prevoir-compaction') as HTMLButtonElement;
      bouton.disabled = true;
      $('message-compaction').classList.add('hidden');
      try {
        peindrePrevision(await prevoirCompaction());
      } finally {
        bouton.disabled = false;
      }
    });

    $('compacter').addEventListener('click', async () => {
      const bouton = $('compacter') as HTMLButtonElement;
      const message = $('message-compaction');
      bouton.disabled = true;
      try {
        const rapport = await compacter();
        message.className = 'mt-3 text-sm text-emerald-600 dark:text-emerald-400';
        message.textContent =
          `Journal compacté : ${rapport.operations} opération(s) et ` +
          `${rapport.revisions} entrée(s) de révision retirées, pour ` +
          `${rapport.cibles} objet(s) supprimé(s). Empreinte : ${rapport.empreinte.slice(0, 16)}.`;
        message.classList.remove('hidden');
        // Repeindre avant d'annoncer la suite : l'aperçu affiché était celui
        // d'avant, et le laisser ferait croire qu'il reste autant à faire.
        peindrePrevision(await prevoirCompaction());
        peindreOccupation(await occupation());
        notifier('Journal compacté', 'succes');
      } catch (erreur) {
        message.className = 'mt-3 text-sm text-amber-700 dark:text-amber-300';
        message.textContent =
          erreur instanceof CompactionRefusee
            ? erreur.message
            : `Le compactage a échoué : ${erreur instanceof Error ? erreur.message : erreur}.`;
        message.classList.remove('hidden');
      } finally {
        bouton.disabled = false;
      }
    });

    $('controler').addEventListener('click', async () => {
      const bouton = $('controler') as HTMLButtonElement;
      bouton.disabled = true;
      try {
        const anomalies = await controlerIntegrite();
        const zone = $('integrite');
        zone.replaceChildren();
        if (!anomalies.length) {
          const p = document.createElement('p');
          p.className = 'text-emerald-600 dark:text-emerald-400';
          p.textContent = 'Aucune anomalie : tous les liens attendus sont en place.';
          zone.appendChild(p);
        } else {
          const liste = document.createElement('ul');
          liste.className = 'list-disc space-y-1 pl-5 text-amber-700 dark:text-amber-300';
          for (const a of anomalies) {
            const li = document.createElement('li');
            li.textContent = `${a.magasin} — ${a.quoi} (${a.combien}).`;
            liste.appendChild(li);
          }
          const intro = document.createElement('p');
          intro.className = 'mb-2 text-slate-600 dark:text-slate-300';
          intro.textContent =
            'Signalé, pas réparé. Aucune de ces anomalies n’empêche le site de fonctionner ; elles viennent le plus souvent d’un contenu renommé ou d’une restauration partielle.';
          zone.append(intro, liste);
        }
        zone.classList.remove('hidden');
        notifier('Contrôle d’intégrité terminé', 'info');
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>
