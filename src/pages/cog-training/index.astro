---
/**
 * Accueil de la rubrique Cog-Training : trois exercices distincts.
 *
 * Les exercices ne contiennent aucune donnée du concours et ne sont donc pas
 * chiffrés, mais ils restent derrière l'écran de connexion comme le reste.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';

/*
   LE FRANÇAIS EN TITRE, L'ANGLAIS EN PETIT DESSOUS (décision 3).

   L'inverse était en place : la carte s'intitulait « Quad N-Back » et le
   français n'était qu'une étiquette de catégorie au-dessus. Quelqu'un qui
   arrive lit donc d'abord trois noms anglais, dont aucun ne dit ce que
   l'exercice demande. Le nom anglais reste — il sert à retrouver l'exercice
   ailleurs —, mais il passe sous le nom français et en plus discret.

   « Utile pour » est remplacé par « Ce que l'exercice fait travailler »
   (décision 7) : une description neutre, sans promesse. Les anciennes lignes
   annonçaient un transfert — « tenir une note de synthèse », « repérer un
   sophisme » — que rien ne source, et que deux d'entre elles démentaient
   elles-mêmes par un « sans garantie de transfert » ajouté après coup.

   La ligne « Durée et matériel » est calculée sur les réglages réels là où
   c'est possible, et non recopiée : voir `duree` plus bas.
*/
const exercices = [
  {
    id: 'quad-n-back',
    icone: 'memoire',
    titre: 'Mémoire de travail',
    anglais: 'Quad N-Back',
    description:
      'Quatre flux de stimuli défilent en parallèle — position, couleur, forme et son. ' +
      'Signalez à chaque épreuve les dimensions identiques à celles vues quelques épreuves plus tôt.',
    travaille:
      'retenir plusieurs informations à la fois et les mettre à jour à chaque tour.',
    duree: '1 à 3 minutes · son conseillé',
    href: 'quad-n-back/',
  },
  {
    id: 'relational-reasoning',
    icone: 'raisonnement',
    titre: 'Raisonnement relationnel',
    anglais: 'Relational Reasoning',
    description:
      'Un réseau de relations vous est montré sans que la règle qui le régit ' +
      'soit nommée : à vous de la trouver, puis de l\'appliquer. Dix systèmes, ' +
      'de l\'ordre sur une ligne aux relations topologiques et temporelles.',
    travaille: 'trouver la règle qui relie des faits, puis l\'appliquer à de nouveaux cas.',
    duree: 'environ 10 minutes · sans son',
    href: 'relational-reasoning/',
  },
  {
    id: 'veridical-mapping',
    icone: 'echelles',
    titre: 'Correspondance perceptive',
    anglais: 'Veridical Mapping',
    description:
      'Deux dimensions perceptives en vis-à-vis — une taille et une intensité sonore, ' +
      'une position et une teinte. Il s\'agit d\'en établir la correspondance, de plus en ' +
      'plus finement, jusqu\'au plus petit écart que vous distinguez encore.',
    travaille: 'comparer des intensités d\'un sens à l\'autre, de plus en plus finement.',
    duree: '5 à 10 minutes · son nécessaire',
    href: 'veridical-mapping/',
  },
] as const;
---

{/*
   « Tableau de bord » et non « Accueil » : c'est le nom que `branches.ts`
   donne à cet onglet, comme aux accueils des trois autres branches, et la
   règle N5 veut qu'un écran porte le même nom partout. Une branche du train
   avait mis « Accueil » ici sans toucher au registre, et
   `essais:navigation:navigateur` l'a dit. Si le renommage était voulu, il
   part du registre — et alors il vaut pour les quatre branches.
*/}
<Base titre="Tableau de bord" actif="accueil">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Entraînement cognitif</h1>
    <p class="mt-1 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
      Trois exercices d'entraînement, indépendants du programme du concours : tenir plusieurs
      informations en mémoire, inférer une règle relationnelle qu'aucun énoncé ne nomme, et mettre
      deux échelles perceptives en correspondance. Ils ne mesurent rien de clinique et ne
      diagnostiquent personne, et rien ne garantit que s'y entraîner améliore quoi que ce soit
      au-delà de la tâche elle-même.
    </p>
  </header>

  <div id="chargement" class="py-20 text-center text-slate-400">Chargement…</div>

  <!--
    PAR OÙ COMMENCER (décision 5), au-dessus des cartes et non dans le chapeau.

    L'accueil présentait trois exercices sans dire lequel prendre, et les trois
    descriptions sont du même niveau de technicité : rien ne distinguait celui
    qui se comprend sans chronomètre. La phrase le dit, et dit POURQUOI —
    « pas de chronomètre, et chaque réponse est expliquée » — plutôt que de
    recommander sans motif.
  -->
  <p
    id="par-ou-commencer"
    class="mb-4 hidden rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"
  >
    Nouveau ? Commencez par <strong>Raisonnement relationnel</strong> : pas de
    chronomètre, et chaque réponse est expliquée.
  </p>

  <div id="exercices" class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      exercices.map((exercice) => (
        <a
          href={exercice.href}
          data-exercice={exercice.id}
          class="group flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-300 hover:shadow dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-700"
        >
          {/* Étiquette de catégorie au-dessus du titre, puis le titre : c'est
              la convention de carte de service-public.gouv.fr. */}
          <div class="flex items-start gap-3">
            <Icone nom={exercice.icone} taille={28} class="mt-0.5" />
            <div class="min-w-0">
              <h2 class="font-semibold text-slate-900 dark:text-white">{exercice.titre}</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400">{exercice.anglais}</p>
            </div>
          </div>

          <p class="mt-3 flex-1 text-sm text-slate-600 dark:text-slate-300">
            {exercice.description}
          </p>

          <p class="mt-3 border-t border-slate-100 pt-3 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
            <span class="font-medium">Ce que l'exercice fait travailler</span> : {exercice.travaille}
          </p>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="font-medium">Durée et matériel</span> : {exercice.duree}
          </p>

          <!--
            « OUVRIR L'EXERCICE », ET NON « COMMENCER ».

            Ce lien ne lance rien : il mène à l'écran de réglages, où se trouve
            le vrai bouton « Commencer ». Les appeler tous deux « Commencer »
            est précisément le défaut que le constat C3 relève — un même mot
            pour deux choses —, et le prompt demande UN SEUL bouton de
            lancement portant ce nom.
          -->
          <span class="mt-3 text-sm font-medium text-indigo-600 group-hover:underline dark:text-indigo-400">
            Ouvrir l'exercice →
          </span>
        </a>
      ))
    }
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { lien } from '../../lib/ui';

  // Les liens sont réécrits avec le chemin de base du site, comme ailleurs.
  for (const carte of document.querySelectorAll<HTMLAnchorElement>('[data-exercice]')) {
    carte.href = lien(`/cog-training/${carte.dataset.exercice}/`);
  }

  auDeverrouillage(() => {
    document.getElementById('chargement')!.classList.add('hidden');
    document.getElementById('par-ou-commencer')!.classList.remove('hidden');
    document.getElementById('exercices')!.classList.remove('hidden');
  });
</script>
