---
import Base from '../layouts/Base.astro';
---

<Base titre="Prétest de positionnement" actif="positionnement">
  <h1 class="mb-1 text-2xl font-bold text-slate-900 dark:text-white">Prétest de positionnement</h1>
  <p class="mb-5 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
    Quelques questions tirées des viviers d'un fascicule, <strong>avant</strong> d'en lire les
    cours. Elles servent à estimer un niveau d'entrée, puis à situer chaque cours par rapport à
    votre <strong>zone proximale de développement</strong> — ni ce que vous savez déjà, ni ce qui
    est hors de portée, mais ce qui s'apprend le mieux maintenant. Rien n'est compté comme une
    erreur, rien n'entre au journal, rien ne touche vos échéances de révision.
  </p>

  <div id="chargement" class="py-20 text-center text-slate-400">Lecture du contenu…</div>

  <!-- ── Choix du périmètre ─────────────────────────────────────────────── -->
  <section
    id="choix"
    class="mb-5 hidden rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Quel fascicule ?</h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      Seuls les fascicules qui comptent encore des fiches non lues dotées d'un vivier sont
      proposés : une fiche déjà lue mesurerait une mémoire, pas un niveau d'entrée.
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <select
        id="perimetre"
        class="min-h-11 w-full max-w-xl rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-900"
      ></select>
      <button
        id="lancer"
        class="min-h-11 rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
      >
        Commencer
      </button>
    </div>
    <p id="aucun-perimetre" class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400"></p>
  </section>

  <!-- ── Questionnaire, puis bilan : remplis côté client ────────────────── -->
  <div id="questionnaire" class="hidden"></div>
  <div id="bilan" class="hidden"></div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import { chargerManifeste, type Manifeste, type QuestionQuiz } from '../lib/contenu';
  import { tousLesEtatsFiches } from '../lib/db';
  import { lireReglagesContenu, type ReponsePretest } from '../lib/niveau';
  import {
    FICHES_MINIMALES,
    LIBELLES_SITUATION,
    QUESTIONS_MINIMALES,
    composer,
    conclure,
    memoriserQuestionnaire,
    perimetres,
    type Bilan,
    type FicheOrientee,
    type QuestionPositionnement,
    type Perimetre,
  } from '../lib/positionnement';
  import { justesse } from '../lib/pretest';
  import { lien, parametreUrl, pluriel } from '../lib/ui';

  const $ = (id: string) => document.getElementById(id)!;

  const CLASSE_OPTION =
    'flex w-full items-start gap-2 rounded-lg border border-slate-300 px-3 py-2 text-left text-sm ' +
    'transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800';
  const CLASSE_CHOISIE =
    'flex w-full items-start gap-2 rounded-lg border border-indigo-500 bg-indigo-50 px-3 py-2 ' +
    'text-left text-sm dark:border-indigo-400 dark:bg-indigo-950/50';

  let manifeste: Manifeste;
  let liste: Perimetre[] = [];

  /** Clé d'option du menu : les deux noms, séparés par un caractère interdit. */
  const clef = (p: Pick<Perimetre, 'matiere' | 'fascicule'>) => `${p.matiere}\u0000${p.fascicule}`;

  /* ── Choix du périmètre ─────────────────────────────────────────────── */

  function peindreChoix() {
    const menu = $('perimetre') as HTMLSelectElement;
    menu.innerHTML = '';
    for (const p of liste) {
      const option = document.createElement('option');
      option.value = clef(p);
      option.textContent =
        `${p.matiere} — ${p.fascicule} · ` +
        `${pluriel(p.eligibles, 'fiche interrogeable', 'fiches interrogeables')}`;
      menu.appendChild(option);
    }

    if (!liste.length) {
      menu.classList.add('hidden');
      ($('lancer') as HTMLButtonElement).disabled = true;
      $('aucun-perimetre').textContent =
        `Aucun fascicule ne peut être positionné : il en faut au moins ${FICHES_MINIMALES} ` +
        'fiches non lues dotées d’un vivier de prétest, et il n’en reste nulle part. Le niveau ' +
        'acquis se lit alors sur la page Statistiques, et les quiz le mettent à jour.';
      $('aucun-perimetre').classList.remove('hidden');
      return;
    }

    // Un lien venu d'un prétest de fiche désigne déjà son fascicule.
    const voulu = { matiere: parametreUrl('matiere') ?? '', fascicule: parametreUrl('fascicule') ?? '' };
    if (voulu.matiere && liste.some((p) => clef(p) === clef(voulu))) menu.value = clef(voulu);
  }

  /* ── Questionnaire ──────────────────────────────────────────────────── */

  async function lancer() {
    const [matiere, fascicule] = ($('perimetre') as HTMLSelectElement).value.split('\u0000');
    const bouton = $('lancer') as HTMLButtonElement;
    bouton.disabled = true;
    bouton.textContent = 'Préparation…';
    const etats = await tousLesEtatsFiches();
    const questions = await composer(
      manifeste,
      matiere,
      fascicule,
      etats,
      await lireReglagesContenu(),
    );
    bouton.disabled = false;
    bouton.textContent = 'Commencer';

    if (questions.length < QUESTIONS_MINIMALES) {
      $('aucun-perimetre').textContent =
        `Il ne reste que ${pluriel(questions.length, 'question inédite', 'questions inédites')} ` +
        `dans ce fascicule, et il en faut au moins ${QUESTIONS_MINIMALES} pour en tirer une ` +
        'orientation qui vaille mieux que l’ordre du cours.';
      $('aucun-perimetre').classList.remove('hidden');
      return;
    }
    $('aucun-perimetre').classList.add('hidden');
    $('choix').classList.add('hidden');
    poserQuestions(questions, matiere, fascicule);
    // Après l'affichage, et seulement là : voir memoriserQuestionnaire.
    await memoriserQuestionnaire(questions);
  }

  function poserQuestions(
    questions: QuestionPositionnement[],
    matiere: string,
    fascicule: string,
  ) {
    const choix = questions.map(() => new Set<number>());
    const hote = $('questionnaire');
    hote.innerHTML = '';
    hote.classList.remove('hidden');

    const panneau = document.createElement('section');
    panneau.className =
      'rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 sm:p-6 dark:border-indigo-900 dark:bg-indigo-950/30';
    const titre = document.createElement('h2');
    titre.className = 'text-lg font-bold text-slate-900 dark:text-white';
    titre.textContent = `${matiere} — ${fascicule}`;
    const intro = document.createElement('p');
    intro.className = 'mt-1 text-sm text-slate-600 dark:text-slate-300';
    intro.textContent =
      `${pluriel(questions.length, 'question', 'questions')} tirées de fiches que vous n’avez ` +
      'pas encore lues. Ne cochez rien plutôt que de deviner au hasard : une question laissée ' +
      'vide n’est pas comptée comme un échec, tandis qu’un coup de chance fausserait ' +
      'l’orientation.';
    panneau.append(titre, intro);

    const corps = document.createElement('div');
    corps.className = 'mt-4 space-y-5';
    panneau.appendChild(corps);

    questions.forEach((question, i) => {
      const bloc = document.createElement('div');
      const enonce = document.createElement('p');
      enonce.className = 'font-medium text-slate-900 dark:text-slate-100';
      enonce.textContent = `${i + 1}. ${question.question}`;
      const multiple = question.bonnes.length > 1;
      const aide = document.createElement('p');
      aide.className = 'mt-0.5 text-xs text-slate-500 dark:text-slate-400';
      aide.textContent = multiple ? 'Plusieurs réponses possibles.' : 'Une seule réponse.';
      const options = document.createElement('div');
      options.className = 'mt-2 space-y-1.5';

      question.options.forEach((option, j) => {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className = CLASSE_OPTION;
        bouton.textContent = option;
        bouton.addEventListener('click', () => {
          if (multiple) {
            if (choix[i].has(j)) choix[i].delete(j);
            else choix[i].add(j);
          } else {
            choix[i].clear();
            choix[i].add(j);
          }
          [...options.children].forEach((enfant, k) => {
            (enfant as HTMLElement).className = choix[i].has(k) ? CLASSE_CHOISIE : CLASSE_OPTION;
          });
        });
        options.appendChild(bouton);
      });

      bloc.append(enonce, aide, options);
      corps.appendChild(bloc);
    });

    const valider = document.createElement('button');
    valider.type = 'button';
    valider.className =
      'mt-5 min-h-11 rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition ' +
      'hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200';
    valider.textContent = 'Valider et me situer';
    valider.addEventListener('click', () => {
      valider.disabled = true;
      valider.textContent = 'Calcul…';
      const reponses: ReponsePretest[] = questions
        .map((question, i) => ({ question, choisies: choix[i] as ReadonlySet<number> }))
        .filter(({ choisies }) => choisies.size > 0)
        .map(({ question, choisies }) => ({
          itemId: question.id,
          resultat: justesse(question, choisies),
          matiere: question.matiere,
          fascicule: question.fascicule,
          ficheId: question.ficheId,
          ficheTitre: question.ficheTitre,
        }));
      void conclure(reponses, manifeste, matiere, fascicule).then((bilan) => {
        corriger(questions, choix, corps);
        valider.remove();
        peindreBilan(bilan, matiere, fascicule);
      });
    });
    panneau.appendChild(valider);
    hote.appendChild(panneau);
    panneau.scrollIntoView({ block: 'nearest' });
  }

  /** Affiche la correction : c'est elle qui produit l'effet de prétest. */
  function corriger(
    questions: readonly QuestionQuiz[],
    choix: readonly Set<number>[],
    corps: HTMLElement,
  ) {
    questions.forEach((question, i) => {
      const options = corps.children[i].querySelector('div:last-child')!;
      [...options.children].forEach((enfant, j) => {
        const bouton = enfant as HTMLButtonElement;
        bouton.disabled = true;
        const bonne = question.bonnes.includes(j);
        const cochee = choix[i].has(j);
        bouton.className =
          'flex w-full items-start gap-2 rounded-lg border px-3 py-2 text-left text-sm ' +
          (bonne
            ? 'border-emerald-500 bg-emerald-50 text-emerald-900 dark:border-emerald-500 dark:bg-emerald-950/50 dark:text-emerald-200'
            : cochee
              ? 'border-slate-400 bg-slate-100 text-slate-600 line-through dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400'
              : 'border-slate-200 text-slate-500 dark:border-slate-800 dark:text-slate-400');
      });
      if (question.explication) {
        const note = document.createElement('p');
        note.className = 'mt-2 text-sm text-slate-600 dark:text-slate-300';
        note.textContent = question.explication;
        corps.children[i].appendChild(note);
      }
    });
  }

  /* ── Bilan et orientation ───────────────────────────────────────────── */

  function carteFiche(fiche: FicheOrientee): HTMLElement {
    const ligne = document.createElement('a');
    ligne.href = `${lien('/fiche/')}?id=${encodeURIComponent(fiche.id)}`;
    ligne.className =
      'block rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:border-indigo-400 ' +
      'dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-600';
    const titre = document.createElement('p');
    titre.className = 'text-sm font-medium text-slate-900 dark:text-slate-100';
    titre.textContent = `${fiche.ordre}. ${fiche.titre}`;
    const detail = document.createElement('p');
    detail.className = 'mt-0.5 text-xs text-slate-500 dark:text-slate-400';
    const morceaux: string[] = [];
    if (fiche.chance !== null) morceaux.push(`réussite prédite ${Math.round(fiche.chance * 100)} %`);
    if (fiche.interrogee && fiche.justesse !== null) {
      morceaux.push(
        fiche.justesse >= 1
          ? 'question du prétest réussie'
          : fiche.justesse > 0
            ? 'question du prétest à moitié réussie'
            : 'question du prétest manquée',
      );
    }
    detail.textContent = morceaux.join(' · ');
    ligne.append(titre);
    if (morceaux.length) ligne.append(detail);
    return ligne;
  }

  function peindreBilan(bilan: Bilan, matiere: string, fascicule: string) {
    const hote = $('bilan');
    hote.innerHTML = '';
    hote.classList.remove('hidden');

    // ── L'estimation ──
    const tete = document.createElement('section');
    tete.className =
      'mb-5 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900';
    const h2 = document.createElement('h2');
    h2.className = 'text-lg font-semibold text-slate-900 dark:text-white';
    h2.textContent = 'Votre niveau d’entrée';
    const chiffre = document.createElement('p');
    chiffre.className = 'mt-1 text-2xl font-bold text-slate-900 dark:text-white';
    const commentaire = document.createElement('p');
    commentaire.className = 'mt-1 max-w-3xl text-sm text-slate-500 dark:text-slate-400';

    if (!bilan.entree) {
      chiffre.textContent = 'non estimé';
      commentaire.textContent =
        'Aucune question n’a été comptée : soit rien n’a été coché, soit ce contenu est écarté ' +
        'de l’estimation par vos réglages (cas pratique, méthodologie).';
    } else if (bilan.entree.fiable) {
      chiffre.textContent = String(bilan.entree.note);
      commentaire.textContent =
        `Estimé sur ${pluriel(bilan.entree.observations, 'question', 'questions')} posées avant ` +
        `lecture, dont ${bilan.observations} à l’instant. Cette note ne compte pas dans votre ` +
        'niveau acquis : elle ne sert qu’à situer les cours ci-dessous. La réussite d’ensemble ' +
        `de ce prétest est de ${Math.round((bilan.justesse ?? 0) * 100)} %, ce qui est normal ` +
        'et attendu avant d’avoir lu quoi que ce soit.';
    } else {
      chiffre.textContent = `${bilan.entree.note} (indicatif)`;
      commentaire.textContent =
        `Seulement ${pluriel(bilan.entree.observations, 'question', 'questions')} posées avant ` +
        'lecture sur ce fascicule. Le chiffre est affiché pour mémoire, mais un second ' +
        'positionnement, ou les prétests des fiches elles-mêmes, l’affermiront.';
    }
    tete.append(h2, chiffre, commentaire);
    hote.appendChild(tete);

    // ── L'orientation, groupe par groupe ──
    for (const groupe of LIBELLES_SITUATION) {
      const fiches = bilan.fiches.filter((f) => f.situation === groupe.situation);
      if (!fiches.length) continue;
      const section = document.createElement('section');
      section.className = 'mb-5';
      const titre = document.createElement('h2');
      titre.className = 'text-base font-semibold text-slate-900 dark:text-white';
      titre.textContent = `${groupe.titre} · ${fiches.length}`;
      const explication = document.createElement('p');
      explication.className = 'mb-2 mt-0.5 max-w-3xl text-sm text-slate-500 dark:text-slate-400';
      explication.textContent = groupe.explication;
      const grille = document.createElement('div');
      grille.className = 'grid gap-2 sm:grid-cols-2';
      for (const fiche of fiches) grille.appendChild(carteFiche(fiche));
      section.append(titre, explication, grille);
      hote.appendChild(section);
    }

    // ── Recommencer ──
    const pied = document.createElement('p');
    pied.className = 'mt-6 text-sm';
    const relancer = document.createElement('a');
    relancer.className = 'font-medium text-indigo-600 hover:underline dark:text-indigo-400';
    relancer.href =
      `${lien('/positionnement/')}?matiere=${encodeURIComponent(matiere)}` +
      `&fascicule=${encodeURIComponent(fascicule)}`;
    relancer.textContent = 'Positionner un autre fascicule →';
    pied.appendChild(relancer);
    hote.appendChild(pied);

    hote.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  async function initialiser() {
    manifeste = await chargerManifeste();
    liste = perimetres(manifeste, await tousLesEtatsFiches(), await lireReglagesContenu());
    peindreChoix();
    $('lancer').addEventListener('click', () => void lancer());
    $('chargement').classList.add('hidden');
    $('choix').classList.remove('hidden');
  }

  auDeverrouillage(initialiser);
</script>
