---
/**
 * Page « Appareils et synchronisation ».
 *
 * Phase 3a : le **transport manuel**, et lui seul. Le plan le met en premier
 * pour une raison précise — il éprouve le moteur de fusion sans qu'un bogue de
 * réseau puisse être confondu avec un bogue de fusion. L'appairage par QR, la
 * liaison directe et le registre d'appareils viennent après ; cet écran le dit
 * plutôt que de laisser croire qu'il est incomplet par négligence.
 *
 * Trois choses y sont vraies, et la maquette les exigeait toutes les trois :
 * l'empreinte est affichée en permanence, l'aperçu annonce les conflits
 * **avant** la fusion, et l'annulation est offerte sept jours.
 */
import Base from '../layouts/Base.astro';
---

<Base titre="Appareils et synchronisation" actif="progression">
  <h1 class="mb-2 text-2xl font-bold text-slate-900 dark:text-white">
    Appareils et synchronisation
  </h1>
  <p class="mb-8 max-w-3xl text-slate-600 dark:text-slate-300">
    Utiliser Cyclades sur deux appareils, en transportant un fichier de l’un à
    l’autre. <strong>Ce n’est pas une sauvegarde</strong> : la synchronisation
    propage aussi les erreurs et les suppressions. Continuez à sauvegarder.
  </p>

  <div id="chargement" class="py-20 text-center text-slate-400">Lecture de l’état…</div>

  <div id="ecran" class="hidden space-y-8">
    <!-- ── La liaison directe, qui est le chemin le plus court ─────────── -->
    <section
      class="rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5 dark:border-indigo-900 dark:bg-indigo-950/30"
    >
      {/*
         « Ajouter un téléphone », et pas « Apparier un appareil ».

         Le parcours existait, sous un nom qui décrit le **procédé** plutôt
         que l'intention. On cherche « comment mettre mes révisions sur mon
         téléphone », pas « comment apparier » — et un écran qui s'intitule
         « Plus rapide : la liaison directe » répond à une question qu'on ne
         s'est pas posée. Le chemin `/apparier/` ne change pas : c'est le nom
         affiché, pas la route.

         Deux portes vers la même page, parce qu'elle fait deux choses : on y
         ajoute un appareil, et on y relance un échange avec un appareil déjà
         connu. Les confondre sous un seul libellé obligerait à en choisir un
         qui mentirait la moitié du temps.
      */}
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Ajouter un téléphone
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
        Un QR visé une fois avec l’autre appareil, et les synchronisations
        suivantes tiennent en un bouton — sans fichier à transporter. Gardez
        les deux écrans allumés le temps de l’échange. Le transfert de fichier
        ci-dessous reste là : il marche sans réseau, et c’est le recours quand
        le reste échoue.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/apparier/"
          class="cible-tactile rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Ajouter un téléphone
        </a>
        <a
          href="/apparier/"
          class="cible-tactile text-sm font-medium text-indigo-700 underline-offset-4 hover:underline dark:text-indigo-300"
        >
          Déjà apparié ? Synchroniser maintenant
        </a>
      </div>
    </section>

    <!-- ── Les appareils ───────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">Vos appareils</h2>
      <ul id="appareils" class="space-y-3"></ul>
      <p class="mt-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Les empreintes se comparent <strong>à l’œil</strong>, d’un écran à
        l’autre : quatre groupes de quatre signes. Si deux appareils affichent la
        même, ils portent les mêmes données. Celle d’un autre appareil est celle
        qu’il annonçait la dernière fois qu’il a parlé à celui-ci — elle a pu
        changer depuis.
      </p>
      <div class="mt-4 flex flex-wrap items-end gap-3">
        <label class="block text-sm">
          <span class="mb-1 block text-slate-600 dark:text-slate-300">Nom de cet appareil</span>
          <input
            id="nom-appareil"
            type="text"
            placeholder="Ordinateur de bureau"
            class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
          />
        </label>
        <button
          id="nommer"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
        >
          Enregistrer ce nom
        </button>
      </div>
      <p id="message-nom" class="mt-3 hidden text-sm"></p>
      <p class="mt-3 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Le nom <strong>voyage</strong> : l’autre appareil l’apprendra à la
        prochaine synchronisation. Ce que chacun a vu de l’autre, en revanche,
        reste chez lui — sinon le téléphone afficherait « vu il y a deux jours »
        alors que c’est l’ordinateur qui l’a vu.
      </p>
    </section>

    <!-- ── Ordinateur certifié ─────────────────────────────────────────── -->
    <section id="certification" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
          Synchronisation automatique
        </h2>
        <span id="etat-certification" class="text-sm font-medium text-slate-500 dark:text-slate-400">
          inactif
        </span>
      </div>
      <p class="mb-3 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Cet appareil peut synchroniser sans que vous ayez à appuyer sur un
        bouton.
      </p>
      <p class="mb-1 max-w-3xl text-sm font-medium text-slate-700 dark:text-slate-200">
        Ce que cela veut dire exactement :
      </p>
      <ul class="mb-3 max-w-3xl list-disc space-y-1 pl-5 text-sm text-slate-500 dark:text-slate-400">
        <li>pendant que Cyclades est ouvert dans un onglet ici ;</li>
        <li>et que l’autre appareil est ouvert aussi.</li>
      </ul>
      <p class="mb-4 max-w-3xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        Cyclades fermé, ou cet appareil éteint, <strong>rien ne se
        synchronise</strong>. Un site web ne peut pas tourner tout seul, et nous
        préférons le dire. Il n’y a donc aucune notification instantanée :
        l’avis arrive à l’ouverture de Cyclades, ou au réveil du navigateur.
      </p>
      <dl id="identite-certification" class="mb-4 grid gap-1 text-sm"></dl>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Vous serez averti de chaque synchronisation, et vous aurez{' '}
        <strong>sept jours</strong> pour l’annuler.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <button
          id="certifier"
          class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Certifier cet appareil
        </button>
        <button
          id="decertifier"
          class="hidden rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
        >
          Retirer la certification
        </button>
        <button
          id="autoriser-avis"
          class="hidden rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
        >
          Autoriser les notifications
        </button>
      </div>
      <p id="message-certification" class="mt-3 hidden text-sm"></p>
      <p id="veille-certification" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Retrait et révocation ───────────────────────────────────────── -->
    <section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-950/40">
      <h2 class="mb-2 text-lg font-semibold text-amber-900 dark:text-amber-200">
        Retirer un appareil n’est pas une révocation
      </h2>
      <p class="mb-3 max-w-3xl text-sm leading-relaxed text-amber-900/90 dark:text-amber-100/90">
        Retirer un appareil le sort du registre et dit au compactage de ne plus
        l’attendre. C’est tout. L’appareil retiré <strong>garde ce qu’il a</strong>,
        et le mot de passe qu’il connaît ouvre encore les paquets de
        synchronisation déjà transmis et les sauvegardes déjà faites : chacun
        porte son propre sel et s’ouvre avec le mot de passe de sa date.
      </p>
      <p class="mb-3 max-w-3xl text-sm leading-relaxed text-amber-900/90 dark:text-amber-100/90">
        Changer le mot de passe du site protège donc <strong>l’avenir, pas le
        passé</strong>. Le dernier changement date du{' '}
        <strong><span id="mdp-change-le">—</span></strong>. Pour le changer :
        poser le nouveau dans <code>.env.local</code>, puis{' '}
        <code>npm run mot-de-passe</code> et <code>npm run deploy</code>. Il
        faudra le ressaisir sur chaque appareil — aucun ne peut l’apprendre tout
        seul, puisque c’est la preuve de connaissance du mot de passe qui fait
        l’appairage, et non un jeton.
      </p>
      <p class="max-w-3xl text-sm leading-relaxed text-amber-900/90 dark:text-amber-100/90">
        Un appareil retiré peut être <strong>repris</strong> d’un geste, et ce
        qu’il n’avait pas encore envoyé arrivera à ce moment-là. Le retrait est
        une décision partagée, pas un ménage local : les deux appareils doivent
        être d’accord sur qui est retiré, sans quoi ils ne compacteraient pas le
        même journal.
      </p>
    </section>

    <!-- ── Sauvegardes partagées ───────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Sauvegardes, tous appareils
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        La même liste des deux côtés. Sans elle, chaque appareil insiste
        séparément : on sauvegarde deux fois le même jour, ou pas du tout en
        croyant que l’autre l’a fait.
      </p>
      <ul id="sauvegardes" class="space-y-2 text-sm"></ul>
    </section>

    <!-- ── Envoyer ─────────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        1. Envoyer depuis cet appareil
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Un fichier chiffré avec le mot de passe du site. Transportez-le comme
        vous voulez — clé USB, partage de fichiers, messagerie : son contenu
        n’est lisible qu’avec votre mot de passe.
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block text-sm">
          <span class="mb-1 block text-slate-600 dark:text-slate-300">Mot de passe du site</span>
          <input
            id="mdp-envoi"
            type="password"
            autocomplete="current-password"
            class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
          />
        </label>
        <button
          id="envoyer"
          class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Créer le paquet
        </button>
      </div>
      <p id="message-envoi" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Recevoir ────────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        2. Recevoir sur cet appareil
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Choisissez le paquet venu de l’autre appareil. Vous verrez ce qu’il
        contient <strong>avant</strong> de fusionner, et la fusion restera
        annulable sept jours.
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <input
          id="fichier"
          type="file"
          accept=".paquet,application/octet-stream"
          class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
        />
      </div>

      <div id="apercu" class="mt-4 hidden rounded-xl border border-slate-300 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950">
        <h3 class="mb-3 font-medium text-slate-900 dark:text-white">Avant de fusionner</h3>
        <dl id="apercu-detail" class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4"></dl>
        <p id="apercu-avertissement" class="mt-3 hidden text-sm"></p>
        <div
          id="marche-a-suivre"
          class="mt-3 hidden rounded-xl border border-red-300 bg-red-50 p-4 text-sm dark:border-red-900 dark:bg-red-950/40"
        >
          <p id="marche-motif" class="mb-2 font-medium text-red-900 dark:text-red-200"></p>
          <ol id="marche-etapes" class="list-decimal space-y-1 pl-5 text-red-900/90 dark:text-red-200/90"></ol>
        </div>
        <div class="mt-4 flex flex-wrap items-end gap-3">
          <label class="block text-sm">
            <span class="mb-1 block text-slate-600 dark:text-slate-300">Mot de passe du site</span>
            <input
              id="mdp-fusion"
              type="password"
              autocomplete="current-password"
              class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          <button
            id="fusionner"
            class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
          >
            Fusionner
          </button>
        </div>
      </div>
      <p id="message-fusion" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Dossier partagé ─────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        3. Dossier partagé, sans aucun geste
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Choisissez un dossier une fois : Cyclades y déposera ses paquets et y
        lira ceux de l’autre appareil. C’est le seul transport qui n’exige{' '}
        <strong>pas</strong> que les deux appareils soient ouverts en même temps.
        Si le dossier est synchronisé par un service de fichiers, celui-ci ne
        voit passer que du chiffré — comme GitHub Pages.
      </p>
      <p id="dossier-indisponible" class="mb-4 hidden max-w-3xl text-sm text-amber-600 dark:text-amber-400"></p>
      <div id="dossier-actions" class="hidden">
        <dl id="dossier-etat" class="mb-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3"></dl>
        <div class="flex flex-wrap items-end gap-3">
          <label class="block text-sm">
            <span class="mb-1 block text-slate-600 dark:text-slate-300">Mot de passe du site</span>
            <input
              id="mdp-dossier"
              type="password"
              autocomplete="current-password"
              class="w-56 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          <button
            id="choisir-dossier"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
          >
            Choisir le dossier
          </button>
          <button
            id="autoriser-dossier"
            class="hidden rounded-lg bg-amber-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-amber-700"
          >
            Autoriser l’accès
          </button>
          <button
            id="deposer"
            class="hidden rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
          >
            Déposer un paquet
          </button>
          <button
            id="oublier-dossier"
            class="hidden rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
          >
            Oublier ce dossier
          </button>
        </div>
        <ul id="paquets-dossier" class="mt-4 space-y-2 text-sm"></ul>
      </div>
      <p id="message-dossier" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Conflits à traiter ──────────────────────────────────────────── -->
    <section
      id="conflits"
      class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-950/40"
    >
      <h2 class="mb-2 text-lg font-semibold text-amber-900 dark:text-amber-200">
        Conflits à traiter
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-amber-900/80 dark:text-amber-200/80">
        Deux appareils ont enregistré des valeurs différentes pour la même chose.{' '}
        <strong>Aucune n’a été écrasée.</strong> En attendant votre réponse, la
        plus récente est affichée et marquée « à vérifier », et les analyses qui
        s’en servent le disent. Votre réponse voyage : elle tranchera le conflit
        sur l’autre appareil aussi.
      </p>
      <ul id="liste-conflits" class="space-y-4 text-sm"></ul>
    </section>
    <!--
      Le message vit **hors** de la section, et c'est une correction de motif et
      non d'instance. Trancher le dernier conflit masque la section — et avec
      elle le message qui confirmait la réponse : on clique, tout s'évanouit, et
      plus rien ne dit si cela a marché. C'est exactement la faute déjà
      rencontrée sur l'historique des synchronisations, refaite ici parce que
      corriger l'instance n'avait rien appris au code. Un message de
      confirmation ne doit jamais être enfant de ce qu'il confirme avoir vidé.
    -->
    <p id="message-conflit" class="hidden text-sm"></p>

    <!-- ── Historique et annulation ────────────────────────────────────── -->
    <section
      id="historique"
      class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
    >
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Synchronisations reçues
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Annuler retire les opérations de cette synchronisation, <strong>et elles
        seules</strong>. Ce que vous avez saisi ici depuis n’est pas touché.
        L’autre appareil les garde : elles reviendront à la prochaine
        synchronisation si vous ne les refusez pas aussi là-bas.
      </p>
      <ul id="lots" class="space-y-3 text-sm"></ul>
      <p id="message-annulation" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Reconstruire ────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Reconstruire les échéances
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Recalcule l’état de toutes vos flashcards à partir du journal de
        révisions. Le journal est la vérité ; l’état n’en est qu’un résumé. À
        faire si une échéance vous paraît fausse — c’est sans danger, et le
        relancer deux fois donne le même résultat.
      </p>
      <button
        id="reconstruire"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
      >
        Reconstruire depuis le journal
      </button>
      <p id="message-reconstruction" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Ce qui n'est pas encore là ──────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Ce qui n’est pas encore là
      </h2>
      <ul class="max-w-3xl list-disc space-y-1 pl-5 text-sm text-slate-600 dark:text-slate-300">
        <li>
          <strong>Ce qui voyage aujourd’hui</strong> : l’histoire de vos révisions
          de flashcards, vos <strong>séances</strong> et leurs{' '}
          <strong>notes</strong>, l’<strong>état de vos fiches</strong> (lue,
          prétestée, questions déjà servies), les <strong>quiz de cours</strong>,
          les <strong>QCM DGFiP</strong>, les <strong>trois familles de
          Cog-Training</strong>, les noms d’appareils, les sauvegardes déclarées,
          les réponses aux conflits et les compactages de journal.
        </li>
        <li>
          Deux versions concurrentes d’une <strong>note de séance</strong> ne
          s’écrasent pas : le désaccord s’affiche ci-dessus, la plus récente
          s’affiche en attendant, et votre réponse décide. Un texte rédigé à la
          main ne doit jamais disparaître en silence.
        </li>
        <li>
          <strong>Ce qui ne voyage pas encore</strong> : les{' '}
          <strong>compteurs de tirage DGFiP</strong>, qui sont un état dérivé des
          sessions et que l’historique ne permet pas de recalculer — les
          sessions d’avant ne portent pas le détail par question. Une session
          reçue de l’autre appareil compte donc dans vos statistiques et votre
          XP, pas encore dans la pondération du tirage.
        </li>
        <li>
          Les <strong>réglages</strong> — rotation hebdomadaire, plafonds de
          session, parcours courant. Le registre versionné existe et se fusionne
          correctement, champ par champ, mais rien n’écrit encore dedans : les
          réglages vivent toujours sous forme d’objets simples, sans horloge.
        </li>
        <li>
          L’<strong>XP, le niveau et la série</strong> ne sont pas transportés, et
          ne le seront pas ainsi. Un dernier-écrivain-gagne ferait perdre l’XP
          gagnée sur l’autre appareil ; l’additionner la compterait deux fois. Ils
          se recalculeront depuis les journaux, comme les échéances. En attendant,
          ils restent propres à chaque appareil — c’est la seule réponse honnête.
        </li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import { echapper } from '../lib/ui';
  import { empreinteLisible } from '../lib/noyau/empreinte';
  import {
    annulable,
    annulerFusion,
    apercuPaquet,
    empreinteLocale,
    etatLocal,
    fabriquerPaquet,
    fusionnerPaquet,
    conflitsALire,
    FusionRefusee,
    JOURS_ANNULABLES,
    lotsRecus,
    nommerAppareil,
    resoudreConflit,
    reconstruireEtatsDerives,
    registreAppareils,
    registreSauvegardes,
    retirerAppareil,
    type LotRecu,
  } from '../lib/sync/service';
  import { SauvegardeRefusee } from '../lib/sauvegarde/format';
  import { lireAppareil } from '../lib/db';
  import config from '../../site.config.mjs';
  import {
    certificationEffective,
    certifier,
    certificationLocale,
    certifiesDeclares,
    TYPE_CERTIFICATION,
  } from '../lib/sync/certification';
  import {
    demanderPermission,
    enregistrerServiceWorker,
    etatPermission,
  } from '../lib/sync/notification';
  import { cesser, veiller, veilleCourante } from '../lib/sync/veille';
  import { enregistrerFait } from '../lib/sync/service';
  import { appairageMemorise } from '../lib/sync/appairage';
  import { motDePasseRetenu } from '../lib/sync/mot-de-passe-session';
  import {
    autorisation,
    choisirDossier,
    deposer,
    disponible as dossierDisponible,
    dossierMemorise,
    DossierRefuse,
    lirePaquet,
    memoriserDossier,
    nettoyer,
    oublierDossier,
    paquetsDisponibles,
    redemanderAutorisation,
  } from '../lib/sync/dossier';

  const $ = (id: string) => document.getElementById(id)!;

  function dire(id: string, texte: string, ton: 'succes' | 'echec' | 'neutre') {
    const e = $(id);
    e.textContent = texte;
    e.className = `mt-3 text-sm ${
      ton === 'succes'
        ? 'text-emerald-600 dark:text-emerald-400'
        : ton === 'echec'
          ? 'text-amber-600 dark:text-amber-400'
          : 'text-slate-500 dark:text-slate-400'
    }`;
    e.classList.remove('hidden');
  }

  const definitions = (lignes: [string, string][]) =>
    lignes
      .map(
        ([terme, valeur]) =>
          `<div><dt class="text-slate-500 dark:text-slate-400">${terme}</dt>` +
          `<dd class="font-medium text-slate-900 dark:text-white">${valeur}</dd></div>`,
      )
      .join('');

  /**
   * La date du dernier changement de mot de passe, lue de la configuration.
   *
   * Affichée parce qu'elle est la seule façon de dire précisément ce qu'un
   * changement ne fait pas : un paquet ou une sauvegarde d'avant cette date
   * s'ouvre encore avec l'ancien mot de passe.
   */
  function peindreDateMotDePasse() {
    const brut = (config as { motDePasseChangeLe?: string }).motDePasseChangeLe;
    $('mdp-change-le').textContent = brut
      ? new Date(`${brut}T12:00:00`).toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })
      : 'date inconnue';
  }

  /* ── L'ordinateur certifié ───────────────────────────────────────────── */

  const LIBELLES_VEILLE: Record<string, string> = {
    'non-certifie': 'Veille inactive : cet appareil n’est pas certifié.',
    'sans-appairage':
      'Veille en attente : aucun appairage mémorisé. Faites une liaison directe une fois.',
    'sans-mot-de-passe':
      'Veille en attente du mot de passe. Il n’est gardé qu’en mémoire : ' +
      'verrouillez puis déverrouillez pour le retaper, et la veille démarrera.',
    'autre-onglet': 'Un autre onglet de Cyclades tient déjà la veille.',
    'en-veille': 'En veille : l’échange se fera dès que l’autre appareil sera ouvert.',
    'en-cours': 'Échange en cours…',
    echec: 'Le dernier échange a échoué. La veille continue.',
  };

  async function peindreCertification() {
    const [locale, registre, { lisible }] = await Promise.all([
      certificationLocale(),
      registreAppareils(),
      empreinteLocale(),
    ]);
    const moi = registre.find((a) => a.soi);
    /*
       L'écran montre la certification **effective**, défaut compris (D-028).
       Montrer la seule décision enregistrée afficherait « inactif » au-dessus
       d'une veille qui tourne, et c'est l'incohérence la plus sûre pour faire
       douter de tout le reste.
    */
    const { certifie, parDefaut } = certificationEffective(locale, {
      apparie: (await appairageMemorise()) !== null,
      motDePasseEnMemoire: motDePasseRetenu() !== null,
    });

    $('etat-certification').textContent = certifie
      ? parDefaut ? 'actif par défaut' : 'actif'
      : 'inactif';
    $('etat-certification').className = certifie
      ? 'text-sm font-medium text-emerald-600 dark:text-emerald-400'
      : 'text-sm font-medium text-slate-500 dark:text-slate-400';

    /*
       Le nom et l'empreinte de cet appareil, affichés au moment de certifier :
       la maquette l'exige, et pour une raison — on doit voir **lequel** on
       certifie, surtout quand deux appareils portent le même modèle.
    */
    definitionsCertification([
      ['Cet appareil', moi?.nom ? `« ${moi.nom} »` : 'sans nom'],
      ['Empreinte', lisible],
      ['Identifiant', moi?.id ?? '—'],
      ...(certifie && locale
        ? ([['Certifié le', new Date(locale.le).toLocaleString('fr-FR')]] as [string, string][])
        : []),
      /*
         Dire d'où vient une certification qu'on n'a pas donnée, et à quelle
         condition elle tient : sans cette ligne, elle paraîtrait surgie de
         nulle part, et sa disparition au prochain verrouillage aussi.
      */
      ...(parDefaut
        ? ([[
            'Certifié',
            'par défaut — cet appareil est apparié et le mot de passe est en ' +
              'mémoire. La certification retombe au verrouillage ; « Certifier » ' +
              'la rend permanente.',
          ]] as [string, string][])
        : []),
    ]);

    /*
       « Certifier » reste offert sous une certification tacite : il la change
       en décision, donc en certification qui survit au verrouillage. Le
       masquer laisserait sans geste pour obtenir ce que le bouton promet.
    */
    ($('certifier') as HTMLButtonElement).classList.toggle('hidden', certifie && !parDefaut);
    ($('decertifier') as HTMLButtonElement).classList.toggle('hidden', !certifie);
    $('autoriser-avis').classList.toggle(
      'hidden',
      !certifie || etatPermission() !== 'a-demander',
    );

    // Un autre appareil se déclare-t-il certifié ? L'amendement en veut un seul
    // à la fois, et on ne peut pas en révoquer un à distance — on le dit donc.
    const autres = [...certifiesDeclares((await etatLocal()).operations)].filter(
      (id) => id !== moi?.id,
    );
    const veille = veilleCourante();
    const texte = certifie
      ? LIBELLES_VEILLE[veille?.etat() ?? 'sans-appairage'] ??
        'Veille en attente.'
      : '';
    const avertissement = autres.length
      ? ` « ${autres
          .map((id) => registre.find((a) => a.id === id)?.nom ?? id)
          .join(' », « ')} » se déclare aussi certifié : la certification se retire sur ` +
        'l’appareil lui-même, jamais d’ici.'
      : '';
    const ligne = $('veille-certification');
    ligne.textContent = texte + avertissement;
    ligne.className =
      'mt-3 text-sm ' +
      (autres.length
        ? 'text-amber-700 dark:text-amber-300'
        : 'text-slate-500 dark:text-slate-400');
    ligne.classList.toggle('hidden', !texte && !avertissement);
  }

  function definitionsCertification(paires: [string, string][]) {
    const e = $('identite-certification');
    e.replaceChildren();
    for (const [clef, valeur] of paires) {
      const ligne = document.createElement('div');
      ligne.className = 'flex flex-wrap gap-2';
      const dt = document.createElement('dt');
      dt.className = 'text-slate-500 dark:text-slate-400';
      dt.textContent = `${clef} :`;
      const dd = document.createElement('dd');
      dd.className = 'font-mono font-medium text-slate-900 dark:text-white';
      dd.textContent = valeur;
      ligne.append(dt, dd);
      e.appendChild(ligne);
    }
  }

  async function peindreEtat() {
    const [{ lisible }, etat, registre, sauvegardes] = await Promise.all([
      empreinteLocale(),
      etatLocal(),
      registreAppareils(),
      registreSauvegardes(),
    ]);

    $('appareils').innerHTML = registre
      .map((app) => {
        const titre = app.nom
          ? `${app.nom}`
          : app.soi
            ? 'Cet appareil'
            : 'Appareil sans nom';
        const empreinte = app.soi
          ? lisible
          : app.empreinte
            ? empreinteLisible(app.empreinte)
            : '—';
        const etatTexte = app.soi
          ? `${etat.operations.length.toLocaleString('fr-FR')} opérations, ` +
            `${etat.revisions.length.toLocaleString('fr-FR')} révisions`
          : app.vuLe
            ? `vu le ${new Date(app.vuLe).toLocaleString('fr-FR')}`
            : 'jamais rencontré depuis cet appareil';
        /*
           Un appareil retiré reste affiché, grisé, avec de quoi le reprendre.
           Le faire disparaître ferait croire à une révocation, qui n'en est
           pas une : il garde ce qu'il a.
        */
        const bouton = app.soi
          ? ''
          : `<button data-retrait="${app.id}" data-sens="${app.retire ? 'reprendre' : 'retirer'}" ` +
            `class="rounded-lg border px-2.5 py-1 text-xs font-medium transition ${
              app.retire
                ? 'border-indigo-300 text-indigo-700 hover:bg-indigo-50 dark:border-indigo-800 dark:text-indigo-300 dark:hover:bg-indigo-950/40'
                : 'border-slate-300 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800'
            }">${app.retire ? 'Reprendre' : 'Retirer'}</button>`;
        return (
          `<li class="rounded-xl border p-3 ${
            app.soi
              ? 'border-indigo-300 bg-indigo-50/50 dark:border-indigo-800 dark:bg-indigo-950/30'
              : app.retire
                ? 'border-dashed border-slate-300 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/60'
                : 'border-slate-200 dark:border-slate-800'
          }">` +
          `<div class="flex flex-wrap items-baseline justify-between gap-2">` +
          `<span class="font-medium text-slate-900 dark:text-white">${titre}` +
          `${app.soi ? ' <span class="text-xs font-normal text-indigo-700 dark:text-indigo-300">(celui-ci)</span>' : ''}` +
          `</span>` +
          `<span class="font-mono text-sm text-slate-900 dark:text-white">${empreinte}</span>` +
          `</div>` +
          `<div class="mt-1 flex flex-wrap items-baseline justify-between gap-2 text-sm text-slate-500 dark:text-slate-400">` +
          `<span class="font-mono">${app.id}</span><span>${etatTexte}</span>` +
          `</div>` +
          (app.retire || bouton
            ? `<div class="mt-2 flex flex-wrap items-center justify-between gap-2">` +
              `<span class="text-xs ${app.retire ? 'text-amber-700 dark:text-amber-300' : 'text-transparent'}">` +
              `${app.retire ? 'Retiré : plus attendu par le compactage du journal.' : ''}</span>` +
              `${bouton}</div>`
            : '') +
          `</li>`
        );
      })
      .join('');

    $('sauvegardes').innerHTML = sauvegardes.length
      ? sauvegardes
          .slice(0, 10)
          .map((s) => {
            const quand = s.le ? new Date(s.le).toLocaleString('fr-FR') : 'date inconnue';
            const nom = registre.find((a) => a.id === s.appareil);
            const qui = nom?.nom ?? s.appareil;
            return (
              `<li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 ` +
              `pb-1 last:border-0 dark:border-slate-800">` +
              `<span class="text-slate-900 dark:text-white">${quand}</span>` +
              `<span class="text-slate-500 dark:text-slate-400">depuis ${qui}</span></li>`
            );
          })
          .join('')
      : '<li class="text-slate-500 dark:text-slate-400">Aucune sauvegarde déclarée. ' +
        'Les sauvegardes faites avant cette version ne sont pas listées : elles n’étaient ' +
        'pas encore déclarées au registre partagé.</li>';

    noms = new Map(registre.filter((a) => a.nom).map((a) => [a.id, a.nom!]));

    const champ = $('nom-appareil') as HTMLInputElement;
    const moi = registre.find((a) => a.soi);
    if (moi?.nom && !champ.value) champ.value = moi.nom;
  }

  async function peindreLots() {
    const lots = await lotsRecus();
    /*
       La section reste **toujours** visible, même sans aucune synchronisation.
       Elle se masquait quand la liste était vide, et annuler la dernière
       synchronisation faisait donc disparaître la section — avec elle, le
       message qui confirmait l'annulation. On cliquait, tout s'évanouissait, et
       plus rien ne disait si cela avait marché. Un état vide nommé vaut mieux
       qu'une section qui s'escamote.
    */
    $('historique').classList.remove('hidden');
    if (!lots.length) {
      $('lots').innerHTML =
        '<li class="text-slate-500 dark:text-slate-400">Aucune synchronisation reçue sur ' +
        'cet appareil.</li>';
      return;
    }
    $('lots').innerHTML = lots
      .map((lot) => {
        const quand = new Date(lot.le).toLocaleString('fr-FR');
        const venu = lot.nomAppareil ?? lot.appareil;
        const encore = annulable(lot);
        const bouton = encore
          ? `<button data-lot="${lot.lot}" class="annuler rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 transition hover:bg-red-100 dark:border-red-800 dark:bg-transparent dark:text-red-300">Annuler</button>`
          : '<span class="text-slate-400">Plus annulable</span>';
        /*
           Une fusion automatique est signalée, et la date limite d'annulation
           écrite : c'est la seule notification qui ne mente jamais, et celle
           qu'on n'a pas demandée est précisément celle qu'il faut pouvoir
           défaire en connaissance de cause.
        */
        const limite = new Date(Date.parse(lot.le) + JOURS_ANNULABLES * 86_400_000);
        const marque = lot.automatique
          ? '<span class="rounded bg-indigo-100 px-1.5 py-0.5 text-xs font-medium text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200">⟳ automatique</span> '
          : '';
        return (
          `<li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border p-3 ${
            lot.automatique
              ? 'border-indigo-200 bg-indigo-50/40 dark:border-indigo-900 dark:bg-indigo-950/20'
              : 'border-slate-200 dark:border-slate-800'
          }">` +
          `<span>${marque}Le ${quand}, de « ${venu} » : ${lot.operations} opération(s), ` +
          `${lot.revisions} révision(s), ${lot.cartes.length} carte(s) recalculée(s).` +
          (encore
            ? `<br><span class="text-slate-500 dark:text-slate-400">Annulable jusqu’au ` +
              `${limite.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}.</span>`
            : '') +
          `</span>${bouton}</li>`
        );
      })
      .join('');

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('.annuler')) {
      bouton.addEventListener('click', async () => {
        const lot = bouton.dataset.lot!;
        const details = (await lotsRecus()).find((l) => l.lot === lot) as LotRecu;
        const confirme = window.confirm(
          `Annuler la synchronisation du ${new Date(details.le).toLocaleString('fr-FR')} ?\n\n` +
            `Seront retirées ${details.operations} opération(s) et ${details.revisions} ` +
            `révision(s) reçues dans cette synchronisation, et elles seules. ` +
            `${details.cartes.length} carte(s) seront recalculées.\n\n` +
            `Ce que vous avez saisi ici depuis n’est pas touché.`,
        );
        if (!confirme) return;
        bouton.disabled = true;
        try {
          const rapport = await annulerFusion(lot);
          dire(
            'message-annulation',
            `Annulée : ${rapport.retirees} opération(s) et ${rapport.revisionsRetirees} ` +
              `révision(s) retirées, ${rapport.cartesRecalculees} carte(s) recalculée(s)` +
              (rapport.domaineEffaces
                ? `, ${rapport.domaineEffaces} enregistrement(s) repartis`
                : '') +
              '.',
            'succes',
          );
          await peindreEtat();
          await peindreLots();
        } catch (erreur) {
          bouton.disabled = false;
          dire('message-annulation', `Annulation impossible : ${(erreur as Error).message}`, 'echec');
        }
      });
    }
  }

  /**
   * Les conflits ouverts, avec leurs quatre issues.
   *
   * L'ordre des boutons suit la maquette, et il n'est pas indifférent : garder
   * l'une, garder l'autre, puis les deux cas qui demandent une précision. Les
   * deux premiers sont les plus fréquents ; mettre « ignorer » en tête
   * apprendrait à ignorer.
   */
  /**
   * Ce qu'on montre d'une valeur en conflit.
   *
   * Deux raisons de ne pas y jeter le JSON brut. D'abord la lisibilité : depuis
   * que les enregistrements de domaine voyagent, une valeur en conflit peut être
   * une note de séance de deux pages, et un `JSON.stringify` de deux pages ne se
   * lit pas. Ensuite la sûreté : ce texte vient d'un autre appareil, donc il est
   * **écrit par quelqu'un**, et il est inséré dans du HTML — il est donc échappé,
   * sans exception, et tronqué.
   */
  function apercuDeCharge(charge: unknown): string {
    const enregistrement =
      charge && typeof charge === 'object' && 'enregistrement' in charge
        ? ((charge as { enregistrement?: unknown }).enregistrement as
            | Record<string, unknown>
            | undefined)
        : undefined;

    if (enregistrement) {
      const note = typeof enregistrement.note === 'string' ? enregistrement.note : null;
      if (note !== null) {
        const restitutions = Object.values(
          (enregistrement.restitutions as Record<string, string> | undefined) ?? {},
        ).filter((r) => r.trim().length >= 80).length;
        const debut = note.trim().slice(0, 120);
        return (
          `${echapper(debut)}${note.trim().length > 120 ? '…' : ''} ` +
          `<span class="text-slate-500 dark:text-slate-400">(${note.trim().length} signes, ` +
          `${restitutions} restitution(s))</span>`
        );
      }
      const brut = JSON.stringify(enregistrement) ?? '';
      return echapper(brut.slice(0, 200)) + (brut.length > 200 ? '…' : '');
    }
    const brut = JSON.stringify(charge) ?? '';
    return echapper(brut.slice(0, 200)) + (brut.length > 200 ? '…' : '');
  }

  async function peindreConflits() {
    const { ouverts } = await conflitsALire();
    if (!ouverts.length) {
      /*
         Vider **puis** masquer. Masquer sans vider laisse les anciens conflits
         dans le DOM : ils ne se voient plus, mais ils sont là — et ils
         réapparaîtraient le jour où la section se réaffiche pour un autre
         conflit, le temps d'un repaint. C'est la troisième variante de la même
         faute dans cet écran : masquer n'est pas vider, et un repaint doit
         laisser le DOM dans l'état qu'il décrit.
      */
      $('liste-conflits').innerHTML = '';
      $('conflits').classList.add('hidden');
      return;
    }
    $('conflits').classList.remove('hidden');
    $('liste-conflits').innerHTML = ouverts
      .map((conflit, index) => {
        const valeurs = conflit.operations
          .map((op) => {
            const quand = new Date(Number(op.hlc.slice(0, 15))).toLocaleString('fr-FR');
            const nom = noms.get(op.appareil) ?? op.appareil;
            return (
              `<li class="flex flex-wrap items-baseline justify-between gap-2">` +
              `<code class="min-w-0 break-words text-slate-900 dark:text-white">` +
              `${apercuDeCharge(op.charge)}</code>` +
              `<span class="text-amber-900/70 dark:text-amber-200/70">saisi sur ${nom}, ` +
              `le ${quand}</span>` +
              `<button data-conflit="${index}" data-issue="retenue" data-retenue="${op.id}" ` +
              `class="resoudre rounded-lg border border-amber-400 bg-white px-3 py-1 text-xs ` +
              `font-medium text-amber-900 transition hover:bg-amber-100 dark:border-amber-700 ` +
              `dark:bg-transparent dark:text-amber-200">Garder celle-ci</button></li>`
            );
          })
          .join('');
        const deja = conflit.repondueAvant
          ? `<p class="mt-2 text-amber-900/80 dark:text-amber-200/80">Vous avez déjà répondu à ` +
            `une partie de cette question ; une valeur nouvelle est arrivée depuis.</p>`
          : '';
        return (
          `<li class="rounded-xl border border-amber-300 bg-white p-4 dark:border-amber-800 ` +
          `dark:bg-slate-900">` +
          `<p class="mb-2 font-medium text-slate-900 dark:text-white">` +
          `${echapper(conflit.type)} — ${echapper(conflit.cible)}</p>` +
          `<ul class="space-y-2">${valeurs}</ul>${deja}` +
          `<div class="mt-3 flex flex-wrap gap-2">` +
          `<button data-conflit="${index}" data-issue="toutes-justes" ` +
          `class="resoudre rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs ` +
          `font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 ` +
          `dark:bg-transparent dark:text-slate-100">Les deux sont justes</button>` +
          `<button data-conflit="${index}" data-issue="ignore" ` +
          `class="resoudre rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs ` +
          `font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 ` +
          `dark:bg-transparent dark:text-slate-100">Ignorer</button></div></li>`
        );
      })
      .join('');

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('.resoudre')) {
      bouton.addEventListener('click', async () => {
        const conflit = ouverts[Number(bouton.dataset.conflit)];
        const issue = bouton.dataset.issue as 'retenue' | 'toutes-justes' | 'ignore';
        let precision: string | undefined;
        if (issue !== 'retenue') {
          const question =
            issue === 'toutes-justes'
              ? 'En quoi les deux sont-elles justes ? (deux pesées dans la journée, par exemple)'
              : 'Pourquoi ne pas trancher maintenant ?';
          precision = window.prompt(question) ?? undefined;
          // Une annulation de l'invite n'est pas une réponse : on ne journalise
          // rien plutôt que d'enregistrer un motif vide.
          if (!precision?.trim()) return;
        }
        bouton.disabled = true;
        try {
          await resoudreConflit(conflit, {
            issue,
            retenue: bouton.dataset.retenue,
            precision,
          });
          dire(
            'message-conflit',
            'Réponse enregistrée. Elle voyagera vers vos autres appareils à la prochaine ' +
              'synchronisation.',
            'succes',
          );
          await peindreEtat();
          await peindreConflits();
        } catch (erreur) {
          bouton.disabled = false;
          dire('message-conflit', `${(erreur as Error).message}`, 'echec');
        }
      });
    }
  }

  /** Les noms d'appareils, pour nommer qui a saisi quoi dans un conflit. */
  let noms = new Map<string, string>();

  let octetsRecus: Uint8Array | null = null;

  auDeverrouillage(async () => {
    peindreDateMotDePasse();
    await peindreEtat();
    await peindreCertification();
    await peindreConflits();
    await peindreLots();
    $('chargement').classList.add('hidden');
    /* ══════════════════════════════════════════════════════════════════
       Le dossier partagé
       ══════════════════════════════════════════════════════════════════ */

    let dossier: Awaited<ReturnType<typeof dossierMemorise>> = null;

    const mdpDossier = () => ($('mdp-dossier') as HTMLInputElement).value;

    async function peindreDossier() {
      if (!dossierDisponible()) {
        $('dossier-indisponible').textContent =
          'Ce navigateur ne sait pas mémoriser un dossier : c’est le cas de Firefox, de Safari ' +
          'et de tous les navigateurs de téléphone. Utilisez la liaison directe ou le fichier.';
        $('dossier-indisponible').classList.remove('hidden');
        return;
      }
      $('dossier-actions').classList.remove('hidden');
      const present = Boolean(dossier);
      $('oublier-dossier').classList.toggle('hidden', !present);
      $('deposer').classList.toggle('hidden', !present);
      ($('choisir-dossier') as HTMLButtonElement).textContent = present
        ? 'Changer de dossier'
        : 'Choisir le dossier';

      if (!dossier) {
        $('dossier-etat').innerHTML = definitions([['Dossier', 'aucun']]);
        $('autoriser-dossier').classList.add('hidden');
        $('paquets-dossier').innerHTML = '';
        return;
      }

      const droit = await autorisation(dossier);
      $('autoriser-dossier').classList.toggle('hidden', droit === 'accordee');
      $('dossier-etat').innerHTML = definitions([
        ['Dossier', dossier.name],
        [
          'Accès',
          droit === 'accordee'
            ? 'accordé'
            : droit === 'refusee'
              ? 'refusé'
              : 'à redemander d’un clic',
        ],
      ]);

      if (droit !== 'accordee') {
        $('paquets-dossier').innerHTML =
          '<li class="text-slate-500 dark:text-slate-400">Autorisez l’accès pour voir les ' +
          'paquets déposés.</li>';
        return;
      }

      const moi = await lireAppareil();
      const paquets = await paquetsDisponibles(dossier, moi);
      $('paquets-dossier').innerHTML = paquets.length
        ? paquets
            .map(
              (p) =>
                `<li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border ` +
                `border-slate-200 p-3 dark:border-slate-700">` +
                `<span><span class="font-medium text-slate-900 dark:text-white">${p.appareil}</span>` +
                ` — ${new Date(p.modifie).toLocaleString('fr-FR')}, ` +
                `${Math.round(p.taille / 1024)} Kio</span>` +
                `<button class="fusionner-dossier rounded-lg bg-indigo-600 px-3 py-2 text-xs ` +
                `font-medium text-white" data-nom="${p.nom}">Fusionner</button></li>`,
            )
            .join('')
        : '<li class="text-slate-500 dark:text-slate-400">Aucun paquet déposé par un autre ' +
          'appareil dans ce dossier.</li>';

      for (const bouton of document.querySelectorAll<HTMLButtonElement>('.fusionner-dossier')) {
        bouton.addEventListener('click', () => void fusionnerDepuisDossier(bouton.dataset.nom!));
      }
    }

    function direDossier(erreur: unknown) {
      dire(
        'message-dossier',
        erreur instanceof DossierRefuse
          ? erreur.message
          : erreur instanceof FusionRefusee
            ? `Fusion refusée, rien n’a été écrit. ${erreur.diagnostic.message}`
            : erreur instanceof SauvegardeRefusee && erreur.motif === 'mot-de-passe'
              ? 'Mot de passe incorrect : rien n’a été fusionné.'
              : `Échec : ${(erreur as Error).message}`,
        'echec',
      );
    }

    $('choisir-dossier').addEventListener('click', async () => {
      try {
        const choisi = await choisirDossier();
        await memoriserDossier(choisi);
        dossier = await dossierMemorise();
        /*
           Repeindre **avant** d'annoncer. L'inverse écrit « dossier mémorisé »
           alors que la liste des paquets n'est pas encore là : l'écran dit que
           c'est fini quand ce n'est pas fini, et c'est exactement ce qu'un essai
           a pris pour un dossier vide.
        */
        await peindreDossier();
        dire('message-dossier', `Dossier « ${choisi.name} » mémorisé.`, 'succes');
      } catch (erreur) {
        direDossier(erreur);
      }
    });

    $('autoriser-dossier').addEventListener('click', async () => {
      if (!dossier) return;
      const droit = await redemanderAutorisation(dossier);
      await peindreDossier();
      dire(
        'message-dossier',
        droit === 'accordee'
          ? 'Accès accordé.'
          : 'Accès toujours refusé : choisissez à nouveau le dossier.',
        droit === 'accordee' ? 'succes' : 'echec',
      );
    });

    $('deposer').addEventListener('click', async () => {
      if (!dossier) return;
      const mdp = mdpDossier();
      if (!mdp) {
        dire('message-dossier', 'Le mot de passe du site est nécessaire pour chiffrer le paquet.', 'echec');
        return;
      }
      const bouton = $('deposer') as HTMLButtonElement;
      bouton.disabled = true;
      try {
        const paquet = await fabriquerPaquet(mdp);
        await deposer(dossier, paquet.nom, paquet.octets);
        /* Le nettoyage suit le dépôt, et non un bouton : une rétention qu'il
           faut penser à déclencher est une rétention qui ne se fait pas. */
        const retires = await nettoyer(dossier);
        ($('mdp-dossier') as HTMLInputElement).value = '';
        await peindreDossier();
        dire(
          'message-dossier',
          `Déposé : ${paquet.nom} (${Math.round(paquet.tailleFichier / 1024)} Kio)` +
            (retires.length ? `, ${retires.length} ancien(s) paquet(s) retiré(s)` : '') +
            '.',
          'succes',
        );
      } catch (erreur) {
        direDossier(erreur);
      } finally {
        bouton.disabled = false;
      }
    });

    async function fusionnerDepuisDossier(nom: string) {
      if (!dossier) return;
      const mdp = mdpDossier();
      if (!mdp) {
        dire('message-dossier', 'Le mot de passe du site est nécessaire pour déchiffrer le paquet.', 'echec');
        return;
      }
      try {
        dire('message-dossier', 'Fusion en cours…', 'neutre');
        const octets = await lirePaquet(dossier, nom);
        const rapport = await fusionnerPaquet(octets, mdp);
        ($('mdp-dossier') as HTMLInputElement).value = '';
        dire(
          'message-dossier',
          `${rapport.recues} opération(s) et ${rapport.revisionsRecues} révision(s) reçues ; ` +
            `${rapport.cartesRecalculees} carte(s) recalculée(s)` +
            (rapport.domaineEcrits ? ` ; ${rapport.domaineEcrits} enregistrement(s) écrit(s)` : '') +
            (rapport.conflits ? ` ; ${rapport.conflits} conflit(s) à traiter` : '') +
            '.',
          'succes',
        );
        await peindreEtat();
        await peindreConflits();
        await peindreLots();
        await peindreDossier();
      } catch (erreur) {
        direDossier(erreur);
      }
    }

    $('oublier-dossier').addEventListener('click', async () => {
      await oublierDossier();
      dossier = null;
      await peindreDossier();
      dire('message-dossier', 'Dossier oublié. Les fichiers déposés y restent.', 'neutre');
    });

    dossier = dossierDisponible() ? await dossierMemorise() : null;
    await peindreDossier();

    $('ecran').classList.remove('hidden');

    $('envoyer').addEventListener('click', async () => {
      const mdp = ($('mdp-envoi') as HTMLInputElement).value;
      if (!mdp) {
        dire('message-envoi', 'Le mot de passe est nécessaire : un paquet n’est jamais en clair.', 'echec');
        return;
      }
      dire('message-envoi', 'Fabrication du paquet…', 'neutre');
      try {
        /* Le nom vient du registre et non d'un champ de cette section : il est
           déclaré une fois, et voyage comme un fait. */
        const moi = (await registreAppareils()).find((a) => a.soi);
        const paquet = await fabriquerPaquet(mdp, { nomAppareil: moi?.nom });
        const url = URL.createObjectURL(
          new Blob([paquet.octets], { type: 'application/octet-stream' }),
        );
        const a = document.createElement('a');
        a.href = url;
        a.download = paquet.nom;
        a.click();
        URL.revokeObjectURL(url);
        ($('mdp-envoi') as HTMLInputElement).value = '';
        dire(
          'message-envoi',
          `Paquet créé : ${paquet.operations} opération(s), ${paquet.revisions} révision(s), ` +
            `${(paquet.tailleFichier / 1024).toFixed(1)} Kio. Transportez-le sur l’autre appareil.`,
          'succes',
        );
      } catch (erreur) {
        dire('message-envoi', `Échec : ${(erreur as Error).message}`, 'echec');
      }
    });

    /*
       Le retrait est délégué : les lignes du registre sont repeintes à chaque
       fusion, et un écouteur posé sur chaque bouton disparaîtrait avec elles.
    */
    $('appareils').addEventListener('click', async (evenement) => {
      const bouton = (evenement.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-retrait]',
      );
      if (!bouton) return;
      const id = bouton.dataset.retrait!;
      const reprendre = bouton.dataset.sens === 'reprendre';
      bouton.disabled = true;
      try {
        await retirerAppareil(id, !reprendre);
        await peindreEtat();
        dire(
          'message-nom',
          reprendre
            ? `Appareil ${id} repris : le compactage l’attendra de nouveau.`
            : `Appareil ${id} retiré. Ce n’est pas une révocation : il garde ce qu’il a, ` +
              'et le mot de passe qu’il connaît ouvre encore les paquets déjà transmis.',
          'succes',
        );
      } catch (erreur) {
        dire('message-nom', `Échec : ${(erreur as Error).message}`, 'echec');
      } finally {
        bouton.disabled = false;
      }
    });

    $('certifier').addEventListener('click', async () => {
      const bouton = $('certifier') as HTMLButtonElement;
      bouton.disabled = true;
      try {
        await certifier(true);
        /*
           La certification est locale ; l'annonce est un fait, écrit **par**
           cet appareil **sur** lui-même. Un fait qui en certifierait un autre
           est ignoré à la lecture : c'est la règle « jamais à distance » tenue
           par le code, et pas seulement par l'écran.
        */
        await enregistrerFait(TYPE_CERTIFICATION, await lireAppareil(), { certifie: true });
        /*
           La permission de notifier se demande **depuis le geste** : un
           navigateur refuse une demande non sollicitée, et certains la
           retiennent contre le site.
        */
        const permission = await demanderPermission();
        await enregistrerServiceWorker(import.meta.env.BASE_URL);
        await veiller();
        await peindreEtat();
        await peindreCertification();
        dire(
          'message-certification',
          'Cet appareil est certifié. Il synchronisera sans geste pendant que Cyclades ' +
            'est ouvert ici. ' +
            (permission === 'accordee'
              ? 'Vous recevrez un avis après chaque fusion.'
              : permission === 'refusee'
                ? 'Les notifications sont refusées par le navigateur : les fusions ' +
                  'resteront visibles ici, dans « Synchronisations reçues ».'
                : 'Sans notification autorisée, les fusions restent visibles ici.'),
          'succes',
        );
      } catch (erreur) {
        dire('message-certification', `Échec : ${(erreur as Error).message}`, 'echec');
      } finally {
        bouton.disabled = false;
      }
    });

    $('decertifier').addEventListener('click', async () => {
      const bouton = $('decertifier') as HTMLButtonElement;
      bouton.disabled = true;
      try {
        await certifier(false);
        await enregistrerFait(TYPE_CERTIFICATION, await lireAppareil(), { certifie: false });
        await cesser();
        await peindreEtat();
        await peindreCertification();
        dire(
          'message-certification',
          'Certification retirée. Cet appareil ne synchronisera plus de lui-même ; ' +
            'rien de ce qu’il a n’est perdu.',
          'succes',
        );
      } catch (erreur) {
        dire('message-certification', `Échec : ${(erreur as Error).message}`, 'echec');
      } finally {
        bouton.disabled = false;
      }
    });

    $('autoriser-avis').addEventListener('click', async () => {
      const etat = await demanderPermission();
      await enregistrerServiceWorker(import.meta.env.BASE_URL);
      await peindreCertification();
      dire(
        'message-certification',
        etat === 'accordee'
          ? 'Notifications autorisées. Un avis s’affichera après chaque fusion automatique.'
          : etat === 'refusee'
            ? 'Le navigateur a refusé. Les fusions restent visibles ici, dans ' +
              '« Synchronisations reçues » — c’est la notification qui ne manque jamais.'
            : 'Rien n’a changé : la permission reste à demander.',
        etat === 'accordee' ? 'succes' : 'neutre',
      );
    });

    $('nommer').addEventListener('click', async () => {
      const nom = ($('nom-appareil') as HTMLInputElement).value.trim();
      if (!nom) {
        dire('message-nom', 'Donnez un nom : c’est lui qui distinguera les deux écrans.', 'echec');
        return;
      }
      try {
        await nommerAppareil(nom);
        dire(
          'message-nom',
          `Nom enregistré. L’autre appareil l’apprendra à la prochaine synchronisation.`,
          'succes',
        );
        await peindreEtat();
      } catch (erreur) {
        dire('message-nom', `Échec : ${(erreur as Error).message}`, 'echec');
      }
    });

    $('reconstruire').addEventListener('click', async () => {
      const bouton = $('reconstruire') as HTMLButtonElement;
      bouton.disabled = true;
      dire('message-reconstruction', 'Recalcul en cours…', 'neutre');
      try {
        const rapport = await reconstruireEtatsDerives();
        dire(
          'message-reconstruction',
          `${rapport.cartes} carte(s) recalculée(s) depuis le journal.` +
            (rapport.sansJournal
              ? ` ${rapport.sansJournal} carte(s) n’ont pas d’entrée au journal : leur état est ` +
                'laissé tel quel, parce qu’on ne sait pas le reconstituer.'
              : '') +
            (rapport.domaineSocles
              ? ` ${rapport.domaineSocles} enregistrement(s) de domaine sont entrés au journal.`
              : '') +
            (rapport.domaineEcrits || rapport.domaineEffaces
              ? ` ${rapport.domaineEcrits} réécrit(s) depuis le journal` +
                (rapport.domaineEffaces ? `, ${rapport.domaineEffaces} effacé(s).` : '.')
              : ''),
          'succes',
        );
        await peindreEtat();
      } catch (erreur) {
        dire('message-reconstruction', `Échec : ${(erreur as Error).message}`, 'echec');
      } finally {
        bouton.disabled = false;
      }
    });

    $('fichier').addEventListener('change', async (evenement) => {
      const fichier = (evenement.target as HTMLInputElement).files?.[0];
      $('apercu').classList.add('hidden');
      $('message-fusion').classList.add('hidden');
      // Cacher ne suffit pas : la marche à suivre d'un refus précédent
      // réapparaîtrait avec l'aperçu du fichier suivant.
      $('marche-a-suivre').classList.add('hidden');
      $('marche-etapes').innerHTML = '';
      $('marche-motif').textContent = '';
      if (!fichier) return;
      try {
        octetsRecus = new Uint8Array(await fichier.arrayBuffer());
        const vu = await apercuPaquet(octetsRecus);
        const { complete } = await empreinteLocale();
        $('apercu-detail').innerHTML = definitions([
          ['Venu de', vu.metadonnees.nomAppareil ?? vu.metadonnees.appareil],
          ['Empreinte annoncée', empreinteLisible(vu.metadonnees.empreinte)],
          ['Taille', `${(vu.tailleFichier / 1024).toFixed(1)} Kio`],
          ['Intégrité', vu.intact ? 'intact ✓' : 'abîmé'],
        ]);
        const avertissements: string[] = [];
        if (!vu.intact) {
          avertissements.push(
            'Ce fichier est incomplet ou abîmé : sa somme de contrôle ne correspond pas. ' +
              'La fusion sera refusée.',
          );
        }
        if (vu.metadonnees.empreinte === complete) {
          avertissements.push(
            'Les empreintes sont déjà identiques : ce paquet n’apporte rien, et le fusionner ' +
              'ne changera rien. C’est sans danger.',
          );
        }
        if (avertissements.length) {
          dire('apercu-avertissement', avertissements.join(' '), vu.intact ? 'neutre' : 'echec');
        } else {
          $('apercu-avertissement').classList.add('hidden');
        }
        $('apercu').classList.remove('hidden');
      } catch (erreur) {
        const motif = erreur instanceof SauvegardeRefusee ? ` (${erreur.motif})` : '';
        dire('message-fusion', `Ce fichier n’est pas un paquet Cyclades${motif}.`, 'echec');
      }
    });

    $('fusionner').addEventListener('click', async () => {
      if (!octetsRecus) return;
      const mdp = ($('mdp-fusion') as HTMLInputElement).value;
      if (!mdp) {
        dire('message-fusion', 'Le mot de passe du site est nécessaire pour déchiffrer le paquet.', 'echec');
        return;
      }
      const bouton = $('fusionner') as HTMLButtonElement;
      bouton.disabled = true;
      dire('message-fusion', 'Fusion en cours…', 'neutre');
      $('marche-a-suivre').classList.add('hidden');
      try {
        const rapport = await fusionnerPaquet(octetsRecus, mdp);
        /*
           Le diagnostic de la fusion est **affiché même quand il est
           favorable** : savoir que les deux appareils n'avaient aucune histoire
           commune mais que les réunir ne perdait rien vaut mieux que de ne rien
           savoir et de s'inquiéter après coup. Il vient du rapport, et non d'un
           appel séparé qui redériverait la clé.
        */
        dire('apercu-avertissement', rapport.diagnostic.message, 'neutre');
        ($('mdp-fusion') as HTMLInputElement).value = '';
        const parties = [
          `${rapport.recues} opération(s) et ${rapport.revisionsRecues} révision(s) reçues`,
          `${rapport.cartesRecalculees} carte(s) recalculée(s)`,
        ];
        /*
           Les enregistrements de domaine ont leur propre ligne : « deux QCM
           sont arrivés » se comprend, « deux opérations » non.
        */
        if (rapport.domaineEcrits || rapport.domaineEffaces) {
          parties.push(
            `${rapport.domaineEcrits} enregistrement(s) écrit(s)` +
              (rapport.domaineEffaces ? `, ${rapport.domaineEffaces} effacé(s)` : ''),
          );
        }
        if (rapport.reglagesChanges.length) {
          parties.push(
            `${rapport.reglagesChanges.length} réglage(s) mis à jour ` +
              `(${rapport.reglagesChanges.join(', ')})`,
          );
        }
        if (rapport.conflits) parties.push(`${rapport.conflits} conflit(s) à traiter`);
        if (rapport.collisions) {
          parties.push(
            `${rapport.collisions} collision(s) d’identifiants — ce paquet est peut-être abîmé`,
          );
        }
        parties.push(
          rapport.identiques
            ? 'les deux appareils sont désormais identiques ✓'
            : 'les empreintes diffèrent encore : envoyez aussi un paquet depuis cet appareil',
        );
        dire('message-fusion', `${parties.join(' ; ')}.`, 'succes');
        await peindreEtat();
        await peindreConflits();
        await peindreLots();
      } catch (erreur) {
        if (erreur instanceof FusionRefusee) {
          $('marche-motif').textContent = erreur.diagnostic.message;
          $('marche-etapes').innerHTML = erreur.marcheASuivre
            .map((etape) => `<li>${etape}</li>`)
            .join('');
          $('marche-a-suivre').classList.remove('hidden');
          dire(
            'message-fusion',
            'Fusion refusée, et rien n’a été écrit : ces deux appareils ont deux passés ' +
              'différents de la même chose. La marche à suivre est au-dessus.',
            'echec',
          );
        } else {
          const motif = erreur instanceof SauvegardeRefusee ? erreur.motif : null;
          dire(
            'message-fusion',
            motif === 'mot-de-passe'
              ? 'Mot de passe incorrect : rien n’a été fusionné.'
              : `Fusion refusée : ${(erreur as Error).message}`,
            'echec',
          );
        }
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>
