---
/**
 * Page « Appareils et synchronisation ».
 *
 * Phase 3a : le **transport manuel**, et lui seul. Le plan le met en premier
 * pour une raison précise — il éprouve le moteur de fusion sans qu'un bogue de
 * réseau puisse être confondu avec un bogue de fusion. L'appairage par QR, la
 * liaison directe et le registre d'appareils viennent après ; cet écran le dit
 * plutôt que de laisser croire qu'il est incomplet par négligence.
 *
 * Trois choses y sont vraies, et la maquette les exigeait toutes les trois :
 * l'empreinte est affichée en permanence, l'aperçu annonce les conflits
 * **avant** la fusion, et l'annulation est offerte sept jours.
 */
import Base from '../layouts/Base.astro';
---

<Base titre="Appareils et synchronisation" actif="progression">
  <h1 class="mb-2 text-2xl font-bold text-slate-900 dark:text-white">
    Appareils et synchronisation
  </h1>
  <p class="mb-8 max-w-3xl text-slate-600 dark:text-slate-300">
    Utiliser Cyclades sur deux appareils, en transportant un fichier de l’un à
    l’autre. <strong>Ce n’est pas une sauvegarde</strong> : la synchronisation
    propage aussi les erreurs et les suppressions. Continuez à sauvegarder.
  </p>

  <div id="chargement" class="py-20 text-center text-slate-400">Lecture de l’état…</div>

  <div id="ecran" class="hidden space-y-8">
    <!-- ── La liaison directe, qui est le chemin le plus court ─────────── -->
    <section
      class="rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5 dark:border-indigo-900 dark:bg-indigo-950/30"
    >
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Plus rapide : la liaison directe
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-600 dark:text-slate-300">
        Un QR visé une fois avec l’autre appareil, et les synchronisations
        suivantes tiennent en un bouton — sans fichier à transporter. Le
        transfert de fichier ci-dessous reste là : il marche sans réseau, et
        c’est le recours quand le reste échoue.
      </p>
      <a
        href="/apparier/"
        class="inline-block rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
      >
        Apparier un appareil
      </a>
    </section>

    <!-- ── Les appareils ───────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">Vos appareils</h2>
      <ul id="appareils" class="space-y-3"></ul>
      <p class="mt-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Les empreintes se comparent <strong>à l’œil</strong>, d’un écran à
        l’autre : quatre groupes de quatre signes. Si deux appareils affichent la
        même, ils portent les mêmes données. Celle d’un autre appareil est celle
        qu’il annonçait la dernière fois qu’il a parlé à celui-ci — elle a pu
        changer depuis.
      </p>
      <div class="mt-4 flex flex-wrap items-end gap-3">
        <label class="block text-sm">
          <span class="mb-1 block text-slate-600 dark:text-slate-300">Nom de cet appareil</span>
          <input
            id="nom-appareil"
            type="text"
            placeholder="Ordinateur de bureau"
            class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
          />
        </label>
        <button
          id="nommer"
          class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
        >
          Enregistrer ce nom
        </button>
      </div>
      <p id="message-nom" class="mt-3 hidden text-sm"></p>
      <p class="mt-3 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Le nom <strong>voyage</strong> : l’autre appareil l’apprendra à la
        prochaine synchronisation. Ce que chacun a vu de l’autre, en revanche,
        reste chez lui — sinon le téléphone afficherait « vu il y a deux jours »
        alors que c’est l’ordinateur qui l’a vu.
      </p>
    </section>

    <!-- ── Sauvegardes partagées ───────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Sauvegardes, tous appareils
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        La même liste des deux côtés. Sans elle, chaque appareil insiste
        séparément : on sauvegarde deux fois le même jour, ou pas du tout en
        croyant que l’autre l’a fait.
      </p>
      <ul id="sauvegardes" class="space-y-2 text-sm"></ul>
    </section>

    <!-- ── Envoyer ─────────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        1. Envoyer depuis cet appareil
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Un fichier chiffré avec le mot de passe du site. Transportez-le comme
        vous voulez — clé USB, partage de fichiers, messagerie : son contenu
        n’est lisible qu’avec votre mot de passe.
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block text-sm">
          <span class="mb-1 block text-slate-600 dark:text-slate-300">Mot de passe du site</span>
          <input
            id="mdp-envoi"
            type="password"
            autocomplete="current-password"
            class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
          />
        </label>
        <button
          id="envoyer"
          class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
        >
          Créer le paquet
        </button>
      </div>
      <p id="message-envoi" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Recevoir ────────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        2. Recevoir sur cet appareil
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Choisissez le paquet venu de l’autre appareil. Vous verrez ce qu’il
        contient <strong>avant</strong> de fusionner, et la fusion restera
        annulable sept jours.
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <input
          id="fichier"
          type="file"
          accept=".paquet,application/octet-stream"
          class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
        />
      </div>

      <div id="apercu" class="mt-4 hidden rounded-xl border border-slate-300 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950">
        <h3 class="mb-3 font-medium text-slate-900 dark:text-white">Avant de fusionner</h3>
        <dl id="apercu-detail" class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4"></dl>
        <p id="apercu-avertissement" class="mt-3 hidden text-sm"></p>
        <div
          id="marche-a-suivre"
          class="mt-3 hidden rounded-xl border border-red-300 bg-red-50 p-4 text-sm dark:border-red-900 dark:bg-red-950/40"
        >
          <p id="marche-motif" class="mb-2 font-medium text-red-900 dark:text-red-200"></p>
          <ol id="marche-etapes" class="list-decimal space-y-1 pl-5 text-red-900/90 dark:text-red-200/90"></ol>
        </div>
        <div class="mt-4 flex flex-wrap items-end gap-3">
          <label class="block text-sm">
            <span class="mb-1 block text-slate-600 dark:text-slate-300">Mot de passe du site</span>
            <input
              id="mdp-fusion"
              type="password"
              autocomplete="current-password"
              class="w-64 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          <button
            id="fusionner"
            class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
          >
            Fusionner
          </button>
        </div>
      </div>
      <p id="message-fusion" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Conflits à traiter ──────────────────────────────────────────── -->
    <section
      id="conflits"
      class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-950/40"
    >
      <h2 class="mb-2 text-lg font-semibold text-amber-900 dark:text-amber-200">
        Conflits à traiter
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-amber-900/80 dark:text-amber-200/80">
        Deux appareils ont enregistré des valeurs différentes pour la même chose.
        <strong>Aucune n’a été écrasée.</strong> En attendant votre réponse, la
        plus récente est affichée et marquée « à vérifier », et les analyses qui
        s’en servent le disent. Votre réponse voyage : elle tranchera le conflit
        sur l’autre appareil aussi.
      </p>
      <ul id="liste-conflits" class="space-y-4 text-sm"></ul>
    </section>
    <!--
      Le message vit **hors** de la section, et c'est une correction de motif et
      non d'instance. Trancher le dernier conflit masque la section — et avec
      elle le message qui confirmait la réponse : on clique, tout s'évanouit, et
      plus rien ne dit si cela a marché. C'est exactement la faute déjà
      rencontrée sur l'historique des synchronisations, refaite ici parce que
      corriger l'instance n'avait rien appris au code. Un message de
      confirmation ne doit jamais être enfant de ce qu'il confirme avoir vidé.
    -->
    <p id="message-conflit" class="hidden text-sm"></p>

    <!-- ── Historique et annulation ────────────────────────────────────── -->
    <section
      id="historique"
      class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
    >
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Synchronisations reçues
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Annuler retire les opérations de cette synchronisation, <strong>et elles
        seules</strong>. Ce que vous avez saisi ici depuis n’est pas touché.
        L’autre appareil les garde : elles reviendront à la prochaine
        synchronisation si vous ne les refusez pas aussi là-bas.
      </p>
      <ul id="lots" class="space-y-3 text-sm"></ul>
      <p id="message-annulation" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Reconstruire ────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Reconstruire les échéances
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-slate-500 dark:text-slate-400">
        Recalcule l’état de toutes vos flashcards à partir du journal de
        révisions. Le journal est la vérité ; l’état n’en est qu’un résumé. À
        faire si une échéance vous paraît fausse — c’est sans danger, et le
        relancer deux fois donne le même résultat.
      </p>
      <button
        id="reconstruire"
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-slate-800"
      >
        Reconstruire depuis le journal
      </button>
      <p id="message-reconstruction" class="mt-3 hidden text-sm"></p>
    </section>

    <!-- ── Ce qui n'est pas encore là ──────────────────────────────────── -->
    <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950">
      <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">
        Ce qui n’est pas encore là
      </h2>
      <ul class="max-w-3xl list-disc space-y-1 pl-5 text-sm text-slate-600 dark:text-slate-300">
        <li>
          L’<strong>XP, le niveau et la série</strong> ne sont pas transportés, et
          ne le seront pas ainsi. Un dernier-écrivain-gagne ferait perdre l’XP
          gagnée sur l’autre appareil ; l’additionner la compterait deux fois. Ils
          se recalculeront depuis les journaux, comme les échéances. En attendant,
          ils restent propres à chaque appareil — c’est la seule réponse honnête.
        </li>
        <li>
          Le <strong>dossier partagé</strong> — déposer le paquet dans un
          emplacement que les deux appareils voient, sans qu’ils soient ouverts
          en même temps. Navigateurs Chromium de bureau seulement, d’après le
          tableau de compatibilité : sur téléphone, cela se réduirait au
          sélecteur de fichiers, c’est-à-dire au transfert ci-dessus déguisé.
        </li>
        <li>
          La <strong>synchronisation en arrière-plan</strong> sur un ordinateur
          certifié, à activer à la main, avec notification et annulation sous
          sept jours.
        </li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import { empreinteLisible } from '../lib/noyau/empreinte';
  import {
    annulable,
    annulerFusion,
    apercuPaquet,
    empreinteLocale,
    etatLocal,
    fabriquerPaquet,
    fusionnerPaquet,
    conflitsALire,
    FusionRefusee,
    lotsRecus,
    nommerAppareil,
    resoudreConflit,
    reconstruireEtatsDerives,
    registreAppareils,
    registreSauvegardes,
    type LotRecu,
  } from '../lib/sync/service';
  import { SauvegardeRefusee } from '../lib/sauvegarde/format';

  const $ = (id: string) => document.getElementById(id)!;

  function dire(id: string, texte: string, ton: 'succes' | 'echec' | 'neutre') {
    const e = $(id);
    e.textContent = texte;
    e.className = `mt-3 text-sm ${
      ton === 'succes'
        ? 'text-emerald-600 dark:text-emerald-400'
        : ton === 'echec'
          ? 'text-amber-600 dark:text-amber-400'
          : 'text-slate-500 dark:text-slate-400'
    }`;
    e.classList.remove('hidden');
  }

  const definitions = (lignes: [string, string][]) =>
    lignes
      .map(
        ([terme, valeur]) =>
          `<div><dt class="text-slate-500 dark:text-slate-400">${terme}</dt>` +
          `<dd class="font-medium text-slate-900 dark:text-white">${valeur}</dd></div>`,
      )
      .join('');

  async function peindreEtat() {
    const [{ lisible }, etat, registre, sauvegardes] = await Promise.all([
      empreinteLocale(),
      etatLocal(),
      registreAppareils(),
      registreSauvegardes(),
    ]);

    $('appareils').innerHTML = registre
      .map((app) => {
        const titre = app.nom
          ? `${app.nom}`
          : app.soi
            ? 'Cet appareil'
            : 'Appareil sans nom';
        const empreinte = app.soi
          ? lisible
          : app.empreinte
            ? empreinteLisible(app.empreinte)
            : '—';
        const etatTexte = app.soi
          ? `${etat.operations.length.toLocaleString('fr-FR')} opérations, ` +
            `${etat.revisions.length.toLocaleString('fr-FR')} révisions`
          : app.vuLe
            ? `vu le ${new Date(app.vuLe).toLocaleString('fr-FR')}`
            : 'jamais rencontré depuis cet appareil';
        return (
          `<li class="rounded-xl border p-3 ${
            app.soi
              ? 'border-indigo-300 bg-indigo-50/50 dark:border-indigo-800 dark:bg-indigo-950/30'
              : 'border-slate-200 dark:border-slate-800'
          }">` +
          `<div class="flex flex-wrap items-baseline justify-between gap-2">` +
          `<span class="font-medium text-slate-900 dark:text-white">${titre}` +
          `${app.soi ? ' <span class="text-xs font-normal text-indigo-700 dark:text-indigo-300">(celui-ci)</span>' : ''}` +
          `</span>` +
          `<span class="font-mono text-sm text-slate-900 dark:text-white">${empreinte}</span>` +
          `</div>` +
          `<div class="mt-1 flex flex-wrap items-baseline justify-between gap-2 text-sm text-slate-500 dark:text-slate-400">` +
          `<span class="font-mono">${app.id}</span><span>${etatTexte}</span>` +
          `</div></li>`
        );
      })
      .join('');

    $('sauvegardes').innerHTML = sauvegardes.length
      ? sauvegardes
          .slice(0, 10)
          .map((s) => {
            const quand = s.le ? new Date(s.le).toLocaleString('fr-FR') : 'date inconnue';
            const nom = registre.find((a) => a.id === s.appareil);
            const qui = nom?.nom ?? s.appareil;
            return (
              `<li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 ` +
              `pb-1 last:border-0 dark:border-slate-800">` +
              `<span class="text-slate-900 dark:text-white">${quand}</span>` +
              `<span class="text-slate-500 dark:text-slate-400">depuis ${qui}</span></li>`
            );
          })
          .join('')
      : '<li class="text-slate-500 dark:text-slate-400">Aucune sauvegarde déclarée. ' +
        'Les sauvegardes faites avant cette version ne sont pas listées : elles n’étaient ' +
        'pas encore déclarées au registre partagé.</li>';

    noms = new Map(registre.filter((a) => a.nom).map((a) => [a.id, a.nom!]));

    const champ = $('nom-appareil') as HTMLInputElement;
    const moi = registre.find((a) => a.soi);
    if (moi?.nom && !champ.value) champ.value = moi.nom;
  }

  async function peindreLots() {
    const lots = await lotsRecus();
    /*
       La section reste **toujours** visible, même sans aucune synchronisation.
       Elle se masquait quand la liste était vide, et annuler la dernière
       synchronisation faisait donc disparaître la section — avec elle, le
       message qui confirmait l'annulation. On cliquait, tout s'évanouissait, et
       plus rien ne disait si cela avait marché. Un état vide nommé vaut mieux
       qu'une section qui s'escamote.
    */
    $('historique').classList.remove('hidden');
    if (!lots.length) {
      $('lots').innerHTML =
        '<li class="text-slate-500 dark:text-slate-400">Aucune synchronisation reçue sur ' +
        'cet appareil.</li>';
      return;
    }
    $('lots').innerHTML = lots
      .map((lot) => {
        const quand = new Date(lot.le).toLocaleString('fr-FR');
        const venu = lot.nomAppareil ?? lot.appareil;
        const encore = annulable(lot);
        const bouton = encore
          ? `<button data-lot="${lot.lot}" class="annuler rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 transition hover:bg-red-100 dark:border-red-800 dark:bg-transparent dark:text-red-300">Annuler</button>`
          : '<span class="text-slate-400">Plus annulable</span>';
        return (
          `<li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 p-3 dark:border-slate-800">` +
          `<span>Le ${quand}, de « ${venu} » : ${lot.operations} opération(s), ` +
          `${lot.revisions} révision(s), ${lot.cartes.length} carte(s) recalculée(s).</span>` +
          `${bouton}</li>`
        );
      })
      .join('');

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('.annuler')) {
      bouton.addEventListener('click', async () => {
        const lot = bouton.dataset.lot!;
        const details = (await lotsRecus()).find((l) => l.lot === lot) as LotRecu;
        const confirme = window.confirm(
          `Annuler la synchronisation du ${new Date(details.le).toLocaleString('fr-FR')} ?\n\n` +
            `Seront retirées ${details.operations} opération(s) et ${details.revisions} ` +
            `révision(s) reçues dans cette synchronisation, et elles seules. ` +
            `${details.cartes.length} carte(s) seront recalculées.\n\n` +
            `Ce que vous avez saisi ici depuis n’est pas touché.`,
        );
        if (!confirme) return;
        bouton.disabled = true;
        try {
          const rapport = await annulerFusion(lot);
          dire(
            'message-annulation',
            `Annulée : ${rapport.retirees} opération(s) et ${rapport.revisionsRetirees} ` +
              `révision(s) retirées, ${rapport.cartesRecalculees} carte(s) recalculée(s).`,
            'succes',
          );
          await peindreEtat();
          await peindreLots();
        } catch (erreur) {
          bouton.disabled = false;
          dire('message-annulation', `Annulation impossible : ${(erreur as Error).message}`, 'echec');
        }
      });
    }
  }

  /**
   * Les conflits ouverts, avec leurs quatre issues.
   *
   * L'ordre des boutons suit la maquette, et il n'est pas indifférent : garder
   * l'une, garder l'autre, puis les deux cas qui demandent une précision. Les
   * deux premiers sont les plus fréquents ; mettre « ignorer » en tête
   * apprendrait à ignorer.
   */
  async function peindreConflits() {
    const { ouverts } = await conflitsALire();
    if (!ouverts.length) {
      /*
         Vider **puis** masquer. Masquer sans vider laisse les anciens conflits
         dans le DOM : ils ne se voient plus, mais ils sont là — et ils
         réapparaîtraient le jour où la section se réaffiche pour un autre
         conflit, le temps d'un repaint. C'est la troisième variante de la même
         faute dans cet écran : masquer n'est pas vider, et un repaint doit
         laisser le DOM dans l'état qu'il décrit.
      */
      $('liste-conflits').innerHTML = '';
      $('conflits').classList.add('hidden');
      return;
    }
    $('conflits').classList.remove('hidden');
    $('liste-conflits').innerHTML = ouverts
      .map((conflit, index) => {
        const valeurs = conflit.operations
          .map((op) => {
            const quand = new Date(Number(op.hlc.slice(0, 15))).toLocaleString('fr-FR');
            const nom = noms.get(op.appareil) ?? op.appareil;
            return (
              `<li class="flex flex-wrap items-baseline justify-between gap-2">` +
              `<code class="text-slate-900 dark:text-white">${JSON.stringify(op.charge)}</code>` +
              `<span class="text-amber-900/70 dark:text-amber-200/70">saisi sur ${nom}, ` +
              `le ${quand}</span>` +
              `<button data-conflit="${index}" data-issue="retenue" data-retenue="${op.id}" ` +
              `class="resoudre rounded-lg border border-amber-400 bg-white px-3 py-1 text-xs ` +
              `font-medium text-amber-900 transition hover:bg-amber-100 dark:border-amber-700 ` +
              `dark:bg-transparent dark:text-amber-200">Garder celle-ci</button></li>`
            );
          })
          .join('');
        const deja = conflit.repondueAvant
          ? `<p class="mt-2 text-amber-900/80 dark:text-amber-200/80">Vous avez déjà répondu à ` +
            `une partie de cette question ; une valeur nouvelle est arrivée depuis.</p>`
          : '';
        return (
          `<li class="rounded-xl border border-amber-300 bg-white p-4 dark:border-amber-800 ` +
          `dark:bg-slate-900">` +
          `<p class="mb-2 font-medium text-slate-900 dark:text-white">${conflit.type} — ` +
          `${conflit.cible}</p>` +
          `<ul class="space-y-2">${valeurs}</ul>${deja}` +
          `<div class="mt-3 flex flex-wrap gap-2">` +
          `<button data-conflit="${index}" data-issue="toutes-justes" ` +
          `class="resoudre rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs ` +
          `font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 ` +
          `dark:bg-transparent dark:text-slate-100">Les deux sont justes</button>` +
          `<button data-conflit="${index}" data-issue="ignore" ` +
          `class="resoudre rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs ` +
          `font-medium text-slate-800 transition hover:bg-slate-100 dark:border-slate-700 ` +
          `dark:bg-transparent dark:text-slate-100">Ignorer</button></div></li>`
        );
      })
      .join('');

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('.resoudre')) {
      bouton.addEventListener('click', async () => {
        const conflit = ouverts[Number(bouton.dataset.conflit)];
        const issue = bouton.dataset.issue as 'retenue' | 'toutes-justes' | 'ignore';
        let precision: string | undefined;
        if (issue !== 'retenue') {
          const question =
            issue === 'toutes-justes'
              ? 'En quoi les deux sont-elles justes ? (deux pesées dans la journée, par exemple)'
              : 'Pourquoi ne pas trancher maintenant ?';
          precision = window.prompt(question) ?? undefined;
          // Une annulation de l'invite n'est pas une réponse : on ne journalise
          // rien plutôt que d'enregistrer un motif vide.
          if (!precision?.trim()) return;
        }
        bouton.disabled = true;
        try {
          await resoudreConflit(conflit, {
            issue,
            retenue: bouton.dataset.retenue,
            precision,
          });
          dire(
            'message-conflit',
            'Réponse enregistrée. Elle voyagera vers vos autres appareils à la prochaine ' +
              'synchronisation.',
            'succes',
          );
          await peindreEtat();
          await peindreConflits();
        } catch (erreur) {
          bouton.disabled = false;
          dire('message-conflit', `${(erreur as Error).message}`, 'echec');
        }
      });
    }
  }

  /** Les noms d'appareils, pour nommer qui a saisi quoi dans un conflit. */
  let noms = new Map<string, string>();

  let octetsRecus: Uint8Array | null = null;

  auDeverrouillage(async () => {
    await peindreEtat();
    await peindreConflits();
    await peindreLots();
    $('chargement').classList.add('hidden');
    $('ecran').classList.remove('hidden');

    $('envoyer').addEventListener('click', async () => {
      const mdp = ($('mdp-envoi') as HTMLInputElement).value;
      if (!mdp) {
        dire('message-envoi', 'Le mot de passe est nécessaire : un paquet n’est jamais en clair.', 'echec');
        return;
      }
      dire('message-envoi', 'Fabrication du paquet…', 'neutre');
      try {
        /* Le nom vient du registre et non d'un champ de cette section : il est
           déclaré une fois, et voyage comme un fait. */
        const moi = (await registreAppareils()).find((a) => a.soi);
        const paquet = await fabriquerPaquet(mdp, { nomAppareil: moi?.nom });
        const url = URL.createObjectURL(
          new Blob([paquet.octets], { type: 'application/octet-stream' }),
        );
        const a = document.createElement('a');
        a.href = url;
        a.download = paquet.nom;
        a.click();
        URL.revokeObjectURL(url);
        ($('mdp-envoi') as HTMLInputElement).value = '';
        dire(
          'message-envoi',
          `Paquet créé : ${paquet.operations} opération(s), ${paquet.revisions} révision(s), ` +
            `${(paquet.tailleFichier / 1024).toFixed(1)} Kio. Transportez-le sur l’autre appareil.`,
          'succes',
        );
      } catch (erreur) {
        dire('message-envoi', `Échec : ${(erreur as Error).message}`, 'echec');
      }
    });

    $('nommer').addEventListener('click', async () => {
      const nom = ($('nom-appareil') as HTMLInputElement).value.trim();
      if (!nom) {
        dire('message-nom', 'Donnez un nom : c’est lui qui distinguera les deux écrans.', 'echec');
        return;
      }
      try {
        await nommerAppareil(nom);
        dire(
          'message-nom',
          `Nom enregistré. L’autre appareil l’apprendra à la prochaine synchronisation.`,
          'succes',
        );
        await peindreEtat();
      } catch (erreur) {
        dire('message-nom', `Échec : ${(erreur as Error).message}`, 'echec');
      }
    });

    $('reconstruire').addEventListener('click', async () => {
      const bouton = $('reconstruire') as HTMLButtonElement;
      bouton.disabled = true;
      dire('message-reconstruction', 'Recalcul en cours…', 'neutre');
      try {
        const rapport = await reconstruireEtatsDerives();
        dire(
          'message-reconstruction',
          `${rapport.cartes} carte(s) recalculée(s) depuis le journal.` +
            (rapport.sansJournal
              ? ` ${rapport.sansJournal} carte(s) n’ont pas d’entrée au journal : leur état est ` +
                'laissé tel quel, parce qu’on ne sait pas le reconstituer.'
              : ''),
          'succes',
        );
        await peindreEtat();
      } catch (erreur) {
        dire('message-reconstruction', `Échec : ${(erreur as Error).message}`, 'echec');
      } finally {
        bouton.disabled = false;
      }
    });

    $('fichier').addEventListener('change', async (evenement) => {
      const fichier = (evenement.target as HTMLInputElement).files?.[0];
      $('apercu').classList.add('hidden');
      $('message-fusion').classList.add('hidden');
      // Cacher ne suffit pas : la marche à suivre d'un refus précédent
      // réapparaîtrait avec l'aperçu du fichier suivant.
      $('marche-a-suivre').classList.add('hidden');
      $('marche-etapes').innerHTML = '';
      $('marche-motif').textContent = '';
      if (!fichier) return;
      try {
        octetsRecus = new Uint8Array(await fichier.arrayBuffer());
        const vu = await apercuPaquet(octetsRecus);
        const { complete } = await empreinteLocale();
        $('apercu-detail').innerHTML = definitions([
          ['Venu de', vu.metadonnees.nomAppareil ?? vu.metadonnees.appareil],
          ['Empreinte annoncée', empreinteLisible(vu.metadonnees.empreinte)],
          ['Taille', `${(vu.tailleFichier / 1024).toFixed(1)} Kio`],
          ['Intégrité', vu.intact ? 'intact ✓' : 'abîmé'],
        ]);
        const avertissements: string[] = [];
        if (!vu.intact) {
          avertissements.push(
            'Ce fichier est incomplet ou abîmé : sa somme de contrôle ne correspond pas. ' +
              'La fusion sera refusée.',
          );
        }
        if (vu.metadonnees.empreinte === complete) {
          avertissements.push(
            'Les empreintes sont déjà identiques : ce paquet n’apporte rien, et le fusionner ' +
              'ne changera rien. C’est sans danger.',
          );
        }
        if (avertissements.length) {
          dire('apercu-avertissement', avertissements.join(' '), vu.intact ? 'neutre' : 'echec');
        } else {
          $('apercu-avertissement').classList.add('hidden');
        }
        $('apercu').classList.remove('hidden');
      } catch (erreur) {
        const motif = erreur instanceof SauvegardeRefusee ? ` (${erreur.motif})` : '';
        dire('message-fusion', `Ce fichier n’est pas un paquet Cyclades${motif}.`, 'echec');
      }
    });

    $('fusionner').addEventListener('click', async () => {
      if (!octetsRecus) return;
      const mdp = ($('mdp-fusion') as HTMLInputElement).value;
      if (!mdp) {
        dire('message-fusion', 'Le mot de passe du site est nécessaire pour déchiffrer le paquet.', 'echec');
        return;
      }
      const bouton = $('fusionner') as HTMLButtonElement;
      bouton.disabled = true;
      dire('message-fusion', 'Fusion en cours…', 'neutre');
      $('marche-a-suivre').classList.add('hidden');
      try {
        const rapport = await fusionnerPaquet(octetsRecus, mdp);
        /*
           Le diagnostic de la fusion est **affiché même quand il est
           favorable** : savoir que les deux appareils n'avaient aucune histoire
           commune mais que les réunir ne perdait rien vaut mieux que de ne rien
           savoir et de s'inquiéter après coup. Il vient du rapport, et non d'un
           appel séparé qui redériverait la clé.
        */
        dire('apercu-avertissement', rapport.diagnostic.message, 'neutre');
        ($('mdp-fusion') as HTMLInputElement).value = '';
        const parties = [
          `${rapport.recues} opération(s) et ${rapport.revisionsRecues} révision(s) reçues`,
          `${rapport.cartesRecalculees} carte(s) recalculée(s)`,
        ];
        if (rapport.reglagesChanges.length) {
          parties.push(
            `${rapport.reglagesChanges.length} réglage(s) mis à jour ` +
              `(${rapport.reglagesChanges.join(', ')})`,
          );
        }
        if (rapport.conflits) parties.push(`${rapport.conflits} conflit(s) à traiter`);
        if (rapport.collisions) {
          parties.push(
            `${rapport.collisions} collision(s) d’identifiants — ce paquet est peut-être abîmé`,
          );
        }
        parties.push(
          rapport.identiques
            ? 'les deux appareils sont désormais identiques ✓'
            : 'les empreintes diffèrent encore : envoyez aussi un paquet depuis cet appareil',
        );
        dire('message-fusion', `${parties.join(' ; ')}.`, 'succes');
        await peindreEtat();
        await peindreConflits();
        await peindreLots();
      } catch (erreur) {
        if (erreur instanceof FusionRefusee) {
          $('marche-motif').textContent = erreur.diagnostic.message;
          $('marche-etapes').innerHTML = erreur.marcheASuivre
            .map((etape) => `<li>${etape}</li>`)
            .join('');
          $('marche-a-suivre').classList.remove('hidden');
          dire(
            'message-fusion',
            'Fusion refusée, et rien n’a été écrit : ces deux appareils ont deux passés ' +
              'différents de la même chose. La marche à suivre est au-dessus.',
            'echec',
          );
        } else {
          const motif = erreur instanceof SauvegardeRefusee ? erreur.motif : null;
          dire(
            'message-fusion',
            motif === 'mot-de-passe'
              ? 'Mot de passe incorrect : rien n’a été fusionné.'
              : `Fusion refusée : ${(erreur as Error).message}`,
            'echec',
          );
        }
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>
