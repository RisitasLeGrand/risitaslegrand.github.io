---
/**
 * Le menu de garde : la première page de Cyclades.
 *
 * ## Pourquoi ce n'est pas un tableau de bord
 *
 * La section 0.1 du prompt complémentaire est explicite : « la première page de
 * Cyclades est un menu qui ouvre le choix entre Odyssée, Sport et Révisions.
 * Aucune branche n'est la page d'accueil du site. » Jusqu'ici, `/` **était** le
 * tableau de bord de Révisions — ce qui se tenait quand il n'y avait qu'une
 * branche, et qui ferait d'elle la branche principale dès qu'il y en aura
 * trois.
 *
 * Le tableau de bord n'a pas disparu : il est à `/revisions/`. Seul l'accueil a
 * bougé, et les autres écrans de la branche gardent leurs chemins — ils en
 * portent déjà de propres (`/flashcards/`, `/planification/`), et un renommage
 * massif de chemins casse en silence une ressource chiffrée dont le chemin est
 * écrit dans un manifeste.
 *
 * ## Ce que le menu affiche, et ce qu'il n'affiche pas
 *
 * Le prénom, si la personne l'a donné et n'a pas coupé la salutation. Rien
 * d'autre de personnel : pas d'XP, pas de série, pas de compte de cartes dues.
 * Un menu qui annoncerait le retard du jour transformerait la porte d'entrée en
 * reproche.
 *
 * Une branche indisponible porte « Bientôt » et n'est pas cliquable. Un onglet
 * qui mène à une page vide ne renseigne personne : il promet.
 */
import Base from '../layouts/Base.astro';
import { BRANCHES } from '../lib/branches';
import { base } from '../lib/ui';
import config from '../../site.config.mjs';
---

<Base titre="Menu" entete="leger">
  <div class="mx-auto max-w-5xl">
    <header class="mb-8">
      <p class="text-sm font-medium tracking-wide text-indigo-600 uppercase dark:text-indigo-400">
        {config.titre}
      </p>
      <h1 id="salutation" class="mt-1 text-3xl font-bold text-slate-900 dark:text-white">
        Bonjour.
      </h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
        Trois branches, une seule base de données, un seul mot de passe. Choisissez par où
        commencer.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        BRANCHES.map((b) => (
          <li>
            {b.disponible ? (
              <a
                href={`${base}${b.racine}`}
                data-branche={b.id}
                class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-800"
              >
                <span class="text-3xl" aria-hidden="true">
                  {b.icone}
                </span>
                <span class="mt-3 text-lg font-semibold text-slate-900 dark:text-white">
                  {b.libelle}
                </span>
                <span class="mt-1 flex-1 text-sm text-slate-500 dark:text-slate-400">
                  {b.description}
                </span>
                <span class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
                  Entrer →
                </span>
              </a>
            ) : (
              <div
                data-branche={b.id}
                aria-disabled="true"
                class="flex h-full cursor-not-allowed flex-col rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-950"
              >
                <span class="text-3xl opacity-50" aria-hidden="true">
                  {b.icone}
                </span>
                <span class="mt-3 text-lg font-semibold text-slate-500 dark:text-slate-400">
                  {b.libelle}
                </span>
                <span class="mt-1 flex-1 text-sm text-slate-400 dark:text-slate-500">
                  {b.description}
                </span>
                <span class="mt-4 text-sm font-medium text-slate-400 dark:text-slate-500">
                  Bientôt
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <!-- ── La proposition du jour (A.8) ─────────────────────────────────
         Au plus une par semaine, jamais bloquante : elle est **sous** les
         cartes, elle n'a pas de bouton de fermeture obligatoire, et l'ignorer
         est une réponse qui ne coûte rien. -->
    <section
      id="proposition"
      class="mt-8 hidden rounded-2xl border border-sky-300 bg-sky-50 p-5 dark:border-sky-800 dark:bg-sky-950/40"
      aria-live="polite"
    >
      <p class="text-xs font-medium tracking-wide text-sky-700 uppercase dark:text-sky-300">
        Observé, pas déclaré
      </p>
      <p id="proposition-constat" class="mt-1 text-sm text-sky-900 dark:text-sky-100"></p>
      <p id="proposition-question" class="mt-2 font-medium text-slate-900 dark:text-white"></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button
          id="proposition-oui"
          type="button"
          class="min-h-11 rounded-lg bg-sky-700 px-4 text-sm font-medium text-white transition hover:bg-sky-800"
        >
          D’accord
        </button>
        <button
          id="proposition-plus-tard"
          type="button"
          class="min-h-11 rounded-lg border border-sky-400 px-4 text-sm font-medium text-sky-800 transition hover:bg-sky-100 dark:border-sky-700 dark:text-sky-200 dark:hover:bg-sky-900/50"
        >
          Plus tard
        </button>
        <button
          id="proposition-non"
          type="button"
          class="min-h-11 rounded-lg px-4 text-sm font-medium text-slate-600 underline-offset-2 transition hover:underline dark:text-slate-300"
        >
          Non, laissez comme ça
        </button>
      </div>
      <p id="proposition-reponse" class="mt-3 hidden text-sm text-slate-700 dark:text-slate-200"></p>
    </section>

    <nav class="mt-10 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Écrans communs">
      <a
        href={`${base}/profil/`}
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Mon profil
      </a>
      <a
        href={`${base}/syntheses/`}
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Mes synthèses
      </a>
      <a
        href={`${base}/appareils/`}
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Appareils
      </a>
      <a
        href={`${base}/stockage/`}
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Stockage
      </a>
      <a
        href={`${base}/progression/`}
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Sauvegarde
      </a>
    </nav>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../lib/chargement';
  import { base } from '../lib/ui';

  /*
     La salutation est le seul élément personnel du menu, et elle se charge
     **après** le déverrouillage : le prénom est dans la base chiffrée, donc il
     n'existe pas avant. Son absence n'est pas un défaut — « Bonjour. » est une
     salutation complète.
  */
  auDeverrouillage(async () => {
    /*
       La garde d'A.1 : mot de passe → *(première fois)* initialisation → menu.
       Elle est **ici** et non dans le déverrouillage lui-même, parce que la
       marque d'initialisation vit dans la base chiffrée : avant l'ouverture de
       la session, on ne sait pas encore s'il faut initialiser. Et elle ne
       retient personne — l'écran d'initialisation porte « Terminer maintenant »
       sur chacune de ses questions.
    */
    const { porteLocale } = await import('../lib/initialisation');
    const porte = await porteLocale();
    if (porte.quoi === 'initialiser') {
      window.location.replace(`${base}/initialisation/`);
      return;
    }

    const { prenom } = await import('../lib/profil');
    const nom = await prenom();
    if (nom) document.getElementById('salutation')!.textContent = `Bonjour ${nom}.`;

    /*
       La proposition vient **après** l'affichage, et son échec n'empêche rien :
       elle publie les faits pour observer l'usage, et une porte d'entrée qui
       attendrait ce calcul serait bloquante par accident — ce qu'A.8 interdit
       par principe.
    */
    void montrerProposition();
  });

  async function montrerProposition() {
    try {
      const { accepter, propositionLocale, refuser, reporterProposition } = await import(
        '../lib/adaptation'
      );
      const { proposition } = await propositionLocale();
      if (!proposition) return;

      const bloc = document.getElementById('proposition')!;
      document.getElementById('proposition-constat')!.textContent = proposition.constat;
      document.getElementById('proposition-question')!.textContent = proposition.question;
      bloc.classList.remove('hidden');

      const repondre = async (travail: () => Promise<void>, message: string) => {
        await travail();
        for (const id of ['proposition-oui', 'proposition-plus-tard', 'proposition-non']) {
          document.getElementById(id)!.classList.add('hidden');
        }
        const reponse = document.getElementById('proposition-reponse')!;
        reponse.textContent = message;
        reponse.classList.remove('hidden');
      };

      document.getElementById('proposition-oui')!.addEventListener('click', () => {
        void repondre(
          () => accepter(proposition),
          'C’est noté. Vous pouvez tout remettre comme avant depuis « Mon profil ».',
        );
      });
      document.getElementById('proposition-plus-tard')!.addEventListener('click', () => {
        void repondre(() => reporterProposition(proposition), 'On en reparle dans deux semaines.');
      });
      document.getElementById('proposition-non')!.addEventListener('click', () => {
        void repondre(() => refuser(proposition), 'Entendu. Cette question ne reviendra pas.');
      });
    } catch (erreur) {
      console.warn('Proposition d’adaptation indisponible :', erreur);
    }
  }
</script>
