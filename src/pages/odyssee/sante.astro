---
/**
 * Odyssée : santé et traitements.
 *
 * Phase 1 du prompt 25, livrée sous la ligne `D-024` de l'audit : **la forme,
 * sans les valeurs**. On y déclare ce qu'on prend, ce qu'on a fait doser, ce
 * qu'on ressent et ce qui dure. Rien n'y est évalué.
 *
 * ## Pourquoi un écran distinct de « Mon corps »
 *
 * Les deux ont des rythmes d'usage opposés, et c'est la décision 3.1 du plan.
 * Le corps se note tous les jours en dix secondes — une pesée, un verre
 * d'eau. La santé s'ouvre par épisodes : un bilan tous les trois mois, une
 * déclaration de traitement. Les réunir ferait un écran long où le geste
 * quotidien se noie.
 *
 * Même domaine `corps`, en revanche : les faits y sont déjà déclarés, les
 * permissions écrites, et Sport lit « corps ». Conséquence voulue — **le
 * coffre ne verrouille pas le quotidien** : peser et noter un repas reste
 * possible coffre fermé, et le mot de passe n'est demandé qu'ici.
 *
 * ## Ce que cet écran ne fera jamais
 *
 * Pas de posologie proposée, pas de rappel d'oubli, pas de courbe de
 * concentration — « une courbe projetée à partir des doses déclarées **est**
 * un outil de planification de dose, quel que soit l'avertissement qui
 * l'accompagne » (décision 3.2). Le seul calcul affiché est le **délai depuis
 * la dernière prise**, qui est une soustraction entre deux instants saisis.
 */
import Base from '../../layouts/Base.astro';
import LienReglages from '../../components/LienReglages.astro';
import { POURQUOI_CATALOGUE_VIDE } from '../../lib/odyssee/sante';
import FormulaireCoffre from '../../components/FormulaireCoffre.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base titre="Santé" actif="sante" coffre>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Santé et traitements</h1>
    <LienReglages section="odyssee" class="mt-2" />
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      Ce que vous prenez, ce que vous faites doser, ce que vous ressentez. Tout est chiffré dans
      la base : illisible sans le mot de passe, y compris pour une extension de navigateur ou
      quelqu’un qui ouvre cet ordinateur.
    </p>
    <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
      <strong>Enregistrement seul.</strong> Aucune dose proposée, aucune vérification
      d’interaction, aucune courbe projetée. Cet écran range ce que vous écrivez et vous le
      rend ; il ne donne aucun avis. Si vous déclarez un schéma prévu, il vous rappelle <strong
      >votre déclaration, telle que vous l’avez écrite</strong>, et jamais un conseil de
      rattrapage.
    </p>

    <!-- ── Avant activation ──────────────────────────────────────────── -->
    <section id="pas-active" class="mt-6 hidden rounded-2xl border-2 border-slate-300 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Cet espace est fermé</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
        Il ne s’ouvre que si vous le demandez, et il reste fermé sur vos autres appareils tant que
        vous ne les ouvrez pas aussi : l’activation ne se synchronise pas.
      </p>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
        Ce qu’il permettrait : déclarer un traitement et sa période, marquer les prises, prévoir
        un schéma et s’en faire rappeler, enregistrer un prélèvement et ses résultats avec
        l’intervalle de votre laboratoire, noter un symptôme, inscrire une condition qui dure.
      </p>
      <button id="activer" type="button"
        class="cible-tactile mt-4 rounded-lg bg-slate-800 px-4 text-sm font-medium text-white dark:bg-slate-200 dark:text-slate-900"
        >Ouvrir l’espace Santé</button>
    </section>

    <!-- ── Coffre fermé ──────────────────────────────────────────────── -->
    <FormulaireCoffre />

    <!-- ── L'écran ───────────────────────────────────────────────────── -->
    <div id="coffre-ouvert" class="hidden space-y-8">
      <p id="erreur" class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-800 dark:bg-rose-950/40 dark:text-rose-200"></p>

      <!--
        Le bandeau du catalogue vide. Il n'est pas une excuse : c'est le
        contenu de la phase. Une fiche de molécule porte une demi-vie, une
        maturité clinique et un statut antidopage, et aucune de ces valeurs
        n'entrera sans source. Tant qu'il n'y en a pas, le catalogue est vide
        et le dit — plutôt que d'afficher des chiffres d'allure savante.
      -->
      <section class="rounded-2xl border border-amber-300 bg-amber-50/70 p-4 dark:border-amber-800 dark:bg-amber-950/30">
        <h2 class="text-sm font-bold tracking-wide text-amber-900 uppercase dark:text-amber-200">
          Valeurs non sourcées
        </h2>
        <p id="bandeau-catalogue" class="mt-2 text-sm text-amber-900 dark:text-amber-100"></p>
      </section>

      <!--
        Aujourd'hui — phase 4, P2.

        En tête de l'écran, parce que c'est le geste quotidien : le prompt
        veut « deux appuis au plus depuis l'accueil de Santé », et un bloc
        placé après quatre formulaires en aurait demandé un de défilement.

        Il reste caché tant qu'aucun traitement ne porte de schéma. Une
        section vide intitulée « Aujourd'hui » apprendrait à sauter ce coin
        de l'écran, et c'est le coin qu'on veut qu'on regarde.
      -->
      <section id="bloc-aujourdhui" class="hidden">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Aujourd’hui</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Ce que vous aviez prévu, et ce que vous en avez noté. «&nbsp;Pas aujourd’hui&nbsp;» est
          une réponse comme une autre : rien n’est compté, rien ne vous est reproché, et aucune
          trace négative n’en reste.
        </p>
        {/*
           `creneaux-du-jour` et non le nom court : il existe un RÉGLAGE déduit
           qui porte justement l'identifiant court — « Plages proposées pour vos
           séances », déclaré `applique: null` parce qu'aucun écran ne s'en
           sert. `essais:reglages-appliques` vérifie que personne ne nomme un
           réglage non appliqué, et il trouvait la recherche d'élément de cet
           écran : une collision de noms, entre deux choses qui n'ont rien de
           commun. L'identifiant dit maintenant ce que la liste porte, et le
           commentaire se garde de réécrire le nom court, qui rallumerait le
           contrôle pour rien.
        */}
        <ul id="creneaux-du-jour" class="mt-3 space-y-2"></ul>
      </section>

      <!-- Traitements -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes traitements</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Le nom tel que vous l’écrivez, la période, et la posologie <strong>en toutes lettres</strong>.
          Un nombre appellerait un calcul, le calcul une comparaison, et la comparaison serait un
          avis que cet écran n’a pas à rendre.
        </p>
        <!--
           Le menu des molécules (2.8).

           Une liste déroulante classique aurait tenu un millier d'entrées et
           aurait été inutilisable au doigt. C'est donc un champ de recherche
           qui propose, et un champ de nom qui reste libre : « ma molécule
           n'est pas dans la liste » n'est pas une sortie de secours
           optionnelle, c'est le cas normal tant que le registre est absent.

           Rien de ce qui est tapé ici n'est enregistré. Seule la déclaration
           validée l'est.
        -->
        <div class="sm:col-span-2">
          <label for="t-chercher" class="mb-1 block text-sm font-medium text-slate-600 dark:text-slate-300">
            Chercher une molécule
          </label>
          <input id="t-chercher" type="search" autocomplete="off"
            placeholder="Trois lettres suffisent"
            class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          <p id="etat-registre" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></p>
          <p class="mt-1 text-xs">
            <a
              id="vers-bibliographie"
              href="#"
              class="cible-tactile font-medium text-indigo-600 underline dark:text-indigo-300"
              >Bibliographie hors ligne — 25 226 références, copie figée</a
            >
          </p>
          <ul id="suggestions" class="mt-1 max-h-64 space-y-1 overflow-y-auto" role="listbox" aria-label="Molécules proposées"></ul>
        </div>

        <form id="form-traitement" class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Nom du traitement</span>
            <input id="t-nom" type="text" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Début du traitement</span>
            <input id="t-debut" type="date" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm sm:col-span-2">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Posologie (facultatif)</span>
            <input id="t-posologie" type="text" placeholder="1 comprimé le matin"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Origine du traitement</span>
            <select id="t-origine"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
              <option value="moi">De ma propre initiative</option>
              <option value="prescrit">Prescrit</option>
            </select>
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Prescripteur (facultatif)</span>
            <input id="t-prescripteur" type="text"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="flex items-center gap-2 text-sm text-slate-600 sm:col-span-2 dark:text-slate-300">
            <input id="t-sporadique" type="checkbox" class="rounded" />
            <span>Prise sporadique — une prise isolée, sans schéma ni rappel</span>
          </label>
          <button type="submit"
            class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white sm:col-span-2"
            >Déclarer ce traitement</button>
        </form>
        <ul id="traitements" class="mt-4 space-y-2"></ul>

        <!--
          L'export vers l'agenda — P3.

          Caché tant qu'aucun traitement ne demande de rappel par agenda : un
          bouton qui produirait un fichier vide est pire qu'un bouton absent,
          puisqu'il faut l'ouvrir pour apprendre qu'il n'y avait rien.
        -->
        <div id="export-agenda" class="mt-4 hidden rounded-2xl border border-slate-200 p-4 dark:border-slate-800">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Vos rappels dans votre agenda</h3>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Un événement récurrent avec alarme, par heure prévue. C’est la seule voie qui sonne
            quand Cyclades est fermé. Réexporter met à jour les mêmes événements au lieu d’en
            ajouter d’autres.
          </p>
          <button id="telecharger-agenda" type="button"
            class="cible-tactile mt-3 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white"
            >Exporter vers mon agenda</button>
          <p id="export-fait" class="mt-2 hidden text-xs text-slate-600 dark:text-slate-300"></p>
        </div>

        <!--
          La porte permanente vers le catalogue (M10).

          Le lien « Voir la fiche » que porte chaque traitement ne naît que
          s'il existe un traitement : sur un appareil qui n'en déclare aucun,
          la page des molécules redevenait orpheline. Celle-ci ne dépend
          d'aucune donnée. Elle est dans le bloc « coffre ouvert » comme tout
          le reste — elle ne dit rien d'Alexis, mais la règle est qu'aucun
          texte ne s'ajoute coffre fermé, et elle vaut aussi pour ce qui est
          anodin.
        -->
        <p class="mt-3">
          <a
            id="vers-catalogue-molecules"
            href={`${base}/odyssee/molecule/`}
            class="cible-tactile rounded-lg text-sm text-indigo-700 underline dark:text-indigo-300"
          >Les fiches de molécules documentées</a>
        </p>
      </section>

      <!-- Prélèvements -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes prélèvements</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Notez le <strong>contexte</strong> au moment du prélèvement — « à jeun », « 3 h après la
          prise ». Deux bilans pris dans des contextes différents ne se comparent pas, et cela ne
          se reconstitue pas six mois plus tard.
        </p>
        <form id="form-prelevement" class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Date du bilan</span>
            <input id="p-jour" type="date" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Laboratoire (facultatif)</span>
            <input id="p-labo" type="text"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm sm:col-span-2">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Contexte du bilan (facultatif)</span>
            <input id="p-contexte" type="text" placeholder="à jeun, 3 h après la prise"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button type="submit"
            class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white sm:col-span-2"
            >Enregistrer ce prélèvement</button>
        </form>
        <ul id="prelevements" class="mt-4 space-y-3"></ul>
      </section>

      <!-- Symptômes -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes symptômes</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          L’intensité est <strong>la vôtre</strong>, de 0 à 10. Elle sert à vous relire, jamais à
          déclencher quoi que ce soit.
        </p>
        <form id="form-symptome" class="mt-3 grid gap-2 sm:grid-cols-3">
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Date du symptôme</span>
            <input id="s-jour" type="date" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Ce que vous ressentez</span>
            <input id="s-intitule" type="text" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Intensité, de 0 à 10</span>
            <input id="s-intensite" type="number" min="0" max="10" step="1" inputmode="numeric" value="5"
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button type="submit"
            class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white sm:col-span-3"
            >Noter ce symptôme</button>
        </form>
        <ul id="symptomes" class="mt-4 space-y-2"></ul>
      </section>

      <!-- Conditions -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Ce qui dure</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Une condition que <strong>vous</strong> déclarez. Ce n’est pas un diagnostic posé par
          Cyclades : c’est une ligne de contexte que vous écrivez pour vous.
        </p>
        <form id="form-condition" class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Intitulé de la condition</span>
            <input id="c-intitule" type="text" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700 dark:text-slate-200">Début de la condition</span>
            <input id="c-debut" type="date" required
              class="cible-tactile w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button type="submit"
            class="cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white sm:col-span-2"
            >Inscrire</button>
        </form>
        <ul id="conditions" class="mt-4 space-y-2"></ul>
      </section>
    </div>
  </div>
</Base>

<script define:vars={{ POURQUOI_CATALOGUE_VIDE }}>
  window.__pourquoiCatalogueVide = POURQUOI_CATALOGUE_VIDE;
</script>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { messageDUneErreur } from '../../lib/agir';
  import { unSeulGeste } from '../../lib/geste';
  import { proposerLAnnulation } from '../../lib/annulation';
  import { jourLogique } from '../../lib/noyau/jour-logique';
  import { coffreOuvert, ouvrirLeCoffre, reprendreLeCoffre, surCoffre } from '../../lib/coffre';
  import {
    controlerSchema,
    creneauxDuJour,
    etatDuCreneau,
    heuresDepuisLaDernierePrise,
    idDuCreneau,
    rangerLesHeures,
    reglageParDefaut,
    situerDansLIntervalle,
    AVERTISSEMENT_LIBELLE_EXPLICITE,
    controlerReglage,
    DELAIS_D_OUBLI,
    type CreneauPrevu,
    type EtatDeCreneau,
    type MarqueDeCreneau,
    type RenduDeCreneau,
    type ReglageDeRappel,
    type RepetitionDePrise,
    type SchemaDePrise,
    type Traitement,
  } from '../../lib/odyssee/sante';
  import type { JourSemaine } from '../../lib/odyssee/repetition';
  import { creneauxOublies, texteDuRappelDOubli } from '../../lib/odyssee/rappels';
  import { ATTRIBUTION } from '../../lib/odyssee/bibliotheque-externe';
  import { lien } from '../../lib/ui';
  import { nombreEntier } from '../../lib/nombre-saisi';
  import { controlerAvantEnvoi, validerALaSortie } from '../../lib/erreur-de-champ';
  import { chercher, type EntreeRegistre } from '../../lib/odyssee/molecules';
  import { chargerRegistreMolecules } from '../../lib/contenu';
  import { toutesLesPrises } from '../../lib/odyssee/donnees-sensible';
  import {
    activerLaSante,
    effacerLaMarque,
    noterLeCreneau,
    poserLeRappel,
    poserLeSchema,
    toutesLesMarques,
    ecrireCondition,
    ecrirePrelevement,
    ecrireSymptome,
    ecrireTraitement,
    santeActive,
    supprimerCondition,
    supprimerPrelevement,
    supprimerSymptome,
    supprimerTraitement,
    toutesLesConditions,
    tousLesPrelevements,
    tousLesResultats,
    tousLesSymptomes,
    tousLesTraitements,
  } from '../../lib/odyssee/donnees-sante';

  const $ = (id: string) => document.getElementById(id)!;
  const dire = (e: unknown) => {
    const z = $('erreur');
    z.textContent = messageDUneErreur(e);
    z.classList.remove('hidden');
  };

  const AUJOURDHUI = jourLogique(new Date());

  function ligne(texte: string, detail: string, retirer: () => Promise<void>): HTMLLIElement {
    const li = document.createElement('li');
    li.className =
      'flex flex-wrap items-baseline justify-between gap-2 rounded-xl border border-slate-200 p-3 dark:border-slate-800';
    const gauche = document.createElement('div');
    const titre = document.createElement('p');
    titre.className = 'font-medium text-slate-900 dark:text-white';
    titre.textContent = texte;
    const sous = document.createElement('p');
    sous.className = 'mt-0.5 text-xs text-slate-500 dark:text-slate-400';
    sous.textContent = detail;
    gauche.append(titre, sous);
    const bouton = document.createElement('button');
    bouton.type = 'button';
    bouton.className =
      'cible-tactile rounded-lg border border-slate-400 px-3 text-xs dark:border-slate-600';
    bouton.textContent = 'Retirer';
    bouton.addEventListener('click', () => void retirer().then(peindre).catch(dire));
    li.append(gauche, bouton);
    return li;
  }

  /* ── Les créneaux du jour — phase 4, P2 ──────────────────────────── */

  /**
   * Une heure murale à la française : « 8 h », « 8 h 12 », « 20 h 30 ».
   *
   * Les espaces sont **insécables** : « 8 h » coupé en fin de ligne laisserait
   * un « 8 » orphelin au-dessus d'un « h ».
   */
  function enHeure(hhmm: string): string {
    const [h, m] = hhmm.split(':').map(Number);
    return m === 0 ? `${h} h` : `${h} h ${String(m).padStart(2, '0')}`;
  }

  /** L'heure murale d'un instant, dans la même forme. */
  const instantEnHeure = (iso: string): string => {
    const d = new Date(iso);
    const hh = String(d.getHours()).padStart(2, '0');
    return enHeure(`${hh}:${String(d.getMinutes()).padStart(2, '0')}`);
  };

  const cleDuCreneau = (c: CreneauPrevu) => `${c.traitementId}|${c.jour}|${c.heure}`;

  /**
   * Ce qui est **annoncé à l'écran mais pas encore écrit**.
   *
   * Le bandeau d'annulation ne défait rien : il retarde l'écriture de six
   * secondes, et annuler consiste à ne pas partir. L'écran doit donc montrer
   * tout de suite ce qui va être écrit, sans que ce soit en base — d'où ce
   * registre, consulté par la peinture et vidé dans les deux issues.
   *
   * Tant qu'un créneau y figure, sa ligne ne porte **aucun bouton** : le
   * chemin de retour est le bandeau, et en offrir un second ferait partir
   * une suppression d'une marque qui n'existe pas encore.
   */
  const enAttente = new Map<string, RenduDeCreneau>();

  /**
   * Un créneau du jour, avec ses deux appuis.
   *
   * Le libellé visible est celui du prompt — « Pris », « Pas aujourd'hui » —
   * et le nom accessible est une phrase entière. Les deux publics n'ont pas
   * le même contexte : à l'œil, deux mots suffisent parce que la ligne porte
   * déjà le nom et l'heure ; un lecteur d'écran, lui, annonce le bouton
   * seul, et « Pris » n'y veut rien dire.
   */
  function ligneDeCreneau(
    traitement: Traitement,
    creneau: CreneauPrevu,
    rendu: RenduDeCreneau,
    attendu: boolean,
    oublie: boolean,
  ): HTMLLIElement {
    const li = document.createElement('li');
    li.className =
      'flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 p-3 dark:border-slate-800';
    li.dataset.creneau = creneau.heure;
    li.dataset.etat = rendu.etat;

    const gauche = document.createElement('div');
    const titre = document.createElement('p');
    titre.className = 'font-medium text-slate-900 dark:text-white';
    titre.textContent = traitement.nom;
    const sous = document.createElement('p');
    /*
       AUCUNE COULEUR D'ÉCHEC, et c'est l'interdit § 1 n° 3 rendu visible :
       un créneau sans réponse est gris comme les autres. Une pastille rouge
       à 20 h sur une prise de 8 h serait le reproche que le texte a pris
       soin d'éviter, rendu par la couleur.
    */
    sous.className = 'mt-0.5 text-xs text-slate-500 dark:text-slate-400';
    const quantite = traitement.schema?.quantite ?? '';
    /*
       LE TEXTE DU RAPPEL D'OUBLI EST ICI, et c'est le seul endroit où il
       s'écrit en toutes lettres. Au centre de notifications, l'élément ne
       porte aucun texte (§ 2.3 du prompt 32) ; en notification du système,
       le libellé est une constante unique. Ce qui reste est l'écran, où le
       coffre est déjà ouvert — ce que P4 appelle « sous coffre ».

       Il REMPLACE la ligne ordinaire au lieu de s'y ajouter : « Prévu à
       8 h » suivi de « prévue à 8 h, rien n'est noté » dirait deux fois la
       même chose, et la répétition ferait du constat une insistance.
    */
    const prevu = `Prévu à ${enHeure(creneau.heure)}${quantite ? ` · ${quantite}` : ''}`;
    sous.textContent =
      rendu.etat === 'pris'
        ? `${prevu} · Noté à ${instantEnHeure(rendu.le)}`
        : rendu.etat === 'pas-aujourdhui'
          ? `${prevu} · Pas aujourd’hui`
          : oublie
            ? `${texteDuRappelDOubli(traitement, creneau.heure)}${quantite ? ` · ${quantite}` : ''}`
            : prevu;
    gauche.append(titre, sous);
    li.append(gauche);

    if (attendu) return li;

    const droite = document.createElement('div');
    droite.className = 'flex gap-2';

    if (rendu.etat === 'prevu') {
      const gestes: [string, EtatDeCreneau, string][] = [
        ['Pris', 'pris', `Noter la prise de ${traitement.nom} prévue à ${enHeure(creneau.heure)}`],
        [
          'Pas aujourd’hui',
          'pas-aujourdhui',
          `Noter que la prise de ${traitement.nom} prévue à ${enHeure(creneau.heure)} n’aura pas lieu aujourd’hui`,
        ],
      ];
      for (const [libelle, etat, phrase] of gestes) {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className =
          etat === 'pris'
            ? 'cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white'
            : 'cible-tactile rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600';
        bouton.textContent = libelle;
        bouton.setAttribute('aria-label', phrase);
        bouton.addEventListener('click', () => {
          void unSeulGeste(bouton, () => marquer(traitement, creneau, etat)).catch(dire);
        });
        droite.append(bouton);
      }
    } else {
      /*
         Revenir en arrière après coup, et ce n'est pas une troisième
         réponse : effacer la marque rend le créneau à l'ABSENCE, celle-là
         même qu'il avait avant le premier appui — donc celle que le rappel
         d'oubli relira comme « rien n'est noté ».
      */
      const reprendre = document.createElement('button');
      reprendre.type = 'button';
      reprendre.className =
        'cible-tactile rounded-lg border border-slate-400 px-3 text-xs dark:border-slate-600';
      reprendre.textContent = 'Reprendre';
      reprendre.setAttribute(
        'aria-label',
        `Reprendre ce qui a été noté pour ${traitement.nom} à ${enHeure(creneau.heure)}`,
      );
      reprendre.addEventListener('click', () => {
        void unSeulGeste(reprendre, async () => {
          await effacerLaMarque(await idDuCreneau(traitement.id, creneau.jour, creneau.heure));
          await peindre();
        }).catch(dire);
      });
      droite.append(reprendre);
    }

    li.append(droite);
    return li;
  }

  /**
   * Note un créneau, avec les six secondes d'annulation.
   *
   * L'instant est pris **ici, au geste**, et passé à l'écriture. Le bandeau
   * retarde celle-ci de six secondes ; sans ce passage, l'heure notée serait
   * celle de l'expiration du bandeau et non celle du pouce. Six secondes ne
   * changent rien à une prise — mais une donnée dont on sait qu'elle est
   * fausse de six secondes est une donnée dont on ne sait plus de combien
   * elle est fausse.
   */
  async function marquer(
    traitement: Traitement,
    creneau: CreneauPrevu,
    etat: EtatDeCreneau,
  ): Promise<void> {
    const le = new Date();
    const cle = cleDuCreneau(creneau);
    enAttente.set(
      cle,
      etat === 'pris' ? { etat: 'pris', le: le.toISOString() } : { etat: 'pas-aujourdhui' },
    );
    await proposerLAnnulation({
      texte: etat === 'pris' ? 'Prise notée' : 'Noté : pas aujourd’hui',
      /*
         L'ÉCRAN DÉCLARE SON INTENTION, il n'appelle plus l'écriture.

         Le registre rappellera `noterLeCreneau` à l'échéance, ou au prochain
         démarrage si l'on quitte pendant le délai. La charge porte
         l'IDENTIFIANT du traitement et non le traitement : le registre le
         relit, et refuse si entre-temps il a été supprimé — écrire une prise
         sur un traitement disparu serait une note sur rien.
      */
      genre: 'noter-creneau',
      charge: {
        traitementId: traitement.id,
        jour: creneau.jour,
        heure: creneau.heure,
        etat,
        le: le.toISOString(),
      },
      /* Vidé même en cas d'échec — le module l'appelle dans un `finally` :
         laisser la ligne annoncer une écriture qui n'a pas eu lieu serait le
         pire des deux états. L'erreur, elle, s'affiche. */
      apres: async () => {
        enAttente.delete(cle);
        await peindre();
      },
      defaire: () => {
        enAttente.delete(cle);
        void peindre().catch(dire);
      },
    });
    await peindre();
  }

  /** Les créneaux du jour, tous traitements confondus, triés par heure. */
  function peindreLesCreneaux(
    traitements: readonly Traitement[],
    marques: readonly MarqueDeCreneau[],
    oublies: readonly string[],
  ): void {
    const zone = $('creneaux-du-jour');
    zone.replaceChildren();

    const duJour = traitements
      .flatMap((t) => creneauxDuJour(t, AUJOURDHUI).map((c) => ({ t, c })))
      .sort((a, b) => a.c.heure.localeCompare(b.c.heure) || a.t.nom.localeCompare(b.t.nom, 'fr'));

    /*
       Le bloc entier disparaît quand il n'y a rien : une section
       « Aujourd'hui » vide apprendrait à sauter ce coin de l'écran, et c'est
       le coin qu'on veut qu'on regarde.
    */
    $('bloc-aujourdhui').classList.toggle('hidden', duJour.length === 0);

    for (const { t, c } of duJour) {
      const attendu = enAttente.get(cleDuCreneau(c));
      zone.append(
        ligneDeCreneau(
          t,
          c,
          attendu ?? etatDuCreneau(c, marques),
          Boolean(attendu),
          !attendu && oublies.includes(cleDuCreneau(c)),
        ),
      );
    }
  }

  /* ── L'éditeur de schéma, sur chaque traitement — phase 4, P1 ────── */

  /**
   * Les jours de la semaine, dans l'ordre où on les lit.
   *
   * Le modèle compte à partir du dimanche (`0`), convention de
   * `Date.getUTCDay()` que le dépôt emploie déjà. L'écran commence le lundi,
   * et la traduction est faite ici — c'est le travail de l'écran, et le
   * commentaire de `repetition.ts` le dit en toutes lettres.
   */
  const JOURS_AFFICHES: [JourSemaine, string][] = [
    [1, 'lundi'],
    [2, 'mardi'],
    [3, 'mercredi'],
    [4, 'jeudi'],
    [5, 'vendredi'],
    [6, 'samedi'],
    [0, 'dimanche'],
  ];

  /**
   * Le formulaire de schéma d'un traitement, replié par défaut.
   *
   * Replié parce que c'est un réglage qu'on pose une fois et qu'on ne relit
   * jamais : déplié, il ferait de la liste des traitements un mur de cases à
   * cocher, et le geste quotidien — répondre aux créneaux du jour — est en
   * haut de l'écran, pas ici.
   *
   * **Absent pour une prise sporadique**, et pas seulement désactivé : la
   * décision 12 dit qu'elle n'en a pas, et un formulaire grisé laisserait
   * croire qu'il suffit de décocher quelque chose.
   */
  function editeurDeSchema(t: Traitement): HTMLDetailsElement {
    const bloc = document.createElement('details');
    bloc.className = 'mt-2 w-full';
    const resume = document.createElement('summary');
    resume.className = 'cible-tactile cursor-pointer text-xs text-indigo-700 dark:text-indigo-300';
    resume.textContent = t.schema ? 'Modifier le schéma prévu' : 'Prévoir un schéma';
    bloc.append(resume);

    const form = document.createElement('form');
    form.className = 'mt-2 grid gap-2 rounded-xl bg-slate-50 p-3 text-sm dark:bg-slate-900';

    /* L'état en cours d'édition, jamais écrit avant l'envoi. */
    let heures = [...(t.schema?.heures ?? [])];
    const repetition = t.schema?.repetition ?? { type: 'jours' as const, tous: 1 };

    const sorte = document.createElement('select');
    sorte.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    sorte.setAttribute('aria-label', 'Rythme du schéma');
    for (const [valeur, libelle] of [
      ['jours', 'Tous les N jours'],
      ['semaines', 'Certains jours de la semaine'],
    ]) {
      sorte.append(new Option(libelle, valeur));
    }
    sorte.value = repetition.type;

    const tous = document.createElement('input');
    tous.type = 'number';
    tous.min = '1';
    tous.step = '1';
    tous.value = String(repetition.tous);
    tous.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    tous.setAttribute('aria-label', 'Un jour sur combien');

    const cases = document.createElement('fieldset');
    cases.className = 'flex flex-wrap gap-3';
    const legende = document.createElement('legend');
    legende.className = 'text-xs text-slate-500 dark:text-slate-400';
    legende.textContent = 'Les jours';
    cases.append(legende);
    const choisis = new Set<JourSemaine>(
      repetition.type === 'semaines' ? repetition.jours : [],
    );
    for (const [valeur, libelle] of JOURS_AFFICHES) {
      const etiquette = document.createElement('label');
      etiquette.className = 'flex items-center gap-1 text-xs';
      const boite = document.createElement('input');
      boite.type = 'checkbox';
      boite.className = 'rounded';
      boite.checked = choisis.has(valeur);
      boite.addEventListener('change', () => {
        if (boite.checked) choisis.add(valeur);
        else choisis.delete(valeur);
      });
      etiquette.append(boite, document.createTextNode(libelle));
      cases.append(etiquette);
    }

    /* L'une ou l'autre, jamais les deux : deux règles visibles à la fois
       laisseraient croire qu'elles se combinent. */
    const montrerCeQuiVa = () => {
      tous.classList.toggle('hidden', sorte.value !== 'jours');
      cases.classList.toggle('hidden', sorte.value !== 'semaines');
    };
    sorte.addEventListener('change', montrerCeQuiVa);

    const listeDHeures = document.createElement('ul');
    listeDHeures.className = 'flex flex-wrap gap-2';
    const peindreLesHeures = () => {
      listeDHeures.replaceChildren();
      for (const h of heures) {
        const puce = document.createElement('li');
        puce.className =
          'flex items-center gap-1 rounded-lg border border-slate-400 px-2 py-1 text-xs dark:border-slate-600';
        puce.append(document.createTextNode(enHeure(h)));
        const retirer = document.createElement('button');
        retirer.type = 'button';
        retirer.className = 'cible-tactile px-1';
        retirer.textContent = '×';
        retirer.setAttribute('aria-label', `Retirer l’heure de ${enHeure(h)}`);
        retirer.addEventListener('click', () => {
          heures = heures.filter((x) => x !== h);
          peindreLesHeures();
        });
        puce.append(retirer);
        listeDHeures.append(puce);
      }
    };
    peindreLesHeures();

    const heure = document.createElement('input');
    heure.type = 'time';
    heure.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    heure.setAttribute('aria-label', 'Une heure à ajouter');
    const ajouter = document.createElement('button');
    ajouter.type = 'button';
    ajouter.className =
      'cible-tactile rounded-lg border border-slate-400 px-3 text-xs dark:border-slate-600';
    ajouter.textContent = 'Ajouter cette heure';
    ajouter.addEventListener('click', () => {
      if (!heure.value) return;
      heures = rangerLesHeures([...heures, heure.value]);
      heure.value = '';
      peindreLesHeures();
    });

    const quantite = document.createElement('input');
    quantite.type = 'text';
    quantite.value = t.schema?.quantite ?? '';
    quantite.placeholder = 'Quantité, dans vos mots — « 5 g »';
    quantite.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    quantite.setAttribute('aria-label', 'Quantité prévue, en toutes lettres');

    const enregistrer = document.createElement('button');
    enregistrer.type = 'submit';
    enregistrer.className =
      'cible-tactile rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white';
    enregistrer.textContent = 'Enregistrer le schéma';

    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap gap-2';
    actions.append(enregistrer);
    if (t.schema) {
      const oter = document.createElement('button');
      oter.type = 'button';
      oter.className =
        'cible-tactile rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600';
      oter.textContent = 'Retirer le schéma';
      oter.setAttribute('aria-label', `Retirer le schéma prévu de ${t.nom}`);
      /*
         Retirer le schéma ne touche à aucune marque déjà posée : ce qui a
         été noté a eu lieu, et l'effacer parce qu'on cesse de prévoir
         réécrirait le passé.
      */
      oter.addEventListener('click', () => {
        void unSeulGeste(oter, async () => {
          await poserLeSchema(t.id, null);
          await peindre();
        }).catch(dire);
      });
      actions.append(oter);
    }

    const aide = document.createElement('p');
    aide.className = 'text-xs text-slate-500 dark:text-slate-400';
    aide.textContent =
      'Ce que vous écrivez ici est votre déclaration. Cyclades ne la propose pas, ne la ' +
      'compare à aucune fiche et ne la corrige jamais.';

    form.append(sorte, tous, cases, listeDHeures, heure, ajouter, quantite, aide, actions);
    montrerCeQuiVa();

    form.addEventListener('submit', (evenement) => {
      evenement.preventDefault();
      void unSeulGeste(form, async () => {
        const regle: RepetitionDePrise =
          sorte.value === 'semaines'
            ? { type: 'semaines', tous: 1, jours: [...choisis].sort() }
            : { type: 'jours', tous: Number(tous.value) };
        const schema: SchemaDePrise = {
          repetition: regle,
          heures: rangerLesHeures(heures),
          quantite: quantite.value.trim(),
        };
        /*
           Les problèmes sont dits à l'écran plutôt que levés : un schéma à
           moitié rempli est l'état normal d'un formulaire qu'on est en train
           de remplir, et une exception rouge en haut de page pour une heure
           manquante serait disproportionnée.
        */
        const problemes = controlerSchema(schema);
        if (problemes.length) {
          dire(problemes.join(' '));
          return;
        }
        await poserLeSchema(t.id, schema);
        await peindre();
      }).catch(dire);
    });

    bloc.append(form);
    return bloc;
  }


  /* ── Le réglage de rappel, sur chaque traitement — phase 4, P3 et P4 ── */

  /**
   * Ce que chaque voie fait vraiment, écrit à l'écran plutôt que promis.
   *
   * Le § 1 n° 6 l'exige — « ce qu'un site statique ne peut pas faire est dit
   * à l'écran, pas promis » — et le plan l'avait anticipé : seul l'agenda
   * sonne application fermée. Ces deux phrases sont la part du lot qui
   * empêche la déception, et elles coûtent deux lignes.
   */
  const CE_QUE_FAIT_LA_VOIE: Record<string, string> = {
    agenda:
      'Un événement récurrent avec alarme, exporté dans votre agenda. C’est la seule voie qui ' +
      'sonne quand Cyclades est fermé, y compris sur iPhone. En retour, votre agenda ne sait ' +
      'pas si vous avez noté la prise : il sonne à l’heure prévue, jamais en cas d’oubli.',
    notification:
      'Une notification de Cyclades, qui part quand l’application est ouverte — ou quand le ' +
      'navigateur la réveille, ce qu’il ne fait que sur Android avec l’application installée. ' +
      'Sur iPhone, rien ne part tant que Cyclades est fermé.',
  };

  /**
   * Où la relance d'oubli arrive, et où elle n'arrive pas.
   *
   * Dit à l'écran parce que la décision du 19 octobre l'exige d'elle-même, et
   * parce qu'une fonction qu'on croit en marche est pire qu'une fonction dont
   * on sait qu'elle attend. Aucun conseil, aucun décompte : le § 1 n° 2 et
   * n° 3 valent ici comme partout dans Santé.
   */
  const OU_LA_RELANCE_ARRIVE =
    'Cette relance s’affiche sur cet écran, et nulle part ailleurs : elle ne paraît pas au ' +
    'centre de notifications. Cyclades l’y retient tant que la nature des molécules n’est pas ' +
    'établie par une source, pour qu’un rappel ne puisse pas renseigner sur ce que vous prenez.';

  /**
   * Le formulaire de rappel d'un traitement, replié lui aussi.
   *
   * **Absent tant qu'il n'y a pas de schéma** : un rappel sans heure prévue
   * n'aurait rien à rappeler, et `controlerTraitement` le refuse de toute
   * façon. Le proposer puis le refuser serait une porte peinte sur un mur.
   */
  function editeurDeRappel(t: Traitement): HTMLDetailsElement | null {
    if (!t.schema || t.sporadique) return null;

    const depart = t.rappel ?? reglageParDefaut();
    const bloc = document.createElement('details');
    bloc.className = 'mt-1 w-full';
    const resume = document.createElement('summary');
    resume.className = 'cible-tactile cursor-pointer text-xs text-indigo-700 dark:text-indigo-300';
    resume.textContent = depart.actif ? 'Modifier le rappel' : 'Me rappeler ces prises';
    bloc.append(resume);

    const form = document.createElement('form');
    form.className = 'mt-2 grid gap-2 rounded-xl bg-slate-50 p-3 text-sm dark:bg-slate-900';

    const coche = (texte: string, etat: boolean) => {
      const etiquette = document.createElement('label');
      etiquette.className = 'flex items-start gap-2';
      const boite = document.createElement('input');
      boite.type = 'checkbox';
      boite.className = 'mt-1 rounded';
      boite.checked = etat;
      etiquette.append(boite, document.createTextNode(texte));
      return { etiquette, boite };
    };

    const actif = coche('Me rappeler', depart.actif);
    const oubli = coche('Me le rappeler si je n’ai rien noté', depart.oubli);

    /*
       OÙ CE RAPPEL ARRIVE, ET OÙ IL N'ARRIVE PAS.

       La relance d'oubli est bien déposée au centre de notifications par
       « recenserLesOublis » — et le filtre du cycle l'écarte aussitôt :
       « rappel-de-prise » est déclaré « exigeUneClasse », aucune molécule ne
       porte de classe, donc aucun rappel de prise n'entre au centre. C'est
       l'option (a) arbitrée le 19 octobre, et elle est juste : un rappel admis
       sans connaître la nature de la molécule renseignerait sur ce que la
       personne prend.

       Ce que personne n'avait écrit, c'est la phrase que cette décision
       exige d'elle-même — « la conséquence est à dire à la personne, et non à
       cacher ». Elle manquait partout : la case s'offrait, la relance
       s'affichait ici, et le centre restait vide sans que rien ne le dise.
       Une fonction silencieusement absente est pire qu'une fonction refusée,
       parce qu'on la croit en marche.

       C'est le même principe que « CE_QUE_FAIT_LA_VOIE » juste au-dessus :
       ce qu'un site ne fait pas se dit à l'écran, il ne se devine pas.
    */
    const ouCaArrive = document.createElement('p');
    ouCaArrive.className = 'text-xs text-slate-500 dark:text-slate-400';
    ouCaArrive.textContent = OU_LA_RELANCE_ARRIVE;

    const voie = document.createElement('select');
    voie.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    voie.setAttribute('aria-label', 'Par quelle voie vous rappeler');
    voie.append(new Option('Par mon agenda', 'agenda'), new Option('Par une notification de Cyclades', 'notification'));
    voie.value = depart.voie;

    const ceQueCaFait = document.createElement('p');
    ceQueCaFait.className = 'text-xs text-slate-500 dark:text-slate-400';

    const libelle = document.createElement('select');
    libelle.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    libelle.setAttribute('aria-label', 'Ce que le rappel affiche');
    libelle.append(
      new Option('« Rappel Cyclades », sans autre mention', 'neutre'),
      new Option('Le nom du traitement', 'explicite'),
      new Option('Un texte de mon choix', 'personnalise'),
    );
    libelle.value = depart.libelle;

    const texte = document.createElement('input');
    texte.type = 'text';
    texte.value = depart.texte;
    texte.placeholder = 'Le texte du rappel';
    texte.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    texte.setAttribute('aria-label', 'Le texte de votre rappel');

    /*
       L'AVERTISSEMENT DU § 3.3, et il n'est pas décoratif : choisir un
       libellé qui nomme sans savoir que l'agenda est peut-être synchronisé
       chez un tiers n'est pas un choix éclairé, et c'est le seul endroit où
       Cyclades peut le dire.
    */
    const avertissement = document.createElement('p');
    avertissement.className =
      'rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:bg-amber-950/40 dark:text-amber-100';
    avertissement.textContent = AVERTISSEMENT_LIBELLE_EXPLICITE;

    const delai = document.createElement('select');
    delai.className =
      'cible-tactile rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950';
    delai.setAttribute('aria-label', 'Au bout de combien de temps vous le rappeler');
    for (const minutes of DELAIS_D_OUBLI) {
      delai.append(
        new Option(minutes < 60 ? `${minutes} minutes après` : `${minutes / 60} h après`, String(minutes)),
      );
    }
    delai.value = String(depart.delaiOubli);

    const limite = document.createElement('p');
    limite.className = 'text-xs text-slate-500 dark:text-slate-400';
    /*
       LA LIMITE DU RAPPEL D'OUBLI, dite en entier. Elle est plus sévère que
       celle que j'avais annoncée : la clé du coffre vit dans
       « sessionStorage », qui meurt avec l'onglet et qu'un service worker ne
       peut pas lire. Même réveillé, il ne saurait lire ni le schéma ni les
       prises, qui sont scellés. Le rappel d'oubli ne part donc que Cyclades
       ouvert et coffre ouvert — et le dire vaut mieux que de le laisser
       découvrir un matin où il n'est pas venu.
    */
    limite.textContent =
      'Ce rappel ne peut partir que si Cyclades est ouvert et votre coffre déverrouillé : ' +
      'ce qui était prévu est chiffré, et rien ne peut le relire sans votre mot de passe. ' +
      'Votre agenda, lui, sonne à l’heure prévue même application fermée — mais il ne sait ' +
      'pas si vous avez noté la prise.';

    const montrerCeQuiVa = () => {
      ceQueCaFait.textContent = CE_QUE_FAIT_LA_VOIE[voie.value] ?? '';
      texte.classList.toggle('hidden', libelle.value !== 'personnalise');
      avertissement.classList.toggle('hidden', libelle.value === 'neutre');
      /*
         Tout le reste disparaît quand le rappel est éteint : des réglages
         visibles sous une case décochée laissent croire qu'ils agissent.
      */
      for (const element of [voie, ceQueCaFait, libelle, texte, avertissement, oubli.etiquette, ouCaArrive, delai, limite]) {
        element.classList.toggle('hidden', !actif.boite.checked);
      }
      if (actif.boite.checked) {
        texte.classList.toggle('hidden', libelle.value !== 'personnalise');
        avertissement.classList.toggle('hidden', libelle.value === 'neutre');
        delai.classList.toggle('hidden', !oubli.boite.checked);
        limite.classList.toggle('hidden', !oubli.boite.checked);
      }
    };
    for (const element of [actif.boite, oubli.boite, voie, libelle]) {
      element.addEventListener('change', montrerCeQuiVa);
    }

    const enregistrer = document.createElement('button');
    enregistrer.type = 'submit';
    enregistrer.className =
      'cible-tactile justify-self-start rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white';
    enregistrer.textContent = 'Enregistrer ce réglage';

    form.append(
      actif.etiquette,
      voie,
      ceQueCaFait,
      libelle,
      texte,
      avertissement,
      oubli.etiquette,
      ouCaArrive,
      delai,
      limite,
      enregistrer,
    );
    montrerCeQuiVa();

    form.addEventListener('submit', (evenement) => {
      evenement.preventDefault();
      void unSeulGeste(form, async () => {
        const reglage: ReglageDeRappel = {
          actif: actif.boite.checked,
          voie: voie.value as ReglageDeRappel['voie'],
          libelle: libelle.value as ReglageDeRappel['libelle'],
          texte: texte.value.trim(),
          oubli: actif.boite.checked && oubli.boite.checked,
          delaiOubli: Number(delai.value),
        };
        const problemes = controlerReglage(reglage);
        if (problemes.length) {
          dire(problemes.join(' '));
          return;
        }
        await poserLeRappel(t.id, reglage.actif ? reglage : null);
        await peindre();
      }).catch(dire);
    });

    bloc.append(form);
    return bloc;
  }

  /**
   * Le bouton d'export vers l'agenda.
   *
   * Il n'apparaît **que** si au moins un traitement demande un rappel par
   * agenda : un bouton qui produirait un fichier vide est pire qu'un bouton
   * absent, puisqu'il faut l'ouvrir pour apprendre qu'il n'y avait rien.
   */
  function peindreLExport(traitements: readonly Traitement[]): void {
    const zone = $('export-agenda');
    const concernes = traitements.filter((t) => t.rappel?.actif && t.rappel.voie === 'agenda');
    zone.classList.toggle('hidden', concernes.length === 0);
    if (!concernes.length) return;

    const bouton = $('telecharger-agenda');
    bouton.onclick = () =>
      void unSeulGeste(bouton, async () => {
        const { rappelsEnIcs } = await import('../../lib/odyssee/rappels-ics');
        const { offrirLeFichier } = await import('../../lib/telecharger');
        let fichier = '';
        try {
          fichier = rappelsEnIcs(concernes);
        } catch (e) {
          /*
             Un fuseau que Cyclades n'a pas vérifié : on le DIT, plutôt que
             d'écrire des rappels faux d'une heure pendant six mois. Le
             message de l'erreur est écrit pour être lu par la personne.
          */
          dire(e);
          return;
        }
        if (!fichier) return;
        offrirLeFichier(fichier, `rappels-${AUJOURDHUI}.ics`, 'text/calendar;charset=utf-8');
        const dit = $('export-fait');
        dit.classList.remove('hidden');
        const combien = fichier.split('BEGIN:VEVENT').length - 1;
        dit.textContent =
          combien === 1
            ? 'Un rappel exporté. Ouvrez le fichier pour l’ajouter à votre agenda.'
            : `${combien} rappels exportés. Ouvrez le fichier pour les ajouter à votre agenda.`;
      }).catch(dire);
  }

  /* ── Le menu des molécules (2.8) ─────────────────────────────────── */

  /**
   * Le registre, chargé une fois à l'ouverture de l'écran.
   *
   * Son absence est un état normal : le fichier n'existe que si l'extraction
   * a été lancée à la main. Le menu le dit, et la saisie libre reste le
   * chemin principal — elle l'était déjà avant ce menu, et elle le reste
   * après.
   */
  let registre: EntreeRegistre[] = [];

  async function chargerLeMenu() {
    try {
      const brut = await chargerRegistreMolecules();
      registre = brut.map((e) => ({ ...e, alias: e.alias ?? [] }));
      /*
         Le crédit accompagne la liste, et pas seulement la passerelle.

         Ces noms viennent de la bibliothèque citée : les afficher sans dire
         d'où ils sortent reviendrait à les présenter comme ceux de Cyclades,
         et la seule condition posée par leur auteur est précisément d'être
         nommé. La mention est donc sur l'écran qui s'en sert.
      */
      $('etat-registre').textContent =
        `${registre.length} molécules proposées. Figurer dans cette liste n’est ni une ` +
        'validation, ni un encouragement, ni une indication de disponibilité légale. ' +
        ATTRIBUTION;
    } catch {
      registre = [];
      $('etat-registre').textContent =
        'Aucun registre de molécules sur cet appareil : écrivez le nom directement. ' +
        '(« npm run molecules:registre » le construit, hors du dépôt.)';
    }
  }

  function peindreSuggestions() {
    const zone = $('suggestions');
    const q = ($('t-chercher') as HTMLInputElement).value.trim();
    zone.innerHTML = '';
    if (!registre.length || q.length < 2) return;

    /*
       Vingt propositions au plus. Le registre en compte près d'un millier :
       tout peindre coûterait une seconde sur téléphone pour un résultat que
       personne ne lit au-delà de la dixième ligne.
    */
    for (const e of chercher(registre, q, new Set(), 20)) {
      const li = document.createElement('li');
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.className =
        'cible-tactile w-full justify-between gap-2 rounded-lg border border-slate-200 px-3 ' +
        'text-left text-sm hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-900';
      const nom = document.createElement('span');
      nom.textContent = e.nom;
      const etat = document.createElement('span');
      etat.className = 'text-xs text-slate-400';
      etat.textContent = [
        e.fiche ? 'fiche disponible' : 'sans fiche',
        e.identiteVerifiee ? '' : 'identité non vérifiée',
      ]
        .filter(Boolean)
        .join(' · ');
      bouton.append(nom, etat);
      bouton.addEventListener('click', () => {
        ($('t-nom') as HTMLInputElement).value = e.nom;
        ($('t-chercher') as HTMLInputElement).value = '';
        zone.innerHTML = '';
        ($('t-debut') as HTMLInputElement).focus();
      });
      li.appendChild(bouton);
      zone.appendChild(li);
    }
  }

  async function peindre() {
    $('erreur').classList.add('hidden');
    $('bandeau-catalogue').textContent = (window as unknown as {
      __pourquoiCatalogueVide: string;
    }).__pourquoiCatalogueVide;

    const [traitements, prelevements, resultats, symptomes, conditions, prises, marques] =
      await Promise.all([
        tousLesTraitements(),
        tousLesPrelevements(),
        tousLesResultats(),
        tousLesSymptomes(),
        toutesLesConditions(),
        toutesLesPrises(),
        toutesLesMarques(),
      ]);

    /*
       LES RAPPELS D'OUBLI, calculés ici et déposés au centre.

       Le recensement est idempotent : l'identifiant d'un élément dérive de
       sa source et de sa référence, et `deposer` n'émet que pour un élément
       NEUF. Rafraîchir cet écran dix fois ne fait donc pas dix
       notifications — c'est « une seule relance par créneau », obtenue sans
       aucun code de garde.

       Et c'est bien ici qu'il faut le faire, faute de mieux : ce calcul lit
       des traitements et des créneaux scellés, donc il exige le coffre
       ouvert. Un service worker réveillé en arrière-plan n'y arriverait
       pas — il n'a pas accès au stockage de session où vit la clé. C'est la
       limite que l'écran du réglage annonce.
    */
    const oublies = creneauxOublies(traitements, marques, new Date(), AUJOURDHUI);
    peindreLesCreneaux(traitements, marques, oublies.map((o) => `${o.traitementId}|${o.jour}|${o.heure}`));
    peindreLExport(traitements);
    void (async () => {
      const { recenserLesOublis } = await import('../../lib/notifications/alimentation');
      await recenserLesOublis(oublies.map((o) => o.ref));
    })().catch(() => {
      /* Le centre est hors d'atteinte : l'écran, lui, a déjà tout montré.
         Une notification qui ne part pas coûte un signal ; un écran qui
         plante pour cela coûte la page entière. */
    });

    const zoneT = $('traitements');
    zoneT.replaceChildren();
    for (const t of [...traitements].sort((a, b) => b.debut.localeCompare(a.debut))) {
      const heures = heuresDepuisLaDernierePrise(prises, t.id, new Date().toISOString());
      /*
         « Aucune prise enregistrée » et « il y a 3 h » sont deux informations
         différentes, et « 0 h » dirait la seconde à la place de la première.
      */
      /*
         « il y a 0 h » était la phrase rendue sous l'heure, et personne ne
         l'avait jamais lue : `ecrirePrise` n'écrivant pas `traitementId`, ce
         calcul rendait toujours `null`. La correction de P2 l'a rendue
         atteignable, et donc visible — une prise notée à l'instant
         s'affichait « dernière prise il y a 0 h ».

         Les trois paliers disent ce que la personne lirait elle-même : moins
         d'une heure, des heures, des jours. Au-delà de deux jours, l'heure
         ne veut plus rien dire — « il y a 73 h » demande un calcul mental
         pour apprendre qu'il s'agit d'avant-hier.
      */
      const depuis =
        heures === null
          ? 'aucune prise enregistrée'
          : heures < 1
            ? 'dernière prise il y a moins d’une heure'
            : heures < 48
              ? `dernière prise il y a ${Math.round(heures)} h`
              : `dernière prise il y a ${Math.round(heures / 24)} jours`;
      const periode = t.fin ? `du ${t.debut} au ${t.fin}` : `depuis le ${t.debut}`;
      const li = ligne(
        t.nom,
        [periode, t.posologie, depuis].filter(Boolean).join(' · '),
        () => supprimerTraitement(t.id),
      );
      /*
         Le lien par le sens (M10) : un traitement déclaré ouvre la fiche de sa
         molécule. Elle existait depuis le 16 octobre et **rien n'y menait** —
         on ne pouvait l'ouvrir qu'en tapant l'adresse.

         Il porte l'**identifiant** du traitement, jamais le nom de la
         molécule : un nom dans une adresse entre dans l'historique du
         navigateur, qui n'est pas sous coffre. La fiche le relit dans le
         magasin scellé, où il est à sa place. Et cette ligne n'est peinte que
         coffre ouvert, comme tout ce bloc.
      */
      const versFiche = document.createElement('a');
      versFiche.href = lien(`/odyssee/molecule/?traitement=${encodeURIComponent(t.id)}`);
      versFiche.className =
        'cible-tactile w-full rounded-lg px-3 text-xs text-indigo-700 underline dark:text-indigo-300';
      versFiche.textContent = 'Voir la fiche de la molécule';
      li.appendChild(versFiche);
      /*
         Le schéma prévu ne se propose qu'aux traitements qui peuvent en
         porter un. Pour une prise sporadique, le formulaire est ABSENT et
         non grisé : la décision 12 dit qu'elle n'en a pas, et un champ
         désactivé laisserait croire qu'il suffit de décocher quelque chose.
      */
      if (!t.sporadique) li.appendChild(editeurDeSchema(t));
      const rappel = editeurDeRappel(t);
      if (rappel) li.appendChild(rappel);
      zoneT.appendChild(li);
    }

    const zoneP = $('prelevements');
    zoneP.replaceChildren();
    for (const p of [...prelevements].sort((a, b) => b.jour.localeCompare(a.jour))) {
      const li = ligne(
        `Prélèvement du ${p.jour}`,
        [p.laboratoire, p.contexte].filter(Boolean).join(' · ') || 'sans précision',
        () => supprimerPrelevement(p.id).then(() => undefined),
      );
      const siens = resultats.filter((r) => r.prelevementId === p.id);
      if (siens.length) {
        const liste = document.createElement('ul');
        liste.className = 'mt-2 w-full space-y-0.5 text-xs text-slate-600 dark:text-slate-300';
        for (const r of siens) {
          const place = situerDansLIntervalle(r);
          const ou =
            place === null
              ? 'intervalle du laboratoire non renseigné'
              : place === 'dans'
                ? 'dans l’intervalle du laboratoire'
                : `${place} l’intervalle du laboratoire`;
          const el = document.createElement('li');
          el.textContent = `${r.analyte} : ${r.valeur} ${r.unite} — ${ou}`;
          liste.appendChild(el);
        }
        li.appendChild(liste);
      }
      zoneP.appendChild(li);
    }

    const zoneS = $('symptomes');
    zoneS.replaceChildren();
    for (const s of [...symptomes].sort((a, b) => b.jour.localeCompare(a.jour))) {
      zoneS.appendChild(
        ligne(s.intitule, `${s.jour} · intensité déclarée ${s.intensite}/10`, () =>
          supprimerSymptome(s.id),
        ),
      );
    }

    const zoneC = $('conditions');
    zoneC.replaceChildren();
    for (const c of [...conditions].sort((a, b) => b.debut.localeCompare(a.debut))) {
      zoneC.appendChild(
        ligne(c.intitule, c.fin ? `du ${c.debut} au ${c.fin}` : `depuis le ${c.debut}`, () =>
          supprimerCondition(c.id),
        ),
      );
    }
  }

  async function montrerCeQuiConvient() {
    const active = await santeActive();
    $('pas-active').classList.toggle('hidden', active);
    if (!active) {
      $('coffre-ferme').classList.add('hidden');
      $('coffre-ouvert').classList.add('hidden');
      return;
    }
    await reprendreLeCoffre();
    const ouvert = coffreOuvert();
    $('coffre-ferme').classList.toggle('hidden', ouvert);
    $('coffre-ouvert').classList.toggle('hidden', !ouvert);
    if (ouvert) {
      /*
         Le registre se charge **à l'ouverture de l'écran**, pas au démarrage
         du site : c'est la seule façon qu'il reste étanche. Un chargement
         global l'aurait rendu disponible à tout module qui passe, et
         l'étanchéité serait redevenue une question de discipline.
      */
      await chargerLeMenu();
      await peindre();
    }
  }

  const valeur = (id: string) => ($(id) as HTMLInputElement | HTMLSelectElement).value;

  auDeverrouillage(
    async () => {
      $('t-chercher').addEventListener('input', peindreSuggestions);
      $('vers-bibliographie').setAttribute('href', lien('/odyssee/bibliographie/'));
      ($('t-debut') as HTMLInputElement).value = AUJOURDHUI;
      ($('p-jour') as HTMLInputElement).value = AUJOURDHUI;
      ($('s-jour') as HTMLInputElement).value = AUJOURDHUI;
      ($('c-debut') as HTMLInputElement).value = AUJOURDHUI;

      $('activer').addEventListener('click', () => {
        void activerLaSante(true).then(montrerCeQuiConvient).catch(dire);
      });

      $('ouvrir-coffre').addEventListener('click', () => {
        void (async () => {
          const mdp = $('mdp-coffre') as HTMLInputElement;
          const erreur = await ouvrirLeCoffre(mdp.value, {
            memoriserAppareil:
              (document.getElementById('coffre-appareil') as HTMLInputElement | null)?.checked ??
              false,
          });
          $('erreur-coffre').classList.toggle('hidden', erreur === null);
          if (erreur) {
            $('erreur-coffre').textContent = erreur;
            return;
          }
          mdp.value = '';
          await montrerCeQuiConvient();
        })();
      });

      /**
       * Un envoi, une écriture — M6.
       *
       * Les quatre formulaires de cet écran écrivent chacun une ligne à
       * identifiant neuf : un traitement, un prélèvement, un symptôme, une
       * condition. Le champ vidé après coup ne protège pas du double appui
       * rapproché — il n'est vidé qu'une fois l'écriture finie, et le second
       * appui a eu lieu avant. `unSeulGeste` prend le formulaire pour clé, et
       * désactive son bouton d'envoi le temps de l'écriture.
       */
      const surEnvoi = (id: string, travail: () => Promise<unknown>) => {
        $(id).addEventListener('submit', (evenement) => {
          evenement.preventDefault();
          void unSeulGeste(evenement.currentTarget as Element, travail).catch(dire);
        });
      };

      surEnvoi('form-traitement', async () => {
        await ecrireTraitement(valeur('t-nom'), valeur('t-debut'), {
          posologie: valeur('t-posologie'),
          origine: valeur('t-origine') as 'moi' | 'prescrit',
          prescripteur: valeur('t-prescripteur'),
          sporadique: ($('t-sporadique') as HTMLInputElement).checked,
        });
        ($('t-nom') as HTMLInputElement).value = '';
        ($('t-posologie') as HTMLInputElement).value = '';
        ($('t-prescripteur') as HTMLInputElement).value = '';
        ($('t-sporadique') as HTMLInputElement).checked = false;
        await peindre();
      });

      surEnvoi('form-prelevement', async () => {
        await ecrirePrelevement(valeur('p-jour'), {
          le: new Date().toISOString(),
          laboratoire: valeur('p-labo'),
          contexte: valeur('p-contexte'),
        });
        ($('p-labo') as HTMLInputElement).value = '';
        ($('p-contexte') as HTMLInputElement).value = '';
        await peindre();
      });

      /*
         D4, seconde moitié : `Number('')` vaut ZÉRO, et ici le zéro est une
         valeur LÉGITIME — l'échelle va de 0 à 10, et zéro veut dire « aucune
         douleur ». Un champ vidé écrivait donc « intensité 0 » : l'absence de
         saisie devenait une mesure, et c'est la pire forme du défaut, parce
         que rien ne distingue ensuite les deux.

         Le champ ne portait pas `required` ; seule une valeur par défaut le
         couvrait, et une valeur par défaut ne survit pas à un effacement.
      */
      const controlerIntensite = (v: string): string | null => {
        const n = nombreEntier(v);
        return n !== null && n >= 0 && n <= 10
          ? null
          : 'Une intensité entière, de 0 à 10. Zéro est une réponse : « aucune douleur ».';
      };
      validerALaSortie($('s-intensite') as HTMLInputElement, controlerIntensite);

      surEnvoi('form-symptome', async () => {
        if (!controlerAvantEnvoi([[$('s-intensite') as HTMLInputElement, controlerIntensite]])) {
          return false;
        }
        const intensite = nombreEntier(valeur('s-intensite'));
        /* Le contrôle vient de passer : ce repli ne sert qu'à n'avoir aucun
           chemin où un zéro non saisi s'écrive. */
        if (intensite === null) return false;
        await ecrireSymptome(valeur('s-jour'), valeur('s-intitule'), intensite);
        ($('s-intitule') as HTMLInputElement).value = '';
        await peindre();
      });

      surEnvoi('form-condition', async () => {
        await ecrireCondition(valeur('c-intitule'), valeur('c-debut'));
        ($('c-intitule') as HTMLInputElement).value = '';
        await peindre();
      });

      /*
         Refermer le coffre doit refermer l'écran tout de suite, et non à la
         prochaine navigation : « verrouiller » qui laisse des traitements
         lisibles à l'écran ne verrouille rien.
      */
      surCoffre(() => void montrerCeQuiConvient().catch(dire));

      await montrerCeQuiConvient();
    },
  );
</script>
