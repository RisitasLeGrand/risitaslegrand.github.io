---
/**
 * Odyssée : à rapprocher — relier le prévu au réel.
 *
 * ## Les certaines sont déjà appliquées
 *
 * Faire confirmer ce dont le système est sûr dépense l'attention là où elle
 * ne sert à rien — et le budget d'attention est précisément ce qui fait
 * abandonner un rapprochement mensuel au bout de deux mois. Les certaines
 * sont donc appliquées, annoncées en pied, et annulables d'un geste.
 *
 * ## Chaque proposition dit pourquoi
 *
 * Avec ses trois critères chiffrés : l'écart au montant, l'écart à la date,
 * le motif reconnu et combien de fois. Un appariement qu'on ne peut pas
 * contester se confirme sans être lu, et la file devient un bouton « oui »
 * répété quatorze fois — ce qui est pire que pas de file du tout, parce que
 * les erreurs y entrent sans qu'on les voie.
 *
 * ## Le solde est la seule vérification qui vaille
 *
 * L'écran de rapprochement de solde ne dit pas seulement qu'il y a un écart :
 * il propose des causes vérifiables une par une sur le relevé papier. Aucune
 * n'est appliquée. Corriger un solde en inventant une opération fabriquerait
 * la concordance au lieu de la constater.
 */
import Base from '../../layouts/Base.astro';
import FormulaireCoffre from '../../components/FormulaireCoffre.astro';
---

<Base titre="À rapprocher" actif="finances" coffre>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">À rapprocher</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      Relier chaque opération du relevé à l’échéance qu’elle solde. Tout se calcule sur cet
      appareil : aucune proposition n’est faite ailleurs qu’ici.{' '}
      <a href="/odyssee/finances/" class="underline">Importer un relevé</a>.{' '}
      <a href="/odyssee/mes-regles/" class="underline">Mes règles</a>.
    </p>

    <div id="chargement-rapprocher" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture…</p>
    </div>

    <div id="vue" class="mt-6 hidden space-y-8">
      <FormulaireCoffre raison={"Le mot de passe est redemandé à chaque nouvel onglet. La clé ne quitte pas cet appareil."} />

      <div id="coffre-ouvert" class="hidden space-y-10">
        <!--
          ── Le compte rendu de la passe automatique (maquette 8.1) ─────

          Il ne s'affiche que quand la passe a **écrit** quelque chose,
          c'est-à-dire après un import ou après une règle nouvelle. Le
          montrer à chaque ouverture annoncerait « import terminé » devant
          un écran où rien n'est entré, et un bandeau qui dit toujours la
          même chose cesse d'être lu.
        -->
        <section id="compte-rendu"
          class="hidden rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 dark:border-indigo-900 dark:bg-indigo-950/30">
          <h2 id="titre-compte-rendu" class="text-lg font-semibold text-slate-900 dark:text-white"></h2>
          <ul id="lignes-compte-rendu" class="mt-3 space-y-2 text-sm"></ul>

          <p id="ligne-sondage" class="mt-4 hidden border-t border-indigo-200 pt-3 text-sm text-slate-700 dark:border-indigo-900 dark:text-slate-200"></p>
          <div id="gestes-sondage" class="mt-2 hidden flex-wrap gap-2">
            <button id="verifier-sondage" type="button"
              class="cible-tactile rounded-lg bg-slate-800 px-3 text-sm font-medium text-white dark:bg-slate-200 dark:text-slate-900"
              >Vérifier</button>
            <button id="sondage-plus-tard" type="button"
              class="cible-tactile rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700"
              >Plus tard</button>
          </div>
          <ul id="echantillon-sondage" class="mt-3 hidden space-y-2 text-sm"></ul>
        </section>

        <!-- ── La file ─────────────────────────────────────────────────── -->
        <section>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="titre-file" class="text-lg font-semibold text-slate-900 dark:text-white">
              À rapprocher
            </h2>
            <button id="tout-confirmer" type="button"
              class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700 disabled:opacity-40"
              >Tout confirmer</button>
          </div>
          <p id="compte-file" class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>

          <!--
            Une seule file, filtrable. Le plan l'impose et la raison est
            d'attention : deux écrans pour vider un mois, c'est un écran de
            trop et un mois qu'on ne vide pas.
          -->
          <div class="mt-3 flex flex-wrap gap-2" role="tablist">
            <button data-filtre="tout" type="button" class="filtre min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">Tout</button>
            <button data-filtre="a-pointer" type="button" class="filtre min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">À pointer</button>
            <button data-filtre="a-rapprocher" type="button" class="filtre min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">À rapprocher</button>
            <button data-filtre="a-revoir" type="button" class="filtre min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">À revoir</button>
          </div>

          <p id="file-vide" class="mt-4 hidden rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:bg-slate-900 dark:text-slate-300"></p>

          <h3 id="titre-probables" class="mt-6 hidden text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Probables — un geste chacun
          </h3>
          <ul id="probables" class="mt-2 space-y-3"></ul>

          <h3 id="titre-a-classer" class="mt-6 hidden text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            À classer — aucune ligne ne correspond
          </h3>
          <ul id="a-classer" class="mt-2 space-y-3"></ul>

          <p id="pied-certaines" class="mt-6 hidden rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-900 dark:bg-emerald-950/30 dark:text-emerald-100"></p>
          <button id="annuler-certaines" type="button"
            class="mt-2 hidden min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700"
            >Annuler les certaines de ce passage</button>
          <ul id="certaines" class="mt-2 hidden space-y-2"></ul>
        </section>

        <!-- ── Les vendeurs inconnus ───────────────────────────────────── -->
        <section id="bloc-inconnus" class="hidden">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Vendeurs inconnus</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            <strong>Un vendeur par ligne</strong>, jamais une opération par ligne : les variantes
            d’un même libellé sont regroupées. Les plus coûteux d’abord, dix à la fois.
            « Plus tard » ne bloque rien — les opérations restent à classer, sans relance.
          </p>
          <ul id="inconnus" class="mt-3 space-y-3"></ul>
          <button id="dix-suivants" type="button"
            class="mt-3 hidden min-h-11 rounded-lg border border-slate-300 px-4 text-sm dark:border-slate-700"
            >Traiter les dix suivants</button>
        </section>

        <!-- ── Fractionner une opération ───────────────────────────────── -->
        <section id="bloc-fractionnement">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Fractionner une opération
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Un passage au supermarché qui tient de l’alimentation et du bricolage, un achat
            partagé : une opération peut appartenir à plusieurs catégories. Les parts somment{' '}
            <strong>au centime</strong> à l’opération — un centime orphelin ferait échouer le
            rapprochement de solde sans dire pourquoi.
          </p>
          <label class="mt-3 block text-sm">
            <span class="block text-slate-700 dark:text-slate-200">
              Chercher une opération, par libellé ou par montant</span>
            <input id="chercher-operation" type="search" placeholder="supermarché, 120, 120,00…"
              class="mt-1 min-h-11 w-full max-w-md rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950" />
          </label>
          <p id="fractionnement-combien" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>
          <ul id="fractionnables" class="mt-3 space-y-3"></ul>
        </section>

        <!-- ── Les catégories pointées ─────────────────────────────────── -->
        <section>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Catégories pointées contre le budget
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Le réalisé est la somme des opérations <strong>pointées</strong>. Les remboursements
            se déduisent de leur catégorie, les virements entre vos comptes sont exclus, et une
            opération fractionnée se répartit entre ses parts.
          </p>
          <ul id="categories-pointees" class="mt-3 space-y-2"></ul>
          <p id="non-pointe"
            class="mt-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950/30 dark:text-amber-100"></p>
          <p id="un-seul-cote" class="mt-2 hidden text-sm text-slate-500 dark:text-slate-400"></p>
        </section>

        <!-- ── Le rapprochement de solde ───────────────────────────────── -->
        <section>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Rapprochement de solde</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Le solde imprimé sur le relevé contre la somme des opérations enregistrées. Aucune
            tolérance : un centime d’écart signale une opération manquante, en double ou mal signée.
          </p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Le <strong>solde de départ</strong> est celui d’avant la première opération enregistrée —
            l’ouverture du plus ancien relevé importé. Sans lui, la comparaison porterait sur la somme
            des mouvements seule, et elle ne pourrait jamais égaler un solde de compte : l’écart
            annoncé serait constant, et ne voudrait rien dire.
          </p>
          <div class="mt-3 flex flex-wrap items-end gap-3">
            <label class="block text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Compte</span>
              <select id="compte-solde"
                class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"></select>
            </label>
            <label class="block text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Solde de départ</span>
              <input id="solde-depart" type="text" inputmode="decimal" placeholder="0,00"
                class="mt-1 min-h-11 w-40 rounded-lg border border-slate-300 bg-white px-3 text-sm tabular-nums dark:border-slate-700 dark:bg-slate-950" />
            </label>
            <label class="block text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Solde du relevé</span>
              <input id="solde-declare" type="text" inputmode="decimal" placeholder="741,62"
                class="mt-1 min-h-11 w-40 rounded-lg border border-slate-300 bg-white px-3 text-sm tabular-nums dark:border-slate-700 dark:bg-slate-950" />
            </label>
            <button id="verifier-solde" type="button"
              class="min-h-11 rounded-lg bg-slate-800 px-4 text-sm font-medium text-white transition hover:bg-slate-900 dark:bg-slate-200 dark:text-slate-900"
              >Vérifier</button>
          </div>
          <p id="verdict-solde" class="mt-3 hidden text-sm"></p>
          <ul id="causes" class="mt-3 space-y-2"></ul>
        </section>

        <!-- ── Les écarts ──────────────────────────────────────────────── -->
        <section>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Le prévu contre le réel</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Les échéances <strong>non échues</strong> ne comptent pas comme un écart : elles ne sont
            pas en retard, elles ne sont pas encore dues.
          </p>
          <div class="mt-3 flex flex-wrap gap-2" role="tablist">
            <button data-axe="ligne" type="button" class="axe min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">Par ligne</button>
            <button data-axe="categorie" type="button" class="axe min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">Par catégorie</button>
            <button data-axe="mois" type="button" class="axe min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700">Par mois</button>
          </div>
          <ul id="ecarts" class="mt-3 space-y-2"></ul>
          <p id="ecarts-vides" class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400"></p>
        </section>

        <!-- ── L'export ICS des échéances ──────────────────────────────── -->
        <section>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Échéances dans l’agenda</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Un fichier <code>.ics</code> à ouvrir dans l’agenda du téléphone, pour que le loyer du 5
            se voie sans ouvrir Cyclades. Chaque échéance y est une journée entière : un prélèvement
            n’a pas d’heure, et lui en inventer une ferait sonner un rappel qui ne veut rien dire.
          </p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            <strong>C’est le seul export de Finances qui quitte l’appareil</strong> — un agenda est,
            pour la plupart des gens, synchronisé chez un tiers. Il ne porte donc que le libellé, la
            date et le montant : aucun compte, aucun écart au budget, aucun solde.
          </p>
          <div class="mt-3 flex flex-wrap items-end gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input id="ics-ressources" type="checkbox" checked
                class="size-5 rounded border-slate-300 dark:border-slate-700" />
              <span class="text-slate-700 dark:text-slate-200">Inclure les ressources</span>
            </label>
            <button id="exporter-ics" type="button"
              class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium dark:border-slate-700"
              >Exporter douze mois</button>
          </div>
          <p id="resultat-ics" class="mt-2 hidden text-sm text-slate-600 dark:text-slate-300"></p>
        </section>

        <!-- ── Déduire du réel ─────────────────────────────────────────── -->
        <section>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Déduire des lignes du réel</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Les opérations déjà importées contiennent la plupart des lignes du budget. Rien n’est
            créé sans votre accord, et chaque proposition dit sur quoi elle repose.
          </p>
          <button id="deduire" type="button"
            class="mt-3 min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-medium dark:border-slate-700"
            >Chercher les récurrences</button>
          <ul id="recurrences" class="mt-3 space-y-3"></ul>
          <p id="recurrences-vides" class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400"></p>
        </section>

        <p id="erreur" class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-900 dark:bg-rose-950/30 dark:text-rose-100"></p>

        <button id="fermer-coffre" type="button"
          class="text-xs text-slate-500 underline dark:text-slate-400"
          >Refermer le coffre maintenant</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { jourISO } from '../../lib/db';
  import { auDeverrouillage } from '../../lib/chargement';
  import { centimesDe, euros, type OperationBancaire } from '../../lib/odyssee/finances';
  import { reconcilier } from '../../lib/odyssee/finances';
  import { occurrences, TOLERANCE_PAR_DEFAUT, type LigneBudget, type Occurrence } from '../../lib/odyssee/budget';
  import {
    construireLaFile,
    defautsDeLaDivision,
    diviser,
    occurrencesProposees,
    type Proposition,
  } from '../../lib/odyssee/appariement';
  import {
    chercherLesCauses,
    ecartsParCategorie,
    ecartsParLigne,
    ecartsParMois,
    type EcartAgrege,
  } from '../../lib/odyssee/rapprochement';
  import { detecterLesRecurrences, enLigneDeBudget } from '../../lib/odyssee/recurrences';
  import { OPTIONS_PAR_DEFAUT, echeancesEnIcs } from '../../lib/odyssee/echeances-ics';
  import { TOUS_LES_TYPES, typeDe } from '../../lib/odyssee/taxonomie';
  import {
    HISTORIQUE_VIDE,
    PREREGLAGE_PAR_DEFAUT,
    decider,
    sondage,
  } from '../../lib/odyssee/pointage';
  import {
    grouperLesInconnus,
    reconnaitre,
    type Connaissance,
  } from '../../lib/odyssee/vendeurs';
  import {
    VERSION_DU_DICTIONNAIRE,
    dictionnaireUtilisable,
  } from '../../lib/odyssee/dictionnaire-vendeurs';
  import {
    apercuSurLePasse,
    brouillonPour,
    controlerLeBrouillon,
    regleDepuisLeBrouillon,
    typesSuggeres,
    type BrouillonDeRegle,
    type OperationPointable,
  } from '../../lib/odyssee/regles-pointage';
  import { vueDesCategories } from '../../lib/odyssee/categories-pointees';
  import {
    annulerLePassage,
    annulerLePointage,
    appliquerLaRegleAuPasse,
    defractionnerLOperation,
    ecrireLaRegle,
    ecrireLesPointages,
    fractionnerLOperation,
    lireLesModifications,
    nomsMasques,
    noterLeVendeur,
    pointables,
    tousLesPointages,
    tousLesVendeurs,
    toutesLesRegles,
  } from '../../lib/odyssee/donnees-pointage';
  import {
    PARTS_MAXIMALES,
    ajouterUnePart,
    partsDeDepart,
    controlerLesParts,
    mettreLeResteSur,
    partEnPourcentage,
    phraseDuReste,
    repartirEnParts,
    retirerUnePart,
  } from '../../lib/odyssee/fractionnement';
  import type { PartPointee } from '../../lib/odyssee/pointage';
  import { offrirLeFichier } from '../../lib/telecharger';
  import {
    annulerLesAutomatiques,
    annulerRapprochement,
    ecrireLigne,
    ecrireRapprochement,
    ecrireRapprochements,
    etatDesRapprochements,
    tousLesComptes,
    toutesLesLignes,
    toutesLesOperations,
  } from '../../lib/odyssee/donnees-finances';
  import {
    coffreOuvert,
    fermerLeCoffre,
    ouvrirLeCoffre,
    reprendreLeCoffre,
    surCoffre,
  } from '../../lib/coffre';

  const $ = (id: string) => document.getElementById(id)!;
  const dire = (e: unknown) => {
    const z = $('erreur');
    z.textContent = e instanceof Error ? e.message : String(e);
    z.classList.remove('hidden');
  };

  /**
   * Le jour d'arrêt des échéances.
   *
   * Lu **une fois** au chargement, et passé partout en paramètre. Une fonction
   * de calcul qui lit l'horloge elle-même ne peut être ni rejouée ni testée à
   * midi comme à minuit — c'est exactement la faute qui avait fait passer un
   * essai de calendrier seulement l'après-midi.
   */
  const aujourdHui = jourISO();

  let axe: 'ligne' | 'categorie' | 'mois' = 'ligne';
  let filtre: 'tout' | 'a-pointer' | 'a-rapprocher' | 'a-revoir' = 'tout';
  /** Combien de vendeurs inconnus sont montrés. Dix de plus à chaque fois. */
  let inconnusMontres = 10;
  /** Le début du passage en cours : ce que « Annuler » peut défaire. */
  let debutDuPassage = new Date().toISOString();
  /** L'échantillon du contrôle par sondage, tiré par le moteur. */
  let sondageDuTour: string[] = [];
  /** Le vendeur dont le mode avancé est ouvert, et son brouillon. */
  let avanceOuvert: string | null = null;
  let brouillon: BrouillonDeRegle | null = null;
  /*
     Ce dont le mode avancé a besoin pour son aperçu, recalculé à chaque
     peinture. En variables plutôt qu'en paramètres parce que l'aperçu se
     refait à chaque frappe dans le champ « motif », et qu'aller relire la
     base à chaque frappe serait une lecture chiffrée par caractère tapé.
  */
  let pointablesDuTour: OperationPointable[] = [];
  let libellesDuTour: string[] = [];
  let lignesDuTour: LigneBudget[] = [];

  /** La recherche de l'éditeur de parts, et l'opération ouverte dedans. */
  let rechercheDOperation = '';
  let operationEnEdition: string | null = null;
  let partsEnEdition: PartPointee[] = [];

  /*
     Les deux gestes de la maquette 4.3, ouverts sur une seule carte à la fois.

     « Autre ligne » corrige la **cible** d'une proposition : le moteur a
     trouvé une occurrence, elle n'est pas la bonne, on en désigne une autre.
     « Diviser » corrige sa **forme** : l'opération n'appartient pas à une
     occurrence mais à plusieurs, et chacune reçoit sa part.

     Un seul panneau ouvert à la fois, et les deux s'excluent : ouvrir l'un
     ferme l'autre. Deux panneaux ouverts sur la même opération poseraient la
     question de celui qui gagne à l'enregistrement, et la réponse ne se
     devine pas depuis l'écran.
  */
  let reaffectationOuverte: string | null = null;
  let divisionOuverte: string | null = null;
  let partsDeLaDivision: { occurrenceId: string; centimes: number }[] = [];

  /* ── Les données du tour ───────────────────────────────────────────────── */

  async function rassembler() {
    const [operations, lignes, etat] = await Promise.all([
      toutesLesOperations(),
      toutesLesLignes(),
      etatDesRapprochements(),
    ]);
    /*
       La fenêtre des occurrences est celle des opérations, élargie d'un mois
       de chaque côté : une échéance du 5 novembre peut être soldée le
       29 octobre, et une du 30 septembre le 2 octobre.
    */
    const jours = operations.map((o) => o.jour).sort();
    const du = jours.length ? reculer(jours[0], 40) : aujourdHui;
    const au = jours.length ? avancer(jours[jours.length - 1], 40) : aujourdHui;
    const occ = lignes.flatMap((l) => occurrences(l, du, au));
    return { operations, lignes, occ, etat };
  }

  const decaler = (jour: string, n: number) =>
    new Date(Date.parse(`${jour}T00:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10);
  const avancer = (j: string, n: number) => decaler(j, n);
  const reculer = (j: string, n: number) => decaler(j, -n);

  function reglagesDe(lignes: Awaited<ReturnType<typeof toutesLesLignes>>) {
    return {
      tolerance: TOLERANCE_PAR_DEFAUT,
      motifs: lignes.flatMap((l) =>
        l.motifs.map((fragment) => ({ ligneId: l.id, fragment, vu: 1 })),
      ),
      sensParLigne: Object.fromEntries(lignes.map((l) => [l.id, l.sens])),
    };
  }

  /* ── La file ───────────────────────────────────────────────────────────── */

  async function peindreLaFile() {
    const { operations, lignes, occ, etat } = await rassembler();
    const dejaRangees = new Set(etat.retenus.map((r) => r.operationId));
    const occPrises = new Set(
      etat.retenus.filter((r) => r.occurrenceId).map((r) => r.occurrenceId as string),
    );
    const libres = operations.filter((o) => !dejaRangees.has(o.id));
    const occLibres = occ.filter((o) => !occPrises.has(o.id));
    const file = construireLaFile(occLibres, libres, reglagesDe(lignes));
    const parOcc = new Map(occ.map((o) => [o.id, o]));
    const parLigne = new Map(lignes.map((l) => [l.id, l]));

    /*
       Les certaines s'appliquent **avant** d'être affichées, et le pied le
       dit. Les afficher d'abord pour les appliquer ensuite laisserait la
       personne croire qu'il lui reste un geste à faire.
    */
    let retenus = etat.retenus;
    if (file.certaines.length) {
      await ecrireRapprochements(
        file.certaines.map((p) => ({
          operationId: p.operationId,
          occurrenceId: p.occurrenceId,
          ligneId: p.ligneId,
          type: 'automatique' as const,
          centimes: operations.find((o) => o.id === p.operationId)?.centimes ?? 0,
          ecartAuPrevu: p.ecartAuPrevu,
          decideLe: new Date().toISOString(),
        })),
      );
      /*
         Et on **relit** : `etat` date d'avant l'écriture, donc il ignore ce
         qu'on vient d'appliquer. Peindre le pied à partir de lui ferait
         disparaître ces opérations de la file sans que rien n'explique où
         elles sont parties — exactement le trou que l'essai en navigateur a
         trouvé un cran plus loin, au rechargement.
      */
      retenus = (await etatDesRapprochements()).retenus;
    }

    $('titre-file').textContent =
      `À rapprocher — ${file.probables.length + file.aClasser.length} opération(s)`;
    $('compte-file').textContent =
      `${file.certaines.length} certaine(s) (déjà appliquée(s)) · ` +
      `${file.probables.length} probable(s) · ${file.aClasser.length} à classer`;

    const rien = !file.certaines.length && !file.probables.length && !file.aClasser.length;
    $('file-vide').classList.toggle('hidden', !rien);
    if (rien) {
      $('file-vide').textContent = operations.length
        ? 'Tout est rangé. Rien n’attend de décision.'
        : 'Aucune opération enregistrée. Importez un relevé pour commencer.';
    }

    /* Les probables. */
    $('titre-probables').classList.toggle('hidden', !file.probables.length);
    const zone = $('probables');
    zone.innerHTML = '';
    for (const p of file.probables) {
      zone.appendChild(carteDeProposition(p, parOcc, parLigne, operations, occLibres));
    }
    ($('tout-confirmer') as HTMLButtonElement).disabled = file.probables.length === 0;

    /* À classer. */
    $('titre-a-classer').classList.toggle('hidden', !file.aClasser.length);
    const zoneC = $('a-classer');
    zoneC.innerHTML = '';
    for (const o of file.aClasser) zoneC.appendChild(carteAClasser(o));

    /*
       Le pied des certaines liste **toutes** celles qui sont appliquées, et
       pas seulement celles de ce passage.

       C'est une correction, et elle venait d'un trou réel : en ne montrant
       que le passage en cours, une opération rangée d'office la semaine
       dernière devenait invisible au rechargement — ni dans la file, ni
       dans le pied, ni annulable. Le système l'avait décidée, et plus rien
       ne permettait de la contester. Une décision automatique qu'on ne peut
       plus voir est pire qu'une décision qu'on doit confirmer.

       Le bouton d'annulation en bloc, lui, reste borné à ce passage : une
       décision prise il y a trois mois et jamais contestée n'a pas à sauter
       parce qu'on rouvre l'écran aujourd'hui.
    */
    const automatiques = retenus.filter((r) => r.type === 'automatique');
    const deCePassage = automatiques.filter((r) => r.decideLe >= debutDuPassage);
    const combien = automatiques.length;
    $('pied-certaines').classList.toggle('hidden', combien === 0);
    $('certaines').classList.toggle('hidden', combien === 0);
    $('annuler-certaines').classList.toggle('hidden', deCePassage.length === 0);
    if (combien) {
      $('pied-certaines').textContent =
        `${combien} certaine(s) appliquée(s) automatiquement : même compte, montant dans la ` +
        'tolérance, date dans la fenêtre, et un libellé déjà vu sur la ligne.' +
        (deCePassage.length ? ` Dont ${deCePassage.length} à l’instant.` : '');
      const parOperation = new Map(operations.map((o) => [o.id, o]));
      const liste = $('certaines');
      liste.innerHTML = '';
      for (const r of automatiques) {
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center gap-2 text-sm text-slate-600 dark:text-slate-300';
        li.dataset.certaine = r.operationId;
        const op = parOperation.get(r.operationId);
        const ligne = r.ligneId ? parLigne.get(r.ligneId) : undefined;
        const texte = document.createElement('span');
        texte.textContent = op
          ? `${op.jour}  ${euros(op.centimes)}  ${op.libelle} → ${ligne?.libelle ?? r.ligneId}`
          : `${r.operationId} → ${r.ligneId}`;
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.dataset.geste = 'annuler-une';
        bouton.className = 'text-xs underline';
        bouton.textContent = 'Annuler';
        bouton.addEventListener('click', () => {
          void annulerRapprochement(r.operationId, r.occurrenceId).then(peindreTout).catch(dire);
        });
        li.append(texte, bouton);
        liste.appendChild(li);
      }
    }
  }

  function carteDeProposition(
    p: Proposition,
    parOcc: Map<string, Occurrence>,
    parLigne: Map<string, { libelle: string; sens: string }>,
    operations: readonly OperationBancaire[],
    occLibres: readonly Occurrence[],
  ): HTMLElement {
    const op = operations.find((o) => o.id === p.operationId)!;
    const occ = parOcc.get(p.occurrenceId);
    const ligne = parLigne.get(p.ligneId);

    const li = document.createElement('li');
    li.dataset.proposition = p.operationId;
    li.dataset.niveau = p.niveau;
    li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';

    const entete = document.createElement('p');
    entete.className = 'font-medium tabular-nums text-slate-900 dark:text-white';
    entete.textContent = `${op.jour}  ${euros(op.centimes)}  ${op.libelle}`;

    const cible = document.createElement('p');
    cible.className = 'mt-1 text-sm text-slate-700 dark:text-slate-200';
    cible.textContent = occ && ligne
      ? `→ ${ligne.libelle} (prévu ${euros(occ.signe * occ.montant)} le ${occ.jour})`
      : `→ ${p.ligneId}`;

    /*
       L'explication porte les trois critères chiffrés. C'est elle, et non un
       seuil, qui rend le refus possible : « Montant hors tolérance de
       17,40 € » se conteste, « probable » ne se conteste pas.
    */
    const pourquoi = document.createElement('p');
    pourquoi.className = 'mt-1 text-sm text-slate-500 dark:text-slate-400';
    pourquoi.dataset.explication = '';
    pourquoi.textContent = p.explication;

    const gestes = document.createElement('div');
    gestes.className = 'mt-2 flex flex-wrap gap-2';
    gestes.append(
      bouton('Confirmer', 'confirmer', async () => {
        await ecrireRapprochement({
          operationId: p.operationId,
          occurrenceId: p.occurrenceId,
          ligneId: p.ligneId,
          type: 'confirme',
          centimes: op.centimes,
          ecartAuPrevu: p.ecartAuPrevu,
          decideLe: new Date().toISOString(),
        });
        await peindreTout();
      }),
      bouton('Hors budget', 'hors-budget', async () => {
        await ecrireRapprochement({
          operationId: p.operationId,
          occurrenceId: null,
          ligneId: null,
          type: 'horsBudget',
          centimes: op.centimes,
          ecartAuPrevu: null,
          decideLe: new Date().toISOString(),
        });
        await peindreTout();
      }),
      bouton('Refuser', 'refuser', async () => {
        await ecrireRapprochement({
          operationId: p.operationId,
          occurrenceId: p.occurrenceId,
          ligneId: p.ligneId,
          type: 'refuse',
          centimes: 0,
          ecartAuPrevu: null,
          decideLe: new Date().toISOString(),
        });
        await peindreTout();
      }),
    );

    gestes.append(
      bouton('Autre ligne', 'autre-ligne', async () => {
        reaffectationOuverte = reaffectationOuverte === p.operationId ? null : p.operationId;
        divisionOuverte = null;
        await peindreLaFile();
      }),
      bouton('Diviser', 'diviser', async () => {
        if (divisionOuverte === p.operationId) {
          divisionOuverte = null;
        } else {
          divisionOuverte = p.operationId;
          reaffectationOuverte = null;
          /*
             On part de l'occurrence que le moteur a proposée, avec la
             totalité du montant. La première part est donc déjà juste si la
             personne n'en ajoute qu'une seconde : le reste ira dessus.
          */
          partsDeLaDivision = [{ occurrenceId: p.occurrenceId, centimes: op.centimes }];
        }
        await peindreLaFile();
      }),
    );

    li.append(entete, cible, pourquoi, gestes);
    if (reaffectationOuverte === p.operationId) {
      li.appendChild(panneauAutreLigne(p, op, occLibres, parLigne));
    }
    if (divisionOuverte === p.operationId) {
      li.appendChild(panneauDeDivision(p, op, occLibres, parLigne));
    }
    if (p.remboursement) {
      const note = document.createElement('p');
      note.className = 'mt-1 text-xs text-emerald-700 dark:text-emerald-300';
      note.dataset.remboursement = '';
      note.textContent =
        'Rentrée sur une ligne de charge : comptée en remboursement, elle réduit le réel de ' +
        'cette ligne au lieu de gonfler les ressources.';
      li.insertBefore(note, gestes);
    }
    return li;
  }

  /* ── Les deux gestes de la maquette 4.3 ────────────────────────────────── */

  /**
   * Le libellé d'une occurrence dans un sélecteur : ligne, prévu, jour.
   *
   * Les trois ensemble, et pas seulement la ligne : deux occurrences d'une
   * même ligne ne se distinguent que par leur jour et leur montant, et un
   * menu qui afficherait deux fois « Électricité » demanderait de deviner.
   */
  function libelleDOccurrence(
    occ: Occurrence,
    parLigne: Map<string, { libelle: string; sens: string }>,
  ): string {
    const ligne = parLigne.get(occ.ligneId);
    return `${ligne?.libelle ?? occ.ligneId} — ${euros(occ.signe * occ.montant)} le ${occ.jour}`;
  }

  function selecteurDOccurrence(
    occurrences: readonly Occurrence[],
    parLigne: Map<string, { libelle: string; sens: string }>,
    valeur: string,
    marque: string,
  ): HTMLSelectElement {
    const choix = document.createElement('select');
    choix.dataset.choixOccurrence = marque;
    choix.className =
      'min-h-11 w-full min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-sm dark:border-slate-700 dark:bg-slate-950';
    for (const occ of occurrences) {
      const option = document.createElement('option');
      option.value = occ.id;
      option.textContent = libelleDOccurrence(occ, parLigne);
      choix.appendChild(option);
    }
    choix.value = valeur;
    return choix;
  }

  /**
   * « Autre ligne » — la même opération, vers une occurrence choisie à la main.
   *
   * Ce que la décision garde du moteur : rien. L'écart au prévu est
   * **recalculé** sur l'occurrence retenue, parce que celui de la proposition
   * se rapportait à une autre ligne et n'aurait plus de sens ici. Le type
   * reste « confirme » : c'est une décision humaine, et l'arbitrage la fait
   * passer devant toute reprise automatique ultérieure.
   */
  function panneauAutreLigne(
    p: Proposition,
    op: OperationBancaire,
    occLibres: readonly Occurrence[],
    parLigne: Map<string, { libelle: string; sens: string }>,
  ): HTMLElement {
    const bloc = document.createElement('div');
    bloc.dataset.panneauAutreLigne = p.operationId;
    bloc.className = 'mt-3 space-y-2 border-t border-slate-200 pt-3 dark:border-slate-800';

    const proposees = occurrencesProposees(op, occLibres);
    if (!proposees.length) {
      const vide = document.createElement('p');
      vide.className = 'text-sm text-slate-500 dark:text-slate-400';
      vide.textContent =
        'Aucune autre occurrence n’est libre : toutes celles du budget sont déjà rapprochées.';
      bloc.appendChild(vide);
      bloc.appendChild(bouton('Fermer', 'fermer-autre-ligne', async () => {
        reaffectationOuverte = null;
        await peindreLaFile();
      }));
      return bloc;
    }

    const ligne = document.createElement('div');
    ligne.className = 'flex flex-wrap items-center gap-2';
    const choix = selecteurDOccurrence(
      proposees,
      parLigne,
      proposees.some((o) => o.id === p.occurrenceId) ? p.occurrenceId : proposees[0].id,
      p.operationId,
    );
    ligne.appendChild(choix);
    bloc.appendChild(ligne);

    const gestes = document.createElement('div');
    gestes.className = 'flex flex-wrap gap-2';
    gestes.appendChild(bouton('Ranger ici', 'valider-autre-ligne', async () => {
      const occ = proposees.find((o) => o.id === choix.value);
      if (!occ) throw new Error('Cette occurrence n’est plus libre : rouvrez la file.');
      await ecrireRapprochement({
        operationId: op.id,
        occurrenceId: occ.id,
        ligneId: occ.ligneId,
        type: 'confirme',
        centimes: op.centimes,
        ecartAuPrevu: op.centimes - occ.signe * occ.montant,
        decideLe: new Date().toISOString(),
      });
      reaffectationOuverte = null;
      await peindreTout();
    }));
    gestes.appendChild(bouton('Abandonner', 'abandonner-autre-ligne', async () => {
      reaffectationOuverte = null;
      await peindreLaFile();
    }));
    bloc.appendChild(gestes);
    return bloc;
  }

  /**
   * « Diviser » — une opération, plusieurs occurrences, des parts qui somment.
   *
   * La somme exacte n'est pas une coquetterie : `etatDesRapprochements` ne
   * reconnaît une opération comme **divisée** que si ses décisions somment au
   * montant de l'opération et qu'aucune ne vaut le total. Des parts qui ne
   * somment pas seraient lues comme un désaccord entre décisions, et une
   * seule survivrait — les autres parts disparaîtraient sans rien dire.
   *
   * D'où le garde-fou en deux temps : `controlerParts` refuse d'enregistrer
   * ce qui ne somme pas, et `diviser` pose le reste de la division sur la
   * dernière part pour qu'un centime de division ne reste jamais orphelin.
   */
  function panneauDeDivision(
    p: Proposition,
    op: OperationBancaire,
    occLibres: readonly Occurrence[],
    parLigne: Map<string, { libelle: string; sens: string }>,
  ): HTMLElement {
    const bloc = document.createElement('div');
    bloc.dataset.panneauDivision = p.operationId;
    bloc.className = 'mt-3 space-y-2 border-t border-slate-200 pt-3 dark:border-slate-800';

    const proposees = occurrencesProposees(op, occLibres);

    partsDeLaDivision.forEach((part, index) => {
      const ligne = document.createElement('div');
      ligne.dataset.partOccurrence = String(index);
      ligne.className = 'flex flex-wrap items-center gap-2';

      const choix = selecteurDOccurrence(proposees, parLigne, part.occurrenceId, String(index));
      choix.addEventListener('change', () => {
        partsDeLaDivision[index] = { ...partsDeLaDivision[index], occurrenceId: choix.value };
        void peindreLaFile();
      });

      const montant = document.createElement('input');
      montant.type = 'text';
      montant.inputMode = 'decimal';
      montant.dataset.montantPartOccurrence = String(index);
      montant.className =
        'min-h-11 w-28 rounded-lg border border-slate-300 bg-white px-2 text-right text-sm tabular-nums dark:border-slate-700 dark:bg-slate-950';
      montant.value = (part.centimes / 100).toFixed(2).replace('.', ',');
      montant.addEventListener('change', () => {
        const lu = centimesDe(montant.value);
        if (lu === null) {
          dire(new Error(`« ${montant.value} » ne se lit pas comme un montant. Par exemple : -70,00.`));
          return;
        }
        partsDeLaDivision[index] = { ...partsDeLaDivision[index], centimes: lu };
        void peindreLaFile();
      });

      ligne.append(choix, montant);
      ligne.appendChild(bouton('Le reste ici', 'reste-sur-la-part', async () => {
        const autres = partsDeLaDivision.reduce(
          (somme, x, i) => (i === index ? somme : somme + x.centimes),
          0,
        );
        partsDeLaDivision[index] = { ...partsDeLaDivision[index], centimes: op.centimes - autres };
        await peindreLaFile();
      }));
      if (partsDeLaDivision.length > 1) {
        ligne.appendChild(bouton('Retirer', 'retirer-part-occurrence', async () => {
          partsDeLaDivision = partsDeLaDivision.filter((_, i) => i !== index);
          await peindreLaFile();
        }));
      }
      bloc.appendChild(ligne);
    });

    const somme = partsDeLaDivision.reduce((s, x) => s + x.centimes, 0);
    const reste = document.createElement('p');
    reste.dataset.resteDivision = p.operationId;
    reste.className = 'text-sm tabular-nums text-slate-700 dark:text-slate-200';
    reste.textContent =
      reste0(op.centimes - somme)
        ? `Les parts somment à ${euros(somme)} : l’opération est entièrement répartie.`
        : `Reste à répartir : ${euros(op.centimes - somme)} sur ${euros(op.centimes)}.`;
    bloc.appendChild(reste);

    /*
       Les trois refus viennent du moteur, et pas d'une règle réécrite ici :
       c'est ce qui permet de les éprouver sans navigateur, et ce qui garantit
       que l'écran refuse exactement ce que l'enregistrement refuserait.
    */
    const defauts = defautsDeLaDivision(op, partsDeLaDivision);
    const liste = document.createElement('ul');
    liste.dataset.defautsDivision = p.operationId;
    liste.className = 'list-disc space-y-1 pl-5 text-sm text-rose-800 dark:text-rose-200';
    liste.classList.toggle('hidden', defauts.length === 0);
    for (const d of defauts) {
      const li = document.createElement('li');
      li.textContent = d;
      liste.appendChild(li);
    }
    bloc.appendChild(liste);

    const gestes = document.createElement('div');
    gestes.className = 'flex flex-wrap gap-2';
    gestes.appendChild(bouton('Ajouter une part', 'ajouter-part-occurrence', async () => {
      const libre = proposees.find((o) => !partsDeLaDivision.some((x) => x.occurrenceId === o.id));
      if (!libre) {
        throw new Error(
          'Toutes les occurrences libres sont déjà prises par une part : il n’en reste aucune à ajouter.',
        );
      }
      partsDeLaDivision = [...partsDeLaDivision, { occurrenceId: libre.id, centimes: 0 }];
      await peindreLaFile();
    }));
    gestes.appendChild(bouton('Parts égales', 'parts-egales-occurrences', async () => {
      /*
         Le reste de la division va sur la dernière part, comme dans
         `diviser()` : deux arrondis différents dans le même écran donneraient
         un total juste à l'enregistrement et faux à l'affichage.
      */
      const n = partsDeLaDivision.length || 1;
      const base = Math.trunc(op.centimes / n);
      partsDeLaDivision = partsDeLaDivision.map((x, i) => ({
        ...x,
        centimes: i === n - 1 ? op.centimes - base * (n - 1) : base,
      }));
      await peindreLaFile();
    }));

    const valider = bouton('Enregistrer la division', 'valider-division', async () => {
      const parts = diviser(op, partsDeLaDivision);
      const parOccurrence = new Map(occLibres.map((o) => [o.id, o]));
      await ecrireRapprochements(
        parts.map((part) => {
          const occ = parOccurrence.get(part.occurrenceId);
          if (!occ) throw new Error('Une occurrence de la division n’est plus libre : rouvrez la file.');
          return {
            operationId: op.id,
            occurrenceId: occ.id,
            ligneId: occ.ligneId,
            type: 'confirme' as const,
            centimes: part.centimes,
            ecartAuPrevu: part.centimes - occ.signe * occ.montant,
            decideLe: new Date().toISOString(),
          };
        }),
      );
      divisionOuverte = null;
      partsDeLaDivision = [];
      await peindreTout();
    });
    valider.disabled = defauts.length > 0;
    valider.classList.toggle('opacity-40', defauts.length > 0);
    gestes.appendChild(valider);

    gestes.appendChild(bouton('Abandonner', 'abandonner-division', async () => {
      divisionOuverte = null;
      partsDeLaDivision = [];
      await peindreLaFile();
    }));
    bloc.appendChild(gestes);
    return bloc;
  }

  /** Vrai quand il ne reste rien à répartir. Nommé pour se lire dans la phrase. */
  function reste0(centimes: number): boolean {
    return centimes === 0;
  }

  function carteAClasser(o: OperationBancaire): HTMLElement {
    const li = document.createElement('li');
    li.dataset.aClasser = o.id;
    li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';
    const p = document.createElement('p');
    p.className = 'font-medium tabular-nums text-slate-900 dark:text-white';
    p.textContent = `${o.jour}  ${euros(o.centimes)}  ${o.libelle}`;
    const gestes = document.createElement('div');
    gestes.className = 'mt-2 flex flex-wrap gap-2';
    gestes.append(
      bouton('Hors budget', 'hors-budget', async () => {
        await ecrireRapprochement({
          operationId: o.id,
          occurrenceId: null,
          ligneId: null,
          type: 'horsBudget',
          centimes: o.centimes,
          ecartAuPrevu: null,
          decideLe: new Date().toISOString(),
        });
        await peindreTout();
      }),
    );
    li.append(p, gestes);
    return li;
  }

  function bouton(texte: string, marque: string, faire: () => Promise<void>): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.geste = marque;
    b.className =
      'min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700';
    b.textContent = texte;
    b.addEventListener('click', () => void faire().catch(dire));
    return b;
  }

  /* ── Le solde ──────────────────────────────────────────────────────────── */

  async function peindreLesComptes() {
    const comptes = await tousLesComptes();
    const select = $('compte-solde') as HTMLSelectElement;
    const choisi = select.value;
    select.innerHTML = '';
    for (const c of comptes) {
      const o = document.createElement('option');
      o.value = c.id;
      o.textContent = c.libelle;
      select.appendChild(o);
    }
    if (choisi) select.value = choisi;
  }

  async function verifierLeSolde() {
    const compteId = ($('compte-solde') as HTMLSelectElement).value;
    const saisie = ($('solde-declare') as HTMLInputElement).value;
    const declare = centimesDe(saisie);
    const saisieDepart = ($('solde-depart') as HTMLInputElement).value.trim();
    const depart = saisieDepart === '' ? 0 : centimesDe(saisieDepart);
    const verdict = $('verdict-solde');
    const causes = $('causes');
    causes.innerHTML = '';
    verdict.classList.remove('hidden');

    if (depart === null) {
      verdict.dataset.concorde = '';
      verdict.className = 'mt-3 text-sm text-rose-800 dark:text-rose-200';
      verdict.textContent =
        'Le solde de départ est attendu en euros, par exemple 1 000,00. Laissez-le vide s’il ' +
        'est nul.';
      return;
    }
    if (declare === null) {
      verdict.dataset.concorde = '';
      verdict.className = 'mt-3 text-sm text-rose-800 dark:text-rose-200';
      verdict.textContent = 'Le solde du relevé est attendu en euros, par exemple 741,62.';
      return;
    }

    const operations = (await toutesLesOperations()).filter((o) => o.compteId === compteId);
    const r = reconcilier(operations, compteId, declare, depart);
    verdict.dataset.concorde = String(r.concorde);
    if (r.concorde) {
      verdict.className = 'mt-3 text-sm text-emerald-800 dark:text-emerald-200';
      verdict.textContent =
        `Le compte boucle au centime : ${euros(r.calcule)} de part et d’autre, sur ` +
        `${operations.length} opération(s).`;
      return;
    }
    verdict.className = 'mt-3 text-sm text-rose-800 dark:text-rose-200';
    verdict.textContent =
      `Écart de ${euros(r.ecart)} : le relevé dit ${euros(r.declare)}, les opérations ` +
      `enregistrées font ${euros(r.calcule)}. Voici ce qui l’expliquerait — à vérifier une ` +
      'par une sur le relevé. Aucune n’est appliquée.';

    for (const c of chercherLesCauses(operations, r.ecart)) {
      const li = document.createElement('li');
      li.dataset.cause = c.nature;
      li.className = 'rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-800';
      li.textContent = c.phrase;
      causes.appendChild(li);
    }
  }

  /* ── Les écarts ────────────────────────────────────────────────────────── */

  async function peindreLesEcarts() {
    const { lignes, occ, etat } = await rassembler();
    const parLigne = ecartsParLigne(lignes, occ, etat.retenus, TOLERANCE_PAR_DEFAUT, aujourdHui);

    let rangees: EcartAgrege[];
    if (axe === 'ligne') {
      rangees = parLigne.map((e) => ({
        cle: e.libelle,
        prevu: e.prevu,
        reel: e.reel,
        ecart: e.ecart,
        ecartRelatif: e.ecartRelatif,
      }));
    } else if (axe === 'categorie') {
      rangees = ecartsParCategorie(parLigne);
    } else {
      rangees = ecartsParMois(lignes, occ, etat.retenus, TOLERANCE_PAR_DEFAUT, aujourdHui);
    }

    const horsTolerance = new Set(parLigne.filter((e) => e.horsTolerance).map((e) => e.libelle));
    const zone = $('ecarts');
    zone.innerHTML = '';
    $('ecarts-vides').classList.toggle('hidden', rangees.length > 0);
    if (!rangees.length) {
      $('ecarts-vides').textContent =
        'Aucune ligne de budget, ou aucune échéance échue sur la période des opérations.';
      return;
    }

    for (const e of rangees) {
      const li = document.createElement('li');
      li.dataset.ecart = e.cle;
      li.className =
        'flex flex-wrap items-baseline justify-between gap-2 rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-800';
      const gauche = document.createElement('span');
      gauche.className = 'font-medium text-slate-900 dark:text-white';
      /*
         Le symbole, le chiffre **et** le mot — jamais la couleur seule. Et le
         vocabulaire reste neutre : « écart », jamais « dépassement ». Un
         budget serré est un choix, pas une faute.
      */
      const alerte = axe === 'ligne' && horsTolerance.has(e.cle);
      gauche.textContent = `${alerte ? '⚠ ' : ''}${e.cle}`;
      const droite = document.createElement('span');
      droite.className = 'tabular-nums text-slate-600 dark:text-slate-300';
      const relatif =
        e.ecartRelatif === null ? '—' : `${(e.ecartRelatif * 100).toFixed(1).replace('.', ',')} %`;
      droite.textContent =
        `prévu ${euros(e.prevu)} · réel ${euros(e.reel)} · écart ${euros(e.ecart)} (${relatif})` +
        (alerte ? ' — hors tolérance' : '');
      li.append(gauche, droite);
      zone.appendChild(li);
    }
  }

  /* ── Déduire du réel ───────────────────────────────────────────────────── */

  async function peindreLesRecurrences() {
    const [operations, lignes] = await Promise.all([toutesLesOperations(), toutesLesLignes()]);
    const connues = new Set(lignes.flatMap((l) => l.motifs));
    const trouvees = detecterLesRecurrences(operations).filter((r) => !connues.has(r.fragment));
    const zone = $('recurrences');
    zone.innerHTML = '';
    $('recurrences-vides').classList.toggle('hidden', trouvees.length > 0);
    if (!trouvees.length) {
      $('recurrences-vides').textContent = operations.length
        ? 'Aucune récurrence nouvelle : il faut au moins trois occurrences régulières pour ' +
          'qu’une périodicité veuille dire quelque chose.'
        : 'Aucune opération enregistrée.';
      return;
    }

    for (const r of trouvees) {
      const p = enLigneDeBudget(r, new Date().toISOString());
      const li = document.createElement('li');
      li.dataset.recurrence = r.fragment;
      li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';
      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      const quand =
        r.periodicite === 'hebdomadaire'
          ? `chaque semaine, jour ${r.jourAttendu}`
          : `le ${r.jourAttendu} de chaque échéance ${r.periodicite}`;
      titre.textContent = `${r.libelle} — ${euros(r.montant)} ${quand}`;
      const fondement = document.createElement('p');
      fondement.className = 'mt-1 text-sm text-slate-500 dark:text-slate-400';
      fondement.dataset.fondement = '';
      fondement.textContent = r.fondement;
      const gestes = document.createElement('div');
      gestes.className = 'mt-2 flex flex-wrap gap-2';
      gestes.append(
        bouton('Créer cette ligne', 'creer-ligne', async () => {
          await ecrireLigne(p.ligne);
          await peindreTout();
        }),
      );
      li.append(titre, fondement, gestes);
      zone.appendChild(li);
    }
  }

  /* ── Le pointage ───────────────────────────────────────────────────────── */

  async function connaissance(): Promise<Connaissance> {
    const [regles, vendeurs, masques] = await Promise.all([
      toutesLesRegles(), tousLesVendeurs(), nomsMasques(),
    ]);
    return {
      regles: regles.filter((r) => r.typeId !== 'masque'),
      vendeurs,
      dictionnaire: dictionnaireUtilisable(masques),
    };
  }

  /**
   * Pointe ce qui peut l'être, et rend le compte rendu.
   *
   * Les pointages automatiques sont écrits **puis** annoncés : « N pointées
   * automatiquement, M à pointer, K à revoir ». Les annoncer sans les
   * écrire laisserait croire qu'un geste reste à faire ; les écrire sans
   * les annoncer les rendrait invisibles.
   */
  async function pointerCeQuiPeutLEtre() {
    const [operations, su, dejaPointees] = await Promise.all([
      toutesLesOperations(), connaissance(), tousLesPointages(),
    ]);
    const parOperation = new Map(dejaPointees.map((p) => [p.operationId, p]));
    const parJour = new Map<string, typeof operations>();
    for (const o of operations) {
      parJour.set(o.jour, [...(parJour.get(o.jour) ?? []), o]);
    }
    /* L'historique d'un vendeur se construit depuis ce qui est déjà pointé. */
    const historiques = new Map<string, { montants: number[]; comptes: string[] }>();
    for (const p of dejaPointees) {
      if (!p.vendeurNom) continue;
      const o = operations.find((x) => x.id === p.operationId);
      if (!o) continue;
      const h = historiques.get(p.vendeurNom) ?? { montants: [], comptes: [] };
      h.montants.push(Math.abs(o.centimes));
      if (!h.comptes.includes(o.compteId)) h.comptes.push(o.compteId);
      historiques.set(p.vendeurNom, h);
    }

    const aEcrire: Parameters<typeof ecrireLesPointages>[0][number][] = [];
    for (const o of operations) {
      if (o.transfertAvec) continue;
      const ancien = parOperation.get(o.id);
      if (ancien?.auteur === 'moi') continue;
      const r = reconnaitre(o.libelle, su);
      const d = decider(o, r, {
        prereglage: PREREGLAGE_PAR_DEFAUT,
        historique: r.nom ? (historiques.get(r.nom) ?? HISTORIQUE_VIDE) : HISTORIQUE_VIDE,
        memeJour: parJour.get(o.jour) ?? [],
      });
      /* Inutile de réécrire un pointage identique à celui qui existe. */
      if (ancien && ancien.statut === d.statut && ancien.typeId === (r.typeId ?? null)) continue;
      aEcrire.push({
        operationId: o.id,
        statut: d.statut,
        vendeurNom: r.nom,
        typeId: r.typeId,
        auteur: r.source === 'ma-regle' ? 'regle'
          : r.source === 'mon-historique' ? 'historique' : 'dictionnaire',
        pourquoi: d.pourquoi,
        versionDuDictionnaire: VERSION_DU_DICTIONNAIRE,
      });
    }
    const { ecrits } = await ecrireLesPointages(aEcrire);

    /*
       Les trois nombres portent sur **tout** ce que la file contient, et non
       sur la seule passe : « 19 à pointer » doit dire ce qui reste à faire,
       pas ce que cette passe vient de reclasser. Seul le déclenchement du
       bandeau dépend de la passe.
    */
    const apres = new Map((await tousLesPointages()).map((p) => [p.operationId, p]));
    const concernees = operations.filter((o) => !o.transfertAvec);
    const statutDe = (o: OperationBancaire) => apres.get(o.id)?.statut ?? 'a-pointer';
    const parStatut = (s: string) => concernees.filter((o) => statutDe(o) === s).length;

    /* L'échantillon se tire sur les pointées seules — jamais sur les miennes. */
    const pointeesSeules = concernees
      .filter((o) => {
        const p = apres.get(o.id);
        return p?.statut === 'pointee-auto' && p.auteur !== 'moi';
      })
      .map((o) => ({ id: o.id, centimes: o.centimes }));

    return {
      ecrits: ecrits.length,
      total: concernees.length,
      pointees: parStatut('pointee-auto'),
      parMoi: parStatut('pointee-par-moi'),
      aPointer: parStatut('a-pointer'),
      aRevoir: parStatut('a-revoir'),
      aVerifier: sondage(pointeesSeules),
    };
  }

  /** Ce que la dernière passe automatique laisse derrière elle. */
  type CompteRendu = Awaited<ReturnType<typeof pointerCeQuiPeutLEtre>>;

  /**
   * Le compte rendu, et ses raccourcis vers les trois tas.
   *
   * Chaque nombre porte le geste qui va avec : annoncer « 7 à revoir » sans
   * dire où elles sont oblige à les chercher dans une file de quatre-vingts
   * lignes, et c'est à ce moment-là qu'on referme l'écran.
   */
  function peindreLeCompteRendu(cr: CompteRendu) {
    const bloc = $('compte-rendu');
    /* Lisible par les essais : combien la passe a réellement écrit. */
    bloc.dataset.ecrits = String(cr.ecrits);
    bloc.classList.toggle('hidden', cr.ecrits === 0);
    if (cr.ecrits === 0) return;

    $('titre-compte-rendu').textContent =
      `Passage terminé — ${cr.total} opération${cr.total > 1 ? 's' : ''}`;

    const zone = $('lignes-compte-rendu');
    zone.innerHTML = '';
    const ligne = (
      nombre: number,
      quoi: string,
      gestes: readonly [string, () => void | Promise<void>][],
    ) => {
      if (nombre === 0) return;
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center gap-x-3 gap-y-1';
      const texte = document.createElement('span');
      texte.className = 'text-slate-800 dark:text-slate-100';
      texte.innerHTML = '';
      const fort = document.createElement('strong');
      fort.textContent = String(nombre);
      texte.append(fort, ` ${quoi}`);
      li.appendChild(texte);
      for (const [libelle, faire] of gestes) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className =
          'cible-tactile rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700';
        b.textContent = libelle;
        b.addEventListener('click', () => void Promise.resolve(faire()).catch(dire));
        li.appendChild(b);
      }
      zone.appendChild(li);
    };

    const allerA = (lequel: typeof filtre) => {
      filtre = lequel;
      appliquerLeFiltre();
      $('titre-file').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    ligne(cr.pointees, 'pointées automatiquement', [
      ['Les revoir', () => allerA('tout')],
      [
        'Tout annuler',
        async () => {
          const combien = await annulerLePassage(debutDuPassage);
          if (combien === 0) return;
          await peindreTout();
        },
      ],
    ]);
    ligne(cr.aPointer, 'à pointer', [['Les traiter', () => allerA('a-pointer')]]);
    ligne(cr.aRevoir, 'à revoir', [['Les voir', () => allerA('a-revoir')]]);
    /*
       Les quatre nombres font le total annoncé. Sans cette quatrième ligne,
       « 87 opérations » surmonterait trois nombres qui n'en font que 73, et
       la première chose qu'on fait devant un compte rendu est l'addition.
    */
    ligne(cr.parMoi, 'déjà pointées par vous', []);

    peindreLeSondage(cr.aVerifier);
  }

  /**
   * Le contrôle par sondage : quelques lignes à relire, pas un inventaire.
   *
   * Le tirage est celui du moteur — les trois plus gros montants et deux au
   * hasard, à partir de dix pointées seules —, et il est déterministe : le
   * même passage propose le même échantillon, sur cet appareil comme sur
   * l'autre. Un sondage qui changerait à chaque ouverture ne se finirait
   * jamais.
   */
  function peindreLeSondage(ids: readonly string[]) {
    const vide = ids.length === 0;
    $('ligne-sondage').classList.toggle('hidden', vide);
    $('gestes-sondage').classList.toggle('hidden', vide);
    $('gestes-sondage').classList.toggle('flex', !vide);
    $('echantillon-sondage').classList.add('hidden');
    if (vide) return;

    $('ligne-sondage').textContent =
      `Contrôle par sondage : ${ids.length} opération${ids.length > 1 ? 's' : ''} ` +
      'à vérifier d’un coup d’œil.';
    sondageDuTour = [...ids];
  }

  /**
   * Les lignes tirées, avec ce qui a été décidé et pourquoi.
   *
   * Un seul geste par ligne : « Annuler ce pointage ». Corriger sur place
   * reviendrait à refaire ici l'écran de pointage, et l'opération annulée
   * retombe justement dans la file, à sa place, avec tous ses gestes.
   */
  async function peindreLEchantillon() {
    const [operations, pointages] = await Promise.all([
      toutesLesOperations(), tousLesPointages(),
    ]);
    const parOperation = new Map(pointages.map((p) => [p.operationId, p]));
    const zone = $('echantillon-sondage');
    zone.innerHTML = '';
    for (const id of sondageDuTour) {
      const o = operations.find((x) => x.id === id);
      const p = parOperation.get(id);
      if (!o || !p) continue;
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-indigo-200 bg-white p-3 dark:border-indigo-900 dark:bg-slate-900';

      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = `${o.libelle} — ${euros(o.centimes)}`;

      const detail = document.createElement('p');
      detail.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
      detail.textContent =
        `${typeDe(p.typeId ?? '')?.libelle ?? 'sans type'} · ${p.pourquoi}`;

      const defaire = document.createElement('button');
      defaire.type = 'button';
      defaire.className =
        'cible-tactile mt-2 rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700';
      defaire.textContent = 'Annuler ce pointage';
      defaire.addEventListener('click', () => {
        void annulerLePointage(id).then(peindreTout).catch(dire);
      });

      li.append(titre, detail, defaire);
      zone.appendChild(li);
    }
    zone.classList.remove('hidden');
  }

  async function peindreLesInconnus() {
    const [operations, su, pointages] = await Promise.all([
      toutesLesOperations(), connaissance(), tousLesPointages(),
    ]);
    pointablesDuTour = await pointables(operations);
    libellesDuTour = operations.map((o) => o.libelle);
    lignesDuTour = await toutesLesLignes();
    const parOperation = new Map(pointages.map((p) => [p.operationId, p]));
    /* On ne redemande pas ce que la personne a déjà classé elle-même. */
    const libres = operations.filter((o) => parOperation.get(o.id)?.auteur !== 'moi');
    const groupes = grouperLesInconnus(libres, su);

    $('bloc-inconnus').classList.toggle('hidden', groupes.length === 0);
    $('dix-suivants').classList.toggle('hidden', groupes.length <= inconnusMontres);
    const zone = $('inconnus');
    zone.innerHTML = '';
    for (const g of groupes.slice(0, inconnusMontres)) {
      zone.appendChild(carteDInconnu(g));
    }
  }

  function carteDInconnu(g: ReturnType<typeof grouperLesInconnus>[number]): HTMLElement {
    const li = document.createElement('li');
    li.dataset.inconnu = g.net;
    li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';

    const titre = document.createElement('p');
    titre.className = 'font-medium text-slate-900 dark:text-white';
    titre.textContent =
      `${g.net} — ${g.operationIds.length} opération(s) · ${euros(-g.cumule)} au total`;

    const variantes = document.createElement('p');
    variantes.className = 'mt-1 truncate text-xs text-slate-500 dark:text-slate-400';
    variantes.textContent = [...new Set(g.libelles)].map((l) => `« ${l} »`).join(', ');

    const choix = document.createElement('select');
    choix.dataset.typePour = g.net;
    choix.className =
      'mt-2 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950';
    const vide = document.createElement('option');
    vide.value = '';
    vide.textContent = 'Choisir un type…';
    choix.appendChild(vide);
    /*
       Les suggérés d'abord, et seulement ensuite la liste entière. Sans
       IA : un mot du libellé qui est le libellé d'un type, et rien de plus.
    */
    const suggeres = typesSuggeres(g.libelles, TOUS_LES_TYPES);
    for (const id of suggeres) {
      const o = document.createElement('option');
      o.value = id;
      o.textContent = `${typeDe(id)!.libelle} — suggéré`;
      choix.appendChild(o);
    }
    for (const t of TOUS_LES_TYPES) {
      if (suggeres.includes(t.id)) continue;
      const o = document.createElement('option');
      o.value = t.id;
      o.textContent = t.libelle;
      choix.appendChild(o);
    }
    if (suggeres.length) choix.value = suggeres[0];

    const gestes = document.createElement('div');
    gestes.className = 'mt-2 flex flex-wrap gap-2';
    gestes.append(
      bouton('Créer la règle', 'creer-regle', async () => {
        if (!choix.value) throw new Error('Choisissez un type avant de créer la règle.');
        await creerLaRegle(g, choix.value);
      }),
      bouton('Je ne sais pas', 'a-identifier', async () => {
        await creerLaRegle(g, 'a-identifier');
      }),
      bouton('Mode avancé', 'mode-avance', async () => {
        /*
           Le brouillon part du geste simple : même motif proposé, même mode
           « proposer ». Le mode avancé ouvre ce que le geste simple décide
           pour vous, il ne recommence pas depuis rien.
        */
        avanceOuvert = g.net;
        brouillon = brouillonPour(g.net, choix.value || 'a-identifier', g.libelles);
        await peindreLesInconnus();
      }),
    );

    li.append(titre, variantes, choix, gestes);
    if (avanceOuvert === g.net && brouillon) li.appendChild(formulaireAvance(g, brouillon));
    return li;
  }

  /**
   * Le mode avancé : ce que le geste simple décide à votre place.
   *
   * Quatre choses, et chacune est une décision que le geste en un clic prend
   * sans le dire — le motif, la façon de comparer, le droit de classer seule,
   * et la ligne de budget visée. Les montrer ne rend pas l'écran plus
   * compliqué : elles sont déjà prises, l'écran se contente d'avouer
   * lesquelles.
   *
   * Le formulaire se repeint en entier à chaque changement, pour la même
   * raison que l'éditeur de parts : l'aperçu, les défauts et l'avis sur le
   * motif dépendent tous de l'ensemble des champs.
   */
  function formulaireAvance(
    g: ReturnType<typeof grouperLesInconnus>[number],
    b: BrouillonDeRegle,
  ): HTMLElement {
    const bloc = document.createElement('div');
    bloc.dataset.avance = g.net;
    bloc.className = 'mt-3 space-y-3 border-t border-slate-200 pt-3 dark:border-slate-800';

    const champ = (
      etiquette: string,
      marque: string,
      valeur: string,
      surChangement: (v: string) => void,
      aide = '',
    ) => {
      const label = document.createElement('label');
      label.className = 'block text-sm';
      const titre = document.createElement('span');
      titre.className = 'block text-slate-700 dark:text-slate-200';
      titre.textContent = etiquette;
      const input = document.createElement('input');
      input.type = 'text';
      input.dataset.champRegle = marque;
      input.value = valeur;
      input.className =
        'mt-1 min-h-11 w-full max-w-md rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950';
      input.addEventListener('change', () => {
        surChangement(input.value);
        void peindreLesInconnus().catch(dire);
      });
      label.append(titre, input);
      if (aide) {
        const p = document.createElement('p');
        p.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
        p.textContent = aide;
        label.appendChild(p);
      }
      return label;
    };

    const liste = (
      etiquette: string,
      marque: string,
      options: readonly { valeur: string; libelle: string; interdit?: boolean }[],
      valeur: string,
      surChangement: (v: string) => void,
      aide = '',
    ) => {
      const label = document.createElement('label');
      label.className = 'block text-sm';
      const titre = document.createElement('span');
      titre.className = 'block text-slate-700 dark:text-slate-200';
      titre.textContent = etiquette;
      const select = document.createElement('select');
      select.dataset.champRegle = marque;
      select.className =
        'mt-1 min-h-11 w-full max-w-md rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950';
      for (const o of options) {
        const option = document.createElement('option');
        option.value = o.valeur;
        option.textContent = o.libelle;
        option.disabled = o.interdit === true;
        select.appendChild(option);
      }
      select.value = valeur;
      select.addEventListener('change', () => {
        surChangement(select.value);
        void peindreLesInconnus().catch(dire);
      });
      label.append(titre, select);
      if (aide) {
        const p = document.createElement('p');
        p.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
        p.textContent = aide;
        label.appendChild(p);
      }
      return label;
    };

    bloc.appendChild(champ('Nom de la règle', 'nom', b.nom, (v) => { b.nom = v; }));

    bloc.appendChild(liste(
      'Type',
      'type',
      TOUS_LES_TYPES.map((t) => ({ valeur: t.id, libelle: t.libelle })),
      b.typeId,
      (v) => { b.typeId = v; },
    ));

    bloc.appendChild(champ(
      'Motif cherché dans le libellé', 'motif', b.motif, (v) => { b.motif = v; },
      'Le libellé est d’abord nettoyé — mentions de carte, dates, références, ville — ' +
        'puis comparé à ce motif.',
    ));

    bloc.appendChild(liste(
      'Comparaison', 'comparaison',
      [
        { valeur: 'contient', libelle: 'Le libellé contient le motif' },
        { valeur: 'commence', libelle: 'Le libellé commence par le motif' },
        { valeur: 'exact', libelle: 'Le libellé est exactement le motif' },
      ],
      b.comparaison,
      (v) => { b.comparaison = v as BrouillonDeRegle['comparaison']; },
      'Les trois portent sur le libellé une fois nettoyé, pas sur celui du relevé : ' +
        '« exact » ' +
        'accepte donc deux lignes qui ne diffèrent que par leur date. Un motif qui déborde ' +
        'n’est pas forcément une erreur — l’aperçu dit ce qu’il prend.',
    ));

    /*
       Le mode « Pointe seule » est **désactivé**, et non masqué, quand le
       type l'interdit. Le masquer laisserait croire qu'il n'existe pas ;
       le montrer barré dit qu'il existe et pourquoi il est hors d'atteinte.
    */
    const interdit = typeDe(b.typeId)?.jamaisAuto === true;
    bloc.appendChild(liste(
      'Ce que la règle a le droit de faire', 'mode',
      [
        { valeur: 'proposer', libelle: 'Proposer, et attendre un geste' },
        { valeur: 'auto', libelle: 'Pointer seule', interdit },
        { valeur: 'manuel', libelle: 'Ne rien faire seule : classement toujours manuel' },
      ],
      b.mode,
      (v) => { b.mode = v as BrouillonDeRegle['mode']; },
      interdit
        ? `« ${typeDe(b.typeId)!.libelle} » n’est jamais pointé automatiquement : « Pointer ` +
          'seule » est hors d’atteinte pour ce type.'
        : 'Une règle créée en un geste propose ; lui laisser décider seule est votre choix.',
    ));

    bloc.appendChild(liste(
      'Ligne de budget visée (facultatif)', 'ligne',
      [{ valeur: '', libelle: 'Aucune' },
       ...lignesDuTour.map((l) => ({ valeur: l.id, libelle: l.libelle }))],
      b.ligneId ?? '',
      (v) => { b.ligneId = v || null; },
      'Sert au rapprochement : les opérations de ce vendeur seront proposées contre cette ligne.',
    ));

    /* ── Les défauts, et l'avis sur le motif ──────────────────────────── */
    const { problemes, avis } = controlerLeBrouillon(b, g.libelles, libellesDuTour);
    const defauts = document.createElement('ul');
    defauts.dataset.defautsRegle = g.net;
    defauts.className = 'list-disc space-y-1 pl-5 text-sm text-rose-800 dark:text-rose-200';
    defauts.classList.toggle('hidden', problemes.length === 0);
    for (const p of problemes) {
      const li = document.createElement('li');
      li.textContent = p.phrase;
      defauts.appendChild(li);
    }
    bloc.appendChild(defauts);

    if (avis.acceptable && avis.deTrop.length) {
      const trop = document.createElement('p');
      trop.dataset.motifDeborde = g.net;
      trop.className = 'text-sm text-amber-800 dark:text-amber-200';
      trop.textContent =
        `${avis.avertissement} Par exemple : ${avis.deTrop.slice(0, 3).map((l) => `« ${l} »`).join(', ')}.`;
      bloc.appendChild(trop);
    }

    /* ── L'aperçu sur le passé ────────────────────────────────────────── */
    const regle = regleDepuisLeBrouillon(b, 'apercu', new Date().toISOString());
    const apercu = apercuSurLePasse(regle, pointablesDuTour);
    const resume = document.createElement('p');
    resume.dataset.apercuRegle = g.net;
    resume.className = 'text-sm text-slate-700 dark:text-slate-200';
    resume.textContent = apercu.phrase;
    bloc.appendChild(resume);

    if (apercu.touchees.length) {
      const exemples = document.createElement('p');
      exemples.dataset.exemplesRegle = g.net;
      exemples.className = 'text-xs text-slate-500 dark:text-slate-400';
      exemples.textContent =
        `Par exemple : ${apercu.touchees.slice(0, 3).map((o) => `« ${o.libelle} »`).join(', ')}.`;
      bloc.appendChild(exemples);
    }

    /* ── Les gestes ───────────────────────────────────────────────────── */
    const gestes = document.createElement('div');
    gestes.className = 'flex flex-wrap gap-2';

    const creer = bouton('Créer la règle', 'creer-avance', async () => {
      await creerDepuisLeBrouillon(g, b, false);
    });
    const creerEtAppliquer = bouton(
      `Créer et appliquer à ${apercu.touchees.length} opération(s) passée(s)`,
      'creer-et-appliquer',
      async () => {
        await creerDepuisLeBrouillon(g, b, true);
      },
    );
    for (const btn of [creer, creerEtAppliquer]) {
      btn.disabled = problemes.length > 0;
      btn.classList.toggle('opacity-40', problemes.length > 0);
    }
    creerEtAppliquer.classList.toggle('hidden', apercu.touchees.length === 0);

    gestes.append(creer, creerEtAppliquer, bouton('Revenir au geste simple', 'fermer-avance', async () => {
      avanceOuvert = null;
      brouillon = null;
      await peindreLesInconnus();
    }));
    bloc.appendChild(gestes);
    return bloc;
  }

  async function creerDepuisLeBrouillon(
    g: ReturnType<typeof grouperLesInconnus>[number],
    b: BrouillonDeRegle,
    auPasse: boolean,
  ) {
    const r = regleDepuisLeBrouillon(b, `r-${Date.now()}-${g.net.slice(0, 12)}`, new Date().toISOString());
    await ecrireLaRegle(r);
    await noterLeVendeur(g.net, b.typeId, g.net);
    if (auPasse) {
      const { ecrits, protegees } = await appliquerLaRegleAuPasse(r, await toutesLesOperations());
      dire(
        `${ecrits} opération(s) reclassée(s)` +
          (protegees ? `, et ${protegees} que vous aviez pointée(s) vous-même n’ont pas bougé.` : '.'),
      );
      $('erreur').className =
        'rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-700 dark:bg-slate-900 dark:text-slate-200';
    } else {
      /* Comme le geste simple : les opérations du groupe sont ce qu'on vient
         de nommer, et les pointer finit le geste au lieu de l'étendre. */
      await ecrireLesPointages(g.operationIds.map((id) => ({
        operationId: id,
        statut: 'pointee-par-moi' as const,
        vendeurNom: g.net,
        typeId: b.typeId,
        auteur: 'moi' as const,
        pourquoi: `Règle « ${r.nom} » créée par vous.`,
      })));
    }
    avanceOuvert = null;
    brouillon = null;
    await peindreTout();
  }

  async function creerLaRegle(
    g: ReturnType<typeof grouperLesInconnus>[number],
    typeId: string,
  ) {
    const b = brouillonPour(g.net, typeId, g.libelles);
    const r = regleDepuisLeBrouillon(b, `r-${Date.now()}-${g.net.slice(0, 12)}`, new Date().toISOString());
    await ecrireLaRegle(r);
    await noterLeVendeur(g.net, typeId, g.net);
    /*
       La règle vaut pour l'avenir. Les opérations de ce groupe sont
       pointées tout de suite parce qu'elles **sont** ce qu'on vient de
       nommer — ce n'est pas « appliquer au passé », c'est finir le geste.
    */
    await ecrireLesPointages(g.operationIds.map((id) => ({
      operationId: id,
      statut: 'pointee-par-moi' as const,
      vendeurNom: g.net,
      typeId,
      auteur: 'moi' as const,
      pourquoi: `Règle « ${r.motif} » créée par vous.`,
    })));
    await peindreTout();
  }

  /* ── L'éditeur de parts ────────────────────────────────────────────────── */

  /** Au-delà, on ne cherche plus, on feuillette : la recherche doit mordre. */
  const OPERATIONS_MONTREES = 12;

  /**
   * Les opérations qui répondent à la recherche.
   *
   * Par libellé **ou** par montant, parce qu'on se souvient de l'un ou de
   * l'autre, rarement des deux. Le montant est comparé sur sa forme affichée
   * autant que sur ses chiffres : quelqu'un qui tape « 120 » cherche 120,00 €
   * et ne pense pas en centimes.
   */
  function operationsCherchees(
    operations: readonly OperationBancaire[],
    recherche: string,
  ): OperationBancaire[] {
    const net = recherche.trim().toLowerCase();
    if (!net) return [];
    const chiffres = net.replace(/[^\d,.-]/g, '').replace(',', '.');
    return operations
      .filter((o) => {
        if (o.libelle.toLowerCase().includes(net)) return true;
        if (!chiffres) return false;
        const montant = Math.abs(o.centimes / 100).toFixed(2);
        return montant.startsWith(chiffres) || montant === chiffres;
      })
      .sort((a, b) => b.jour.localeCompare(a.jour))
      .slice(0, OPERATIONS_MONTREES);
  }

  async function peindreLeFractionnement() {
    const [operations, pointages] = await Promise.all([
      toutesLesOperations(), tousLesPointages(),
    ]);
    const parOperation = new Map(pointages.map((p) => [p.operationId, p]));
    const trouvees = operationsCherchees(operations, rechercheDOperation);

    const combien = $('fractionnement-combien');
    combien.textContent = !rechercheDOperation.trim()
      ? 'Tapez de quoi reconnaître l’opération : une opération se fractionne une par une.'
      : trouvees.length
        ? `${trouvees.length} opération(s) trouvée(s)${trouvees.length === OPERATIONS_MONTREES ? ', les plus récentes' : ''}.`
        : 'Aucune opération ne correspond.';

    const liste = $('fractionnables');
    liste.innerHTML = '';
    for (const o of trouvees) {
      liste.appendChild(ligneFractionnable(o, parOperation.get(o.id) ?? null));
    }
  }

  function ligneFractionnable(
    o: OperationBancaire,
    pointage: { typeId: string | null; parts: readonly PartPointee[] } | null,
  ): HTMLElement {
    const li = document.createElement('li');
    li.dataset.fractionnable = o.id;
    li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';

    const entete = document.createElement('p');
    entete.className = 'font-medium tabular-nums text-slate-900 dark:text-white';
    entete.textContent = `${o.jour}  ${euros(o.centimes)}  ${o.libelle}`;
    li.appendChild(entete);

    const etat = document.createElement('p');
    etat.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
    etat.dataset.etatPointage = o.id;
    etat.textContent = pointage?.parts.length
      ? `Déjà fractionnée en ${pointage.parts.length} parts : ` +
        pointage.parts.map((x) => `${typeDe(x.typeId)?.libelle ?? x.typeId} ${euros(x.centimes)}`).join(' · ')
      : pointage?.typeId
        ? `Pointée « ${typeDe(pointage.typeId)?.libelle ?? pointage.typeId} », en une seule part.`
        : 'Pas encore pointée.';
    li.appendChild(etat);

    if (operationEnEdition === o.id) {
      li.appendChild(editeurDeParts(o));
    } else {
      const gestes = document.createElement('div');
      gestes.className = 'mt-2 flex flex-wrap gap-2';
      gestes.appendChild(bouton(
        pointage?.parts.length ? 'Modifier les parts' : 'Fractionner',
        'ouvrir-fractionnement',
        async () => {
          operationEnEdition = o.id;
          /*
             On reprend les parts existantes s'il y en a. Repartir d'un
             partage égal effacerait sans prévenir une répartition que la
             personne avait réglée au centime.
          */
          partsEnEdition = pointage?.parts.length
            ? pointage.parts.map((x) => ({ ...x }))
            : partsDeDepart(o, pointage?.typeId ?? null);
          await peindreLeFractionnement();
        },
      ));
      if (pointage?.parts.length) {
        gestes.appendChild(bouton('Défaire le fractionnement', 'defaire-fractionnement', async () => {
          await defractionnerLOperation(o.id);
          await peindreTout();
        }));
      }
      li.appendChild(gestes);
    }
    return li;
  }

  /**
   * L'éditeur lui-même.
   *
   * Il se repeint en entier à chaque frappe. C'est inhabituel pour un
   * formulaire, et c'est voulu ici : le reste à répartir, les pourcentages et
   * la liste des défauts dépendent tous de l'ensemble des parts, et un rendu
   * partiel laisserait un chiffre en retard d'une frappe sur les autres —
   * exactement le genre d'écart qui fait douter de tout l'écran.
   */
  function editeurDeParts(o: OperationBancaire): HTMLElement {
    const bloc = document.createElement('div');
    bloc.dataset.editeurParts = o.id;
    bloc.className = 'mt-3 space-y-2 border-t border-slate-200 pt-3 dark:border-slate-800';

    const redessiner = () => {
      void peindreLeFractionnement();
    };

    partsEnEdition.forEach((part, index) => {
      const ligne = document.createElement('div');
      ligne.dataset.part = String(index);
      ligne.className = 'flex flex-wrap items-center gap-2';

      const choix = document.createElement('select');
      choix.dataset.typeDeLaPart = String(index);
      choix.className =
        'min-h-11 flex-1 rounded-lg border border-slate-300 bg-white px-2 text-sm dark:border-slate-700 dark:bg-slate-950';
      for (const t of TOUS_LES_TYPES) {
        const option = document.createElement('option');
        option.value = t.id;
        option.textContent = t.libelle;
        choix.appendChild(option);
      }
      choix.value = part.typeId;
      choix.addEventListener('change', () => {
        partsEnEdition[index] = { ...part, typeId: choix.value };
        redessiner();
      });

      const montant = document.createElement('input');
      montant.type = 'text';
      montant.inputMode = 'decimal';
      montant.dataset.montantDeLaPart = String(index);
      montant.className =
        'min-h-11 w-28 rounded-lg border border-slate-300 bg-white px-2 text-right text-sm tabular-nums dark:border-slate-700 dark:bg-slate-950';
      montant.value = (part.centimes / 100).toFixed(2).replace('.', ',');
      /*
         Sur « change » et non sur « input » : relire à chaque frappe
         transformerait « 1 » en un euro, puis « 12 » en douze, et
         repeindrait l'écran sous les doigts de la personne.
      */
      montant.addEventListener('change', () => {
        const lu = centimesDe(montant.value);
        if (lu === null) {
          dire(new Error(`« ${montant.value} » ne se lit pas comme un montant. Par exemple : -70,00.`));
          return;
        }
        partsEnEdition[index] = { ...partsEnEdition[index], centimes: lu };
        redessiner();
      });

      const part100 = partEnPourcentage(part, o);
      const pourcentage = document.createElement('span');
      pourcentage.dataset.pourcentage = String(index);
      pourcentage.className = 'w-14 text-right text-xs tabular-nums text-slate-500 dark:text-slate-400';
      pourcentage.textContent = part100 === null ? '—' : `${part100.toFixed(0)} %`;

      ligne.append(choix, montant, pourcentage);
      ligne.appendChild(bouton('Le reste ici', 'poser-le-reste', async () => {
        partsEnEdition = mettreLeResteSur(o, partsEnEdition, index);
        await peindreLeFractionnement();
      }));
      ligne.appendChild(bouton('Retirer', 'retirer-part', async () => {
        partsEnEdition = retirerUnePart(partsEnEdition, index);
        await peindreLeFractionnement();
      }));
      bloc.appendChild(ligne);
    });

    const reste = document.createElement('p');
    reste.dataset.reste = o.id;
    reste.className = 'text-sm tabular-nums text-slate-700 dark:text-slate-200';
    reste.textContent = phraseDuReste(o, partsEnEdition);
    bloc.appendChild(reste);

    const defauts = controlerLesParts(o, partsEnEdition);
    const liste = document.createElement('ul');
    liste.dataset.defautsParts = o.id;
    liste.className = 'list-disc space-y-1 pl-5 text-sm text-rose-800 dark:text-rose-200';
    liste.classList.toggle('hidden', defauts.length === 0);
    for (const d of defauts) {
      const li = document.createElement('li');
      li.textContent = d;
      liste.appendChild(li);
    }
    bloc.appendChild(liste);

    const gestes = document.createElement('div');
    gestes.className = 'flex flex-wrap gap-2';
    gestes.appendChild(bouton('Ajouter une part', 'ajouter-part', async () => {
      if (partsEnEdition.length >= PARTS_MAXIMALES) {
        throw new Error(
          `${PARTS_MAXIMALES} parts est le maximum : au-delà, ce n’est plus répartir une ` +
            'opération, c’est ressaisir un ticket.',
        );
      }
      const libre = TOUS_LES_TYPES.find((t) => !partsEnEdition.some((x) => x.typeId === t.id));
      partsEnEdition = ajouterUnePart(o, partsEnEdition, libre?.id ?? TOUS_LES_TYPES[0].id);
      await peindreLeFractionnement();
    }));
    gestes.appendChild(bouton('Parts égales', 'parts-egales', async () => {
      /*
         On garde les types déjà choisis, et l'on ne redistribue que les
         montants : « parts égales » corrige une répartition, il ne recommence
         pas le classement.
      */
      const egales = repartirEnParts(o, partsEnEdition.length, partsEnEdition[0]?.typeId ?? '');
      partsEnEdition = egales.map((part, i) => ({
        typeId: partsEnEdition[i]?.typeId ?? part.typeId,
        centimes: part.centimes,
      }));
      await peindreLeFractionnement();
    }));

    const valider = bouton('Enregistrer la répartition', 'valider-parts', async () => {
      await fractionnerLOperation(o, partsEnEdition);
      operationEnEdition = null;
      partsEnEdition = [];
      await peindreTout();
    });
    valider.disabled = defauts.length > 0;
    valider.classList.toggle('opacity-40', defauts.length > 0);
    gestes.appendChild(valider);

    gestes.appendChild(bouton('Abandonner', 'abandonner-parts', async () => {
      operationEnEdition = null;
      partsEnEdition = [];
      await peindreLeFractionnement();
    }));
    bloc.appendChild(gestes);
    return bloc;
  }

  /* ── Les catégories pointées ───────────────────────────────────────────── */

  async function peindreLesCategoriesPointees() {
    const [operations, lignes, pointages, modifications] = await Promise.all([
      toutesLesOperations(), toutesLesLignes(), tousLesPointages(), lireLesModifications(),
    ]);
    const jours = operations.map((o) => o.jour).sort();
    const du = jours.length ? jours[0].slice(0, 8) + '01' : aujourdHui;
    const au = jours.length ? jours[jours.length - 1] : aujourdHui;

    /* Le prévu par catégorie, mensualisé sur la période des opérations. */
    const prevuParCategorie: Record<string, number> = {};
    for (const l of lignes) {
      const v = l.versions[l.versions.length - 1];
      if (!v) continue;
      prevuParCategorie[l.categorie || 'Sans catégorie'] =
        (prevuParCategorie[l.categorie || 'Sans catégorie'] ?? 0) + v.montant;
    }

    const vue = vueDesCategories({
      operations, pointages, prevuParCategorie, modifications, du, au,
    });

    const zone = $('categories-pointees');
    zone.innerHTML = '';
    for (const l of vue.lignes) {
      const li = document.createElement('li');
      li.dataset.categoriePointee = l.categorie;
      li.className =
        'flex flex-wrap items-baseline justify-between gap-2 rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-800';
      const gauche = document.createElement('span');
      gauche.className = 'font-medium text-slate-900 dark:text-white';
      gauche.textContent = `${l.dUnSeulCote ? '⚠ ' : ''}${l.categorie}`;
      const droite = document.createElement('span');
      droite.className = 'tabular-nums text-slate-600 dark:text-slate-300';
      const relatif = l.ecartRelatif === null
        ? '—'
        : `${(l.ecartRelatif * 100).toFixed(1).replace('.', ',')} %`;
      droite.textContent =
        `prévu ${euros(l.prevu)} · réalisé ${euros(l.reel)} · écart ${euros(l.ecart)} (${relatif})`;
      li.append(gauche, droite);
      zone.appendChild(li);
    }

    $('non-pointe').textContent = vue.nonPointe.phrase;
    const seul = [
      ...vue.prevuesSansRealise.map((c) => `« ${c} » est prévue et rien ne l’alimente`),
      ...vue.realiseesSansPrevu.map((c) => `« ${c} » est dépensée et n’est prévue nulle part`),
    ];
    $('un-seul-cote').classList.toggle('hidden', seul.length === 0);
    if (seul.length) {
      $('un-seul-cote').textContent = `⚠ ${seul.join(' ; ')}.`;
    }
  }

  /* ── L'export ICS ──────────────────────────────────────────────────────── */

  async function exporterLesEcheances() {
    const { lignes } = await rassembler();
    const options = {
      ...OPTIONS_PAR_DEFAUT(aujourdHui),
      ressourcesComprises: ($('ics-ressources') as HTMLInputElement).checked,
    };
    /*
       Les occurrences sont recalculées sur la fenêtre de l'export, et non
       reprises de celle de la file : la file regarde autour des opérations
       importées, l'export regarde devant. Réutiliser la première exporterait
       surtout du passé.
    */
    const occ = lignes.flatMap((l) => occurrences(l, options.depuis, options.jusqua));
    const texte = echeancesEnIcs(lignes, occ, options);
    const combien = texte.split('BEGIN:VEVENT').length - 1;

    offrirLeFichier(texte, `echeances-${aujourdHui}.ics`, 'text/calendar;charset=utf-8');

    const zone = $('resultat-ics');
    zone.classList.remove('hidden');
    zone.dataset.combien = String(combien);
    zone.textContent = combien
      ? `${combien} échéance(s) exportée(s), du ${options.depuis} au ${options.jusqua}.`
      : 'Aucune échéance sur les douze prochains mois : il n’y a pas encore de ligne de budget.';
  }

  /* ── Le cycle ──────────────────────────────────────────────────────────── */

  async function peindreTout() {
    $('erreur').classList.add('hidden');
    peindreLeCompteRendu(await pointerCeQuiPeutLEtre());
    await peindreLaFile();
    await peindreLesInconnus();
    await peindreLeFractionnement();
    await peindreLesCategoriesPointees();
    await peindreLesComptes();
    await peindreLesEcarts();
    appliquerLeFiltre();
  }

  /**
   * Le filtre masque, il ne recalcule pas.
   *
   * Un filtre qui refait les calculs changerait les totaux affichés
   * ailleurs sur l'écran selon l'onglet choisi, ce qui est la façon la plus
   * sûre de rendre deux chiffres incomparables.
   */
  function appliquerLeFiltre() {
    const montrer = (selecteur: string, oui: boolean) => {
      for (const e of document.querySelectorAll<HTMLElement>(selecteur)) {
        e.classList.toggle('hidden', !oui);
      }
    };
    const rapprocher = filtre === 'tout' || filtre === 'a-rapprocher';
    const pointer = filtre === 'tout' || filtre === 'a-pointer';
    montrer('[data-proposition]', rapprocher);
    montrer('[data-a-classer]', pointer);
    montrer('[data-inconnu]', pointer);
    $('bloc-fractionnement').classList.toggle('hidden', !pointer);

    /*
       Un titre de section ne s'affiche que si le filtre le permet **et**
       qu'il y a quelque chose dessous. Sans la seconde condition, le filtre
       réaffiche « Probables — un geste chacun » au-dessus du vide, et le
       premier essai en navigateur l'a vu : il écrasait la logique de
       vacuité que la peinture venait d'appliquer.
    */
    const combien = (s: string) => document.querySelectorAll(s).length;
    $('titre-probables').classList.toggle(
      'hidden', !(rapprocher && combien('[data-proposition]') > 0),
    );
    $('titre-a-classer').classList.toggle(
      'hidden', !(pointer && combien('[data-a-classer]') > 0),
    );
    $('bloc-inconnus').classList.toggle(
      'hidden', !(pointer && combien('[data-inconnu]') > 0),
    );
    for (const b of document.querySelectorAll<HTMLElement>('.filtre')) {
      const actif = b.dataset.filtre === filtre;
      b.dataset.actif = String(actif);
      b.classList.toggle('bg-slate-800', actif);
      b.classList.toggle('text-white', actif);
      b.classList.toggle('dark:bg-slate-200', actif);
      b.classList.toggle('dark:text-slate-900', actif);
    }
  }

  async function recharger() {
    await reprendreLeCoffre();
    const ouvert = coffreOuvert();
    $('coffre-ferme').classList.toggle('hidden', ouvert);
    $('coffre-ouvert').classList.toggle('hidden', !ouvert);
    if (ouvert) await peindreTout();
  }

  function marquerLAxe() {
    for (const b of document.querySelectorAll<HTMLElement>('.axe')) {
      const actif = b.dataset.axe === axe;
      b.dataset.actif = String(actif);
      b.classList.toggle('bg-slate-800', actif);
      b.classList.toggle('text-white', actif);
      b.classList.toggle('dark:bg-slate-200', actif);
      b.classList.toggle('dark:text-slate-900', actif);
    }
  }

  auDeverrouillage(
    async () => {
      $('ouvrir-coffre').addEventListener('click', () => {
        void (async () => {
          const mdp = $('mdp-coffre') as HTMLInputElement;
          const erreur = await ouvrirLeCoffre(mdp.value, {
            memoriserAppareil:
              (document.getElementById('coffre-appareil') as HTMLInputElement | null)?.checked ??
              false,
          });
          $('erreur-coffre').classList.toggle('hidden', erreur === null);
          if (erreur) {
            $('erreur-coffre').textContent = erreur;
            return;
          }
          mdp.value = '';
          debutDuPassage = new Date().toISOString();
          await recharger();
        })();
      });
      $('mdp-coffre').addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') $('ouvrir-coffre').click();
      });
      $('fermer-coffre').addEventListener('click', () => {
        fermerLeCoffre();
        void recharger();
      });

      $('tout-confirmer').addEventListener('click', () => {
        void (async () => {
          /*
             « Tout confirmer » porte sur les **probables** seules. Les
             certaines sont déjà appliquées, et les « à classer » n'ont
             aucune cible : les emporter dans le même geste rangerait des
             opérations nulle part.
          */
          const { operations, lignes, occ, etat } = await rassembler();
          const dejaRangees = new Set(etat.retenus.map((r) => r.operationId));
          const occPrises = new Set(
            etat.retenus.filter((r) => r.occurrenceId).map((r) => r.occurrenceId as string),
          );
          const file = construireLaFile(
            occ.filter((o) => !occPrises.has(o.id)),
            operations.filter((o) => !dejaRangees.has(o.id)),
            reglagesDe(lignes),
          );
          const quand = new Date().toISOString();
          await ecrireRapprochements(
            file.probables.map((p) => ({
              operationId: p.operationId,
              occurrenceId: p.occurrenceId,
              ligneId: p.ligneId,
              type: 'confirme' as const,
              centimes: operations.find((o) => o.id === p.operationId)?.centimes ?? 0,
              ecartAuPrevu: p.ecartAuPrevu,
              decideLe: quand,
            })),
          );
          await peindreTout();
        })().catch(dire);
      });

      /*
         « Annuler » du pied : il défait les certaines **de ce passage**, et
         non toutes celles jamais appliquées. Une opération rangée d'office
         il y a trois mois et jamais contestée n'a pas à revenir dans la file
         parce qu'on rouvre l'écran aujourd'hui.
      */
      $('annuler-certaines').addEventListener('click', () => {
        void annulerLesAutomatiques(debutDuPassage).then(peindreTout).catch(dire);
      });

      $('verifier-sondage').addEventListener('click', () => {
        void peindreLEchantillon().catch(dire);
      });
      /*
         « Plus tard » ne reporte rien et ne retient rien : il referme la
         ligne pour cette visite. Un sondage qu'on repousse en le notant
         quelque part reviendrait le lendemain avec les mêmes opérations,
         et c'est ainsi qu'un contrôle devient une corvée.
      */
      $('sondage-plus-tard').addEventListener('click', () => {
        $('ligne-sondage').classList.add('hidden');
        $('gestes-sondage').classList.add('hidden');
        $('gestes-sondage').classList.remove('flex');
        $('echantillon-sondage').classList.add('hidden');
      });

      $('verifier-solde').addEventListener('click', () => void verifierLeSolde().catch(dire));
      for (const champ of ['solde-declare', 'solde-depart']) {
        $(champ).addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Enter') $('verifier-solde').click();
        });
      }
      $('deduire').addEventListener('click', () => void peindreLesRecurrences().catch(dire));
      $('exporter-ics').addEventListener('click', () => void exporterLesEcheances().catch(dire));

      for (const b of document.querySelectorAll<HTMLElement>('.filtre')) {
        b.addEventListener('click', () => {
          filtre = (b.dataset.filtre as typeof filtre) ?? 'tout';
          appliquerLeFiltre();
        });
      }
      /*
         La recherche se déclenche sur « input » et non sur « change » : elle
         ne fait que filtrer une liste déjà en mémoire, et attendre que le
         champ perde le focus pour montrer le résultat donnerait l'impression
         d'un écran qui ne répond pas.
      */
      $('chercher-operation').addEventListener('input', (e) => {
        rechercheDOperation = (e.target as HTMLInputElement).value;
        /* Changer de recherche ferme l'éditeur : il porte sur une opération
           qui peut disparaître de la liste sous lui. */
        operationEnEdition = null;
        partsEnEdition = [];
        void peindreLeFractionnement().catch(dire);
      });

      $('dix-suivants').addEventListener('click', () => {
        inconnusMontres += 10;
        void peindreLesInconnus().then(appliquerLeFiltre).catch(dire);
      });

      for (const b of document.querySelectorAll<HTMLElement>('.axe')) {
        b.addEventListener('click', () => {
          axe = (b.dataset.axe as typeof axe) ?? 'ligne';
          marquerLAxe();
          void peindreLesEcarts().catch(dire);
        });
      }
      marquerLAxe();
      appliquerLeFiltre();

      surCoffre(() => void recharger());
      await recharger();
      $('vue').classList.remove('hidden');
    },
    { zoneChargement: '#chargement-rapprocher' },
  );
</script>
