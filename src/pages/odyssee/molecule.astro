---
/**
 * La fiche d'une molécule.
 *
 * ## Ce que cet écran montre aujourd'hui, et pourquoi
 *
 * Peu de choses, et il dit lesquelles. Les sources primaires restent
 * injoignables depuis la machine qui construit ce site — PubMed, Europe PMC,
 * PubChem, les agences —, donc aucune limite de sécurité et aucune dose
 * étudiée n'a pu être sourcée.
 *
 * **Deux choses y figurent pourtant, et c'est une correction.** Cinq fiches
 * sont arrivées le 16 octobre, lues dans leur RCP, et ONZE INTERACTIONS avec
 * elles, tirées du Thésaurus de l'ANSM. Cet en-tête disait encore « aucune
 * interaction n'a pu être sourcée », et l'écran n'en montrait aucune : elles
 * existaient, justes et invisibles, pendant trois jours. C'est l'anomalie
 * A-21 une seconde fois — une phrase que l'application montre et qui ment
 * vaut moins que pas de phrase du tout, parce qu'elle apprend à se méfier
 * du reste.
 *
 * L'écran existe quand même, et complet, pour une raison : la **forme** est
 * ce qui empêchera plus tard d'écrire n'importe quoi. Chaque section porte
 * déjà sa phrase fixe, son étiquette de provenance et son contrôle. Le jour
 * où une valeur arrivera, elle devra entrer par une de ces portes, avec sa
 * source — ou elle n'entrera pas.
 *
 * ## Ce qu'il ne fait pas
 *
 * Il ne dit pas ce que la bibliothèque externe contient pour cette molécule.
 * Cyclades ne le sait pas, et ne doit pas pouvoir le savoir : le registre des
 * noms ne garde aucune trace de provenance. Le lien sortant est générique, et
 * la phrase le dit.
 */
import Base from '../../layouts/Base.astro';
import FormulaireCoffre from '../../components/FormulaireCoffre.astro';
import {
  ADRESSE_BIBLIOTHEQUE,
  ATTRIBUTION,
  AVERTISSEMENT_SORTANT,
  COUVERTURE_INCONNUE,
  LIBELLE_LIEN,
  MENTION_DONNEE_MORTE,
} from '../../lib/odyssee/bibliotheque-externe';
import {
  AUCUNE_DOSE_HUMAINE,
  AUCUNE_LIMITE,
  direLaLimite,
  limitesDe,
  BANDEAU_SANS_FICHE,
  LIBELLE_DOSES,
  NON_DOCUMENTE,
} from '../../lib/odyssee/molecules';
---

<Base titre="Molécule" actif="sante" coffre>
  <h1 id="titre-molecule" class="text-2xl font-bold text-slate-900 dark:text-white">Molécule</h1>
  <p id="etiquette-identite" class="mt-1 hidden text-xs font-medium text-amber-700 dark:text-amber-300">
    identité non vérifiée
  </p>

  <!--
    Le coffre fermé n'est pas une erreur.

    Cette page affichait un encadré rouge « Déchiffrement impossible » avec un
    bouton « Réessayer », et déposait une erreur dans la console. Or il ne
    s'était rien passé d'anormal : le mot de passe est redemandé à chaque
    nouvel onglet, par conception. Traiter cet état comme une panne apprend à
    la personne à se méfier de son propre coffre, et le bouton « Réessayer »
    ne pouvait rien réessayer du tout.

    La carte est celle de Psyché et de Finances, au mot près — deux versions
    de la même promesse finiraient par diverger.
  -->
  <FormulaireCoffre raison={"Le mot de passe est redemandé à chaque nouvel onglet. La clé ne quitte pas cet appareil."} />

  <div id="chargement" class="py-16 text-center text-slate-400">Lecture de la fiche…</div>

  <!--
    L'index du catalogue, quand l'adresse ne nomme aucune molécule (M10).

    Sans lui, cette page n'était atteignable **que** depuis un traitement
    déclaré — donc pas du tout sur un appareil qui n'en porte aucun, et pas
    davantage pour le contrôle de la carte des écrans. Une page dont la seule
    porte dépend des données de la personne est orpheline la moitié du temps.

    Les noms du catalogue sont ceux d'une référence publique — un RCP, le
    Thésaurus de l'ANSM — et non des données d'Alexis. Ce qui est à lui, c'est
    le **lien** entre une molécule et lui, et celui-là passe par
    « ?traitement=<identifiant> », jamais par un nom dans une adresse.
  -->
  <section id="index-molecules" class="hidden mt-5">
    <p class="text-sm text-slate-600 dark:text-slate-300">
      Les fiches documentées. Chacune cite sa source et sa date de lecture.
    </p>
    <ul id="liste-catalogue" class="mt-3 space-y-1"></ul>
  </section>

  <div id="fiche" class="hidden mt-5 space-y-6">
    <!-- Le bandeau de la molécule sans fiche (décision 13). -->
    <section
      id="bandeau-sans-fiche"
      class="hidden rounded-2xl border border-amber-300 bg-amber-50/70 p-4 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
    >
      {BANDEAU_SANS_FICHE}
    </section>

    <!-- Profondeur 1 : d'un coup d'œil. -->
    <section>
      <h2 class="etiquette text-slate-500 dark:text-slate-400">D’un coup d’œil</h2>
      <dl class="mt-2 grid gap-x-6 gap-y-2 sm:grid-cols-2">
        <div class="flex justify-between gap-4 border-b border-slate-100 py-1.5 dark:border-slate-900">
          <dt class="text-sm text-slate-500 dark:text-slate-400">Classe</dt>
          <dd id="v-classe" class="text-sm text-slate-700 dark:text-slate-200">{NON_DOCUMENTE}</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-slate-100 py-1.5 dark:border-slate-900">
          <dt class="text-sm text-slate-500 dark:text-slate-400">Statut en France</dt>
          <dd id="v-statut" class="text-sm text-slate-700 dark:text-slate-200">{NON_DOCUMENTE}</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-slate-100 py-1.5 dark:border-slate-900">
          <dt class="text-sm text-slate-500 dark:text-slate-400">Niveau de preuve</dt>
          <dd id="v-preuve" class="text-sm text-slate-700 dark:text-slate-200">inconnu</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-slate-100 py-1.5 dark:border-slate-900">
          <dt class="text-sm text-slate-500 dark:text-slate-400">Demi-vie</dt>
          <dd id="v-demi-vie" class="text-sm text-slate-700 dark:text-slate-200">{NON_DOCUMENTE}</dd>
        </div>
      </dl>
    </section>

    <!--
      Les interactions connues.

      DÉPLIÉE, et non rangée sous « Exhaustif » avec les limites et les
      doses. Celles-là sont vides et le resteront jusqu'à ce qu'une source
      arrive ; celles-ci sont documentées, sourcées et nommées, et une
      contre-indication derrière un pli est une contre-indication qu'on ne
      lit pas. C'est le même raisonnement que la hiérarchie anti-fatigue de
      la décision 3.10 : documentées dépliées, toujours en tête.
    -->
    <section id="bloc-interactions">
      <h2 class="etiquette text-slate-500 dark:text-slate-400">Interactions connues</h2>
      <p id="interactions-etat" class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p>
      <p id="interactions-sous" class="mt-1 hidden text-xs text-slate-500 dark:text-slate-400"></p>
      <ul id="interactions" class="mt-2 space-y-2"></ul>
      <p id="interactions-source" class="mt-2 hidden text-xs text-slate-500 dark:text-slate-400"></p>
    </section>

    <!-- Profondeurs 2 et 3 : repliées, pour ne pas submerger (2.6). -->
    <details class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800">
      <summary class="cible-tactile cursor-pointer text-sm font-medium text-slate-900 dark:text-white">
        À la demande — mécanisme, effets indésirables
      </summary>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        {NON_DOCUMENTE}. Une affirmation n’entre ici qu’avec son étiquette de provenance —
        humain, animal, cellules, mécanisme déduit — et sa source vérifiée.
      </p>
    </details>

    <details class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800">
      <summary class="cible-tactile cursor-pointer text-sm font-medium text-slate-900 dark:text-white">
        Exhaustif — doses étudiées, limites, sources
      </summary>

      <h3 class="mt-3 etiquette text-slate-500 dark:text-slate-400">Limites à ne pas dépasser</h3>
      <p id="limites" class="mt-1 text-sm text-slate-700 dark:text-slate-200">{AUCUNE_LIMITE}</p>

      <h3 class="mt-4 etiquette text-slate-500 dark:text-slate-400">Doses étudiées</h3>
      <p id="doses" class="mt-1 text-sm text-slate-700 dark:text-slate-200">{AUCUNE_DOSE_HUMAINE}</p>
      <p id="libelle-doses" class="mt-1 hidden text-xs text-slate-500 dark:text-slate-400">
        {LIBELLE_DOSES}
      </p>
    </details>

    <!-- Mon journal : ma donnée, la seule expérience que Cyclades regarde. -->
    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="etiquette text-slate-500 dark:text-slate-400">Mon journal</h2>
        <p id="compte-ressentis" class="text-xs text-slate-400 dark:text-slate-500"></p>
      </div>
      <div id="liste-ressentis" class="mt-2 space-y-2"></div>
      <form id="form-ressenti" class="mt-3 grid gap-2 sm:grid-cols-2">
        <input
          id="r-jour"
          type="date"
          aria-label="Jour du ressenti"
          class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900"
        />
        <input
          id="r-ressenti"
          type="text"
          aria-label="Ce que je ressens"
          placeholder="Ce que je ressens"
          class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900"
        />
        <input
          id="r-indesirable"
          type="text"
          aria-label="Effet que je tiens pour indésirable"
          placeholder="Effet que je tiens pour indésirable"
          class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900"
        />
        <input
          id="r-tolerance"
          type="text"
          aria-label="Tolérance, dans mes mots"
          placeholder="Tolérance, dans mes mots"
          class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900"
        />
        <button
          id="r-noter"
          type="submit"
          class="cible-tactile justify-center rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white sm:col-span-2"
        >
          Noter ce que je ressens
        </button>
      </form>
      <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
        Chiffré au repos, exclu des exports et de « Préparer une question pour une IA ».
        Aucun score, aucune moyenne, aucune XP.
      </p>
    </section>

    <!-- La passerelle sortante (2.1). -->
    <section class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800">
      <p
        id="avertissement-biblio"
        class="hidden rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
      >
        {AVERTISSEMENT_SORTANT}
        <label class="mt-2 flex items-center gap-2 text-sm">
          <input id="ne-plus-avertir" type="checkbox" class="rounded" />
          <span>Ne plus afficher cet avertissement</span>
        </label>
        <button
          id="confirmer-sortie"
          type="button"
          class="cible-tactile mt-2 rounded-lg bg-amber-600 px-3 text-sm font-medium text-white"
        >
          Ouvrir la bibliothèque
        </button>
      </p>

      <a
        id="lien-biblio"
        href={ADRESSE_BIBLIOTHEQUE}
        target="_blank"
        rel="noopener noreferrer"
        class="cible-tactile font-medium text-indigo-600 underline dark:text-indigo-300"
      >
        {LIBELLE_LIEN}
        <span class="sr-only">— site externe, s’ouvre dans un nouvel onglet</span>
      </a>
      <div class="mt-2">
        <button
          id="copier-nom"
          type="button"
          class="cible-tactile rounded-lg border border-slate-300 px-3 text-sm font-medium dark:border-slate-700"
        >
          Copier le nom
        </button>
        <span id="nom-a-copier" class="ml-2 hidden rounded bg-slate-100 px-2 py-1 font-mono text-xs select-all dark:bg-slate-800"></span>
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{COUVERTURE_INCONNUE}</p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{MENTION_DONNEE_MORTE}</p>
      {/*
         Le crédit, à la demande du propriétaire de la ressource — c'est la
         seule condition qu'il a posée. Il est écrit en toutes lettres et non
         déduit du lien : une adresse n'est pas une citation, et un lien qu'on
         ne suit pas ne crédite personne.
      */}
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{ATTRIBUTION}</p>
      {/*
         La copie hors ligne, à côté de la passerelle.

         Elle répond à une autre question : la passerelle mène à la version
         vivante, la copie permet de chercher une référence sans réseau — et
         sans que la molécule cherchée sorte de l'appareil.
      */}
      <p class="mt-3">
        <a
          id="vers-bibliographie"
          href="#"
          class="cible-tactile font-medium text-indigo-600 underline dark:text-indigo-300"
          >Chercher dans la copie hors ligne de la bibliographie</a
        >
      </p>
    </section>
  </div>
</Base>

<script>
  import { jourISO } from '../../lib/db';
  import { messageDUneErreur } from '../../lib/agir';
  import { auDeverrouillage } from '../../lib/chargement';
  import { unSeulGeste } from '../../lib/geste';
  import { coffreOuvert, ouvrirLeCoffre, surCoffre } from '../../lib/coffre';
  import {
    ecrireRessenti,
    ressentisDuTraitement,
    tousLesTraitements,
  } from '../../lib/odyssee/donnees-sante';
  import { CLEF_AVERTISSEMENT_VU } from '../../lib/odyssee/bibliotheque-externe';
  import {
    ABSENTE_DU_THESAURUS,
    INTERACTIONS_NON_RELIEES,
    NIVEAUX_ANSM,
    NON_DOCUMENTE,
    interactionsDeLaFiche,
  } from '../../lib/odyssee/molecules';
  import { CATALOGUE } from '../../lib/odyssee/sante';
  import { formaterDate, lien, notifier, parametreUrl, pluriel } from '../../lib/ui';

  const $ = (id: string) => document.getElementById(id)!;

  /** Branche la carte une seule fois, quel que soit le nombre de rendus. */
  function brancherLeCoffre(rendre: () => Promise<void>) {
    $('ouvrir-coffre').addEventListener('click', () => {
      void (async () => {
        const champ = $('mdp-coffre') as HTMLInputElement;
        const erreur = await ouvrirLeCoffre(champ.value, {
            memoriserAppareil:
              (document.getElementById('coffre-appareil') as HTMLInputElement | null)?.checked ??
              false,
          });
        $('erreur-coffre').classList.toggle('hidden', erreur === null);
        if (erreur) {
          $('erreur-coffre').textContent = erreur;
          return;
        }
        /* Vidé tout de suite : un mot de passe laissé dans un champ reste à
           portée du gestionnaire de mots de passe et de la restauration
           d'onglet. */
        champ.value = '';
        await rendre();
      })();
    });
    $('mdp-coffre').addEventListener('keydown', (evenement) => {
      if ((evenement as KeyboardEvent).key === 'Enter') $('ouvrir-coffre').click();
    });
    surCoffre(() => void rendre());
  }

  auDeverrouillage(async () => {
    if (!coffreOuvert()) {
      $('chargement').classList.add('hidden');
      $('coffre-ferme').classList.remove('hidden');
      brancherLeCoffre(async () => {
        $('coffre-ferme').classList.add('hidden');
        $('chargement').classList.remove('hidden');
        await rendreLaFiche();
      });
      return;
    }
    brancherLeCoffre(async () => {
      $('coffre-ferme').classList.add('hidden');
      await rendreLaFiche();
    });
    await rendreLaFiche();
  });


  /**
   * Les interactions d'une fiche, ou la raison de leur absence.
   *
   * Trois états, trois phrases, et aucune ne se confond avec une autre :
   * « documentées » montre la liste ; « absente du document » dit que le
   * Thésaurus a été lu et ne traite pas cette molécule ; « non reliée » dit
   * que personne n'a regardé. Les deux dernières se ressemblent à l'œil et
   * ne disent pas du tout la même chose — c'est la distinction que
   * `ABSENTES_DU_THESAURUS` existe pour tenir, et la perdre à l'écran
   * reviendrait à ne l'avoir jamais faite.
   *
   * Une molécule hors catalogue n'a pas d'identifiant : elle est « non
   * reliée », ce qui est exact.
   */
  function peindreLesInteractions(idFiche: string | null) {
    const zone = $('interactions');
    const etat = $('interactions-etat');
    const sous = $('interactions-sous');
    const source = $('interactions-source');
    zone.replaceChildren();
    sous.classList.add('hidden');
    source.classList.add('hidden');

    const resultat = idFiche ? interactionsDeLaFiche(idFiche) : { etat: 'non-reliee' as const };

    if (resultat.etat === 'absente-du-thesaurus') {
      etat.textContent = ABSENTE_DU_THESAURUS;
      return;
    }
    if (resultat.etat === 'non-reliee') {
      etat.textContent = INTERACTIONS_NON_RELIEES;
      return;
    }

    etat.textContent =
      resultat.paires.length === 1
        ? 'Une interaction documentée par le Thésaurus des interactions de l’ANSM.'
        : `${resultat.paires.length} interactions documentées par le Thésaurus des interactions de l’ANSM.`;

    /*
       SOUS QUEL NOM, et ce n'est pas un détail d'érudition. Le Thésaurus ne
       traite pas la testostérone : il traite la classe « androgènes », avec
       l'androstanolone et la noréthandrolone. Montrer ces paires sans le
       dire laisserait croire que l'entrée vise cet ester-là.
    */
    sous.textContent = `Traitée par le document sous : ${resultat.sous.join(', ')}.`;
    sous.classList.remove('hidden');

    for (const paire of resultat.paires) {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-slate-200 p-3 dark:border-slate-800';
      li.dataset.avec = paire.b;

      const haut = document.createElement('div');
      haut.className = 'flex flex-wrap items-baseline justify-between gap-2';

      const avec = document.createElement('p');
      avec.className = 'font-medium text-slate-900 dark:text-white';
      avec.textContent = `Avec ${paire.b}`;

      const niveau = paire.gravite?.connue ? paire.gravite.valeur : NON_DOCUMENTE;
      const badge = document.createElement('span');
      /*
         LA COULEUR SUIT LA GRAVITÉ, et elle ne la devine pas : les quatre
         libellés viennent de `NIVEAUX_ANSM`, comparés à la constante et non
         à une chaîne recopiée. Une variante d'écriture ferait retomber une
         contre-indication dans le gris de la dernière ligne.

         C'est la seule couleur de cet écran, et elle ne juge pas la
         personne — elle reprend le classement de l'agence.
      */
      badge.className =
        'rounded-lg px-2 py-0.5 text-xs font-medium ' +
        (niveau === NIVEAUX_ANSM.contreIndication
          ? 'bg-rose-100 text-rose-900 dark:bg-rose-950/60 dark:text-rose-100'
          : niveau === NIVEAUX_ANSM.deconseillee
            ? 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-100'
            : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200');
      badge.textContent = niveau;
      badge.dataset.niveau = niveau;

      haut.append(avec, badge);
      li.append(haut);

      /*
         LA CITATION SOUS CHAQUE PAIRE, page comprise. Une gravité sans sa
         source serait exactement la valeur non sourcée que tout ce domaine
         est construit pour empêcher — et ici elle porterait sur une
         association médicamenteuse.
      */
      if (paire.gravite?.connue) {
        const citation = document.createElement('p');
        citation.className = 'mt-1 text-xs text-slate-500 dark:text-slate-400';
        citation.textContent = `${paire.gravite.source.nom}, consulté le ${paire.gravite.source.le}`;
        li.append(citation);
      }
      zone.append(li);
    }

    /*
       CE QUE LA LISTE NE DIT PAS. Le Thésaurus n'est plus mis à jour depuis
       septembre 2023, et c'est le seul document consulté : une interaction
       absente d'ici n'est pas une interaction inexistante. Le dire une fois
       sous la liste vaut mieux que de le répéter sous chaque ligne, où on
       cesserait de le lire.
    */
    source.textContent =
      'Ce document n’est plus mis à jour depuis septembre 2023, et c’est le seul consulté. ' +
      'Une interaction qui n’y figure pas n’est pas une interaction inexistante. ' +
      'À aborder avec un médecin ou un pharmacien.';
    source.classList.remove('hidden');
  }

  async function rendreLaFiche() {
    const traitementId = parametreUrl('traitement') ?? '';
    const traitements = await tousLesTraitements();
    const traitement = traitements.find((t) => t.id === traitementId) ?? null;

    /*
       Aucune molécule nommée : on montre l'index du catalogue plutôt qu'une
       fiche vide intitulée « Molécule », qui ne disait rien et ne menait
       nulle part.
    */
    if (!traitement && !parametreUrl('nom')) {
      $('chargement').classList.add('hidden');
      $('fiche').classList.add('hidden');
      $('index-molecules').classList.remove('hidden');
      const liste = $('liste-catalogue');
      liste.replaceChildren();
      /*
         DES BOUTONS, ET NON DES LIENS — M-20.

         Hier, ces entrées étaient des liens « ?nom=<nom de la molécule> ».
         Je m'étais convaincu que c'était sans conséquence : les noms du
         catalogue sont une référence publique, et le lien entre une molécule
         et Alexis passe par un identifiant. J'avais tort sur un point que je
         n'avais pas regardé — une adresse entre dans l'historique du
         navigateur, qui n'est pas sous coffre, et elle y reste après la
         fermeture du coffre. Savoir quelles fiches quelqu'un ouvre sur un
         écran de santé en dit déjà trop.

         Un bouton qui peint la fiche sur place ne laisse ni adresse, ni
         entrée d'historique, et c'est en prime le geste le plus rapide.
      */
      for (const f of CATALOGUE) {
        const li = document.createElement('li');
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className =
          'cible-tactile w-full rounded-lg border border-slate-200 px-3 text-left text-sm ' +
          'text-indigo-700 underline dark:border-slate-800 dark:text-indigo-300';
        bouton.textContent = f.nom;
        bouton.addEventListener('click', () => {
          $('index-molecules').classList.add('hidden');
          void peindreLaFiche(f.nom, null);
        });
        li.appendChild(bouton);
        liste.appendChild(li);
      }
      return;
    }
    $('index-molecules').classList.add('hidden');

    await peindreLaFiche(traitement?.nom ?? parametreUrl('nom') ?? 'Molécule', traitement);
  }

  /**
   * Peint une fiche, qu'elle vienne d'un traitement déclaré ou de l'index.
   *
   * Séparée de `rendreLaFiche` depuis M-20 : l'index la rappelle sur place,
   * au lieu de recharger la page avec le nom de la molécule dans l'adresse.
   * Sans traitement, le journal reste fermé — on peut lire une fiche sans
   * pour autant déclarer qu'on en prend.
   */
  async function peindreLaFiche(
    nom: string,
    traitement: Awaited<ReturnType<typeof tousLesTraitements>>[number] | null,
  ) {
    $('titre-molecule').textContent = nom;
    /*
       LE TITRE D'ONGLET RESTE MUET — M-20, et c'est l'interdit 1 du prompt 41
       au mot près : « coffre fermé, aucun texte en clair de plus
       qu'aujourd'hui, y compris dans un titre de page ».

       Il portait « <molécule> · Cyclades ». Quand la page est ouverte depuis
       un traitement déclaré, ce nom vient du magasin **scellé** : le coffre
       le protégeait au repos, et le titre le publiait dans l'onglet, dans la
       liste des onglets, dans l'historique — et il y restait une fois le
       coffre refermé. Le nom s'affiche dans la page, derrière le coffre, et
       nulle part ailleurs.
    */
    document.title = 'Molécule · Cyclades';
    $('nom-a-copier').textContent = nom;

    /*
       Le catalogue portait zéro fiche quand cette page a été écrite, et cinq
       depuis le 16 octobre. Rien n'a changé ici, et c'était le but : le code
       cherche, et le bandeau s'affiche quand la recherche échoue. Une
       molécule déclarée hors catalogue reste donc « sans fiche », ce qui est
       exact et le restera.
    */
    const fiche = CATALOGUE.find((f) => f.nom.toLowerCase() === nom.toLowerCase()) ?? null;
    $('bandeau-sans-fiche').classList.toggle('hidden', Boolean(fiche));
    $('etiquette-identite').classList.toggle('hidden', Boolean(fiche));
    if (fiche) {
      $('v-demi-vie').textContent = fiche.demiVie.connue ? fiche.demiVie.valeur : NON_DOCUMENTE;
    }

    /*
       LES LIMITES, CHERCHÉES PAR IDENTIFIANT.

       Le paragraphe portait « AUCUNE_LIMITE » en dur, ce qui était vrai tant
       qu'aucune limite n'était livrée. Une seule l'est aujourd'hui — la dose
       maximale du RCP de Fluimucil 600 —, et le texte en dur l'aurait cachée.

       Les quatre autres molécules retombent sur la même phrase qu'avant, et
       sa seconde moitié reste le message important : « l'absence de limite
       n'est pas une preuve d'innocuité ».
    */
    const limites = limitesDe(fiche?.id ?? null);
    const paragrapheLimites = $('limites');
    if (limites.length === 0) {
      paragrapheLimites.textContent = AUCUNE_LIMITE;
    } else {
      paragrapheLimites.textContent = '';
      for (const l of limites) {
        const ligne = document.createElement('span');
        ligne.className = 'block';
        ligne.textContent = direLaLimite(l);
        paragrapheLimites.append(ligne);
      }
    }
    peindreLesInteractions(fiche?.id ?? null);

    /* ── Le journal ───────────────────────────────────────────────── */

    async function peindreJournal() {
      if (!traitement) {
        $('form-ressenti').classList.add('hidden');
        $('compte-ressentis').textContent = 'Ouvrez cette fiche depuis un traitement pour la noter.';
        return;
      }
      const notes = await ressentisDuTraitement(traitement.id);
      $('compte-ressentis').textContent = notes.length
        ? `${pluriel(notes.length, 'note')} · chiffré`
        : 'Aucune note · chiffré';
      const zone = $('liste-ressentis');
      zone.innerHTML = '';
      for (const n of notes) {
        const ligne = document.createElement('div');
        ligne.className =
          'rounded-xl border border-slate-200 px-3 py-2 text-sm dark:border-slate-800';
        const date = document.createElement('span');
        date.className = 'mr-2 text-xs text-slate-400';
        date.textContent = formaterDate(n.jour);
        const corps = document.createElement('span');
        corps.className = 'text-slate-700 dark:text-slate-200';
        corps.textContent = [n.ressenti, n.indesirable, n.tolerance].filter(Boolean).join(' · ');
        ligne.append(date, corps);
        zone.appendChild(ligne);
      }
    }

    /*
       Un envoi, une écriture — M6. `ecrireRessenti` frappe un identifiant
       neuf : deux envois rapprochés notaient deux fois le même ressenti du
       jour, et les champs ne sont vidés qu'une fois l'écriture finie.
    */
    $('form-ressenti').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!traitement) return;
      const lire = (id: string) => ($(id) as HTMLInputElement).value.trim();
      void unSeulGeste(e.currentTarget as Element, () =>
        ecrireRessenti({
          traitementId: traitement.id,
          jour: lire('r-jour') || jourISO(),
          ressenti: lire('r-ressenti'),
          indesirable: lire('r-indesirable'),
          tolerance: lire('r-tolerance'),
          note: '',
        })
          .then(() => {
            for (const id of ['r-ressenti', 'r-indesirable', 'r-tolerance']) {
              ($(id) as HTMLInputElement).value = '';
            }
            return peindreJournal();
          })
          .catch((err) => notifier(String(messageDUneErreur(err)))),
      );
    });

    /* ── La passerelle ────────────────────────────────────────────── */

    const vu = (() => {
      try {
        return localStorage.getItem(CLEF_AVERTISSEMENT_VU) === 'oui';
      } catch {
        return false;
      }
    })();

    /*
       `lienBiblio`, et non `lien` : ce nom-là masquait l'aide `lien()`
       importée en tête de module, et l'appel de la ligne 428 levait
       « lien is not a function ». La page restait donc sur « chargement »,
       et `astro check` le disait depuis le début dans ses neuf erreurs.
    */
    const lienBiblio = $('lien-biblio') as HTMLAnchorElement;
    if (!vu) {
      /*
         Tant que l'avertissement n'a pas été lu, le lien ne navigue pas : il
         déplie l'avertissement. Un avertissement qu'on peut traverser sans le
         voir n'avertit personne.
      */
      lienBiblio.addEventListener('click', (e) => {
        e.preventDefault();
        $('avertissement-biblio').classList.remove('hidden');
        ($('confirmer-sortie') as HTMLButtonElement).focus();
      });
      $('confirmer-sortie').addEventListener('click', () => {
        if (($('ne-plus-avertir') as HTMLInputElement).checked) {
          try {
            localStorage.setItem(CLEF_AVERTISSEMENT_VU, 'oui');
          } catch {
            /* stockage refusé : l'avertissement reviendra, ce qui est le bon défaut */
          }
        }
        window.open(lienBiblio.href, '_blank', 'noopener,noreferrer');
      });
    }

    $('copier-nom').addEventListener('click', () => {
      /*
         Le nom passe par le presse-papiers, jamais par l'adresse : ce qu'on
         consulte dans une bibliothèque de molécules est une donnée de santé,
         et une URL se retrouve dans l'historique.
      */
      navigator.clipboard
        ?.writeText(nom)
        .then(() => notifier(`« ${nom} » copié.`, 'succes'))
        .catch(() => {
          $('nom-a-copier').classList.remove('hidden');
          notifier('Presse-papiers indisponible : le nom est affiché, sélectionnez-le.');
        }) ??
        (() => {
          $('nom-a-copier').classList.remove('hidden');
        })();
    });

    $('vers-bibliographie').setAttribute('href', lien('/odyssee/bibliographie/'));

    await peindreJournal();
    $('chargement').classList.add('hidden');
    $('fiche').classList.remove('hidden');
  }
</script>
