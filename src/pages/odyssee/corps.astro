---
/**
 * Odyssée : mon corps.
 *
 * Pesées, mesures, sommeil, repas, boissons, santé. Tout se saisit à la main
 * — **aucun appel réseau, aucune base d'aliments** : c'est la décision 4, et
 * le défaut sûr tant qu'elle n'est pas tranchée autrement.
 *
 * ## Ce que l'écran affiche en premier
 *
 * La moyenne mobile du poids, pas le poids du jour. Le poids d'un matin bouge
 * d'un kilo avec un repas salé de la veille ; la moyenne sur sept jours est
 * ce qu'on regarde pour savoir où l'on va. Le chiffre brut reste là, en
 * second, parce que c'est lui qu'on vient de poser sur la balance.
 *
 * ## Ce qui n'y est pas
 *
 * Les médicaments et le statut hormonal. Ils appartiennent au domaine, ils
 * sont déclarés au contrat de faits, et ils attendent la **décision 3** sur
 * le chiffrement au repos. L'écran le dit plutôt que de faire comme s'ils
 * n'existaient pas : une absence silencieuse se lirait comme un oubli.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { MESURES, MOMENTS } from '../../lib/odyssee/corps';
import { NATURES, VOIES } from '../../lib/odyssee/sensible';
import FormulaireCoffre from '../../components/FormulaireCoffre.astro';
---

<Base titre="Corps" actif="corps" coffre>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mon corps</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Tout se saisit à la main : aucune base d’aliments, aucun appel réseau. Un repas noté sans
      chiffre reste un repas noté.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Les traitements, les bilans et les symptômes sont ailleurs, sur{' '}
      <a href="/odyssee/sante/" class="font-medium text-indigo-700 underline underline-offset-4 dark:text-indigo-300">Santé et traitements</a> :
      ils s’ouvrent par épisodes et demandent le coffre, alors que cet écran se remplit en dix
      secondes par jour.
    </p>

    <!--
      LA LIGNE VERS LE SUIVI PERSONNEL, et son libellé est neutre exprès.

      La décision 4.8 — la discrétion — veut que le mot « règles » n'apparaisse
      qu'à l'intérieur du module. Cette ligne est donc la seule porte, et elle
      ne nomme rien : ni la nature du suivi, ni ce qu'il enregistre.

      Elle est ici plutôt que dans la navigation parce que « Modules
      disponibles », que le registre des usages décrit, n'existe pas encore
      comme écran, et parce que `branches.ts` n'appartient pas à ce lot. Elle
      donne aussi à la page son parent logique : sous `/odyssee/corps/`, la
      flèche de retour ramène ici.
    -->
    <!--
         CETTE LIGNE EST MASQUÉE PAR DÉFAUT, et c'est le changement du
         19 octobre.

         Elle était visible de tous. Décision d'Alexis : le suivi n'apparaît
         que pour un sexe féminin déclaré. Elle part donc `hidden` dans le HTML
         rendu — donc masquée avant même que le script tourne, et masquée si le
         script ne tourne pas — et `leSuiviEstVisibleMaintenant()` est seul à
         pouvoir la montrer.

         Ce sens-là est le bon : un défaut de rendu, un script qui échoue, un
         navigateur sans JavaScript laissent la ligne cachée. L'inverse
         l'aurait montrée à tout le monde pendant une fraction de seconde, ce
         qui suffit.
    -->
    <!--
         CETTE LIGNE-CI N'A AUCUNE CONDITION, et c'est le choix d'Alexis du
         19 octobre vers 17 h 10 — l'option 2.

         « Quand consulter » est la seule partie de ce domaine qui ne soit pas
         du suivi : des repères sur le moment de voir quelqu'un, cités d'ameli.
         La première version de la décision les masquait avec le reste, ce qui
         retirait à tout le monde — y compris à une personne de sexe féminin
         qui n'avait pas encore ouvert son coffre — la page utile au moment où
         elle l'est le plus.

         Elle est donc visible sans coffre, sans déclaration, pour tout le
         monde. Son libellé ne nomme ni le cycle ni le suivi, et la page vers
         laquelle elle mène ne porte aucun lien vers le suivi : son existence
         ne dit donc rien de qui que ce soit.
    -->
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      <a href="/odyssee/corps/quand-consulter/" class="font-medium text-indigo-700 underline underline-offset-4 dark:text-indigo-300">Quand consulter</a>{' '}
      rassemble des repères cités de l’Assurance maladie sur les situations qui
      méritent un avis médical. Rien n’y est déduit de ce que vous saisissez.
    </p>

    <p id="ligne-du-suivi" class="mt-2 hidden max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Un <a href="/odyssee/corps/suivi/" class="font-medium text-indigo-700 underline underline-offset-4 dark:text-indigo-300">suivi personnel</a> existe aussi, sous coffre et désactivé tant que vous ne l’ouvrez pas.
      Il porte une saisie par jour, et des repères sur le moment de consulter.
    </p>

    <div id="chargement-corps" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture…</p>
    </div>

    <div id="vue" class="mt-6 hidden space-y-10">
      <!-- Aujourd'hui -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Aujourd’hui</h2>
        <dl id="aujourdhui" class="mt-3 grid gap-3 sm:grid-cols-4"></dl>
      </section>

      <!-- Le poids -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mon poids</h2>
        <p id="tendance" class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Poids du jour (kg)</span>
            <input id="kg" type="text" inputmode="decimal" data-min="20" data-max="400"
              class="mt-1 min-h-11 w-32 rounded-lg border border-slate-400 bg-white px-3 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button id="peser" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Enregistrer</button>
        </div>
        <div id="courbe" class="mt-4 overflow-x-auto"></div>
        <table class="mt-3 w-full text-sm">
          <caption class="sr-only">Pesées récentes, avec la moyenne mobile sur sept jours.</caption>
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs uppercase text-slate-500 dark:border-slate-800 dark:text-slate-400">
              <th scope="col" class="py-2">Jour</th>
              <th scope="col" class="py-2 text-right">Pesée</th>
              <th scope="col" class="py-2 text-right">Moyenne 7 j</th>
              <th scope="col" class="py-2 text-right">Sur</th>
              <th scope="col" class="py-2"></th>
            </tr>
          </thead>
          <tbody id="pesees"></tbody>
        </table>
        <p id="aucune-pesee" class="text-sm text-slate-500 dark:text-slate-400">Aucune pesée.</p>
      </section>

      <!-- Les mesures -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes mesures</h2>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Quoi</span>
            <select id="quoi"
              class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
              {Object.entries(MESURES).map(([id, libelle]) => <option value={id}>{libelle}</option>)}
            </select>
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Mesure (cm)</span>
            <input id="cm" type="text" inputmode="decimal" data-min="1" data-max="300"
              class="mt-1 min-h-11 w-28 rounded-lg border border-slate-400 bg-white px-3 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button id="mesurer" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Enregistrer</button>
        </div>
        <ul id="mesures" class="mt-3 space-y-1 text-sm"></ul>
        <p id="aucune-mesure" class="text-sm text-slate-500 dark:text-slate-400">Aucune mesure.</p>
      </section>

      <!-- Le sommeil -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mon sommeil</h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Une nuit appartient au jour où l’on se lève : « j’ai mal dormi » désigne la nuit qui
          précède la journée dont on parle.
        </p>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Couché à</span>
            <input id="coucher" type="datetime-local"
              class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Levé à</span>
            <input id="lever" type="datetime-local"
              class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Qualité</span>
            <select id="qualite"
              class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
              <option value="">Non donnée</option>
              <option value="1">1 — très mauvaise</option>
              <option value="2">2</option>
              <option value="3" selected>3</option>
              <option value="4">4</option>
              <option value="5">5 — excellente</option>
            </select>
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Réveils</span>
            <input id="reveils" type="number" inputmode="numeric" min="0" max="30"
              class="mt-1 min-h-11 w-20 rounded-lg border border-slate-400 bg-white px-3 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button id="dormir" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Enregistrer</button>
        </div>
        <ul id="nuits" class="mt-3 space-y-1 text-sm"></ul>
        <p id="aucune-nuit" class="text-sm text-slate-500 dark:text-slate-400">Aucune nuit notée.</p>
      </section>

      <!-- Les repas -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Mes repas</h2>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Moment</span>
            <select id="moment"
              class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
              {Object.entries(MOMENTS).map(([id, libelle]) => <option value={id}>{libelle}</option>)}
            </select>
          </label>
          <label class="min-w-48 flex-1 text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Quoi</span>
            <input id="intitule" type="text" maxlength="200"
              class="mt-1 min-h-11 w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">kcal</span>
            <input id="kcal" type="number" min="0" max="20000" inputmode="numeric"
              class="mt-1 min-h-11 w-24 rounded-lg border border-slate-400 bg-white px-3 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">P</span>
            <input id="proteines" type="number" inputmode="numeric" min="0" max="2000"
              class="mt-1 min-h-11 w-20 rounded-lg border border-slate-400 bg-white px-2 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">G</span>
            <input id="glucides" type="number" inputmode="numeric" min="0" max="2000"
              class="mt-1 min-h-11 w-20 rounded-lg border border-slate-400 bg-white px-2 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">L</span>
            <input id="lipides" type="number" inputmode="numeric" min="0" max="2000"
              class="mt-1 min-h-11 w-20 rounded-lg border border-slate-400 bg-white px-2 text-sm tabular-nums dark:border-slate-600 dark:bg-slate-950" />
          </label>
          <button id="manger" type="button"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
            >Enregistrer</button>
        </div>
        <p id="macros" class="mt-2 text-xs text-slate-500 dark:text-slate-400" aria-live="polite"></p>
        <ul id="repas" class="mt-3 space-y-1 text-sm"></ul>
        <p id="aucun-repas" class="text-sm text-slate-500 dark:text-slate-400">Aucun repas noté aujourd’hui.</p>
      </section>

      <!-- Les boissons -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Ce que je bois</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-verre="150"
            class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600">+ 150 mL</button>
          <button type="button" data-verre="250"
            class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600">+ 250 mL</button>
          <button type="button" data-verre="500"
            class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600">+ 500 mL</button>
          <button type="button" data-verre="1000"
            class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm dark:border-slate-600">+ 1 L</button>
          <button id="annuler-verre" type="button"
            class="min-h-11 rounded-lg px-3 text-sm text-slate-500 underline dark:text-slate-400"
            >Annuler le dernier</button>
        </div>
      </section>

      <!-- La santé -->
      <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Ma santé</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Cocher « cela m’empêche de faire un effort » est la seule déclaration d’ici qui agit sur
          une autre branche : Sport la lit, et cesse de proposer de progresser.
        </p>
        <div id="sante-ouverte" class="mt-3 space-y-2"></div>
        <p id="aucune-sante" class="mt-3 text-sm text-emerald-700 dark:text-emerald-300">
          Rien de déclaré en ce moment.
        </p>

        <details class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer text-sm font-medium text-slate-900 dark:text-white">
            Déclarer quelque chose
          </summary>
          <div class="mt-3 flex flex-wrap items-end gap-3">
            <label class="min-w-48 flex-1 text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Quoi</span>
              <input id="intitule-sante" type="text" maxlength="200"
                class="mt-1 min-h-11 w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
            </label>
            <label class="text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Depuis le</span>
              <input id="debut-sante" type="date"
                class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
            </label>
            <label class="text-sm">
              <span class="block text-slate-700 dark:text-slate-200">Intensité</span>
              <input id="intensite" type="range" min="1" max="10" value="4" class="mt-2 w-32" />
              <output id="intensite-valeur" for="intensite" class="ml-1 text-sm tabular-nums text-slate-700 dark:text-slate-200">4</output>
            </label>
          </div>
          <label class="mt-3 flex min-h-11 items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
            <input id="empeche" type="checkbox" class="size-5 rounded" />
            Cela m’empêche de faire un effort
          </label>
          <button id="declarer-sante" type="button"
            class="mt-3 min-h-11 rounded-lg bg-rose-700 px-4 text-sm font-medium text-white transition hover:bg-rose-800"
            >Déclarer</button>
        </details>
      </section>

      <!-- Ce qui passe par le coffre -->
      <section class="rounded-2xl border-2 border-slate-300 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-white">
          <Icone nom="coffre-ferme" taille={20} />
          <span>Mes traitements et mon statut hormonal</span>
        </h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Ces deux-là sont <strong>chiffrés dans la base</strong> : illisibles sans le mot de passe,
          même pour une extension de navigateur ou quelqu’un qui ouvre cet ordinateur. La clé est
          gardée le temps de l’onglet : le mot de passe est redemandé à chaque nouvel onglet, et
          elle disparaît à sa fermeture.
        </p>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          <strong>Enregistrement seul.</strong> Aucun rappel de prise, aucune vérification
          d’interaction, aucune posologie proposée : ce seraient des actes médicaux rendus par un
          logiciel qui ne sait rien de vous.
        </p>

        <p id="rappel-sauvegarde" class="mt-3 hidden rounded-xl px-4 py-3 text-sm"></p>

        <!-- Le coffre fermé -->
        <FormulaireCoffre nu />

        <!-- Le coffre ouvert -->
        <div id="coffre-ouvert" class="mt-4 hidden space-y-6">
          <!--
               LA QUESTION DU SEXE, sous coffre et nulle part ailleurs.

               Elle est ici parce que le plan de phase 0 range ce champ dans
               Odyssée > Corps, et parce que la réponse est scellée : la poser
               dans le profil commun, en clair, aurait mis en clair ce que le
               coffre protège.

               Sa formulation ne nomme ni le cycle ni le suivi. Une question
               qui dirait « pour savoir si le suivi du cycle vous concerne »
               révélerait le module à qui répond « Masculin », c'est-à-dire
               exactement à qui la décision d'Alexis veut qu'il reste
               invisible.
          -->
          <div id="bloc-sexe">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Mon corps</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
              Certains repères de santé dépendent du sexe. Vous pouvez répondre, ou
              non : cette réponse reste dans votre coffre, et vous pouvez la changer
              ou l’effacer quand vous voulez.
            </p>
            <div id="reponses-sexe" class="mt-2 flex flex-wrap gap-2">
              <button type="button" data-sexe="feminin" aria-pressed="false"
                class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm text-slate-700 aria-pressed:border-indigo-500 aria-pressed:bg-indigo-50 dark:border-slate-600 dark:text-slate-200 dark:aria-pressed:bg-indigo-950"
                >Féminin</button>
              <button type="button" data-sexe="masculin" aria-pressed="false"
                class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm text-slate-700 aria-pressed:border-indigo-500 aria-pressed:bg-indigo-50 dark:border-slate-600 dark:text-slate-200 dark:aria-pressed:bg-indigo-950"
                >Masculin</button>
              <button type="button" data-sexe="sans-reponse" aria-pressed="false"
                class="min-h-11 rounded-lg border border-slate-400 px-4 text-sm text-slate-700 aria-pressed:border-indigo-500 aria-pressed:bg-indigo-50 dark:border-slate-600 dark:text-slate-200 dark:aria-pressed:bg-indigo-950"
                >Je préfère ne pas répondre</button>
            </div>
            <p id="sexe-dit" class="mt-2 text-sm text-slate-600 dark:text-slate-300" role="status"></p>
            <button id="effacer-sexe" type="button"
              class="mt-1 hidden min-h-11 text-sm text-slate-500 underline underline-offset-4 dark:text-slate-400"
              >Effacer cette réponse</button>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Ce que j’ai pris</h3>
            <div class="mt-2 flex flex-wrap items-end gap-3">
              <label class="text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Quoi</span>
                <input id="nom-prise" type="text" maxlength="120"
                  class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
              </label>
              <label class="text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Dose</span>
                <input id="dose" type="text" maxlength="60" placeholder="500 mg"
                  class="mt-1 min-h-11 w-28 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
              </label>
              <label class="text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Voie</span>
                <select id="voie"
                  class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
                  {Object.entries(VOIES).map(([id, libelle]) => <option value={id}>{libelle}</option>)}
                </select>
              </label>
              <label class="text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Pourquoi</span>
                <input id="motif-prise" type="text" maxlength="120"
                  class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
              </label>
              <button id="noter-prise" type="button"
                class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
                >Noter</button>
            </div>
            <ul id="prises" class="mt-3 space-y-1 text-sm"></ul>
            <p id="aucune-prise" class="text-sm text-slate-500 dark:text-slate-400">
              Rien de noté aujourd’hui.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Mon statut</h3>
            <div class="mt-2 flex flex-wrap items-end gap-3">
              <label class="text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Nature</span>
                <select id="nature"
                  class="mt-1 min-h-11 rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950">
                  {Object.entries(NATURES).map(([id, libelle]) => <option value={id}>{libelle}</option>)}
                </select>
              </label>
              <label class="min-w-48 flex-1 text-sm">
                <span class="block text-slate-700 dark:text-slate-200">Intitulé</span>
                <input id="intitule-statut" type="text" maxlength="200"
                  class="mt-1 min-h-11 w-full rounded-lg border border-slate-400 bg-white px-3 text-sm dark:border-slate-600 dark:bg-slate-950" />
              </label>
              <button id="noter-statut" type="button"
                class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
                >Déclarer</button>
            </div>
            <ul id="statuts" class="mt-3 space-y-1 text-sm"></ul>
            <p id="aucun-statut" class="text-sm text-slate-500 dark:text-slate-400">
              Rien de déclaré.
            </p>
          </div>

          <button id="fermer-coffre" type="button"
            class="text-xs text-slate-500 underline dark:text-slate-400"
            >Refermer le coffre maintenant</button>
        </div>
      </section>

      <p id="erreur" class="hidden text-sm text-rose-700 dark:text-rose-300"></p>
    </div>
  </div>
</Base>

<script>
  import { nombreDuChamp } from '../../lib/nombre-saisi';
  import { direLErreur, effacerLErreur, validerALaSortie } from '../../lib/erreur-de-champ';
  import { auDeverrouillage } from '../../lib/chargement';
  import {
    agirPuisPeindre,
    direLEchec,
    effacerLEchec,
    messageDUneErreur,
  } from '../../lib/agir';
  import { unSeulGeste } from '../../lib/geste';
  import { jourLogique } from '../../lib/noyau/jour-logique';
  import { reglagesJourLogiqueLocaux } from '../../lib/adaptation';
  import {
    MESURES,
    MOMENTS,
    dureeDeLaNuit,
    journee,
    kcalDesMacros,
    macrosIncoherentes,
    moyenneMobile,
    type Boisson,
    type EtatDeSante,
    type MesureCorporelle,
    type MomentDuRepas,
    type Nuit,
    type Pesee,
    type QuoiMesurer,
    type Repas,
  } from '../../lib/odyssee/corps';
  import {
    ecrireBoisson,
    ecrireMesure,
    ecrireNuit,
    ecrirePesee,
    ecrireRepas,
    ecrireSante,
    refermerSante,
    rouvrirSante,
    supprimerBoisson,
    supprimerMesure,
    supprimerNuit,
    supprimerPesee,
    supprimerRepas,
    supprimerSante,
    toutLEtatDeSante,
    toutesLesBoissons,
    toutesLesMesures,
    toutesLesNuits,
    toutesLesPesees,
    tousLesRepas,
  } from '../../lib/odyssee/donnees-corps';
  import {
    coffreOuvert,
    fermerLeCoffre,
    ouvrirLeCoffre,
    reprendreLeCoffre,
    surCoffre,
  } from '../../lib/coffre';
  import { rappelDeSauvegarde } from '../../lib/noyau/coffre';
  import { ecrireLeSexe, effacerLeSexe, reponseAAfficher } from '../../lib/odyssee/donnees-sexe';
  import { LIBELLES_DU_SEXE } from '../../lib/odyssee/sexe';
  import { leSuiviEstVisibleMaintenant } from '../../lib/odyssee/portee-du-suivi';
  import { jourISO, lireDerniereSauvegarde } from '../../lib/db';
  import {
    NATURES,
    VOIES,
    prisesDuJour,
    statutsEnCours,
    type NatureDuStatut,
    type Prise,
    type StatutHormonal,
    type VoieDAdministration,
  } from '../../lib/odyssee/sensible';
  import {
    combienDeScelles,
    ecrirePrise,
    ecrireStatut,
    refermerStatut,
    supprimerPrise,
    supprimerStatut,
    toutesLesPrises,
    tousLesStatuts,
  } from '../../lib/odyssee/donnees-sensible';

  const $ = (id: string) => document.getElementById(id)!;
  const SVG = 'http://www.w3.org/2000/svg';

  let pesees: Pesee[] = [];
  let mesures: MesureCorporelle[] = [];
  let nuits: Nuit[] = [];
  let repas: Repas[] = [];
  let boissons: Boisson[] = [];
  let sante: EtatDeSante[] = [];
  let aujourdhui = '';
  let prises: Prise[] = [];
  let statuts: StatutHormonal[] = [];

  const nombre = (n: number, decimales = 1) =>
    n.toLocaleString('fr-FR', { maximumFractionDigits: decimales });
  const heures = (secondes: number) => {
    const h = Math.floor(secondes / 3600);
    const m = Math.round((secondes % 3600) / 60);
    return `${h} h ${String(m).padStart(2, '0')}`;
  };
  const jourLong = (jour: string) =>
    new Date(`${jour}T12:00:00`).toLocaleDateString('fr-FR', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
    });

  /*
     A1 et A2 du 43 : l'échec passe par la porte commune.

     Cette fonction écrivait le `message` brut de l'erreur dans un paragraphe
     sans `role` : rien n'était annoncé au lecteur d'écran (A1), et une base
     pleine s'affichait « Quota dépassé. », ce qui ne dit pas quoi faire (A2).
     `direLEchec` pose le rôle sur la zone et `messageDUneErreur` traduit les
     pannes connues. La zone, elle, ne bouge pas : elle est déjà sous les
     formulaires, au bon endroit.
  */
  const dire = (erreur: unknown) => direLEchec(messageDUneErreur(erreur), 'erreur');
  const taire = () => effacerLEchec('erreur');

  function carte(libelle: string, valeur: string, note: string): HTMLDivElement {
    const bloc = document.createElement('div');
    bloc.className =
      'rounded-2xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950';
    const dt = document.createElement('dt');
    dt.className = 'text-xs uppercase text-slate-500 dark:text-slate-400';
    dt.textContent = libelle;
    const dd = document.createElement('dd');
    dd.className = 'mt-1 text-xl font-bold tabular-nums text-slate-900 dark:text-white';
    dd.textContent = valeur;
    const p = document.createElement('p');
    p.className = 'mt-0.5 text-xs text-slate-400 dark:text-slate-500';
    p.textContent = note;
    bloc.append(dt, dd, p);
    return bloc;
  }

  function bouton(texte: string, action: () => void, classe = 'text-rose-700 dark:text-rose-300') {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = `text-xs underline ${classe}`;
    b.textContent = texte;
    b.addEventListener('click', action);
    return b;
  }

  /* ── Le résumé du jour ─────────────────────────────────────────────────── */

  function peindreAujourdhui() {
    const j = journee(aujourdhui, { pesees, nuits, repas, boissons });
    const zone = $('aujourdhui');
    zone.innerHTML = '';
    /*
       `—` et non `0` quand rien n'est noté. « Je n'ai rien bu » et « je n'ai
       rien noté » ne sont pas la même journée, et les confondre ferait mentir
       toute moyenne calculée dessus.
    */
    zone.append(
      carte('Poids', j.poids === null ? '—' : `${nombre(j.poids)} kg`, j.poids === null ? 'pas de pesée' : 'dernière du jour'),
      carte('Sommeil', j.sommeil === null ? '—' : heures(j.sommeil), j.sommeil === null ? 'rien noté' : 'cette nuit'),
      carte(
        'Calories',
        j.kcal === null ? '—' : nombre(j.kcal, 0),
        j.repas ? `${j.repas} repas noté${j.repas > 1 ? 's' : ''}` : 'aucun repas noté',
      ),
      carte(
        'Boissons',
        j.hydratation === null ? '—' : `${nombre(j.hydratation / 1000, 2)} L`,
        j.hydratation === null ? 'rien noté' : 'depuis ce matin',
      ),
    );
  }

  /* ── Le poids ──────────────────────────────────────────────────────────── */

  function peindrePoids() {
    const serie = moyenneMobile(pesees);
    $('aucune-pesee').classList.toggle('hidden', serie.length > 0);

    /* La tendance : la moyenne d'aujourd'hui contre celle d'il y a trente jours. */
    if (serie.length >= 2) {
      const dernier = serie[serie.length - 1];
      const cible = new Date(Date.parse(`${dernier.jour}T12:00:00.000Z`) - 30 * 86400000)
        .toISOString()
        .slice(0, 10);
      const avant = [...serie].reverse().find((p) => p.jour <= cible) ?? serie[0];
      const ecart = dernier.moyenne - avant.moyenne;
      $('tendance').textContent =
        `Moyenne sur 7 jours : ${nombre(dernier.moyenne, 2)} kg` +
        (avant === dernier
          ? '.'
          : ` — ${ecart === 0 ? 'stable' : `${ecart > 0 ? '+' : '−'}${nombre(Math.abs(ecart), 2)} kg`} ` +
            `depuis le ${jourLong(avant.jour)}.`);
    } else {
      $('tendance').textContent =
        serie.length === 1
          ? 'Une seule pesée : la moyenne mobile a besoin de plusieurs jours pour dire quelque chose.'
          : 'Aucune pesée. Le poids d’un seul matin ne dit rien ; c’est la moyenne qui parle.';
    }

    tracerPoids(serie);

    const corps = $('pesees');
    corps.innerHTML = '';
    for (const point of [...serie].reverse().slice(0, 14)) {
      const pesee = pesees.find((p) => p.jour === point.jour)!;
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 dark:border-slate-900';
      tr.dataset.jour = point.jour;
      for (const [texte, classe] of [
        [jourLong(point.jour), 'py-1.5 text-slate-700 dark:text-slate-200'],
        [`${nombre(point.kg, 1)} kg`, 'py-1.5 text-right tabular-nums text-slate-900 dark:text-white'],
        [`${nombre(point.moyenne, 2)} kg`, 'py-1.5 text-right tabular-nums text-slate-600 dark:text-slate-300'],
        [`${point.points} j`, 'py-1.5 text-right text-xs text-slate-400 dark:text-slate-500'],
      ] as [string, string][]) {
        const td = document.createElement('td');
        td.className = classe;
        td.textContent = texte;
        tr.appendChild(td);
      }
      const actions = document.createElement('td');
      actions.className = 'py-1.5 pl-3 text-right';
      actions.appendChild(
        bouton('Supprimer', () => void agirPuisPeindre(() => supprimerPesee(pesee.id), { peindre: recharger, zone: 'erreur' })),
      );
      tr.appendChild(actions);
      corps.appendChild(tr);
    }
  }

  function tracerPoids(serie: { jour: string; kg: number; moyenne: number }[]) {
    const zone = $('courbe');
    zone.innerHTML = '';
    if (serie.length < 2) return;

    const L = 720;
    const H = 200;
    const marge = { haut: 12, bas: 26, gauche: 48, droite: 10 };
    const largeur = L - marge.gauche - marge.droite;
    const hauteur = H - marge.haut - marge.bas;

    const valeurs = serie.flatMap((p) => [p.kg, p.moyenne]);
    const bas = Math.floor(Math.min(...valeurs) - 0.5);
    const haut = Math.ceil(Math.max(...valeurs) + 0.5);
    const etendue = Math.max(1, haut - bas);
    const t = serie.map((p) => Date.parse(`${p.jour}T12:00:00Z`));
    const x = (i: number) => marge.gauche + (largeur * (t[i] - t[0])) / Math.max(1, t[t.length - 1] - t[0]);
    const y = (v: number) => marge.haut + hauteur - (hauteur * (v - bas)) / etendue;

    const svg = document.createElementNS(SVG, 'svg');
    svg.setAttribute('viewBox', `0 0 ${L} ${H}`);
    // Largeur minimale calée sur le « viewBox », hauteur libre : voir le
    // suivi de la force, qui porte la démonstration (D-042).
    svg.setAttribute('class', 'h-auto w-full min-w-[45rem]');
    // Le tableau en dessous porte les mêmes points : voir le suivi de la force.
    svg.setAttribute('aria-hidden', 'true');

    for (const valeur of [bas, haut]) {
      const ligne = document.createElementNS(SVG, 'line');
      ligne.setAttribute('x1', String(marge.gauche));
      ligne.setAttribute('x2', String(L - marge.droite));
      ligne.setAttribute('y1', String(y(valeur)));
      ligne.setAttribute('y2', String(y(valeur)));
      ligne.setAttribute('stroke', 'currentColor');
      ligne.setAttribute('class', 'text-slate-200 dark:text-slate-800');
      svg.appendChild(ligne);
      const texte = document.createElementNS(SVG, 'text');
      texte.setAttribute('x', String(marge.gauche - 6));
      texte.setAttribute('y', String(y(valeur) + 4));
      texte.setAttribute('text-anchor', 'end');
      texte.setAttribute('class', 'fill-slate-400 text-xs');
      texte.textContent = String(valeur);
      svg.appendChild(texte);
    }

    /* Les pesées brutes, en gris clair : le bruit est montré, pas caché. */
    const brut = document.createElementNS(SVG, 'polyline');
    brut.setAttribute('fill', 'none');
    brut.setAttribute('stroke', 'currentColor');
    brut.setAttribute('class', 'text-slate-300 dark:text-slate-700');
    brut.setAttribute('stroke-width', '1.5');
    brut.setAttribute('points', serie.map((p, i) => `${x(i)},${y(p.kg)}`).join(' '));
    svg.appendChild(brut);

    const lisse = document.createElementNS(SVG, 'polyline');
    lisse.setAttribute('fill', 'none');
    /* `stroke` est un attribut de présentation : il n'accepte pas `var()`.
       On passe donc par le style en ligne, qui, lui, le résout. */
    lisse.style.stroke = 'var(--etat-action)';
    lisse.setAttribute('stroke-width', '2.5');
    lisse.setAttribute('stroke-linejoin', 'round');
    lisse.setAttribute('points', serie.map((p, i) => `${x(i)},${y(p.moyenne)}`).join(' '));
    svg.appendChild(lisse);

    zone.appendChild(svg);
    const legende = document.createElement('p');
    legende.className = 'mt-1 text-xs text-slate-400 dark:text-slate-500';
    legende.textContent =
      `Échelle de ${bas} à ${haut} kg — elle ne part pas de zéro. ` +
      'Trait épais : moyenne sur sept jours. Trait clair : les pesées, telles quelles.';
    zone.appendChild(legende);
  }

  /* ── Mesures, nuits, repas ─────────────────────────────────────────────── */

  function peindreMesures() {
    const liste = $('mesures');
    liste.innerHTML = '';
    const triees = [...mesures].sort((a, b) => b.le.localeCompare(a.le)).slice(0, 12);
    $('aucune-mesure').classList.toggle('hidden', triees.length > 0);
    for (const m of triees) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.mesure = m.id;
      const texte = document.createElement('span');
      texte.textContent = `${MESURES[m.quoi]} — ${nombre(m.cm)} cm, ${jourLong(m.jour)}`;
      li.append(texte, bouton('Supprimer', () => void agirPuisPeindre(() => supprimerMesure(m.id), { peindre: recharger, zone: 'erreur' })));
      liste.appendChild(li);
    }
  }

  function peindreNuits() {
    const liste = $('nuits');
    liste.innerHTML = '';
    const triees = [...nuits].sort((a, b) => b.jour.localeCompare(a.jour)).slice(0, 10);
    $('aucune-nuit').classList.toggle('hidden', triees.length > 0);
    for (const n of triees) {
      const duree = dureeDeLaNuit(n);
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.nuit = n.id;
      const texte = document.createElement('span');
      texte.textContent =
        `${jourLong(n.jour)} — ${duree === null ? '?' : heures(duree)}` +
        (n.qualite !== null ? `, qualité ${n.qualite}/5` : '') +
        (n.reveils !== null ? `, ${n.reveils} réveil${n.reveils > 1 ? 's' : ''}` : '');
      li.append(texte, bouton('Supprimer', () => void agirPuisPeindre(() => supprimerNuit(n.id), { peindre: recharger, zone: 'erreur' })));
      liste.appendChild(li);
    }
  }

  function peindreRepas() {
    const liste = $('repas');
    liste.innerHTML = '';
    const duJour = repas
      .filter((r) => r.jour === aujourdhui)
      .sort((a, b) => a.le.localeCompare(b.le));
    $('aucun-repas').classList.toggle('hidden', duJour.length > 0);
    for (const r of duJour) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.repas = r.id;
      li.dataset.chiffre = String(r.kcal !== null);
      const texte = document.createElement('span');
      texte.textContent =
        `${MOMENTS[r.moment]} — ${r.intitule}` +
        (r.kcal !== null ? ` · ${nombre(r.kcal, 0)} kcal` : ' · non chiffré');
      li.appendChild(texte);
      if (macrosIncoherentes(r)) {
        const alerte = document.createElement('span');
        alerte.className = 'text-xs text-amber-700 dark:text-amber-300';
        alerte.textContent = `(les macros disent ${kcalDesMacros(r)} kcal)`;
        li.appendChild(alerte);
      }
      li.appendChild(bouton('Supprimer', () => void agirPuisPeindre(() => supprimerRepas(r.id), { peindre: recharger, zone: 'erreur' })));
      liste.appendChild(li);
    }
  }

  function direMacros() {
    const lire = (id: string) => {
      const v = ($(id) as HTMLInputElement).value;
      return v === '' ? null : Number(v);
    };
    const calcule = kcalDesMacros({
      proteines: lire('proteines'),
      glucides: lire('glucides'),
      lipides: lire('lipides'),
    });
    $('macros').textContent =
      calcule === null ? '' : `Les macros saisies font ${nombre(calcule, 0)} kcal.`;
  }

  /* ── La santé ──────────────────────────────────────────────────────────── */

  function peindreSante() {
    const zone = $('sante-ouverte');
    zone.innerHTML = '';
    const triees = [...sante].sort(
      (a, b) => Number(b.fin === null) - Number(a.fin === null) || b.debut.localeCompare(a.debut),
    );
    const ouvertes = triees.filter((e) => e.fin === null);
    $('aucune-sante').classList.toggle('hidden', ouvertes.length > 0);

    for (const e of triees.slice(0, 10)) {
      const bloc = document.createElement('div');
      bloc.className =
        e.fin === null
          ? 'rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm dark:border-rose-900 dark:bg-rose-950/30'
          : 'rounded-xl border border-slate-200 px-4 py-2 text-sm dark:border-slate-800';
      bloc.dataset.sante = e.id;
      bloc.dataset.ouvert = String(e.fin === null);
      bloc.dataset.empeche = String(e.empecheEffort);

      const titre = document.createElement('p');
      titre.className = 'font-medium text-slate-900 dark:text-white';
      titre.textContent = e.intitule;
      bloc.appendChild(titre);

      const detail = document.createElement('p');
      detail.className = 'mt-0.5 text-xs text-slate-600 dark:text-slate-300';
      detail.textContent =
        `Intensité ${e.intensite}/10 · depuis le ${jourLong(e.debut.slice(0, 10))}` +
        (e.fin ? ` · terminé le ${jourLong(e.fin.slice(0, 10))}` : '') +
        (e.empecheEffort ? ' · empêche l’effort' : '');
      bloc.appendChild(detail);

      const actions = document.createElement('div');
      actions.className = 'mt-2 flex gap-4';
      actions.append(
        bouton(
          e.fin ? 'Rouvrir' : 'C’est passé',
          () => void agirPuisPeindre(() => (e.fin ? rouvrirSante(e.id) : refermerSante(e.id)), {
            peindre: recharger,
            zone: 'erreur',
          }),
          'text-indigo-700 dark:text-indigo-300',
        ),
        bouton('Supprimer', () => void agirPuisPeindre(() => supprimerSante(e.id), { peindre: recharger, zone: 'erreur' })),
      );
      bloc.appendChild(actions);
      zone.appendChild(bloc);
    }
  }

  /* ── Le coffre ─────────────────────────────────────────────────────────── */

  /**
   * Le rappel de sauvegarde, gradué.
   *
   * C'est la condition **bloquante** de la décision 3 : chiffrer sans
   * sauvegarder fabrique une perte définitive. Il se calcule coffre **fermé**,
   * puisque compter les enregistrements scellés n'ouvre rien — et prévenir
   * quelqu'un qui n'a pas ouvert le coffre depuis longtemps est précisément
   * utile.
   */
  async function peindreRappel() {
    const [derniere, scelles] = await Promise.all([
      lireDerniereSauvegarde(),
      combienDeScelles(),
    ]);
    const jours =
      derniere === null
        ? null
        : Math.floor((Date.now() - Date.parse(derniere)) / 86_400_000);
    const rappel = rappelDeSauvegarde({
      joursDepuisLaSauvegarde: jours,
      enregistrementsScelles: scelles,
    });

    const zone = $('rappel-sauvegarde');
    zone.classList.toggle('hidden', rappel.insistance === 'aucune');
    zone.dataset.insistance = rappel.insistance;
    const fond: Record<string, string> = {
      discrete: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200',
      insistante: 'bg-amber-50 text-amber-900 dark:bg-amber-950/30 dark:text-amber-100',
      urgente: 'bg-rose-50 font-medium text-rose-900 dark:bg-rose-950/40 dark:text-rose-100',
      aucune: '',
    };
    zone.className = `mt-3 rounded-xl px-4 py-3 text-sm ${fond[rappel.insistance]}`;
    zone.textContent = rappel.message.replaceAll('**', '');

    /*
       Et le centre de notifications l'apprend — prompt 32, phase 3. Ici
       plutôt qu'ailleurs parce que c'est ici que le rappel se calcule
       déjà : le recalculer dans le centre ferait deux lectures et, un
       jour, deux réponses différentes. Seule l'insistance passe, jamais
       le message : le § 2.3 ne veut pas de texte dans un élément.
    */
    void (async () => {
      try {
        const { signalerLaSauvegarde } = await import(
          '../../lib/notifications/alimentation'
        );
        await signalerLaSauvegarde(rappel.insistance);
      } catch {
        /* Un centre indisponible ne doit pas effacer le rappel à l'écran. */
      }
    })();
  }

  /* ── Le sexe déclaré, et la ligne qu'il ouvre ──────────────────────────── */

  /*
     DEUX CHOSES SÉPARÉES, et il faut qu'elles le restent.

     `peindreLaReponse` montre à la personne ce qu'elle a répondu : elle lit le
     magasin, parce que cet écran est celui qui POSSÈDE le champ.

     `peindreLaLigneDuSuivi` décide si le suivi apparaît : elle passe par
     `leSuiviEstVisibleMaintenant()`, donc par la porte du registre des usages,
     parce que c'est un USAGE du sexe et non la lecture de son propre champ.
     Les confondre aurait été plus court d'une ligne, et aurait fait de cet
     écran un contournement de la porte.
  */
  async function peindreLaReponse() {
    const reponse = await reponseAAfficher();
    const connue = reponse !== 'pas-de-coffre' && reponse !== null;
    for (const bouton of document.querySelectorAll<HTMLButtonElement>('#reponses-sexe button')) {
      bouton.setAttribute('aria-pressed', String(connue && bouton.dataset.sexe === reponse));
    }
    $('effacer-sexe').classList.toggle('hidden', !connue);
    $('sexe-dit').textContent = connue
      ? `Votre réponse : ${LIBELLES_DU_SEXE[reponse as keyof typeof LIBELLES_DU_SEXE]}.`
      : '';
  }

  async function peindreLaLigneDuSuivi() {
    const visible = await leSuiviEstVisibleMaintenant();
    $('ligne-du-suivi').classList.toggle('hidden', !visible);
  }

  for (const bouton of document.querySelectorAll<HTMLButtonElement>('#reponses-sexe button')) {
    bouton.addEventListener('click', () => {
      void (async () => {
        try {
          await ecrireLeSexe(bouton.dataset.sexe as 'feminin' | 'masculin' | 'sans-reponse');
          await peindreLaReponse();
          await peindreLaLigneDuSuivi();
        } catch (e) {
          $('sexe-dit').textContent = messageDUneErreur(e);
        }
      })();
    });
  }

  $('effacer-sexe').addEventListener('click', () => {
    void (async () => {
      try {
        /*
           Effacer la réponse n'efface RIEN d'autre — point 5 de la décision
           d'Alexis. Les saisies déjà faites ne sont ni effacées ni montrées :
           le suivi est seulement masqué, et toute suppression reste un geste
           explicite, par l'effacement par période de l'écran du suivi ou par
           le groupe Odyssée de « Vos données ».
        */
        await effacerLeSexe();
        await peindreLaReponse();
        await peindreLaLigneDuSuivi();
        $('sexe-dit').textContent = 'Réponse effacée.';
      } catch (e) {
        $('sexe-dit').textContent = messageDUneErreur(e);
      }
    })();
  });

  function peindreCoffre() {
    const ouvert = coffreOuvert();
    $('coffre-ferme').classList.toggle('hidden', ouvert);
    $('coffre-ouvert').classList.toggle('hidden', !ouvert);
    /*
       La ligne du suivi se repeint dans les DEUX sens : ouvrir le coffre peut
       la faire paraître, le refermer doit la faire disparaître. Un `return`
       placé avant aurait laissé la ligne visible après « Refermer le coffre
       maintenant », ce qui est exactement le cas que la décision point 2
       nomme — coffre fermé, on ne peut pas savoir, donc rien.
    */
    void peindreLaLigneDuSuivi();
    if (!ouvert) return;
    void peindreLaReponse();

    const liste = $('prises');
    liste.innerHTML = '';
    const duJour = prisesDuJour(prises, aujourdhui);
    $('aucune-prise').classList.toggle('hidden', duJour.length > 0);
    for (const groupe of duJour) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.prise = groupe.nom;
      const texte = document.createElement('span');
      const heures = groupe.heures
        .map((h) => new Date(h).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }))
        .join(', ');
      texte.textContent = `${groupe.nom} — ${groupe.fois} fois (${heures})`;
      li.append(texte);
      for (const prise of prises.filter((p) => p.jour === aujourdhui && p.nom === groupe.nom)) {
        li.appendChild(
          bouton(`Retirer ${new Date(prise.le).toLocaleTimeString('fr-FR', {
            hour: '2-digit',
            minute: '2-digit',
          })}`, () => void agirPuisPeindre(() => supprimerPrise(prise.id), { peindre: recharger, zone: 'erreur' })),
        );
      }
      liste.appendChild(li);
    }

    const zone = $('statuts');
    zone.innerHTML = '';
    const triees = [...statuts].sort(
      (a, b) => Number(b.fin === null) - Number(a.fin === null) || b.debut.localeCompare(a.debut),
    );
    $('aucun-statut').classList.toggle('hidden', triees.length > 0);
    const courants = statutsEnCours(statuts);
    for (const statut of triees) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-baseline gap-2 text-slate-700 dark:text-slate-200';
      li.dataset.statut = statut.id;
      li.dataset.encours = String(courants.some((c) => c.id === statut.id));
      const texte = document.createElement('span');
      texte.textContent =
        `${NATURES[statut.nature]} — ${statut.intitule}, depuis le ` +
        `${new Date(statut.debut).toLocaleDateString('fr-FR')}` +
        (statut.fin ? ` jusqu’au ${new Date(statut.fin).toLocaleDateString('fr-FR')}` : '');
      li.appendChild(texte);
      if (!statut.fin) {
        li.appendChild(
          bouton('Terminé', () => void agirPuisPeindre(() => refermerStatut(statut.id), { peindre: recharger, zone: 'erreur' }),
            'text-indigo-700 dark:text-indigo-300'),
        );
      }
      li.appendChild(bouton('Supprimer', () => void agirPuisPeindre(() => supprimerStatut(statut.id), { peindre: recharger, zone: 'erreur' })));
      zone.appendChild(li);
    }
  }

  /** Relit ce que le coffre protège. Silencieux s'il est fermé. */
  async function rechargerLeCoffre() {
    // La clé peut venir de la session : on la reprend avant de conclure.
    await reprendreLeCoffre();
    if (!coffreOuvert()) {
      prises = [];
      statuts = [];
      return;
    }
    [prises, statuts] = await Promise.all([toutesLesPrises(), tousLesStatuts()]);
  }

  /* ── Le cycle ──────────────────────────────────────────────────────────── */

  function peindre() {
    peindreAujourdhui();
    peindrePoids();
    peindreMesures();
    peindreNuits();
    peindreRepas();
    peindreSante();
    peindreCoffre();
  }

  async function recharger() {
    [pesees, mesures, nuits, repas, boissons, sante] = await Promise.all([
      toutesLesPesees(),
      toutesLesMesures(),
      toutesLesNuits(),
      tousLesRepas(),
      toutesLesBoissons(),
      toutLEtatDeSante(),
    ]);
    await rechargerLeCoffre();
    peindre();
    await peindreRappel();
  }

  /*
     Rend `false` quand le geste a ÉCHOUÉ, et c'est ce que `unSeulGeste`
     attend pour ne pas poser son repos de 600 ms (voir `lib/geste.ts`).

     Sans cette valeur de retour, un refus était indiscernable d'une
     réussite une fois l'exception attrapée ici, et le repos s'appliquait
     quand même. Parcours constaté le 19 octobre : on saisit 5 kg, le modèle
     refuse (« attendu entre 20 et 400 »), on corrige en 78,4, on réappuie —
     et le second appui, tombé dans le repos, était ignoré SANS un mot. La
     correction la plus naturelle qui soit se perdait, et l'écran gardait un
     message d'erreur qui désignait un poids déjà corrigé.
  */
  const essayer = async (travail: () => Promise<unknown>) => {
    try {
      /*
         Le refus du travail se propage — D2 du 43.

         `essayer` rendait `true` dès que rien n'avait levé, y compris quand
         le travail avait REFUSÉ d'écrire (un poids illisible, un champ vide).
         `unSeulGeste` comptait donc le geste comme abouti, notait son repos
         de 600 ms, et avalait l'appui qui suivait la correction : on corrige
         « abc » en « 72,5 », on réappuie, et il ne se passe rien — l'ancien
         message restant sous un champ qu'on vient de corriger. C'est le
         défaut que `geste.ts` décrit au 19 octobre, et il revenait par cette
         porte-ci. Trouvé par l'essai de D2, pas en relisant le diff.
      */
      const resultat = await travail();
      taire();
      await recharger();
      return resultat !== false;
    } catch (erreur) {
      dire(erreur);
      return false;
    }
  };

  /**
   * Un appui, une écriture — M6.
   *
   * ## Ce qui a été mesuré ici, le 18 octobre
   *
   * Deux appuis sur un verre d'eau, à 0, 60, 150 et 300 ms d'écart :
   * **deux boissons** à chaque fois. « J'ai dormi » : **deux nuits**. La
   * pesée : deux pesées à 0 ms, puis une seule au-delà — non par
   * protection, mais parce que son gestionnaire vide `#kg` et que le
   * second appui se fait refuser par le contrôle de saisie. Une garantie
   * qui tient au champ vidé n'en est pas une : elle tombe dès que les deux
   * appuis sont assez rapprochés, et c'est justement le cas qu'on craint.
   *
   * Aucun de ces boutons n'est dans un formulaire, donc aucun ne
   * bénéficiait même de l'accident qui couvrait la séance de Sport. Ils
   * passent tous par `unSeulGeste`, qui refuse le recouvrement **et**
   * impose un repos après la fin.
   *
   * Le bouton appuyé sert de clé : deux verres d'eau voulus, à une seconde
   * d'écart, passent toujours — un garde-fou qui accuse à tort se fait
   * désactiver, et on perd les deux.
   */
  const surAppui = (id: string, travail: () => Promise<unknown>) => {
    $(id).addEventListener('click', (evenement) => {
      void unSeulGeste(evenement.currentTarget as Element, () => essayer(travail));
    });
  };

  auDeverrouillage(
    async () => {
      const reglages = await reglagesJourLogiqueLocaux();
      aujourdhui = jourLogique(new Date(), reglages);

      /* Les champs d'heure proposent la nuit écoulée : 23 h hier, maintenant. */
      const maintenant = new Date();
      const hier = new Date(maintenant.getTime() - 86_400_000);
      const local = (d: Date, h: number, m: number) => {
        const copie = new Date(d);
        copie.setHours(h, m, 0, 0);
        const decalage = copie.getTimezoneOffset() * 60_000;
        return new Date(copie.getTime() - decalage).toISOString().slice(0, 16);
      };
      ($('coucher') as HTMLInputElement).value = local(hier, 23, 0);
      ($('lever') as HTMLInputElement).value = local(maintenant, 7, 0);
      ($('debut-sante') as HTMLInputElement).value = jourISO();

      $('intensite').addEventListener('input', () => {
        $('intensite-valeur').textContent = ($('intensite') as HTMLInputElement).value;
      });
      for (const champ of ['proteines', 'glucides', 'lipides']) {
        $(champ).addEventListener('input', direMacros);
      }

      /*
         D4 du 43 : la saisie passe par l'analyseur commun, qui accepte la
         virgule. Avant, `Number('')` valait zéro et `Number('72,5')` valait
         `NaN` : appuyer sur « Enregistrer » avec un champ vide écrivait une
         pesée à 0 kg au journal, sans un mot.

         D2 : et maintenant on le dit, au pied du champ, avec « aria-invalid »
         et le focus qui y revient. La phrase dit COMMENT corriger — les
         bornes et la virgule — et non « valeur invalide ».
      */
      const PHRASES: Record<string, string> = {
        kg: 'Indiquez un poids entre 20 et 400 kg. La virgule est acceptée.',
        cm: 'Indiquez une mesure entre 1 et 300 cm. La virgule est acceptée.',
      };
      for (const id of Object.keys(PHRASES)) {
        const champ = $(id) as HTMLInputElement;
        /* Un champ vide n'est pas une faute à la sortie : on n'a peut-être
           rien voulu saisir. Il en devient une à l'envoi, et c'est là que la
           phrase se dit. */
        validerALaSortie(champ, (valeur) =>
          valeur.trim() === '' || nombreDuChamp(champ) !== null ? null : PHRASES[id],
        );
      }

      /** Lit le champ, ou dit pourquoi il ne se lit pas et y ramène le focus. */
      function nombreOuPhrase(id: string): number | null {
        const champ = $(id) as HTMLInputElement;
        const valeur = nombreDuChamp(champ);
        if (valeur === null) {
          direLErreur(champ, PHRASES[id]);
          champ.focus();
          return null;
        }
        effacerLErreur(champ);
        return valeur;
      }

      /*
         `return false` et non `return` : c'est la convention d'`unSeulGeste`
         pour un geste REFUSÉ. Sans elle, le refus compterait comme un geste
         abouti, le repos de 600 ms serait noté, et l'appui qui suit la
         correction tomberait dedans — avalé sans un mot, l'ancien message
         d'erreur restant à l'écran sous un poids qu'on vient de corriger.
         C'est le défaut que `geste.ts` décrit au 19 octobre ; mes deux
         gestes neufs seraient retombés dedans, et c'est l'essai de D2 qui
         me l'a montré.
      */
      surAppui('peser', async () => {
        const kg = nombreOuPhrase('kg');
        if (kg === null) return false;
        await ecrirePesee(kg);
        ($('kg') as HTMLInputElement).value = '';
        return true;
      });

      surAppui('mesurer', async () => {
        const cm = nombreOuPhrase('cm');
        if (cm === null) return false;
        await ecrireMesure(($('quoi') as HTMLSelectElement).value as QuoiMesurer, cm);
        ($('cm') as HTMLInputElement).value = '';
        return true;
      });

      surAppui('dormir', async () => {
        const qualite = ($('qualite') as HTMLSelectElement).value;
        const reveils = ($('reveils') as HTMLInputElement).value;
        await ecrireNuit(
          new Date(($('coucher') as HTMLInputElement).value).toISOString(),
          new Date(($('lever') as HTMLInputElement).value).toISOString(),
          {
            qualite: qualite === '' ? null : Number(qualite),
            reveils: reveils === '' ? null : Number(reveils),
          },
        );
      });

      surAppui('manger', async () => {
        const lire = (id: string) => {
          const v = ($(id) as HTMLInputElement).value;
          return v === '' ? null : Number(v);
        };
        await ecrireRepas({
          moment: ($('moment') as HTMLSelectElement).value as MomentDuRepas,
          intitule: ($('intitule') as HTMLInputElement).value.trim(),
          kcal: lire('kcal'),
          proteines: lire('proteines'),
          glucides: lire('glucides'),
          lipides: lire('lipides'),
          note: '',
        });
        for (const id of ['intitule', 'kcal', 'proteines', 'glucides', 'lipides']) {
          ($(id) as HTMLInputElement).value = '';
        }
        direMacros();
      });

      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-verre]')) {
        b.addEventListener('click', (evenement) => {
          void unSeulGeste(evenement.currentTarget as Element, () =>
            essayer(() => ecrireBoisson(Number(b.dataset.verre))),
          );
        });
      }
      surAppui('annuler-verre', async () => {
        const derniere = [...boissons]
          .filter((b) => b.jour === aujourdhui)
          .sort((a, b) => a.le.localeCompare(b.le))
          .at(-1);
        if (derniere) await supprimerBoisson(derniere.id);
      });

      surAppui('declarer-sante', async () => {
        await ecrireSante({
          intitule: ($('intitule-sante') as HTMLInputElement).value.trim(),
          // Midi : une date sans heure prise à minuit UTC bascule de jour en France.
          debut: `${($('debut-sante') as HTMLInputElement).value}T12:00:00.000Z`,
          fin: null,
          intensite: Number(($('intensite') as HTMLInputElement).value),
          empecheEffort: ($('empeche') as HTMLInputElement).checked,
          note: '',
        });
        ($('intitule-sante') as HTMLInputElement).value = '';
        ($('empeche') as HTMLInputElement).checked = false;
      });

      $('ouvrir-coffre').addEventListener('click', () => {
        void (async () => {
          const champ = $('mdp-coffre') as HTMLInputElement;
          const erreur = await ouvrirLeCoffre(champ.value, {
            memoriserAppareil:
              (document.getElementById('coffre-appareil') as HTMLInputElement | null)?.checked ??
              false,
          });
          $('erreur-coffre').classList.toggle('hidden', erreur === null);
          if (erreur) {
            $('erreur-coffre').textContent = erreur;
            return;
          }
          /*
             Le champ est vidé tout de suite. Laisser un mot de passe dans un
             champ de formulaire le laisse à portée du gestionnaire de mots de
             passe, de l'autocomplétion et de la restauration d'onglet.
          */
          champ.value = '';
          await recharger();
        })();
      });
      $('mdp-coffre').addEventListener('keydown', (evenement) => {
        if ((evenement as KeyboardEvent).key === 'Enter') $('ouvrir-coffre').click();
      });
      $('fermer-coffre').addEventListener('click', () => {
        fermerLeCoffre();
        void recharger();
      });

      surAppui('noter-prise', async () => {
        await ecrirePrise(
          ($('nom-prise') as HTMLInputElement).value,
          ($('dose') as HTMLInputElement).value,
          {
            voie: ($('voie') as HTMLSelectElement).value as VoieDAdministration,
            motif: ($('motif-prise') as HTMLInputElement).value.trim(),
          },
        );
        for (const id of ['nom-prise', 'dose', 'motif-prise']) {
          ($(id) as HTMLInputElement).value = '';
        }
      });

      surAppui('noter-statut', async () => {
        await ecrireStatut(($('intitule-statut') as HTMLInputElement).value, {
          nature: ($('nature') as HTMLSelectElement).value as NatureDuStatut,
        });
        ($('intitule-statut') as HTMLInputElement).value = '';
      });

      /* Si le coffre se referme ailleurs — verrouillage de la session —, suivre. */
      surCoffre(() => {
        void rechargerLeCoffre().then(() => peindreCoffre());
      });

      await recharger();
      $('vue').classList.remove('hidden');
    },
    { zoneChargement: '#chargement-corps' },
  );
</script>
