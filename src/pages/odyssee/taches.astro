---
/**
 * Odyssée : les tâches.
 *
 * ## Trois sorties, et pas deux
 *
 * Une tâche se termine, s'abandonne, ou reste ouverte. L'abandon n'est pas un
 * confort d'interface : sans lui, la seule façon de retirer une tâche de
 * l'arriéré serait de la supprimer, et supprimer ferait **remonter** le taux
 * de plan tenu à chaque renoncement — l'inverse de ce qu'un suivi doit faire.
 * Renoncer est donc une réponse, elle est enregistrée comme telle, et elle
 * demande un motif.
 *
 * ## Pourquoi l'écran exige le motif alors que le modèle l'exige déjà
 *
 * Il ne l'exige pas : il le **demande avant**, pour que l'échec d'écriture ne
 * soit jamais la façon dont la personne découvre la règle. Le contrôle du
 * modèle reste la garantie ; l'écran est la politesse.
 *
 * ## Les domaines proposés sont les domaines actifs
 *
 * Un domaine en pause se tait, suggestions comprises — c'est la règle posée en
 * O2. Offrir ici un domaine en pause permettrait de créer une tâche qui ne
 * reparaîtrait jamais.
 */
import Base from '../../layouts/Base.astro';
---

<Base titre="Tâches" actif="taches">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Mes tâches</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Une tâche se fait une fois. Ce qui revient chaque jour ou chaque semaine est une{' '}
      <strong>quête</strong>, et se tient depuis le tableau de bord.
    </p>

    <div id="chargement-taches" class="mt-6">
      <p class="text-sm text-slate-500 dark:text-slate-400">Lecture des tâches…</p>
    </div>

    <div id="vue" class="mt-6 hidden">
      <form
        id="ajout"
        class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="flex flex-wrap items-end gap-3">
          <label class="min-w-56 flex-1 text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Quoi</span>
            <input
              id="titre"
              type="text"
              required
              maxlength="200"
              class="mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Domaine</span>
            <select
              id="domaine"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
            ></select>
          </label>
          <!--
            « Relier à » — anomalie A-16.

            Sans ce champ, aucune tâche liée ne pouvait exister : quatorze
            endroits lisaient `tache.lien`, rien ne l'écrivait, et tout le
            mécanisme branche ↔ tâche était hors d'atteinte. Le champ est
            facultatif et vide par défaut : la grande majorité des tâches
            ne visent aucune branche.
          -->
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Relier à</span>
            <select
              id="lien"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
            ></select>
          </label>
          <!--
            La cible du lien — prompt 52, P5.

            Une action qui vise un objet précis a besoin qu'on le nomme :
            « cocher une tâche liée à un traitement note une prise » suppose
            de savoir lequel. Sans cible, le pointage ne choisit pas au
            hasard, il ne fait rien et le dit — ce qui est juste, mais
            inutilisable tant que rien ne permet de la désigner.

            Le champ reste caché pour les actions qui n'en demandent pas,
            c'est-à-dire pour presque toutes.
          -->
          <label id="ligne-cible" class="hidden text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Lequel</span>
            <select
              id="cible"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
            ></select>
            <span id="cible-fermee" class="mt-1 block text-xs text-slate-500 dark:text-slate-400"></span>
          </label>
          <!--
            CE QUE LE LIEN FAIT, ET QUAND IL NE FAIT RIEN.

            Un lien n'écrit dans sa branche qu'au pointage d'une OCCURRENCE,
            c'est-à-dire sur une tâche répétée : `pointerLaTache` clôt
            simplement une tâche unique, sans passer par la branche. Ce
            n'est pas propre à Santé — une tâche unique liée à une séance de
            sport n'en crée aucune non plus —, et ce n'est pas corrigé ici :
            le mécanisme des occurrences appartient au prompt 38, et
            l'étendre aux tâches uniques changerait le comportement de deux
            autres branches sans décision.

            Ce qui est corrigé, c'est le silence. Un lien posé sur une tâche
            sans répétition ne promettait rien et ne faisait rien ; il le
            dit désormais.
          -->
          <p id="lien-sans-repetition" class="hidden text-xs text-amber-800 sm:col-span-2 dark:text-amber-200"></p>
          <label class="text-sm">
            <span class="block text-slate-700 dark:text-slate-200">Pour quand</span>
            <input
              id="echeance"
              type="date"
              class="mt-1 min-h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
            />
          </label>
          <button
            id="ajouter"
            type="submit"
            class="min-h-11 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white transition hover:bg-indigo-700"
          >
            Ajouter
          </button>
        </div>
        <!--
          « Répéter » — prompt 38, R1. Replié par défaut : la grande majorité
          des tâches ne se répètent pas, et imposer six champs de plus à
          chacune ferait payer à tout le monde le coût d'un cas minoritaire.
        -->
        <!--
          « Répéter » — prompt 38, R1. Replié par défaut : la grande majorité
          des tâches ne se répètent pas, et imposer six champs de plus à
          chacune ferait payer à tout le monde le coût d'un cas minoritaire.

          Les champs sont posés par `champsDeSerie()` et non écrits ici : le
          même jeu sert à la création et à la modification d'une série
          existante, et deux copies auraient divergé au premier ajout.
        -->
        <details id="repeter" class="mt-3">
          <summary class="min-h-11 cursor-pointer text-sm text-slate-700 dark:text-slate-200">
            Répéter
          </summary>
          <div id="champs-serie" class="mt-2"></div>
        </details>

        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          Sans date, la tâche reste une intention : elle ne compte pas dans le suivi du plan, et
          ne vous sera pas reprochée.
        </p>
        <p id="erreur-ajout" class="mt-2 hidden text-sm text-rose-700 dark:text-rose-300"></p>
      </form>

      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">En retard</h2>
        <div id="retard" class="space-y-2"></div>
        <p id="retard-vide" class="hidden text-sm text-slate-500 dark:text-slate-400">
          Rien en retard.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">À faire</h2>
        <div id="ouvertes" class="space-y-2"></div>
        <p id="ouvertes-vide" class="hidden text-sm text-slate-500 dark:text-slate-400">
          Rien à faire pour l’instant.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="mb-1 text-lg font-semibold text-slate-900 dark:text-white">Closes</h2>
        <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
          Faites et abandonnées, les trente dernières. Une tâche abandonnée reste ici : elle
          compte dans le suivi, et la supprimer ferait remonter le taux à chaque renoncement.
        </p>
        <div id="closes" class="space-y-2"></div>
        <p id="closes-vide" class="hidden text-sm text-slate-500 dark:text-slate-400">
          Rien encore.
        </p>
      </section>
    </div>
  </div>
</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { messageDUneErreur } from '../../lib/agir';
  import { unSeulGeste } from '../../lib/geste';
  import { domainesActifs } from '../../lib/odyssee-jour';
  import {
    abandonner,
    ajouterTache,
    clore,
    ecrireTache,
    supprimerTache,
    toutesLesTaches,
  } from '../../lib/odyssee/donnees';
  import { MOTIFS, libelleDuMotif, type MotifNonFait, type Tache } from '../../lib/odyssee/modele';
  import {
    avancement,
    cochagesDeLOccurrence,
    cochees,
    etapesOrdonnees,
    jourDeLOccurrence,
    seClotToutSeul,
  } from '../../lib/odyssee/etapes';
  import {
    cocherEtape,
    cochagesDuJour,
    decocherEtape,
    occurrencesDeLaTache,
    exceptionsDeLaFenetre,
  } from '../../lib/odyssee/donnees-occurrences';
  /*
     Les trois moteurs des phases 5 à 7 du prompt 38 — anomalie A-9.

     Ils existaient, éprouvés et verts, et **aucun écran ne les appelait** :
     le bouton « Faite » clôturait la tâche quelle que soit sa nature, donc
     une tâche répétée pointée une fois ne revenait jamais. C'est cet écran
     qui les appelle désormais, parce que c'est le seul qui connaisse les
     séries.
  */
  import { coffreOuvert } from '../../lib/coffre';
  import { ecritDansLaBranche } from '../../lib/odyssee/liaison-branches';
  import {
    ecrireLException,
    pointerLOccurrence,
    retirerLePointage,
  } from '../../lib/odyssee/pointage-partage';
  /*
     Le sens branche → tâche — prompt 39, C2. Il ne s'écrit pas, il se
     relit : une occurrence liée est faite quand un fait compté de son
     action existe ce jour-là. L'exception, elle, fait toujours autorité.
  */
  import { ACTIONS_LIABLES } from '../../lib/odyssee/liaison-branches';
  import { faitsDuJour } from '../../lib/odyssee/faits-du-jour';
  import {
    gesteDeRetrait,
    pointageDeLOccurrence,
    type FaitObserve,
  } from '../../lib/odyssee/pointage-derive';
  import {
    LIBELLE_PORTEE,
    planifierAbandon,
    planifierModification,
    planifierReprise,
    type Portee,
  } from '../../lib/odyssee/modification-serie';
  import type { EtapeCochee, EtatDOccurrence } from '../../lib/odyssee/modele';
  /*
     Les champs de série vivent dans leur propre module depuis le prompt 39 :
     le calendrier les monte aussi, et un formulaire recopié aurait divergé.
  */
  import { champsDeSerie, type ChampsDeSerie } from '../../lib/odyssee/champs-de-serie';
  import {
    libelleDeLaSerie,
    problemesDeLaSerie,
    type Fin,
    type JourSemaine,
    type Repetition,
    type Serie,
  } from '../../lib/odyssee/repetition';
  import { jourLogique } from '../../lib/noyau/jour-logique';
  import { reglagesJourLogiqueLocaux } from '../../lib/adaptation';
  import { DOMAINES, libelleDuDomaine } from '../../lib/noyau/domaines';

  const $ = (id: string) => document.getElementById(id)!;

  let actifs: string[] = [];
  let aujourdhui = '';
  /*
     Les occurrences pointées des jours affichés — A-9.

     Depuis que le pointage d'une tâche répétée écrit une occurrence au lieu
     de clore la tâche, la carte ne peut plus lire son état sur `faiteLe` :
     la tâche reste ouverte, c'est son occurrence du jour qui est faite. Sans
     cette lecture, le bouton « Faite » resterait proposé après coup, et il
     mentirait.
  */
  let pointagesAffiches: { tacheId: string; jourPrevu: string; etat: string }[] = [];
  /** Les faits du jour, pour le sens branche → tâche. Bornés à la journée. */
  let faitsAffiches: FaitObserve[] = [];
  /**
   * Les branches qu'on n'a pas pu lire — scellées, coffre fermé.
   *
   * **Elles ne s'affichent pas nommées.** Coffre fermé, dire « Psyché n'a
   * pas pu être lue » révélerait l'existence d'un lien vers Psyché sur une
   * carte qui ne le montre pas autrement. La mention reste neutre ; ce
   * décompte sert au diagnostic, pas à l'écran.
   */
  let branchesIllisibles: string[] = [];
  /* Les cochages de toutes les occurrences affichées, relus à chaque peinture. */
  let tousLesCochages: EtapeCochee[] = [];

  function ligne(texte: string, classe: string): HTMLParagraphElement {
    const p = document.createElement('p');
    p.className = classe;
    p.textContent = texte;
    return p;
  }

  function bouton(libelle: string, classe = ''): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button';
    b.className =
      'min-h-11 rounded-lg border border-slate-300 px-3 text-sm transition ' +
      'hover:border-indigo-400 dark:border-slate-700 ' +
      classe;
    b.textContent = libelle;
    return b;
  }

  /* ══════════════════════════════════════════════════════════════════════
     « Répéter » — prompt 38, R1
     ══════════════════════════════════════════════════════════════════════ */

  /*
     Cette variable appartient à la PAGE, pas au module des champs.

     Elle a été emportée par l'extraction du prompt 39, et la page a
     cessé de s'afficher : « serieNeuve is not defined ». Le contrôle de
     navigateur l'a vu tout de suite — c'est précisément ce qu'un essai
     qui part d'une route sait dire et qu'aucun essai de module ne dit.

     Elle reste ici parce qu'elle tient l'état d'UN formulaire, celui de
     la création sur cet écran. Le calendrier aura le sien.
  */
  /** Les champs du formulaire de création, montés une fois. */
  let serieNeuve: ChampsDeSerie | null = null;

  /** (Re)monte les champs de création. Les remonter les remet à zéro. */
  function monterLesChampsDeSerie(initiale: Serie | null = null) {
    const zone = $('champs-serie');
    zone.innerHTML = '';
    serieNeuve = champsDeSerie(
      'neuve',
      () => ($('echeance') as HTMLInputElement).value || aujourdhui,
      initiale,
    );
    zone.appendChild(serieNeuve.element);
  }

  /**
   * La liste à cocher d'une tâche à étapes — phase 3 du prompt 38.
   *
   * ## Le jour, et pourquoi il est calculé et non pris du calendrier
   *
   * Les cochages appartiennent à une **occurrence**, pas à la tâche :
   * « chaque occurrence repart d'une liste décochée ». `jourDeLOccurrence()`
   * donne la bonne ancre — le jour courant pour une tâche répétée, le jour de
   * création pour une tâche simple, dont la liste ne doit surtout pas se
   * décocher chaque nuit.
   *
   * ## La clôture automatique, et le geste qui la précède
   *
   * Décision 2c : la tâche se clôt **d'elle-même** quand toutes ses étapes
   * sont cochées, et reste clôturable **à la main** à tout moment. La première
   * moitié est ici, après l'écriture du cochage et non avant : clore d'abord
   * aurait fermé la tâche sur une écriture qui pouvait encore échouer.
   *
   * Décocher ne rouvre rien tout seul. Rouvrir est un geste, et le déduire
   * d'un décochage ferait ressusciter une tâche close hier parce qu'on a
   * corrigé une étape aujourd'hui.
   */
  function listeDesEtapes(tache: Tache): HTMLElement {
    const jour = jourDeLOccurrence(tache, aujourdhui);
    const siennes = cochagesDeLOccurrence(tousLesCochages, tache.id, jour);
    const faites = cochees(siennes);
    const etapes = tache.etapes ?? [];
    const etat = avancement(etapes, siennes);

    const bloc = document.createElement('div');
    bloc.className = 'mt-2';
    bloc.dataset.etapesDe = tache.id;

    const compteur = ligne(
      etat.texte,
      'text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400',
    );
    compteur.dataset.avancement = tache.id;
    bloc.appendChild(compteur);

    const liste = document.createElement('ul');
    liste.className = 'mt-1 space-y-1';
    for (const etape of etapesOrdonnees(etapes)) {
      const li = document.createElement('li');
      const label = document.createElement('label');
      /* min-h-11 : la cible tactile du socle, cochage compris. */
      label.className = 'flex min-h-11 cursor-pointer items-center gap-2 text-sm';

      const case_ = document.createElement('input');
      case_.type = 'checkbox';
      case_.className = 'size-5 shrink-0 accent-indigo-600';
      case_.checked = faites.has(etape.id);
      case_.dataset.etape = `${tache.id}/${etape.id}`;
      case_.disabled = Boolean(tache.faiteLe || tache.abandonneeLe);

      const texte = document.createElement('span');
      texte.textContent = etape.intitule;
      texte.className = case_.checked
        ? 'text-slate-400 line-through dark:text-slate-500'
        : 'text-slate-700 dark:text-slate-200';

      case_.addEventListener('change', () => {
        void agirPuisPeindre(async () => {
          if (case_.checked) await cocherEtape(tache.id, jour, etape.id);
          else await decocherEtape(tache.id, jour, etape.id);

          /*
             Relu depuis la base plutôt que déduit de l'état de la case : une
             écriture peut échouer, et l'avancement doit dire ce qui est
             enregistré, non ce qui a été cliqué.
          */
          const apres = cochagesDeLOccurrence(
            await cochagesDuJour(jour),
            tache.id,
            jour,
          );
          if (!tache.faiteLe && !tache.abandonneeLe && seClotToutSeul(etapes, apres)) {
            await clore(tache.id, true);
          }
        });
      });

      label.append(case_, texte);
      li.appendChild(label);
      liste.appendChild(li);
    }
    bloc.appendChild(liste);
    return bloc;
  }

  /**
   * Modifier la règle d'une série existante — prompt 38, phase 4.
   *
   * ## Rien n'est écrit avant que le plan soit montré
   *
   * Le bouton ouvre les champs, pré-remplis avec la série actuelle. Choisir
   * une portée demande le **plan** à `planifierModification()` et affiche ses
   * avertissements — dont la liste des occurrences **déjà pointées** que la
   * nouvelle règle ne produirait plus. La confirmation applique ce même plan
   * et rien d'autre : c'est la seule façon que ce qui est montré corresponde
   * à ce qui se passe.
   *
   * ## L'ancre ne bouge pas
   *
   * Les champs sont ancrés sur le `depuis` de la série existante, pas sur le
   * jour courant. Changer la règle d'une série mensuelle ne doit pas en
   * déplacer le quantième au passage, sans que personne l'ait demandé.
   */
  function editeurDeSerie(tache: Tache): HTMLElement {
    const bloc = document.createElement('div');
    bloc.dataset.editeurSerie = tache.id;

    const ouvrir = bouton('Modifier la répétition', 'mt-2');
    ouvrir.dataset.modifierSerie = tache.id;
    bloc.appendChild(ouvrir);

    const zone = document.createElement('div');
    zone.className = 'mt-2 hidden';
    bloc.appendChild(zone);

    ouvrir.addEventListener('click', () => {
      if (!zone.classList.contains('hidden')) {
        zone.classList.add('hidden');
        return;
      }
      zone.classList.remove('hidden');
      if (zone.childElementCount) return;

      const champs = champsDeSerie(tache.id, () => tache.serie!.depuis, tache.serie!);
      zone.appendChild(champs.element);

      let portee: Portee | null = null;
      const avertissement = ligne('', 'mt-2 hidden text-sm text-amber-700 dark:text-amber-300');
      const erreur = ligne('', 'mt-2 hidden text-sm text-rose-700 dark:text-rose-300');

      const groupe = document.createElement('fieldset');
      groupe.className = 'mt-2';
      groupe.dataset.porteeSerie = tache.id;
      const legende = document.createElement('legend');
      legende.className = 'text-sm text-slate-700 dark:text-slate-200';
      legende.textContent = 'À quoi cela s’applique-t-il ?';
      groupe.appendChild(legende);

      const montrerLePlan = async () => {
        if (!portee) return;
        const nouvelle = champs.lire();
        if (!nouvelle) return;
        /* Les exceptions ne sont lues QUE pour « toute la série » : c'est la
           seule portée qui peut laisser un pointage hors de la règle. */
        const exceptions =
          portee === 'toute-la-serie' ? await occurrencesDeLaTache(tache.id) : [];
        const plan = planifierModification(
          tache,
          aujourdhui,
          portee,
          nouvelle,
          exceptions,
          aujourdhui,
        );
        avertissement.textContent = plan.avertissements.join(' ');
        avertissement.classList.toggle('hidden', plan.avertissements.length === 0);
      };

      for (const p of ['cette-fois', 'celle-ci-et-suivantes', 'toute-la-serie'] as const) {
        const label = document.createElement('label');
        label.className = 'flex min-h-11 cursor-pointer items-center gap-2 text-sm';
        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = `portee-serie-${tache.id}`;
        radio.value = p;
        radio.className = 'size-4 accent-indigo-600';
        radio.addEventListener('change', () => {
          portee = p;
          void montrerLePlan();
        });
        const texte = document.createElement('span');
        texte.textContent = LIBELLE_PORTEE[p];
        label.append(radio, texte);
        groupe.appendChild(label);
      }
      zone.appendChild(groupe);

      const appliquer = bouton('Appliquer', 'mt-2');
      appliquer.dataset.appliquerSerie = tache.id;
      appliquer.addEventListener('click', () => {
        const nouvelle = champs.lire();
        if (!nouvelle) {
          erreur.textContent = 'Choisissez un rythme, ou renoncez à la répétition autrement.';
          erreur.classList.remove('hidden');
          return;
        }
        const soucis = champs.problemes();
        if (soucis.length) {
          erreur.textContent = soucis.join(' ');
          erreur.classList.remove('hidden');
          return;
        }
        if (!portee) {
          erreur.textContent = 'Dites à quoi la modification s’applique.';
          erreur.classList.remove('hidden');
          return;
        }
        erreur.classList.add('hidden');
        void agirPuisPeindre(async () => {
          const exceptions =
            portee === 'toute-la-serie' ? await occurrencesDeLaTache(tache.id) : [];
          const plan = planifierModification(
            tache,
            aujourdhui,
            portee!,
            nouvelle,
            exceptions,
            aujourdhui,
          );
          /* Le magasin se choisit : une tâche scellée n'écrit pas en clair (A-14). */
          if (plan.occurrence) await ecrireLException(tache, plan.occurrence);
          if (plan.tache) await ecrireTache(plan.tache);
          /* La seconde moitié d'une scission naît comme une tâche neuve :
             elle a besoin d'un identifiant et d'une date de création, que le
             plan ne pose pas — lui seul ne sait ni tirer un ULID ni lire
             l'horloge. */
          if (plan.suite) {
            await ajouterTache({
              titre: plan.suite.titre,
              domaine: plan.suite.domaine,
              echeance: null,
              note: plan.suite.note,
              serie: plan.suite.serie,
              etapes: plan.suite.etapes,
            });
          }
        });
      });
      zone.append(appliquer, erreur, avertissement);
    });

    return bloc;
  }

  /**
   * La carte d'une tâche.
   *
   * L'abandon ouvre le choix du motif au lieu de s'appliquer : c'est la seule
   * action de cet écran qui demande une réponse, et la demander après coup —
   * par un message d'erreur — serait la pire façon de l'apprendre.
   */
  function carte(tache: Tache): HTMLElement {
    const bloc = document.createElement('div');
    bloc.className =
      'rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 ' +
      'dark:bg-slate-950';
    bloc.dataset.tache = tache.id;
    bloc.dataset.etat = tache.faiteLe ? 'faite' : tache.abandonneeLe ? 'abandonnee' : 'ouverte';
    /* Plus de `view-transition-name` ici : l'appariement se fait désormais par
       `data-tache`, que `peindre()` relève avant et après l'écriture. Le nom
       servait à l'API de transition, abandonnée en A5 parce qu'elle rendait la
       liste insensible au doigt pendant qu'elle glissait. */

    const titre = ligne(
      tache.titre,
      'font-medium ' +
        (tache.faiteLe || tache.abandonneeLe
          ? 'text-slate-400 line-through dark:text-slate-500'
          : 'text-slate-900 dark:text-white'),
    );
    bloc.appendChild(titre);

    const detail: string[] = [libelleDuDomaine(tache.domaine)];
    /* La série AVANT l'échéance : c'est la chose la plus structurante de la
       tâche, et une tâche répétée n'a de toute façon pas d'échéance. */
    if (tache.serie) detail.push(libelleDeLaSerie(tache.serie));
    if (tache.echeance) detail.push(`pour le ${tache.echeance}`);
    if (tache.faiteLe) detail.push(`faite le ${tache.faiteLe}`);
    else if (pointeeAujourdhui(tache)) detail.push('faite aujourd’hui');
    if (tache.abandonneeLe) {
      detail.push(
        `abandonnée le ${tache.abandonneeLe}` +
          (tache.motifAbandon ? ` — ${libelleDuMotif(tache.motifAbandon).toLowerCase()}` : ''),
      );
    }
    bloc.appendChild(
      ligne(detail.join(' · '), 'mt-0.5 text-xs text-slate-400 dark:text-slate-500'),
    );

    if (tache.etapes?.length) bloc.appendChild(listeDesEtapes(tache));

    const actions = document.createElement('div');
    actions.className = 'mt-2 flex flex-wrap gap-2';

    if (!tache.faiteLe && !tache.abandonneeLe) {
      /*
         Une tâche répétée pointée aujourd'hui n'est pas close — sa série
         continue — mais son occurrence du jour est faite. Reproposer
         « Faite » serait un mensonge ; on propose de défaire.
      */
      if (pointeeAujourdhui(tache)) {
        /*
           Défaire n'est pas un seul geste — prompt 39, C1.

           Si c'est nous qui avons pointé, on efface notre exception et il
           ne reste rien. Si c'est la branche qui l'a dit, effacer ne
           servirait à rien : l'affichage suivant relirait le fait et
           recocherait. Il faut alors écrire une exception qui contredit,
           sans toucher à la séance elle-même.
        */
        const geste = gesteDeRetrait(etatDuJour(tache));
        const jour = jourDeLOccurrence(tache, aujourdhui);
        const defaire = bouton(geste === 'ecrire-un-depointage' ? 'Ce n’était pas ça' : 'Pas finalement');
        defaire.dataset.depointer = tache.id;
        defaire.title =
          geste === 'ecrire-un-depointage'
            ? 'Retire la coche sans toucher à ce que la branche a enregistré.'
            : 'Efface le pointage que vous avez fait ici.';
        /*
           La même chose, mais VISIBLE. Une infobulle ne s'ouvre pas au
           doigt, et c'est au doigt que ce bouton sera pressé. Dire après
           coup « votre séance est toujours là » ne vaut pas la dire avant.
        */
        if (geste === 'ecrire-un-depointage') {
          const note = document.createElement('p');
          note.className = 'mt-2 w-full text-xs text-slate-500 dark:text-slate-400';
          note.dataset.notePointage = tache.id;
          note.textContent =
            'Fait depuis sa branche. « Ce n’était pas ça » retire la coche ici ; la séance reste comptée.';
          actions.appendChild(note);
        }
        defaire.addEventListener('click', () =>
          /*
             Le magasin se choisit dans `retirerLePointage` : écrire ici
             mettait le dépointage d'une tâche scellée EN CLAIR — anomalie
             A-14, seconde moitié.
          */
          void agirPuisPeindre(() =>
            geste === 'rien-a-defaire'
              ? Promise.resolve()
              : retirerLePointage(tache, jour, geste),
          ),
        );
        actions.appendChild(defaire);
      } else {
        const faite = bouton('Faite');
        faite.dataset.faire = tache.id;
        faite.addEventListener('click', () => void agirPuisPeindre(() => pointerLaTache(tache)));
        actions.appendChild(faite);
      }

      const renoncer = bouton('J’y renonce');
      renoncer.dataset.renoncer = tache.id;
      const choix = document.createElement('div');
      choix.className = 'mt-2 hidden w-full';
      const select = document.createElement('select');
      select.dataset.motif = tache.id;
      select.className =
        'min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm ' +
        'dark:border-slate-700 dark:bg-slate-950';
      const vide = document.createElement('option');
      vide.value = '';
      vide.textContent = 'Pourquoi y renoncez-vous ? (obligatoire)';
      select.appendChild(vide);
      for (const m of MOTIFS) {
        const option = document.createElement('option');
        option.value = m.id;
        option.textContent = m.libelle;
        option.title = m.precision;
        select.appendChild(option);
      }
      /*
         LE CHOIX DE LA PORTÉE — prompt 38, et c'est ici que se joue « aucune
         série réécrite en silence ».

         Il n'apparaît que pour une tâche répétée : le proposer à une tâche
         unique poserait une question dont les trois réponses sont la même, et
         habituerait à cliquer sans lire — ce qui est exactement la façon dont
         un consentement devient une formalité.

         Rien n'est présélectionné. La portée la plus destructrice est la
         dernière, et aucune n'est le défaut : c'est une décision, pas un
         réglage.
      */
      let portee: Portee | null = null;
      const avertissement = ligne('', 'mt-2 hidden text-sm text-amber-700 dark:text-amber-300');

      if (tache.serie) {
        const groupe = document.createElement('fieldset');
        groupe.className = 'mt-2';
        groupe.dataset.portee = tache.id;
        const legende = document.createElement('legend');
        legende.className = 'text-sm text-slate-700 dark:text-slate-200';
        legende.textContent = 'À quoi cela s’applique-t-il ?';
        groupe.appendChild(legende);
        for (const p of ['cette-fois', 'celle-ci-et-suivantes', 'toute-la-serie'] as const) {
          const label = document.createElement('label');
          label.className = 'flex min-h-11 cursor-pointer items-center gap-2 text-sm';
          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = `portee-${tache.id}`;
          radio.value = p;
          radio.className = 'size-4 accent-indigo-600';
          radio.addEventListener('change', () => {
            portee = p;
            /*
               L'avertissement est montré AVANT la confirmation, et il vient du
               plan — non d'un texte écrit à la main qui pourrait mentir sur ce
               que le code va faire.
            */
            const plan = planifierAbandon(
              tache,
              aujourdhui,
              p,
              (select.value || 'imprevu') as MotifNonFait,
              new Date().toISOString(),
            );
            avertissement.textContent = plan.avertissements.join(' ');
            avertissement.classList.toggle('hidden', plan.avertissements.length === 0);
          });
          const texte = document.createElement('span');
          texte.textContent = LIBELLE_PORTEE[p];
          label.append(radio, texte);
          groupe.appendChild(label);
        }
        choix.appendChild(groupe);
      }

      const confirmer = bouton('Confirmer le renoncement', 'mt-2');
      confirmer.dataset.confirmer = tache.id;
      const erreur = ligne('', 'mt-2 hidden text-sm text-rose-700 dark:text-rose-300');
      confirmer.addEventListener('click', () => {
        if (!select.value) {
          erreur.textContent = 'Dire pourquoi vous y renoncez fait partie du renoncement.';
          erreur.classList.remove('hidden');
          return;
        }
        if (tache.serie && !portee) {
          erreur.textContent =
            'Cette tâche se répète : dites à quoi le renoncement s’applique.';
          erreur.classList.remove('hidden');
          return;
        }
        const motif = select.value as MotifNonFait;
        void agirPuisPeindre(async () => {
          if (!tache.serie) {
            await abandonner(tache.id, true, motif);
            return;
          }
          /*
             On applique LE PLAN, et rien d'autre. L'écran ne décide pas de ce
             qu'il écrit : il exécute ce qu'il vient de montrer. C'est la seule
             façon que l'avertissement affiché corresponde à ce qui se passe.
          */
          const plan = planifierAbandon(
            tache,
            aujourdhui,
            portee!,
            motif,
            new Date().toISOString(),
          );
          /* Le magasin se choisit : une tâche scellée n'écrit pas en clair (A-14). */
          if (plan.occurrence) await ecrireLException(tache, plan.occurrence);
          if (plan.tache) await ecrireTache(plan.tache);
        });
      });
      renoncer.addEventListener('click', () => choix.classList.remove('hidden'));
      choix.append(select, confirmer, erreur, avertissement);
      actions.append(renoncer);
      bloc.append(actions, choix);
      if (tache.serie) bloc.appendChild(editeurDeSerie(tache));
      return bloc;
    }

    /*
       REPRENDRE UNE SÉRIE — prompt 39, C4.

       Une tâche close qui porte une série ne se « rouvre » pas comme une
       tâche simple : la rouvrir telle quelle la ferait repartir depuis son
       ancre d'origine, et trois semaines d'occurrences remonteraient « en
       retard » au moment même où l'on reprend. Une clôture n'est pas un
       oubli, et le dire ainsi punirait le geste qu'on veut encourager.

       Le plan décide, l'écran exécute et **affiche ce que le plan dit** —
       jamais une phrase écrite à la main, qui finirait par promettre autre
       chose que ce que le code fait.
    */
    const plan = tache.serie ? planifierReprise(tache, aujourdhui) : null;

    const rouvrir = bouton(tache.serie ? 'Reprendre la série' : 'Rouvrir');
    rouvrir.dataset.rouvrir = tache.id;
    if (plan?.quoi === 'impossible') {
      /*
         Une série dont la règle ne prévoit plus aucun jour. On ne la
         rallonge pas d'autorité : le bouton se tait et dit pourquoi,
         plutôt que de rouvrir une série qui ne reviendrait jamais.
      */
      rouvrir.disabled = true;
      rouvrir.className += ' cursor-not-allowed opacity-50';
      rouvrir.title = plan.pourquoi;
    }
    rouvrir.addEventListener('click', () =>
      void agirPuisPeindre(async () => {
        if (plan?.quoi === 'impossible') throw new Error(plan.pourquoi);
        if (plan?.quoi === 'reprise') {
          /* Une seule écriture : la tâche réécrite porte déjà les deux
             levées et la nouvelle ancre. Deux écritures laisseraient un
             instant une tâche à moitié reprise. */
          await ecrireTache(plan.tache);
          return;
        }
        /*
           Rouvrir défait les deux sorties, et dans cet ordre : lever l'abandon
           efface le motif, puis la clôture est levée. Les inverser laisserait
           un instant une tâche faite **et** abandonnée, que le contrôle
           refuse — et le refus porterait sur un état que personne n'a voulu.
        */
        if (tache.abandonneeLe) await abandonner(tache.id, false);
        if (tache.faiteLe) await clore(tache.id, false);
      }),
    );
    actions.appendChild(rouvrir);

    /* Dit AVANT le geste, en une ligne, et visible — pas une infobulle. */
    if (plan) {
      const dit = ligne(
        plan.quoi === 'reprise' ? plan.dit : plan.pourquoi,
        'mt-2 w-full text-xs ' +
          (plan.quoi === 'reprise'
            ? 'text-slate-500 dark:text-slate-400'
            : 'text-amber-700 dark:text-amber-300'),
      );
      dit.dataset.ditReprise = tache.id;
      actions.appendChild(dit);
    }

    const supprimer = bouton('Supprimer', 'text-rose-700 dark:text-rose-300');
    supprimer.dataset.supprimer = tache.id;
    supprimer.addEventListener('click', () =>
      void agirPuisPeindre(() => supprimerTache(tache.id)),
    );
    actions.appendChild(supprimer);

    bloc.appendChild(actions);
    return bloc;
  }

  /**
   * Pointer une tâche — anomalie A-9, option A signée le 15 octobre 2026.
   *
   * Trois cas, et l'ordre des questions porte toute la règle :
   *
   * 1. **sans série, on clôt.** Une tâche qui se fait une fois est finie
   *    quand elle est faite ; il n'y a pas d'occurrence à écrire, et lui en
   *    fabriquer une inventerait une série que personne n'a demandée ;
   * 2. **avec série, c'est l'occurrence du jour qu'on pointe**, jamais la
   *    série. `pointerDepuisLeCalendrier` écrit l'exception d'abord, puis
   *    rend son fait à la branche si la tâche en vise une — un fait par
   *    geste, jamais deux ;
   * 3. **sous coffre fermé**, `gesteSousCoffre` décide, et il rend un refus
   *    comme une **valeur** : la raison s'affiche, rien n'est lancé à la
   *    figure de l'écran.
   *
   * Le report (A-6, option D) dépose un pli chiffré que la réouverture du
   * coffre rejouera. `deposerUnReport` rend `false` s'il n'y a pas de boîte
   * sur cet appareil — on lève alors, plutôt que de laisser croire que le
   * geste a été gardé.
   */
  /**
   * L'état de pointage de l'occurrence du jour — exception ou branche.
   *
   * Une seule source pour la carte entière : le libellé, le bouton et son
   * nom en découlent. Les lire séparément les ferait diverger le jour où
   * l'un des trois changerait.
   */
  const etatDuJour = (tache: Tache) => {
    const jour = jourDeLOccurrence(tache, aujourdhui);
    const exception = pointagesAffiches.find((o) => o.tacheId === tache.id && o.jourPrevu === jour);
    return pointageDeLOccurrence(tache, jour, {
      exception: exception ? { etat: exception.etat as EtatDOccurrence } : null,
      faits: faitsAffiches,
      coffreOuvert: coffreOuvert(),
    });
  };

  /** L'occurrence du jour de cette tâche répétée est-elle faite ? */
  const pointeeAujourdhui = (tache: Tache): boolean =>
    Boolean(tache.serie) && etatDuJour(tache).faite;

  async function pointerLaTache(tache: Tache): Promise<void> {
    if (!tache.serie) {
      await clore(tache.id, true);
      return;
    }

    /*
       Le geste complet — coffre, boîte, report — vit dans
       `pointage-partage.ts` depuis le prompt 39 : le calendrier pointe
       aussi, et deux copies de cet enchaînement auraient divergé là où
       la divergence coûte le plus cher.
    */
    const geste = await pointerLOccurrence(tache, jourDeLOccurrence(tache, aujourdhui));
    if (geste.quoi === 'refuse') throw new Error(geste.pourquoi);
  }

  async function agirPuisPeindre(action: () => Promise<unknown>) {
    try {
      await action();
    } catch (erreur) {
      const message = messageDUneErreur(erreur);
      $('erreur-ajout').textContent = message;
      $('erreur-ajout').classList.remove('hidden');
      return;
    }
    await peindre();
  }

  /**
   * Repeint les trois zones — et fait glisser les cartes vers leur nouvelle
   * place au lieu de les laisser sauter (prompt 34, A3).
   *
   * **POURQUOI CE N'EST PLUS `startViewTransition` — A5 du prompt 37.**
   *
   * Le glissement était confié à l'API de transition. Elle fige l'écran sur une
   * photographie, et pendant ce temps **le contenu réel n'est plus testable au
   * pointeur** : mesuré ici, `elementFromPoint` au centre exact d'un bouton
   * « Faite » renvoie l'élément racine à 40, 100 et 200 ms après la première
   * action, puis le bouton de nouveau à 1 200 ms. Un appui tombé dans cet
   * intervalle est perdu, et la liste n'en garde aucune trace.
   *
   * J'ai d'abord essayé `skipTransition()` au `pointerdown`, que le prompt
   * proposait. **Mesuré : cela ne suffit pas.** Le test d'impact de l'appui a
   * déjà eu lieu quand le gestionnaire s'exécute ; l'appui est perdu quand
   * même. J'ai aussi essayé `::view-transition { pointer-events: none }` au cas
   * où la couche intercepterait : aucun effet, ce n'est pas elle.
   *
   * Reste la seconde voie que le prompt autorise : **animer les vraies cartes**.
   * On relève leur place avant l'écriture, on écrit, on relève la nouvelle, et
   * on joue l'écart par une transformation. Les cartes restent les cartes :
   * elles sont dans le document, sensibles au doigt, et un appui tombe sur ce
   * qu'on voit. Elles ne passent plus non plus au-dessus de la barre d'onglets,
   * puisqu'elles n'entrent dans aucune couche supérieure.
   *
   * **La lecture de la base reste hors de l'animation**, comme avant : on lit
   * d'abord, on n'anime que ce qui suit l'écriture (interdit n° 5).
   *
   * **Durée et courbe viennent des jetons**, lus sur la racine — et non des
   * 250 ms en `ease` que le navigateur appliquait par défaut.
   */
  async function peindre() {
    const taches = await toutesLesTaches();
    /*
       Les cochages de toutes les occurrences affichées, en une passe. Lire par
       tâche aurait fait une requête par carte ; lire par jour ne suffit pas,
       puisqu'une tâche simple s'ancre sur son jour de création. On réunit donc
       les jours dont on a besoin.
    */
    const jours = new Set(taches.filter((t) => t.etapes?.length).map((t) => jourDeLOccurrence(t, aujourdhui)));
    tousLesCochages = (await Promise.all([...jours].map((j) => cochagesDuJour(j)))).flat();
    /*
       Les occurrences pointées, pour les tâches répétées seulement — A-9. Le
       jour est le même pour toutes (celui d'aujourd'hui), donc une requête.
    */
    /*
       LES DEUX MAGASINS, et non le seul magasin clair — défaut constaté en
       branchant le lien de Santé (prompt 52, P5).

       Cet écran lisait `occurrencesDuJour`, qui n'interroge que
       `odysseeOccurrences`. Or `pointerDepuisLeCalendrier` range l'exception
       de toute tâche liée à une branche SOUS COFFRE dans
       `odysseeExceptionsScellees` — c'est `magasinDeLException` qui le veut,
       et c'est la décision 3 du prompt 38. Le pointage s'écrivait donc, et
       l'écran ne le voyait jamais : « Faite » restait proposé, et « défaire »
       n'apparaissait pas.

       Le défaut est antérieur à ce lot et touchait déjà Psyché et Finances,
       dont les liens sont scellés eux aussi. Le calendrier, lui, lisait
       correctement les deux magasins depuis l'anomalie A-14 ; cet écran-ci
       est mis d'accord avec lui, et l'exception retrouve l'autorité que son
       module lui donne.
    */
    pointagesAffiches = taches.some((t) => t.serie)
      ? await exceptionsDeLaFenetre(aujourdhui, aujourdhui, { coffreOuvert: coffreOuvert() })
      : [];
    /*
       Les faits du jour, pour les tâches liées seulement. Les projeter sans
       tâche liée serait une lecture de branche qu'aucun affichage ne demande.
    */
    if (taches.some((t) => t.lien)) {
      const fenetre = await faitsDuJour(aujourdhui);
      faitsAffiches = fenetre.faits;
      branchesIllisibles = fenetre.branchesIllisibles;
    } else {
      faitsAffiches = [];
      branchesIllisibles = [];
    }
    const ouvertes = taches.filter((t) => !t.faiteLe && !t.abandonneeLe);
    const retard = ouvertes.filter((t) => t.echeance && t.echeance < aujourdhui);
    const aFaire = ouvertes.filter((t) => !retard.includes(t));
    const closes = taches
      .filter((t) => t.faiteLe || t.abandonneeLe)
      .sort((a, b) => (b.faiteLe ?? b.abandonneeLe ?? '').localeCompare(a.faiteLe ?? a.abandonneeLe ?? ''))
      .slice(0, 30);

    const ecrire = () => {
      for (const [zone, liste] of [
        ['retard', retard],
        ['ouvertes', aFaire],
        ['closes', closes],
      ] as const) {
        const cible = $(zone);
        cible.innerHTML = '';
        $(`${zone}-vide`).classList.toggle('hidden', liste.length > 0);
        const tries = [...liste].sort((a, b) =>
          (a.echeance ?? '9999').localeCompare(b.echeance ?? '9999'),
        );
        for (const tache of tries) cible.appendChild(carte(tache));
      }
      $('vue').classList.remove('hidden');
    };

    /* Où sont les cartes AVANT l'écriture. */
    const avant = new Map<string, DOMRect>();
    for (const el of document.querySelectorAll<HTMLElement>('[data-tache]')) {
      avant.set(el.dataset.tache!, el.getBoundingClientRect());
    }

    ecrire();

    /*
       Sous mouvement réduit — réglage du système OU interrupteur de
       l'application, le plus restrictif l'emporte — la liste se repeint d'un
       coup. C'est aussi le repli d'un navigateur sans `Element.animate`.
    */
    const reduit =
      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.getAttribute('data-animations') === 'reduites';
    if (reduit) return;

    /*
       LIRE L'UNITÉ, PAS SEULEMENT LE NOMBRE.

       Le jeton est écrit « 200ms » dans la feuille, mais le minificateur CSS
       le republie en « .2s ». Ma première écriture faisait un `parseFloat`
       sans regarder l'unité : elle obtenait 0,2 et animait les cartes pendant
       0,2 MILLISECONDE. Elles sautaient donc exactement comme avant, et ni
       moi ni mon essai de gestes ne l'avons vu — il mesurait que le bouton
       restait atteignable, pas que la carte glissait. C'est « essais:listes »,
       une fois remis au nouveau mécanisme, qui l'a relevé.
    */
    const racine = getComputedStyle(document.documentElement);
    const enMillisecondes = (brut: string, defaut: number) => {
      const texte = brut.trim();
      const nombre = Number.parseFloat(texte);
      if (!Number.isFinite(nombre)) return defaut;
      return /ms$/i.test(texte) ? nombre : nombre * 1000;
    };
    const duree = enMillisecondes(racine.getPropertyValue('--duree-moyenne'), 200);
    const courbe = racine.getPropertyValue('--courbe-entree').trim() || 'ease-out';

    for (const el of document.querySelectorAll<HTMLElement>('[data-tache]')) {
      const vieux = avant.get(el.dataset.tache!);
      if (!vieux) continue;
      const neuf = el.getBoundingClientRect();
      const dx = vieux.left - neuf.left;
      const dy = vieux.top - neuf.top;
      /* Moins d'un pixel : rien n'a bougé, et une animation nulle coûterait
         une couche de composition pour rien. */
      if (Math.abs(dx) < 1 && Math.abs(dy) < 1) continue;
      el.animate?.(
        [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
        { duration: duree, easing: courbe },
      );
    }
  }

  auDeverrouillage(
    async () => {
      actifs = await domainesActifs();
      aujourdhui = jourLogique(new Date(), await reglagesJourLogiqueLocaux());

      const select = $('domaine') as HTMLSelectElement;
      for (const d of DOMAINES) {
        if (!actifs.includes(d.id)) continue;
        const option = document.createElement('option');
        option.value = d.id;
        option.textContent = d.libelle;
        select.appendChild(option);
      }

      $('ajout').addEventListener('submit', (evenement) => {
        evenement.preventDefault();
        const titre = ($('titre') as HTMLInputElement).value.trim();
        if (!titre) return;
        const echeance = ($('echeance') as HTMLInputElement).value || null;
        const serie = serieNeuve?.lire() ?? null;
        /*
           Un envoi, une écriture — M6. `ajouterTache` frappe un identifiant
           neuf à chaque appel : deux envois rapprochés créaient deux tâches
           jumelles. Le champ vidé après coup n'y pouvait rien, puisqu'il
           n'est vidé qu'une fois l'écriture finie. Le formulaire sert de
           clé, et son bouton d'envoi est désactivé le temps de l'écriture.
        */
        const formulaire = evenement.currentTarget as Element;
        /*
           Une tâche répétée NE PORTE PAS d'échéance : `controlerTache()` les
           refuse ensemble. L'échéance saisie sert ici d'ancre à la série —
           c'est elle qui porte le quantième d'une règle mensuelle — puis elle
           s'efface, parce que ce sont les occurrences qui en tiennent lieu.
        */
        void unSeulGeste(formulaire, () =>
          agirPuisPeindre(async () => {
          const vise = choixDuLien.value
            ? ACTIONS_LIABLES.find((a) => a.id === choixDuLien.value)
            : null;
          await ajouterTache({
            titre,
            domaine: select.value,
            echeance: serie ? null : echeance,
            serie,
            /*
               La branche vient du registre, jamais du champ : c'est lui qui
               sait à quelle branche une action appartient, et deux sources
               auraient fini par se contredire.
            */
            lien: vise
              ? {
                  branche: vise.branche,
                  action: vise.id,
                  /*
                     L'identifiant du traitement, jamais son nom : la tâche
                     vit en clair, et y recopier « Créatine » annulerait le
                     scellement de Santé pour cette ligne.
                  */
                  cible: vise.id === 'odyssee.medicament' ? choixDeLaCible.value || null : null,
                }
              : null,
          });
          ($('titre') as HTMLInputElement).value = '';
          ($('echeance') as HTMLInputElement).value = '';
          choixDuLien.value = '';
          ligneCible.classList.add('hidden');
          $('lien-sans-repetition').classList.add('hidden');
          /* Les champs repartent à neuf : laisser la règle en place ferait
             répéter la tâche suivante sans que personne l'ait demandé. */
          monterLesChampsDeSerie();
          ($('repeter') as HTMLDetailsElement).open = false;
          $('erreur-ajout').classList.add('hidden');
          /*
             Venu du calendrier, on y retourne — sur le jour d'origine.
             Après l'écriture, jamais avant : partir d'abord laisserait
             croire la tâche créée si l'écriture avait échoué.
          */
          if (retour) location.assign(retour);
          }),
        );
      });

      /*
         ARRIVÉE DEPUIS LE CALENDRIER — prompt 39, C3.

         Le calendrier n'ouvre pas un second formulaire de création : il
         emmène ici, avec le jour choisi et la série déjà dépliée. Trois
         paramètres, et chacun est vérifié avant d'être cru.

         `retour` surtout : c'est une adresse qui vient de la barre du
         navigateur, donc de n'importe où. On n'accepte qu'un chemin
         **interne** — il commence par « / » et pas par « // », qui
         désignerait un autre site. Sans ce contrôle, un lien forgé
         renverrait ailleurs après l'enregistrement, et l'écran aurait
         l'air d'y envoyer de lui-même.
      */
      const parametres = new URLSearchParams(location.search);
      const jourDemande = parametres.get('jour');
      const retourDemande = parametres.get('retour');
      const retour =
        retourDemande && retourDemande.startsWith('/') && !retourDemande.startsWith('//')
          ? retourDemande
          : null;

      /*
         LES GESTES QU'UNE TÂCHE PEUT VISER — A-16.

         Le registre fait foi, et l'écran ne choisit pas : proposer ici une
         liste écrite à la main aurait divergé du registre au premier ajout,
         et une tâche aurait visé une action qu'aucun écrivain ne sert.

         Les actions « hors-du-lot » ne sont pas proposées : elles ne
         produisent ni écriture ni cochage, et les offrir promettrait une
         liaison qui n'arriverait jamais.
      */
      const choixDuLien = $('lien') as HTMLSelectElement;
      const aucun = document.createElement('option');
      aucun.value = '';
      aucun.textContent = 'Aucune branche';
      choixDuLien.appendChild(aucun);
      for (const action of ACTIONS_LIABLES) {
        if (action.sens === 'hors-du-lot') continue;
        const option = document.createElement('option');
        option.value = action.id;
        option.textContent = action.libelle;
        option.title = action.pourquoi;
        choixDuLien.appendChild(option);
      }

      /*
         LA CIBLE DU LIEN — P5 du prompt 52.

         Seule l'action de Santé en demande une aujourd'hui, et la liste
         vient d'un magasin SCELLÉ. Deux conséquences dites à l'écran plutôt
         que subies :

         - coffre fermé, la liste est vide et la phrase explique pourquoi.
           Proposer un menu vide sans raison ferait croire qu'il n'y a aucun
           traitement, ce qui est exactement l'inverse de ce que le coffre
           protège ;
         - ce qui est rangé dans la tâche est l'IDENTIFIANT du traitement,
           jamais son nom. La tâche vit en clair : y écrire « Créatine »
           annulerait le scellement de Santé pour cette ligne-là. La
           conséquence assumée est qu'un œil sans la clé voit qu'une tâche
           vise un traitement — ce que l'action du lien disait déjà — mais
           pas lequel.
      */
      const ligneCible = $('ligne-cible');
      const choixDeLaCible = $('cible') as HTMLSelectElement;
      const montrerLaCible = async () => {
        const vise = ACTIONS_LIABLES.find((a) => a.id === choixDuLien.value);
        const enDemande = vise?.id === 'odyssee.medicament';
        ligneCible.classList.toggle('hidden', !enDemande);
        if (!enDemande) return;

        choixDeLaCible.innerHTML = '';
        if (!coffreOuvert()) {
          $('cible-fermee').textContent =
            'Vos traitements sont chiffrés : ouvrez le coffre depuis l’espace Santé pour ' +
            'en choisir un.';
          return;
        }
        const { tousLesTraitements } = await import('../../lib/odyssee/donnees-sante');
        const traitements = (await tousLesTraitements()).filter((t) => !t.sporadique);
        $('cible-fermee').textContent = traitements.length
          ? ''
          : 'Aucun traitement déclaré : l’espace Santé en attend un avant de pouvoir le relier.';
        for (const t of traitements) {
          const option = document.createElement('option');
          option.value = t.id;
          option.textContent = t.nom;
          choixDeLaCible.appendChild(option);
        }
      };
      /*
         Et l'avertissement, qui vaut pour toutes les branches qui écrivent :
         sans répétition, pointer la tâche ne la fait que se clore.
      */
      const montrerLAvertissement = () => {
        const vise = ACTIONS_LIABLES.find((a) => a.id === choixDuLien.value);
        const ecrit = Boolean(vise && ecritDansLaBranche(vise.id));
        const repete = ($('repeter') as HTMLDetailsElement).open;
        const zone = $('lien-sans-repetition');
        zone.classList.toggle('hidden', !ecrit || repete);
        if (ecrit && !repete) {
          zone.textContent =
            `« ${vise?.libelle} » s’enregistre au pointage d’une occurrence, donc sur une tâche ` +
            'répétée. Sans répétition, cocher cette tâche la clôt seulement, et rien n’est ' +
            'enregistré dans sa branche.';
        }
      };
      choixDuLien.addEventListener('change', () => {
        montrerLAvertissement();
        void montrerLaCible().catch(() => {});
      });
      $('repeter').addEventListener('toggle', montrerLAvertissement);

      monterLesChampsDeSerie();

      if (jourDemande && /^\d{4}-\d{2}-\d{2}$/.test(jourDemande)) {
        ($('echeance') as HTMLInputElement).value = jourDemande;
      }
      if (parametres.get('serie') === '1') {
        ($('repeter') as HTMLDetailsElement).open = true;
        /* Remonté APRÈS l'échéance : c'est elle qui ancre la règle. */
        monterLesChampsDeSerie();
      }

      /* L'échéance est l'ancre de la règle : la changer change le libellé
         d'une série mensuelle ou annuelle, et l'aperçu doit le dire. */
      for (const evenement of ['change', 'input']) {
        $('echeance').addEventListener(evenement, () => {
          const serie = serieNeuve?.lire();
          if (serie) monterLesChampsDeSerie(serie);
        });
      }

      await peindre();
    },
    { zoneChargement: '#chargement-taches' },
  );
</script>
