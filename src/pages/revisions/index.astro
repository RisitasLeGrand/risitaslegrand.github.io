---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import LienReglages from '../../components/LienReglages.astro';
import Section from '../../components/Section.astro';
---

<Base titre="Tableau de bord" actif="accueil">
  {/*
     Le titre de l'écran, lu et non vu (D-037).

     C'était le seul des cinquante-deux écrans sans « h1 » : la page d'accueil
     s'ouvre sur ses quatre tuiles, et rien ne nommait l'écran. Pour qui voit
     la page, le nom est déjà partout — l'onglet actif, le titre de l'onglet
     du navigateur, le fil de la barre. Pour qui l'écoute, il manquait, et la
     structure du document commençait à « h2 ».

     « sr-only » plutôt qu'un titre visible : la demande était de rendre
     l'écran conforme, pas de changer l'allure de celui qu'on regarde le plus
     souvent.
  */}
  <h1 class="sr-only">Tableau de bord</h1>
  <LienReglages section="revisions" class="mt-2" />

  <div id="chargement" class="py-20 text-center text-slate-400">Déchiffrement du contenu…</div>

  <div id="tableau" class="hidden space-y-6">
    {/*
       Le compte à rebours vers les épreuves (décision 3 du prompt 56).

       En tête, parce que c'est la seule ligne de cet écran qui ne dépend pas
       de ce qu'on a fait aujourd'hui : elle situe tout le reste.

       Aucune couleur, aucun « plus que », rien qui vire au rouge quand la date
       approche — l'interdit 3 du prompt le proscrit, et la façon la plus sûre
       de s'y tenir est de n'avoir aucun endroit où poser une couleur. Le bloc
       reste « hidden » tant que le script n'a rien à y mettre : coffre fermé,
       réglage coupé, ou aucune date connue d'un parcours.
    */}
    <section id="bloc-rebours" class="hidden" aria-labelledby="titre-rebours">
      <h2 id="titre-rebours" class="sr-only">Vos épreuves</h2>
      <div
        id="rebours"
        class="rounded-xl border border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-900"
      >
      </div>
    </section>

    <!-- Bandeau niveau / XP / série -->
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div id="carte-niveau" class="rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 p-5 text-white shadow-sm">
        <p class="etiquette opacity-80">Niveau</p>
        <p class="mt-1 flex items-baseline gap-2">
          <span id="niveau" class="text-3xl font-bold">—</span>
          <span id="xp-total" class="text-sm opacity-80"></span>
        </p>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/25">
          <div id="barre-niveau" class="h-full rounded-full bg-white jauge-remplissage" style="transform:scaleX(0)"></div>
        </div>
        <p id="xp-restant" class="mt-2 text-xs opacity-80"></p>
      </div>

      <div id="carte-streak" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="etiquette text-slate-500 dark:text-slate-400">Série en cours</p>
        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-white">
          <span id="streak">—</span> <Icone nom="serie" taille={22} />
        </p>
        <p id="streak-detail" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>
        <!--
          LA RÈGLE EST ÉCRITE, ET ELLE EST ÉCRITE ICI.

          Le jour de grâce ne vaut que si on le connaît AVANT d'oublier un
          jour : une règle qu'on découvre le lendemain de l'oubli a déjà
          laissé passer l'angoisse qu'elle existait pour éviter. Elle est
          donc sous le compteur, en permanence, et non dans un message qui
          ne paraîtrait qu'une fois la grâce consommée.

          Phrase fixe, sans état : dire « il vous reste un jour de grâce »
          remettrait un compte à rebours là où le lot vient d'en retirer deux.
        -->
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Un jour oublié par semaine ne casse pas la série.
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <!--
          « À revoir », et non « à réviser » : ce compteur ne montre que les
          cartes déjà apprises dont l'échéance est atteinte. Il comptait aussi
          les cartes inédites, ce qui affichait les milliers de cartes du site
          comme un retard du jour — un nombre que personne ne peut tenir, et
          qui ne descend jamais. Les cartes neuves s'apprennent au rythme
          qu'on choisit, depuis la session elle-même.
        -->
        <p class="etiquette text-slate-500 dark:text-slate-400">À revoir aujourd'hui</p>
        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-white" id="dues">—</p>
        <a id="lien-reviser" href="#" class="cible-tactile mt-2 text-xs font-medium text-indigo-600 hover:underline dark:text-indigo-400">
          Lancer la session →
        </a>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="etiquette text-slate-500 dark:text-slate-400">Maîtrise globale</p>
        <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-white" id="maitrise">—</p>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
          <div id="barre-maitrise" class="h-full rounded-full bg-emerald-500 jauge-remplissage" style="transform:scaleX(0)"></div>
        </div>
        <p id="temps-semaine" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>
      </div>
    </section>

    <!-- Journal d'erreurs : une ligne, et seulement quand il y a quelque chose
         à reprendre. Le compteur est un signal, pas un reproche permanent. -->
    <section
      id="bloc-journal-accueil"
      class="hidden rounded-xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-950/30"
    >
      <p class="text-sm text-slate-700 dark:text-slate-200">
        <span id="journal-compte" class="font-semibold"></span>
        <span class="text-slate-500 dark:text-slate-400">
          — servies d'office au début de la prochaine séance de leur matière.
        </span>
        <a
          id="lien-journal"
          href="#"
          class="ml-1 font-medium text-amber-800 hover:underline dark:text-amber-300"
        >Voir le journal →</a>
      </p>
    </section>

    <!--
      Prétest de la fiche du jour. Sa place est ici : c'est le moment où l'on
      décide de se mettre au travail, donc juste avant la première lecture — et
      l'effet de prétest n'existe qu'à cet instant-là.
    -->
    <section
      id="bloc-pretest"
      class="hidden rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-900 dark:bg-indigo-950/30"
    >
      <p class="etiquette text-indigo-700 dark:text-indigo-300">Avant de lire</p>
      <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">
        <span id="pretest-titre" class="font-semibold"></span>
        <span class="text-slate-500 dark:text-slate-400">
          — quelques questions avant d'ouvrir la fiche. Se tromper est normal, et c'est même ce qui
          rend la lecture plus efficace : rien n'est compté comme une erreur.
        </span>
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button
          id="pretest-lancer"
          class="min-h-11 rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >
          Commencer le prétest
        </button>
        <a
          id="pretest-fiche"
          href="#"
          class="inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-4 text-sm font-medium transition hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800"
        >Ouvrir la fiche directement</a>
      </div>
      <div id="pretest-hote" class="mt-4 hidden"></div>
    </section>

    <!--
      Entrée vers le positionnement. Toujours visible, et c'est voulu : le bloc
      « zone de travail » ci-dessous reste muet tant qu'aucun fascicule n'a
      assez d'observations — c'est-à-dire précisément quand on a le plus besoin
      de savoir par où commencer.
    -->
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Vous ne savez pas par quel cours commencer dans un fascicule ?{' '}
      <a
        id="lien-positionnement"
        href="#"
        class="font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >Passez un prétest de positionnement →</a>
    </p>

    <!-- Zone de travail : un repère lisible plutôt qu'un chiffre isolé. -->
    <section
      id="bloc-zone"
      class="hidden rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-900 dark:bg-indigo-950/30"
    >
      <p class="text-sm text-slate-700 dark:text-slate-200">
        <span class="font-semibold">Zone de travail actuelle :</span>
        <span id="zone-libelle"></span>
        <a
          id="lien-niveaux"
          href="#"
          class="ml-1 font-medium text-indigo-700 hover:underline dark:text-indigo-300"
        >Voir les niveaux →</a>
        <a
          id="lien-situer"
          href="#"
          class="ml-1 font-medium text-indigo-700 hover:underline dark:text-indigo-300"
        >Situer les cours →</a>
      </p>
    </section>

    <!-- Séance du jour : proposée automatiquement par la rotation.
         C'est la <section> qui porte « hidden », et non le lien : un <a> dont
         on retire « hidden » repasserait en « display: inline », et la carte
         perdrait son fond, sa bordure et ses marges intérieures. -->
    <section id="bloc-seance" class="hidden">
      <a
        id="carte-seance"
        href="planification/"
        class="block rounded-xl border border-indigo-200 bg-indigo-50 p-5 transition hover:border-indigo-400 dark:border-indigo-800 dark:bg-indigo-950/40 dark:hover:border-indigo-600"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p id="seance-etiquette" class="etiquette text-indigo-600 dark:text-indigo-400"></p>
            <p id="seance-titre" class="mt-1 text-lg font-bold text-slate-900 dark:text-white"></p>
            <p id="seance-detail" class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p>
          </div>
          <span
            id="seance-badge"
            class="hidden shrink-0 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 uppercase dark:bg-amber-950 dark:text-amber-300"
          >
            Révision du mois
          </span>
        </div>
      </a>
    </section>

    <!--
      ICI SE TROUVAIENT LES DEUX BANDEAUX DE PRESSION, ET ILS NE REVIENNENT PAS.

      « Votre série de N jours s'arrête ce soir si vous ne révisez pas »,
      précédé d'un sablier, et
      « La série s'est interrompue » : l'un pressait, l'autre reprochait, et
      aucun des deux n'apprenait quoi que ce soit. Une journée sans révision
      est une journée sans révision ; le compteur la dit déjà, et il la dit
      sans menace ni regret.

      Le point F du 43 les retire tous les deux. La place reste vide : rien ne
      la remplace, parce que rien n'avait à y être.
    -->

    <!-- Écoutes en cours (prompt 46, P3) : masqué tant qu'il n'y en a aucune,
         plutôt qu'une section vide qui occuperait l'écran pour rien. -->
    <section id="bloc-ecoutes" class="hidden">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Écoutes en cours</h2>
      </div>
      <div id="ecoutes" class="grid gap-3 sm:grid-cols-2"></div>
    </section>

    <!-- Progression par matière -->
    <Section
      titre="Progression par matière"
      lienLibelle="Voir tout"
      lienHref="bibliotheque/"
      lienId="lien-biblio"
      grilleId="matieres"
      grille="grid gap-4 sm:grid-cols-2"
    />

    <!-- Actualités : données non chiffrées, chargées à la volée depuis
         « actualites-data/ » sur la branche publiée (voir src/lib/actualites.ts). -->
    <section id="bloc-actualites" class="hidden">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Actualités</h2>
        <a
          id="lien-actualites"
          href="actualites/"
          class="inline-flex min-h-11 items-center text-sm font-medium text-indigo-600 underline-offset-4 hover:underline dark:text-indigo-400"
        >
          Voir les actualités passées <span aria-hidden="true">→</span>
        </a>
      </div>

      <div id="fiches-actu" class="grid gap-4 md:grid-cols-2"></div>

      <div id="semaine-actu" class="mt-6">
        <h3
          id="titre-semaine-actu"
          class="etiquette mb-3 text-slate-500 dark:text-slate-400"
        >
        </h3>
        <div id="items-semaine-actu" class="grid gap-4 md:grid-cols-2"></div>
      </div>
    </section>

    <!-- Horizon pluriannuel : la série de jours dit la semaine en cours, pas
         la profondeur d'un programme qui s'étale sur plusieurs années. -->
    <Section titre="Programme pluriannuel" grille="">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="etiquette text-indigo-600 dark:text-indigo-400">Depuis le début</p>
        <p id="horizon-duree" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">—</p>
        <p id="horizon-debut" class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>

        <div id="horizon-jalon" class="mt-4 hidden">
          <div class="flex flex-wrap items-baseline justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span id="horizon-jalon-libelle"></span>
            <span id="horizon-jalon-restant"></span>
          </div>
          <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
            <div id="horizon-jalon-barre" class="h-full rounded-full bg-indigo-600 jauge-remplissage" style="transform:scaleX(0)"></div>
          </div>
        </div>

        <dl id="horizon-chiffres" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4"></dl>

        <div id="horizon-annees" class="mt-5 space-y-2"></div>
      </div>
    </Section>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Activité des 8 dernières semaines -->
      <Section titre="Régularité" grille="">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div id="calendrier" class="flex gap-1 overflow-x-auto"></div>
          <p id="legende-regularite" class="mt-3 text-xs text-slate-500 dark:text-slate-400">
            Huit dernières semaines — l'intensité de la couleur reflète l'XP gagné dans la journée.
          </p>
        </div>
      </Section>

      <!-- Badges -->
      <Section titre="Succès" grilleId="badges" grille="grid grid-cols-2 gap-2 sm:grid-cols-3" />
    </div>
  </div>

</Base>

<script>
  import { auDeverrouillage } from '../../lib/chargement';
  import { iconeDuGabarit } from '../../lib/icone-gabarit';
  import { construireVue } from '../../lib/agregats';
  import { lireProfil, lireReglagesSession, tousLesJours, jourISO, ajouterJours } from '../../lib/db';
  import { BADGES, calculerNiveau, statutStreak, vueLongTerme } from '../../lib/gamification';
  import { serieEtXpAffichees } from '../../lib/serie-xp';
  import { formaterDuree, lien, pluriel } from '../../lib/ui';
  import { chargerDerniereSemaine, chargerFiches } from '../../lib/actualites';
  import { carteFiche, carteItem, definirIndexTexte } from '../../lib/actualites-rendu';
  import { aplatirFiches, chargerIndexRecherche, chargerManifeste } from '../../lib/contenu';
  import { construireIndexTexte } from '../../lib/rattachement';
  import {
    estRepos,
    fichesDuTheme,
    historique,
    seanceDuJour,
    theme as themeParId,
  } from '../../lib/planification';
  import { chargerFiche, urlDeLaFiche } from '../../lib/contenu';
  import { aProposer, montrer as montrerPretest } from '../../lib/pretest';
  import { entreesOuvertes } from '../../lib/journal';
  import { zoneDeTravail } from '../../lib/niveau';

  const dateLongue = new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

  async function afficher() {
    const [vue, profil, streak, jours] = await Promise.all([
      construireVue(),
      lireProfil(),
      statutStreak(),
      tousLesJours(),
    ]);

    /*
       LES SCORES SONT AFFICHÉS, OU ILS NE LE SONT PAS (F2).

       La valeur est lue UNE FOIS, et les deux cartes sont retirées du
       document plutôt que vidées : une carte « Niveau — » sans chiffre
       garderait la place et l'idée, ce qui est exactement ce que
       l'interrupteur éteint.

       Le calcul, lui, continue : rien n'est perdu, et rallumer l'affichage
       rend un total juste et une série exacte.
    */
    const scores = serieEtXpAffichees();
    document.getElementById('carte-niveau')!.hidden = !scores;
    document.getElementById('carte-streak')!.hidden = !scores;
    /* La légende de la régularité nomme l'XP : elle dit autrement la même
       chose quand le chiffre n'est plus affiché. */
    document.getElementById('legende-regularite')!.textContent = scores
      ? "Huit dernières semaines — l'intensité de la couleur reflète l'XP gagné dans la journée."
      : 'Huit dernières semaines — plus la couleur est forte, plus la journée a été travaillée.';

    // --- Niveau et XP ---
    const niveau = calculerNiveau(profil.xp);
    document.getElementById('niveau')!.textContent = String(niveau.niveau);
    document.getElementById('xp-total')!.textContent = `${profil.xp} XP au total`;
    document.getElementById('barre-niveau')!.style.transform =
      `scaleX(${Math.round(niveau.progression * 100) / 100})`;
    document.getElementById('xp-restant')!.textContent =
      `${niveau.xpRequisNiveau - niveau.xpDansNiveau} XP avant le niveau ${niveau.niveau + 1}`;

    // --- Série ---
    document.getElementById('streak')!.textContent = String(streak.courante);
    document.getElementById('streak-detail')!.textContent = streak.record
      ? `Record : ${pluriel(streak.record, 'jour')}`
      : 'Révisez aujourd\'hui pour démarrer la série.';

    if (streak.etudieAujourdhui) {
      document.getElementById('carte-streak')!.classList.add('ring-2', 'ring-emerald-400');
    }

    // --- File du jour et maîtrise ---
    document.getElementById('dues')!.textContent = String(vue.cartesARevoir);

    // Zone de travail : le fascicule le plus bas parmi ceux qu'on connaît assez
    // pour l'affirmer. Rien ne s'affiche tant qu'aucun ne l'est.
    const zone = await zoneDeTravail();
    if (zone) {
      document.getElementById('zone-libelle')!.textContent = `${zone.matiere} — ${zone.libelle}`;
      document.getElementById('lien-niveaux')!.setAttribute('href', lien('/statistiques/'));
      document
        .getElementById('lien-situer')!
        .setAttribute(
          'href',
          `${lien('/positionnement/')}?matiere=${encodeURIComponent(zone.matiere)}` +
            `&fascicule=${encodeURIComponent(zone.libelle)}`,
        );
      document.getElementById('bloc-zone')!.classList.remove('hidden');
    }

    // Journal d'erreurs.
    const ouvertes = await entreesOuvertes();
    if (ouvertes.length) {
      document.getElementById('journal-compte')!.textContent = pluriel(
        ouvertes.length,
        'erreur à reprendre',
        'erreurs à reprendre',
      );
      document.getElementById('lien-journal')!.setAttribute('href', lien('/journal/'));
      document.getElementById('bloc-journal-accueil')!.classList.remove('hidden');
    }
    document.getElementById('lien-positionnement')!.setAttribute('href', lien('/positionnement/'));
    document.getElementById('lien-reviser')!.setAttribute('href', lien('/flashcards/'));
    document.getElementById('lien-biblio')!.setAttribute('href', lien('/bibliotheque/'));
    document.getElementById('maitrise')!.textContent = `${Math.round(vue.maitriseGlobale * 100)} %`;
    document.getElementById('barre-maitrise')!.style.transform =
      `scaleX(${Math.round(vue.maitriseGlobale * 100) / 100})`;

    const debutSemaine = ajouterJours(jourISO(), -6);
    const secondesSemaine = jours.filter((j) => j.jour >= debutSemaine).reduce((n, j) => n + j.secondes, 0);
    document.getElementById('temps-semaine')!.textContent =
      `${formaterDuree(secondesSemaine)} révisées ces 7 derniers jours`;

    // --- Matières ---
    const conteneur = document.getElementById('matieres')!;
    conteneur.innerHTML = '';
    for (const matiere of vue.matieres) {
      const pourcent = Math.round(matiere.maitrise * 100);
      // Étiquette de catégorie au-dessus du titre : elle dit où en est la
      // matière, ce qu'un pourcentage seul ne raconte pas d'un coup d'œil.
      const etat =
        pourcent === 0
          ? { libelle: 'À découvrir', classe: 'text-slate-500 dark:text-slate-400' }
          : pourcent >= 80
            ? { libelle: 'Consolidé', classe: 'text-emerald-700 dark:text-emerald-300' }
            : { libelle: 'En cours', classe: 'text-indigo-700 dark:text-indigo-300' };

      const carte = document.createElement('a');
      carte.href = `${lien('/bibliotheque/')}?matiere=${encodeURIComponent(matiere.nom)}`;
      carte.className =
        'block rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-300 hover:shadow dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-700';
      carte.innerHTML = `
        <div class="flex items-baseline justify-between gap-3">
          <p class="etiquette ${etat.classe}">${etat.libelle}</p>
          <span class="shrink-0 text-sm font-semibold text-slate-500 dark:text-slate-400">${pourcent} %</span>
        </div>
        <p class="mt-1.5 font-semibold text-slate-900 dark:text-white"></p>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
          <div class="h-full rounded-full bg-indigo-600 jauge-remplissage" style="transform:scaleX(${pourcent / 100})"></div>
        </div>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          ${matiere.fichesLues}/${matiere.fiches.length} ${matiere.fiches.length > 1 ? 'fiches lues' : 'fiche lue'}${matiere.cartesARevoir ? ` · ${pluriel(matiere.cartesARevoir, 'carte à revoir', 'cartes à revoir')}` : ''}
        </p>`;
      carte.querySelectorAll('p')[1]!.textContent = matiere.nom;
      conteneur.appendChild(carte);
    }
    if (!vue.matieres.length) {
      conteneur.innerHTML =
        '<p class="text-sm text-slate-500">Aucun contenu trouvé. Déposez vos fiches dans « content/ » puis relancez le build.</p>';
    }

    // --- Calendrier de régularité (8 semaines) ---
    const parJour = new Map(jours.map((j) => [j.jour, j]));
    const calendrier = document.getElementById('calendrier')!;
    calendrier.innerHTML = '';
    const aujourdhui = jourISO();
    for (let semaine = 7; semaine >= 0; semaine--) {
      const colonne = document.createElement('div');
      colonne.className = 'flex flex-col gap-1';
      for (let jour = 6; jour >= 0; jour--) {
        const date = ajouterJours(aujourdhui, -(semaine * 7 + jour));
        const xp = parJour.get(date)?.xp ?? 0;
        const intensite = xp === 0 ? 0 : xp < 20 ? 1 : xp < 60 ? 2 : xp < 120 ? 3 : 4;
        const couleurs = [
          'bg-slate-100 dark:bg-slate-800',
          'bg-emerald-200 dark:bg-emerald-900',
          'bg-emerald-300 dark:bg-emerald-700',
          'bg-emerald-500 dark:bg-emerald-600',
          'bg-emerald-600 dark:bg-emerald-400',
        ];
        const case_ = document.createElement('div');
        case_.className = `h-3.5 w-3.5 rounded-sm ${couleurs[intensite]}`;
        /* La grille reste : elle dit ce qu'on a travaillé, pas ce qu'on a
           marqué. Seul le chiffre d'XP sort de l'infobulle. */
        case_.title = scores ? `${date} — ${xp} XP` : `${date} — ${xp > 0 ? 'travaillé' : 'rien'}`;
        colonne.appendChild(case_);
      }
      calendrier.appendChild(colonne);
    }

    // --- Badges ---
    const obtenus = new Set(profil.badges);
    const zoneBadges = document.getElementById('badges')!;
    zoneBadges.innerHTML = '';
    for (const badge of BADGES) {
      const acquis = obtenus.has(badge.id);
      const element = document.createElement('div');
      element.className = acquis
        ? 'rounded-xl border border-amber-200 bg-amber-50 p-3 text-center dark:border-amber-800 dark:bg-amber-950/40'
        : 'rounded-xl border border-slate-200 bg-white p-3 text-center opacity-50 dark:border-slate-800 dark:bg-slate-900';
      element.title = badge.description;
      /*
         LE CADENAS RESTE UN ÉMOJI — ICI, ET NULLE PART AILLEURS.

         J'avais passé ce cadenas au catalogue, puisque « pas encore obtenu »
         est un état de l'interface et non du contenu. Le Pilote a tranché
         l'inverse, et il a raison sur ce qu'on voit : les badges déclarent
         leur pictogramme dans « gamification.ts », qui reste en émoji, et
         cette grille les montre tous ensemble. Un cadenas dessiné au trait
         parmi vingt-huit émojis colorés ne se lirait pas comme le même genre
         de case : il se lirait comme une erreur d'affichage.

         L'exemption est donc NOMMÉE pour cet endroit, et pour lui seul.
         Partout ailleurs — l'en-tête, le coffre, l'Odyssée — le cadenas est
         un SVG du catalogue.
      */
      element.innerHTML =
        `<div class="text-2xl">${acquis ? badge.icone : '🔒'}</div>` +
        `<p class="mt-1 text-xs font-medium text-slate-700 dark:text-slate-300"></p>`;
      element.querySelector('p')!.textContent = badge.nom;
      zoneBadges.appendChild(element);
    }

    // --- Horizon pluriannuel ---
    await afficherHorizon();

    // --- Séance du jour ---
    await afficherSeanceDuJour();

    // --- Compte à rebours vers les épreuves ---
    await afficherCompteARebours();

    document.getElementById('chargement')!.classList.add('hidden');
    document.getElementById('tableau')!.classList.remove('hidden');
  }

  /**
   * Rappel de la matière du jour, proposée par la rotation hebdomadaire.
   * Le détail de la séance vit sur la page « Planification » : on se contente
   * ici d'annoncer ce qui est prévu et d'y conduire.
   */
  /**
   * Situe la progression dans le programme pluriannuel : ancienneté, prochain
   * jalon de durée, assiduité et bilan par année de préparation.
   */
  async function afficherHorizon() {
    const horizon = await vueLongTerme();
    const $h = (id: string) => document.getElementById(id)!;

    if (!horizon.debut) {
      $h('horizon-duree').textContent = 'Le programme commence aujourd\'hui';
      $h('horizon-debut').textContent =
        'Dès la première séance, cette section suivra votre préparation année par année.';
      return;
    }

    const mois = horizon.moisDepuisDebut;
    const annees = Math.floor(mois / 12);
    $h('horizon-duree').textContent =
      annees >= 1
        ? `${pluriel(annees, 'an')} et ${pluriel(mois - annees * 12, 'mois', 'mois')} de révision`
        : mois >= 1
          ? `${pluriel(mois, 'mois', 'mois')} de révision`
          : `${pluriel(horizon.joursDepuisDebut, 'jour')} de révision`;
    $h('horizon-debut').textContent =
      `Première journée enregistrée le ${dateLongue.format(new Date(`${horizon.debut}T12:00:00`))}.`;

    const jalon = horizon.prochainJalon;
    if (jalon) {
      $h('horizon-jalon').classList.remove('hidden');
      $h('horizon-jalon-libelle').textContent = `Prochain jalon : ${jalon.libelle}`;
      $h('horizon-jalon-restant').textContent = `encore ${pluriel(jalon.restant, 'jour')}`;
      $h('horizon-jalon-barre').style.transform =
        `scaleX(${Math.round((horizon.joursDepuisDebut / jalon.jours) * 100) / 100})`;
    }

    const chiffres: [string, string][] = [
      ['Jours travaillés', String(horizon.joursEtudies)],
      ['Assiduité', `${Math.round(horizon.assiduite * 100)} %`],
      ['Temps cumulé', formaterDuree(horizon.secondesTotales)],
      ['Séances tenues', String(horizon.seancesTerminees)],
    ];
    const zone = $h('horizon-chiffres');
    zone.innerHTML = '';
    for (const [libelle, valeur] of chiffres) {
      const dt = document.createElement('dt');
      dt.className = 'etiquette text-slate-500 dark:text-slate-400';
      dt.textContent = libelle;
      const dd = document.createElement('dd');
      dd.className = 'mt-0.5 text-lg font-bold text-slate-900 dark:text-white';
      dd.textContent = valeur;
      const bloc = document.createElement('div');
      bloc.append(dt, dd);
      zone.appendChild(bloc);
    }

    // Années de préparation glissantes : elles partent de la première
    // journée enregistrée, pas du 1er janvier.
    const liste = $h('horizon-annees');
    liste.innerHTML = '';
    for (const annee of [...horizon.annees].reverse()) {
      const ligne = document.createElement('div');
      ligne.className = annee.enCours
        ? 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm dark:border-indigo-800 dark:bg-indigo-950/40'
        : 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800';
      const titre = document.createElement('span');
      titre.className = 'font-semibold text-slate-900 dark:text-white';
      titre.textContent = `Année ${annee.rang}${annee.enCours ? ' (en cours)' : ''}`;
      const detail = document.createElement('span');
      detail.className = 'text-xs text-slate-600 dark:text-slate-300';
      detail.textContent =
        `${pluriel(annee.joursEtudies, 'jour')} · ${formaterDuree(annee.secondes)} · ${pluriel(annee.seances, 'séance')}` +
        (serieEtXpAffichees() ? ` · ${annee.xp} XP` : '');
      ligne.append(titre, detail);
      liste.appendChild(ligne);
    }
  }

  async function afficherSeanceDuJour() {
    const seance = await seanceDuJour();
    const sujet = themeParId(seance.theme);
    if (!sujet) return;

    const passees = await historique(seance.theme);
    const terminee = seance.statut === 'terminee';
    const nombreRappels = seance.etendue ? Math.min(4, passees.length) : Math.min(2, passees.length);

    const repos = estRepos(seance.theme);
    document.getElementById('seance-etiquette')!.textContent = repos
      ? 'Aucune révision prévue'
      : terminee
        ? 'Séance du jour — terminée'
        : 'Séance du jour';
    document.getElementById('seance-titre')!.textContent = `${sujet.icone} ${sujet.nom}`;
    document.getElementById('seance-detail')!.textContent = repos
      ? "Journée de repos : rien n'est programmé, et votre série reste intacte."
      : terminee
      ? 'C\'est fait pour aujourd\'hui. Vous pouvez relire vos notes de séance.'
      : nombreRappels === 0
        ? 'Première séance sur cette matière : directement le contenu du jour, puis la note de séance.'
        : `Restitution à blanc ${
            nombreRappels === 1 ? 'de la séance précédente' : `des ${nombreRappels} séances précédentes`
          }, puis contenu du jour et note de séance.`;
    // Un <span> réaffiché redevient « inline » : on bascule explicitement vers
    // « inline-flex », sans quoi la pastille perdrait ses marges verticales.
    const badge = document.getElementById('seance-badge')!;
    badge.classList.toggle('hidden', !seance.etendue);
    badge.classList.toggle('inline-flex', seance.etendue);

    document.getElementById('carte-seance')!.setAttribute('href', lien('/planification/'));
    document.getElementById('bloc-seance')!.classList.remove('hidden');

    if (!terminee && !repos) await proposerPretest(seance.theme);
    if (!repos) void garderLesFichesDuJour(seance.theme);
  }

  /**
   * Le compte à rebours vers les épreuves (décision 3 du prompt 56).
   *
   * ## Ce que cette fonction ne fait pas
   *
   * Elle ne calcule rien : l'arithmétique des jours vit dans
   * `lib/compte-a-rebours.ts`, qui s'éprouve sans navigateur et franchit le
   * changement d'heure. Ici il ne reste que trois décisions d'écran — montrer,
   * inviter, ou se taire — et c'est tout ce que l'essai a à vérifier.
   *
   * ## Les trois raisons de se taire, et elles ne se confondent pas
   *
   * Le réglage coupé fait disparaître le bloc : c'est la promesse de l'entrée
   * « Compte à rebours vers mes épreuves » des paramètres, et un essai la tient.
   * Aucune date, ou des dates toutes passées, ne font pas disparaître le bloc :
   * elles changent ce qu'il dit, parce que proposer de donner ses dates est
   * précisément ce que l'entrée des paramètres annonce. Coffre fermé, enfin,
   * rien ne s'affiche — mais pas d'ici : tout `#tableau` attend le
   * déverrouillage, et le compte à rebours n'y fait pas exception.
   *
   * Les modules sont importés à la demande : un écran qui n'affiche pas le
   * compte à rebours n'a pas à télécharger le registre des parcours.
   */
  async function afficherCompteARebours() {
    const bloc = document.getElementById('bloc-rebours')!;
    const zone = document.getElementById('rebours')!;
    zone.replaceChildren();
    bloc.classList.add('hidden');

    if ((await lireReglagesSession()).compteARebours === false) return;

    const [{ echeances }, { PARCOURS }, { champ }] = await Promise.all([
      import('../../lib/compte-a-rebours'),
      import('../../lib/parcours/registre'),
      import('../../lib/profil'),
    ]);
    const etat = echeances(jourISO(), (await champ('datesEpreuves'))?.valeur, PARCOURS);

    if (etat.etat === 'lignes') {
      const liste = document.createElement('ul');
      liste.className = 'space-y-1 text-sm text-slate-700 dark:text-slate-300';
      for (const ligne of etat.lignes) {
        const item = document.createElement('li');
        /* `textContent` et non `innerHTML` : le libellé du parcours vient d'un
           registre, mais la date vient du journal, donc d'un autre appareil. */
        item.textContent = ligne.texte;
        liste.appendChild(item);
      }
      zone.appendChild(liste);
    } else {
      const phrase = document.createElement('p');
      phrase.className = 'text-sm text-slate-600 dark:text-slate-300';
      phrase.textContent =
        etat.etat === 'sans-date'
          ? 'Vous n’avez pas dit quand sont vos épreuves.'
          : 'Les dates d’épreuves que vous avez données sont passées.';
      const vers = document.createElement('a');
      vers.href = lien('/profil/');
      vers.className =
        'mt-1 inline-flex min-h-11 items-center text-sm font-medium text-indigo-600 ' +
        'underline-offset-4 hover:underline dark:text-indigo-400';
      vers.textContent = etat.etat === 'sans-date' ? 'Les renseigner' : 'Les mettre à jour';
      zone.append(phrase, vers);
    }

    bloc.classList.remove('hidden');
  }

  /**
   * Garder les fiches du jour pour une ouverture hors ligne (D-025).
   *
   * « Du jour » veut dire celles du thème que la rotation a posé aujourd'hui,
   * et douze au plus : le cache est un confort, pas une copie du site, et
   * garder une matière entière pour une séance d'une heure reviendrait à
   * télécharger ce qu'on ne lira pas.
   *
   * Lancé sans attendre, et sans jamais lever : c'est du confort, et un
   * confort qui retarderait l'affichage du tableau de bord serait une
   * mauvaise affaire.
   */
  async function garderLesFichesDuJour(themeId: string) {
    try {
      const [{ garderPourHorsLigne }, manifeste] = await Promise.all([
        import('../../lib/hors-ligne'),
        chargerManifeste(),
      ]);
      const duJour = fichesDuTheme(manifeste, themeId).slice(0, 12);
      const urls = await Promise.all(duJour.map((f) => urlDeLaFiche(f.id)));
      await garderPourHorsLigne(urls);
    } catch {
      /* Pas de worker, hors ligne, quota : la séance se fait quand même. */
    }
  }

  /**
   * Propose le prétest d'une fiche du jour, si l'une d'elles en a un qu'elle
   * n'a pas encore reçu.
   *
   * On ne déchiffre que les fiches dont le manifeste annonce un prétest, et on
   * s'arrête à la première candidate : ouvrir toute une matière pour savoir
   * laquelle proposer coûterait bien plus que ce que la proposition rapporte.
   */
  async function proposerPretest(themeId: string) {
    const manifeste = await chargerManifeste();
    const candidates = fichesDuTheme(manifeste, themeId).filter((f) => f.aPretest);
    for (const legere of candidates.slice(0, 8)) {
      const complete = await chargerFiche(legere.id).catch(() => null);
      if (!complete || !(await aProposer(complete))) continue;

      document.getElementById('pretest-titre')!.textContent = complete.titre;
      document
        .getElementById('pretest-fiche')!
        .setAttribute('href', `${lien('/fiche/')}?id=${encodeURIComponent(complete.id)}`);
      const bloc = document.getElementById('bloc-pretest')!;
      const hote = document.getElementById('pretest-hote')!;
      document.getElementById('pretest-lancer')!.addEventListener(
        'click',
        () => {
          void montrerPretest(complete, hote).then(() => {
            // Une fois le prétest passé, la fiche est la suite naturelle.
            location.href = `${lien('/fiche/')}?id=${encodeURIComponent(complete.id)}`;
          });
        },
        { once: true },
      );
      bloc.classList.remove('hidden');
      return;
    }
  }

  /**
   * Rubrique Actualités : chargée indépendamment du tableau de bord.
   * Les fichiers peuvent ne pas exister encore (avant le premier passage des
   * routines) : dans ce cas la section reste simplement masquée.
   */
  async function afficherActualites() {
    document.getElementById('lien-actualites')!.setAttribute('href', lien('/actualites/'));

    const [fiches, derniere, manifeste] = await Promise.all([
      chargerFiches(),
      chargerDerniereSemaine(),
      chargerManifeste(),
    ]);
    const semaine = derniere?.entree ?? null;
    if (!fiches.length && !semaine?.items?.length) return;

    // Les fiches de cours servent à rattacher chaque actualité au programme.
    const fichesCours = aplatirFiches(manifeste);

    const zoneFiches = document.getElementById('fiches-actu')!;
    for (const fiche of fiches) zoneFiches.appendChild(carteFiche(fiche, fichesCours));

    const blocSemaine = document.getElementById('semaine-actu')!;
    if (semaine?.items?.length) {
      const intitule = semaine.periode ?? derniere?.id ?? '';
      document.getElementById('titre-semaine-actu')!.textContent =
        `${derniere?.courante ? 'Cette semaine' : 'Dernière veille'} · ${intitule}`.trim();
      const zoneItems = document.getElementById('items-semaine-actu')!;
      for (const item of semaine.items.slice(0, 4)) zoneItems.appendChild(carteItem(item, fichesCours));
    } else {
      blocSemaine.classList.add('hidden');
    }

    document.getElementById('bloc-actualites')!.classList.remove('hidden');

    // Repêchage : si une actualité n'a trouvé aucune fiche par les titres et
    // les tags, on charge l'index de recherche (lourd) et on refait le rendu.
    await repecherRattachements(() => {
      const zone = document.getElementById('fiches-actu')!;
      zone.innerHTML = '';
      for (const fiche of fiches) zone.appendChild(carteFiche(fiche, fichesCours));
      const zoneItems = document.getElementById('items-semaine-actu');
      if (zoneItems && semaine?.items?.length) {
        zoneItems.innerHTML = '';
        for (const item of semaine.items.slice(0, 4)) zoneItems.appendChild(carteItem(item, fichesCours));
      }
    });
  }

  /** Charge l'index de recherche et redessine, si des cartes sont restées sans lien. */
  async function repecherRattachements(redessiner: () => void) {
    const orphelines = document.querySelectorAll('#bloc-actualites [data-rattachements="0"]').length;
    if (!orphelines) return;
    try {
      definirIndexTexte(construireIndexTexte(await chargerIndexRecherche()));
      redessiner();
    } catch (e) {
      console.warn('Index de recherche indisponible pour le rattachement :', e);
    }
  }

  // « auDeverrouillage » : barre de progression, garde-fou de 5 secondes et
  // exécution même si ce script arrive après l'ouverture de la session.
  /**
   * « Écoutes en cours » (prompt 46, P3).
   *
   * Une fiche audio commencée et pas finie, avec où l'on en est et ce qui
   * reste. Rien d'autre : une fiche écoutée jusqu'au bout n'a plus de
   * position, donc ne figure pas ici — la liste dit « ce qui est commencé »,
   * et non « ce que vous avez écouté ».
   *
   * Une position dont la fiche a disparu du manifeste est **ignorée en
   * silence**, et sa position laissée en place : le contenu peut avoir été
   * réorganisé, ou la fiche appartenir à un parcours qu'on ne sert pas
   * aujourd'hui. L'effacer serait perdre une reprise pour une absence
   * peut-être temporaire.
   */
  async function afficherEcoutes() {
    const { toutesLesPositionsPodcast } = await import('../../lib/db');
    const { horodatage, horodatageParle } = await import('../../lib/podcast');
    const positions = await toutesLesPositionsPodcast();
    if (!positions.length) return;

    const manifeste = await chargerManifeste();
    const parId = new Map(aplatirFiches(manifeste).map((f) => [f.id, f]));
    const grille = document.getElementById('ecoutes')!;
    grille.replaceChildren();

    let combien = 0;
    for (const position of positions) {
      const fiche = parId.get(position.fiche);
      if (!fiche) continue;
      combien += 1;

      const carte = document.createElement('a');
      carte.href = `${lien('/fiche/')}?id=${encodeURIComponent(fiche.id)}`;
      carte.className =
        'cible-tactile block rounded-xl border border-slate-200 bg-white p-4 shadow-sm ' +
        'transition hover:border-indigo-300 dark:border-slate-800 dark:bg-slate-900 ' +
        'dark:hover:border-indigo-700';

      const etiquette = document.createElement('p');
      etiquette.className =
        'etiquette flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400';
      etiquette.append(
        iconeDuGabarit('gabarit-ecoute'),
        document.createTextNode('Reprendre l’écoute'),
      );

      const titre = document.createElement('p');
      titre.className = 'mt-1 font-semibold text-slate-900 dark:text-white';
      titre.textContent = fiche.titre;

      const detail = document.createElement('p');
      detail.className = 'mt-1 text-sm text-slate-500 dark:text-slate-400';
      /*
         Le temps restant ne s'affiche que si la durée est connue : une
         position reprise de l'ancienne clé `localStorage` n'en portait pas,
         et annoncer « reste 0 min » serait faux.
      */
      const restant =
        position.duree && position.duree > position.secondes
          ? ` · reste ${formaterDuree(position.duree - position.secondes)}`
          : '';
      detail.textContent = `${fiche.matiere} · arrêté à ${horodatage(position.secondes)}${restant}`;

      /*
         M9 — le nom accessible, en une phrase.

         Sans lui, le nom se compose par concaténation : « Reprendre
         l'écoute La hiérarchie des normes Droit public · arrêté à 1:09 ·
         reste 6 min » — l'heure lue « un deux-points zéro neuf », et aucune
         ponctuation pour séparer. On dit donc la même chose en français, et
         le visible garde sa forme brève. Le casque, lui, est devenu un SVG
         muet : il n'entre plus dans le nom, où il se lisait « casque audio ».
      */
      carte.setAttribute(
        'aria-label',
        `Reprendre l’écoute de « ${fiche.titre} », arrêté à ${horodatageParle(position.secondes)}`,
      );
      carte.append(etiquette, titre, detail);
      grille.appendChild(carte);
    }

    if (combien) document.getElementById('bloc-ecoutes')!.classList.remove('hidden');
  }

  auDeverrouillage(async () => {
    /*
       Les questions de la branche sont posées **à la première entrée**, et pas
       à l'initialisation : demander les matières fortes avant d'avoir montré à
       quoi elles servent, c'est demander à quelqu'un de se noter sur un
       programme qu'il n'a pas vu. La marque est journalisée, donc le téléphone
       ne redemandera pas.
    */
    const { porteLocale } = await import('../../lib/initialisation');
    const porte = await porteLocale('revisions');
    if (porte.quoi !== 'entrer') {
      const { base } = await import('../../lib/ui');
      window.location.replace(
        porte.quoi === 'module'
          ? `${base}/initialisation/?branche=revisions`
          : `${base}/initialisation/`,
      );
      return;
    }

    await afficher();
    // Un échec de la veille ne doit jamais empêcher l'affichage du tableau de bord.
    afficherActualites().catch((e) => console.warn('Actualités indisponibles :', e));
    afficherEcoutes().catch((e) => console.warn('Écoutes en cours indisponibles :', e));
  });
</script>
