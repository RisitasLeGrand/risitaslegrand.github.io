---
/**
 * Gabarit commun : en-tête, navigation, écran de connexion, thème.
 * Le contenu de la page n'est rendu qu'une fois la session déverrouillée.
 */
import '../styles/global.css';
import Verrou from '../components/Verrou.astro';
import config from '../../site.config.mjs';

interface Props {
  titre: string;
  /** Identifiant de l'onglet de navigation actif. */
  actif?: string;
  /** Masque la navigation principale (page plein écran). */
  sansNavigation?: boolean;
}

const { titre, actif, sansNavigation = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// « libelle » est le nom complet (lecteurs d'écran, info-bulle) ; « court »
// est la version affichée à côté de l'icône sur les grands écrans.
const onglets = [
  { id: 'accueil', libelle: 'Tableau de bord', court: 'Accueil', href: `${base}/`, icone: '🏠' },
  { id: 'bibliotheque', libelle: 'Bibliothèque', court: 'Cours', href: `${base}/bibliotheque/`, icone: '📚' },
  { id: 'flashcards', libelle: 'Flashcards', court: 'Cartes', href: `${base}/flashcards/`, icone: '🃏' },
  { id: 'quiz', libelle: 'Quiz', court: 'Quiz', href: `${base}/quiz/`, icone: '🎯' },
  { id: 'recherche', libelle: 'Recherche', court: 'Recherche', href: `${base}/recherche/`, icone: '🔎' },
  { id: 'statistiques', libelle: 'Statistiques', court: 'Stats', href: `${base}/statistiques/`, icone: '📈' },
  { id: 'glossaire', libelle: 'Glossaire', court: 'Glossaire', href: `${base}/glossaire/`, icone: '📖' },
  { id: 'progression', libelle: 'Sauvegarde et synchronisation', court: 'Sauvegarde', href: `${base}/progression/`, icone: '💾' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Non-indexation : aucun moteur ne doit référencer ce site. -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <title>{titre} · {config.titre}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Applique le thème avant le premier rendu pour éviter tout clignotement.
      (function () {
        try {
          var choix = localStorage.getItem('revinsp.theme');
          var sombre =
            choix === 'sombre' ||
            (!choix && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', sombre ? 'sombre' : 'clair');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'clair');
        }
      })();
    </script>
  </head>

  <body>
    <Verrou />

    <div id="application" class="hidden min-h-screen">
      {
        !sansNavigation && (
          <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
            <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
              <a
                href={`${base}/`}
                class="flex shrink-0 items-center gap-2 font-semibold text-slate-900 dark:text-white"
              >
                <span class="text-lg">🎓</span>
                <span class="hidden sm:inline">{config.titre}</span>
              </a>

              <nav
                aria-label="Navigation principale"
                class="defilement-fin -mx-1 flex flex-1 gap-1 overflow-x-auto px-1"
              >
                {onglets.map((onglet) => (
                  <a
                    href={onglet.href}
                    title={onglet.libelle}
                    aria-current={actif === onglet.id ? 'page' : undefined}
                    class:list={[
                      'flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition',
                      actif === onglet.id
                        ? 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
                        : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
                    ]}
                  >
                    <span aria-hidden="true">{onglet.icone}</span>
                    <span class="hidden lg:inline">{onglet.court}</span>
                    <span class="sr-only">{onglet.libelle}</span>
                  </a>
                ))}
              </nav>

              <div class="flex shrink-0 items-center gap-1">
                <button
                  id="bouton-theme"
                  type="button"
                  title="Changer de thème"
                  aria-label="Changer de thème"
                  class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
                >
                  <span aria-hidden="true">🌓</span>
                </button>
                <button
                  id="bouton-verrouiller"
                  type="button"
                  title="Verrouiller la session"
                  aria-label="Verrouiller la session"
                  class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
                >
                  <span aria-hidden="true">🔒</span>
                </button>
              </div>
            </div>
          </header>
        )
      }

      <main class="mx-auto max-w-6xl px-4 py-6 pb-16">
        <slot />
      </main>
    </div>

    <script>
      import { verrouiller } from '../lib/auth';
      import { initGlossaireGlobal } from '../lib/glossaire';
      import { suivreTemps } from '../lib/temps';

      initGlossaireGlobal();

      document.getElementById('bouton-theme')?.addEventListener('click', () => {
        const actuel = document.documentElement.getAttribute('data-theme');
        const suivant = actuel === 'sombre' ? 'clair' : 'sombre';
        document.documentElement.setAttribute('data-theme', suivant);
        try {
          localStorage.setItem('revinsp.theme', suivant);
        } catch {
          /* navigation privée */
        }
      });

      document.getElementById('bouton-verrouiller')?.addEventListener('click', () => {
        verrouiller();
        document.dispatchEvent(new CustomEvent('revinsp:verrouille'));
        location.reload();
      });

      // Le temps n'est comptabilisé qu'une fois la session ouverte.
      document.addEventListener('revinsp:deverrouille', () => suivreTemps(), { once: true });
    </script>
  </body>
</html>
