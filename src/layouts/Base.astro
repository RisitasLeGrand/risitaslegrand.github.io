---
/**
 * Gabarit commun : en-tête, navigation, écran de connexion, thème.
 * Le contenu de la page n'est rendu qu'une fois la session déverrouillée.
 */
import '../styles/global.css';
import Verrou from '../components/Verrou.astro';
import CentreNotifications from '../components/CentreNotifications.astro';
import CommutateurTheme from '../components/CommutateurTheme.astro';
import BarreProgression from '../components/BarreProgression.astro';
import PiedDePage from '../components/PiedDePage.astro';
import SelecteurParcours from '../components/SelecteurParcours.astro';
import config from '../../site.config.mjs';
import TemoinCoffre from '../components/TemoinCoffre.astro';
import {
  branchesDisponibles,
  brancheDuChemin,
  brancheDUnOnglet,
  entreesDeLaBarre,
  nomCourt,
  ongletsPrincipaux,
  ECRANS_COMMUNS,
  ID_BRANCHE_PAR_DEFAUT,
  type EntreeDeBarre,
} from '../lib/branches';

interface Props {
  titre: string;
  /** Identifiant de l'onglet de navigation actif. */
  actif?: string;
  /** Masque la navigation principale (page plein écran). */
  sansNavigation?: boolean;
  /**
   * L'en-tête voulu.
   *
   * `complet` : le ruban d'onglets de la branche. `leger` : le titre, le thème
   * et le verrou, sans navigation de branche — c'est ce qu'il faut au **menu**,
   * qui est au-dessus des branches et n'a donc pas d'onglets à montrer, mais
   * qui doit pouvoir changer de thème et verrouiller la session. `aucun` : rien,
   * pour une page plein écran.
   */
  entete?: 'complet' | 'leger' | 'aucun';
  /**
   * La page rend du contenu du coffre une fois celui-ci ouvert.
   *
   * Seule conséquence à ce jour : **aucune transition entre documents**. Une
   * transition capture la page sortante pour la rejouer par-dessus la page
   * entrante ; sur un écran déverrouillé, cette capture contient des données
   * chiffrées rendues en clair, ce que l'interdit n° 2 du prompt 34 exclut.
   *
   * Comme une transition exige que les **deux** pages y consentent, ne pas
   * émettre la règle ici suffit à l'empêcher dans les deux sens, en partant
   * comme en arrivant.
   *
   * « npm run essais:coffre-transitions » vérifie que toute page portant le
   * formulaire de déverrouillage le déclare, et qu'aucune ne le déclare sans
   * en porter un. Une liste tenue à la main rouillerait en silence : la page
   * oubliée fonctionnerait, elle fuirait seulement.
   */
  coffre?: boolean;
}

const { titre, actif, sansNavigation = false, entete, coffre = false } = Astro.props;

/*
   La feuille des transitions entre pages, passée telle quelle par `set:html`.

   Pourquoi pas un `<style>` ordinaire : le 14 octobre, écrite en littéral
   JSX dans le gabarit, elle est arrivée dans la page avec son accolade et son
   accent grave — « {`@view-transition … » — donc invalide dès le premier
   caractère. La feuille entière était rejetée par le moteur, et les essais de
   coffre passaient au vert parce qu'**aucune** transition n'avait lieu, nulle
   part. Un contrôle vert parce qu'il ne voit rien.

   `set:html` pose le texte sans que rien ne le réinterprète, et `is:inline`
   le soustrait au pipeline CSS d'Astro, qui n'a pas à connaître une règle
   qu'il pourrait écarter.
*/
const CSS_TRANSITIONS = `@view-transition { navigation: auto }

/* Sobre (décision 2) : un fondu seul, aux durées du socle A6, sans glissement
   ni rebond. Le mouvement réduit est déjà couvert par le socle, qui ramène
   ces durées à 0,01 ms. */
::view-transition-old(root) {
  animation-duration: var(--duree-courte, 120ms);
  animation-timing-function: var(--courbe-sortie, ease-in);
}
::view-transition-new(root) {
  animation-duration: var(--duree-moyenne, 200ms);
  animation-timing-function: var(--courbe-entree, ease-out);
}

/* --- Le cadre reste immobile (A12), et rien ne passe dessus (A5) ---------

   SANS CE BLOC, L'EN-TÊTE ET LA BARRE D'ONGLETS SE DÉDOUBLENT. Ils font partie
   de la capture « root » : pendant le fondu, la photographie de la page
   sortante et celle de la page entrante sont toutes deux à l'écran, donc le
   cadre aussi, deux fois. Leur donner un nom les sort de « root » et en fait un
   groupe à part, apparié d'une page à l'autre.

   « display: none » sur l'ancien plutôt qu'une absence d'animation sur les deux :
   ce cadre est translucide (fond à 90 % et flou d'arrière-plan), et deux couches
   translucides superposées ne donnent pas la même teinte qu'une seule. On ne
   garde donc que le nouveau, qui ne bouge pas.

   LE Z-INDEX RÈGLE L'AUTRE MOITIÉ D'A5. Les groupes de transition vivent dans la
   couche supérieure, au-dessus du z-40 de la barre d'onglets : les cartes de la
   liste des tâches lui passaient donc par-dessus en glissant. Nommer le cadre le
   met dans le même arbre qu'elles, où l'ordre se règle, et 100 le place au-dessus
   des groupes anonymes.

   ATTENTION, LE PIÈGE DE CE FICHIER : cette feuille est un littéral de gabarit
   JavaScript. Un accent grave dans un commentaire le referme et casse le build —
   c'est arrivé en écrivant ce bloc. On cite donc avec des guillemets français.

   Rien de tout cela n'est émis sur les pages sous coffre : ce bloc vit dans la
   feuille conditionnelle, qui n'y est pas écrite. */
#entete-principal {
  view-transition-name: entete-principal;
}
#barre-du-bas {
  view-transition-name: barre-du-bas;
}
::view-transition-group(entete-principal),
::view-transition-group(barre-du-bas) {
  z-index: 100;
}
::view-transition-old(entete-principal),
::view-transition-old(barre-du-bas) {
  display: none;
}
::view-transition-new(entete-principal),
::view-transition-new(barre-du-bas) {
  animation: none;
}

/* --- La durée et la courbe viennent des jetons (A5) ----------------------

   Les groupes nommés par la liste des tâches — une carte, un nom — glissaient
   à la durée et à la courbe par défaut du navigateur : 250 ms en « ease« , deux
   valeurs qui ne viennent d'aucun jeton. Le sélecteur universel les couvre
   toutes, y compris les cartes créées plus tard. « root » garde ses propres
   règles, écrites plus haut et plus spécifiques. */
::view-transition-group(*) {
  animation-duration: var(--duree-moyenne, 200ms);
  animation-timing-function: var(--courbe-entree, ease-out);
}`;
const enteteVoulu = entete ?? (sansNavigation ? 'aucun' : 'complet');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
   La branche se déduit du chemin, et ses onglets viennent du registre. La mise
   en page ne connaît plus aucun écran : ajouter une branche ne demande donc
   pas d'y toucher, ce que la phase 8 posait comme le seul critère
   d'extensibilité qui vaille.
*/
const brancheCourante = brancheDuChemin(Astro.url.pathname);
/*
   L'ordre des branches ne bouge **jamais** (N3).

   Il bougeait : la branche courante passait en tête, donc Révisions affichait
   🎓 🧭 🏋, Odyssée 🧭 🎓 🏋, Sport 🏋 🎓 🧭. Un même lien changeait de place
   d'une page à l'autre, ce qui défait la seule chose qu'une barre fixe
   apporte — qu'on finisse par viser sans lire. La branche courante est
   maintenant marquée, pas déplacée.
*/
const branches = branchesDisponibles();

/*
   La barre affiche des **entrées**, dont certaines regroupent plusieurs
   onglets. Douze onglets ne tenaient pas : mesuré, la barre de Révisions
   disposait de 517 px pour 1 261 px de contenu à 1280 px de large, et de 8 px
   pour 550 px sur téléphone. Sept écrans sur douze étaient inatteignables
   sans faire glisser une barre dont rien ne disait qu'elle glissait.
*/
const entrees = entreesDeLaBarre(brancheCourante);
const idsDeLEntree = (e: EntreeDeBarre) =>
  e.sorte === 'onglet' ? [e.onglet.id] : e.membres.map((o) => o.id);
const principaux = ongletsPrincipaux(brancheCourante);

/*
   Le nom de la page courante, pour le téléphone.

   Sous « sm », la barre du bas porte déjà `principaux` — exactement la même
   liste que le ruban du haut. Les deux rangées disaient donc la même chose,
   l'une au-dessus de l'autre, et c'est l'un des constats de la critique du
   14 octobre.

   Ce qui se perd en retirant le ruban n'est pas la navigation, qui reste en
   bas : c'est de **savoir où l'on est**, puisque la barre du bas le marque
   discrètement. Le nom le remplace, et prend moins de place qu'il n'en
   libère.

   Il vient du registre quand l'onglet y figure, et du titre de la page
   sinon — une page hors onglets (une fiche, un détail) a tout de même un
   nom à afficher.
*/
const nomDeLaPage = principaux.find((o) => o.id === actif)?.nom ?? titre;

/*
   La portée du pied de page : la branche où l'on est, ou le menu.

   Elle n'est pas toujours celle de l'en-tête, et c'est voulu. Une page à
   en-tête complet est dans sa branche, par le préfixe de son chemin. Une page
   à en-tête léger est **au-dessus** des branches — sauf si le registre la
   déclare comme onglet de l'une d'elles, ce qui est le cas de « Mes
   synthèses », onglet d'Odyssée hébergé à `/syntheses/`. Le préfixe la
   rangerait dans Révisions ; la déclaration sait mieux.
*/
const porteeDuPied =
  enteteVoulu === 'complet'
    ? brancheCourante.id
    : (brancheDUnOnglet(Astro.url.pathname)?.id ?? 'menu');

/*
   Le retour au menu dans l'en-tête léger.

   Quatre pages le portaient sans offrir la moindre sortie : il fallait
   descendre jusqu'au pied pour trouver « Menu ». Deux exceptions restent, et
   elles sont justes : le menu **est** la sortie, et l'initialisation est un
   parcours d'accueil, où une porte de sortie dessert la personne — c'est
   `sansNavigation` qui la signale.
*/
const estLeMenu = Astro.url.pathname.replace(/\/+$/, '') === base;
const retourAuMenu = enteteVoulu === 'leger' && !estLeMenu && !sansNavigation;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <!--
      « viewport-fit=cover » : la page va jusqu'aux bords de l'écran, bandes
      réservées comprises. Sans lui, la barre du bas d'un iPhone à encoche
      flotte au-dessus d'un ruban gris, et le fond du site s'arrête avant le
      bord. Avec lui, c'est à la feuille de style d'écarter les commandes de
      la poignée d'accueil : les quatre variables « --sur-* » s'en chargent.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Non-indexation : aucun moteur ne doit référencer ce site. -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    {/*
       Le titre d'onglet porte la branche, et c'est deux problèmes réglés.

       Les trois branches ont chacune un « Tableau de bord » : sans la
       branche, trois onglets de navigateur s'appelleraient pareil et
       l'historique deviendrait illisible. Et la critique relève qu'on ne sait
       pas **où l'on est** — le titre est le seul endroit qui puisse le dire
       quand la page est défilée.
    */}
    <title>
      {titre} · {enteteVoulu === 'complet' ? `${brancheCourante.libelle} · ` : ''}{config.titre}
    </title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Applique le thème avant le premier rendu pour éviter tout clignotement.
      // Trois choix possibles : « clair », « sombre » et « systeme ». Seul le
      // thème résolu (clair ou sombre) est écrit dans « data-theme » ; le choix
      // d'origine est conservé dans « data-theme-choix » pour le commutateur.
      // En l'absence de choix enregistré, on reste sur le thème sombre, qui est
      // celui du site depuis toujours.
      (function () {
        var choix = 'sombre';
        try {
          var brut = localStorage.getItem('revinsp.theme');
          if (brut === 'clair' || brut === 'sombre' || brut === 'systeme') choix = brut;
        } catch (e) {
          /* navigation privée : on garde le défaut */
        }
        var rendu =
          choix === 'systeme'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'sombre'
              : 'clair'
            : choix;
        var racine = document.documentElement;
        racine.setAttribute('data-theme', rendu);
        racine.setAttribute('data-theme-choix', choix);
        racine.style.colorScheme = rendu === 'sombre' ? 'dark' : 'light';

        // Animations : même principe, et pour la même raison — appliqué avant
        // le premier rendu, sinon une animation aurait le temps de jouer avant
        // que le réglage soit lu. Deux valeurs seulement : « reduites » et
        // « completes ». Le réglage du système reste honoré de son côté par
        // « prefers-reduced-motion » ; le plus restrictif des deux l'emporte,
        // puisque chacun neutralise sans que l'autre puisse rétablir.
        var animations = 'completes';
        try {
          var a = localStorage.getItem('revinsp.animations');
          if (a === 'reduites' || a === 'completes') animations = a;
        } catch (e) {
          /* navigation privée : on garde le défaut */
        }
        racine.setAttribute('data-animations', animations);
      })();
    </script>

    {
      /*
         Transitions entre documents (prompt 34, A1 — décision 1 : CSS seul,
         pas de routeur client).

         La règle n'est émise que sur les pages **sans coffre**. Une transition
         entre documents n'a lieu que si la page sortante et la page entrante
         y consentent toutes les deux : l'omettre ici empêche donc la capture
         dans les deux sens, sans avoir à nommer la moindre région sensible.

         Les navigateurs qui ne connaissent pas cette règle l'ignorent, et la
         navigation y reste sèche — c'est le repli prévu par la décision 1.
      */
      !coffre && <style is:inline set:html={CSS_TRANSITIONS} />
    }
  </head>

  <body>
    <BarreProgression />
    <Verrou />

    <div id="application" class="hidden min-h-screen">
      {/*
         Le lien d'évitement, premier arrêt de tabulation de la page.

         Dans Révisions, atteindre le contenu au clavier demandait dix-neuf
         tabulations : le logo, trois branches, douze onglets, la liste de
         parcours, le thème et le verrou. Dix-neuf, à chaque page, pour
         quelqu'un qui ne se sert pas d'une souris.

         Il est invisible tant qu'il n'a pas le focus — « sr-only » le sort de
         l'écran, « focus:not-sr-only » l'y ramène —, parce qu'un lien
         d'évitement visible en permanence occupe le coin de chaque page pour
         une minorité de visites.

         L'ancre s'appelle « contenu-principal » et non « contenu », qui
         existait déjà sur l'écran de fiche. Un identifiant en double ne
         produit aucune erreur : « getElementById » rend le premier du
         document, et la fiche a écrit son cours dans le <main> au lieu de sa
         propre zone, effaçant la page entière. C'est l'essai « essais:pretest »
         qui l'a vu, pas la relecture.
      */}
      <a
        href="#contenu-principal"
        class="sr-only rounded-br-lg bg-indigo-600 px-4 py-3 font-medium text-white focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50"
      >
        Aller au contenu
      </a>
      {
        enteteVoulu === 'complet' && (
          <header
            id="entete-principal"
            class="entete-sur sticky z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90"
          >
            <div class="bandeau-tricolore"></div>
            <TemoinCoffre />
            {/*
               L'en-tête tient sur **une ou deux rangées**, selon la place.

               Il tenait sur une seule, de force : le bloc de droite portait
               « shrink-0 » et refusait de se réduire, de sorte que son bord
               droit tombait à 388 px sur un écran de 360 — et que le document
               entier défilait de 28 px sur quarante-quatre pages. La barre
               d'onglets, elle, n'y était pour rien : elle défile proprement.

               Deux contraintes se heurtaient, et aucune ne pouvait céder.
               Une cible tactile veut 44 px ; six cibles de 44 px, les écarts
               et les marges font déjà 330 px, et il reste à loger la barre
               d'onglets et le sélecteur de parcours. Sur une rangée, à 360 px,
               c'est arithmétiquement impossible.

               Donc : au-dessous de « lg », la barre d'onglets passe à la ligne
               (« w-full order-last »), et la rangée du haut ne porte plus que
               l'identité, les branches, le thème et le verrou. Au-dessus,
               l'ordre d'origine revient, en une rangée. Une seule structure,
               deux mises en forme — rien n'est dupliqué.
            */}
            <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 lg:py-3">
              {/*
                Deux liens et non un : le nom du produit ramène au **menu**, le
                nom de la branche à son accueil. Un seul lien aurait forcé à
                choisir, et le retour au menu serait devenu introuvable depuis
                l'intérieur d'une branche.
              */}
              <div class="flex shrink-0 items-center gap-1 font-semibold text-slate-900 sm:gap-1.5 dark:text-white">
                <a
                  href={`${base}/`}
                  title="Menu de Cyclades"
                  class="cible-tactile-pleine gap-2 rounded-lg px-1 transition hover:text-indigo-600 dark:hover:text-indigo-400"
                >
                  <span class="text-lg" aria-hidden="true">🗂️</span>
                  <span class="hidden sm:inline">{config.titre}</span>
                  <span class="sr-only">Menu de {config.titre}</span>
                </a>
                <span class="hidden text-slate-400 sm:inline dark:text-slate-500" aria-hidden="true">·</span>
                {/*
                   Les trois branches, **toujours dans le même ordre**, la
                   courante marquée par son fond et par `aria-current`.

                   Le contraste des inactives passe de 3,74 : 1 à la couleur
                   du texte secondaire ordinaire : le seuil de WCAG AA pour du
                   texte courant est 4,5 : 1, et « inactif » n'est pas une
                   raison d'être illisible — c'est une raison d'être moins
                   appuyé, ce que fait déjà l'absence de fond.
                */}
                {branches.map((b) => (
                  <a
                    href={`${base}${b.racine}`}
                    title={b.description}
                    data-branche={b.id}
                    aria-current={b.id === brancheCourante.id ? 'true' : undefined}
                    class:list={[
                      'cible-tactile-pleine gap-1.5 rounded-lg px-2 text-sm font-normal transition',
                      b.id === brancheCourante.id
                        ? 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white'
                        : 'text-slate-600 hover:bg-slate-100 hover:text-indigo-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-indigo-400',
                    ]}
                  >
                    <span class="text-base" aria-hidden="true">{b.icone}</span>
                    <span class="hidden sm:inline">{b.libelle}</span>
                    <span class="sr-only">
                      {b.id === brancheCourante.id ? `${b.libelle} — branche courante` : `Aller dans ${b.libelle}`}
                    </span>
                    {/*
                       La pastille de la revue — V4 / décision 2 du 36. Le
                       bandeau de l'accueil disait déjà « la revue vous
                       attend » ; il fallait encore qu'on le voie depuis une
                       page de Révisions, où l'accueil n'est pas sous les yeux.

                       Un POINT, pas un nombre. Il n'y a qu'une revue par jour :
                       un compteur dirait « 1 » tous les soirs, et un compteur
                       qui ne compte qu'à un n'apprend rien. Le libellé
                       accessible, lui, dit la chose en toutes lettres — la
                       même règle que le témoin de synchronisation, deux
                       éléments plus loin.

                       Sur Odyssée seulement : la revue est à elle, et une
                       pastille sur chaque branche serait une décoration.
                    */}
                    {b.id === 'odyssee' && (
                      <span id="pastille-revue" class="hidden" role="status" aria-live="polite">
                        <span
                          aria-hidden="true"
                          class="block h-2 w-2 rounded-full bg-indigo-500"
                        ></span>
                        <span class="sr-only">La revue vous attend.</span>
                      </span>
                    )}
                  </a>
                ))}
              </div>

              {/*
                 Le parcours et les onglets vont ensemble, et c'est aussi la
                 bonne lecture : le parcours est la **portée** de ce que les
                 onglets ouvrent — ses thèmes de planification, ses matières,
                 son filtre de banque de QCM. Il était dans le groupe du thème
                 et du verrou, qui sont des réglages de l'application entière.

                 Et il ne paraît plus que dans Révisions, la seule branche
                 qu'il gouverne : sur une page de Sport, il occupait cent
                 pixels pour proposer un choix sans effet visible ici.
                 (« Demander à l'IA », ouvert depuis le glossaire sur
                 n'importe quelle page, continue de lire le parcours en
                 cours ; c'est le **changer** d'ailleurs que Révisions qui
                 n'avait pas de sens.)
              */}
              {/*
                 La barre prend **sa propre rangée** tant qu'elle n'a pas la
                 place de tenir sur celle du haut.

                 Mesuré à 1280 px : la rangée haute offrait 407 px à une barre
                 qui en demandait 624, parce que le nom du produit, les trois
                 branches et le sélecteur de parcours occupaient le reste.
                 Le seuil passe donc de « lg » à « 2xl » — en dessous de
                 1536 px, la barre descend d'une rangée et dispose de toute la
                 largeur. Mesuré à 1280 px après : 624 px de contenu pour
                 1248 px disponibles. Une rangée de plus coûte quarante pixels
                 de hauteur ; sept écrans invisibles coûtaient plus.
              */}
              <div class="order-last flex w-full min-w-0 shrink items-center gap-2 2xl:order-none 2xl:w-auto 2xl:flex-1">
                {brancheCourante.id === ID_BRANCHE_PAR_DEFAUT && <SelecteurParcours />}
                {/*
                   Le nom de la page, sous « sm » seulement : il prend la place
                   du ruban caché juste à côté. `aria-hidden` parce que le
                   titre du document le dit déjà à un lecteur d'écran, et
                   l'entendre deux fois à chaque page serait une gêne, pas une
                   aide.
                */}
                <span
                  id="nom-de-la-page"
                  aria-hidden="true"
                  class="min-w-0 flex-1 truncate text-sm font-medium text-slate-700 sm:hidden dark:text-slate-200"
                  >{nomDeLaPage}</span
                >
                {/*
                   `hidden sm:flex` sur la barre : sous 640 px la barre du bas
                   rend la **même liste**, et deux navigations identiques l'une
                   au-dessus de l'autre ne valent pas mieux qu'une. Au-dessus,
                   la barre du bas disparaît (`sm:hidden`) et ce ruban redevient
                   la seule navigation de branche : les deux seuils sont le
                   même, et c'est volontaire.

                   Ce qui se perdrait sans contrepartie, c'est de savoir où
                   l'on est — d'où le nom de la page, juste au-dessus.
                */}
                {/*
                   Plus de `overflow-x-auto` sur la barre ci-dessous : il n'y a
                   plus rien à faire défiler, et surtout il **coupait les
                   panneaux** des groupes, qui sont positionnés en absolu et
                   doivent déborder de la barre pour s'afficher. Un menu
                   déroulant dans un conteneur qui masque le débordement est
                   un menu qui s'ouvre dans une fente.

                   Le commentaire est ICI et non entre deux attributs : le
                   compilateur l'y tolérait, `astro check` non, et deux de ses
                   neuf erreurs venaient de ces quatre lignes.
                */}
                <nav
                  id="navigation-principale"
                  aria-label="Navigation principale"
                  class="-mx-1 hidden min-w-0 flex-1 flex-wrap gap-1 px-1 sm:flex"
                >
                  {/*
                     Un nom par écran, le même partout.

                     Le registre porte désormais un seul `nom` : la barre, le
                     titre de la page, son `<h1>` et le pied de page le
                     reprennent tel quel. L'onglet disait « Cours » et la page
                     « Bibliothèque » ; pour qui pilote à la voix, c'était un
                     onglet qu'on n'atteint pas (WCAG 2.5.3, niveau A), et
                     pour tout le monde, deux écrans là où il y en a un.

                     Les groupes s'ouvrent par `<details>` : au clavier
                     naturellement, sans JavaScript, et refermés par la touche
                     d'échappement. Un menu fait à la main aurait demandé
                     cinquante lignes pour refaire ce que le navigateur sait.
                  */}
                  {entrees.map((e) =>
                    e.sorte === 'onglet' ? (
                      <a
                        href={`${base}${e.onglet.chemin}`}
                        title={e.onglet.description ?? e.onglet.nom}
                        aria-current={actif === e.onglet.id ? 'page' : undefined}
                        class:list={[
                          'cible-tactile-pleine hidden shrink-0 gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition sm:inline-flex',
                          actif === e.onglet.id
                            ? 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
                            : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
                        ]}
                      >
                        <span aria-hidden="true">{e.onglet.icone}</span>
                        <span>{e.onglet.nom}</span>
                      </a>
                    ) : (
                      <details
                        class="groupe-onglets hidden shrink-0 sm:block"
                        data-groupe={e.groupe.id}
                      >
                        <summary
                          class:list={[
                            'cible-tactile-pleine list-none gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition',
                            idsDeLEntree(e).includes(actif ?? '')
                              ? 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
                              : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
                          ]}
                        >
                          <span aria-hidden="true">{e.groupe.icone}</span>
                          <span>{e.groupe.nom}</span>
                          <span aria-hidden="true" class="text-xs">▾</span>
                        </summary>
                        <ul class="absolute z-50 mt-1 min-w-48 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                          {e.membres.map((o) => (
                            <li>
                              <a
                                href={`${base}${o.chemin}`}
                                title={o.description ?? o.nom}
                                aria-current={actif === o.id ? 'page' : undefined}
                                class:list={[
                                  'cible-tactile w-full gap-2 rounded-lg px-3 text-sm transition',
                                  actif === o.id
                                    ? 'bg-indigo-50 font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
                                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800',
                                ]}
                              >
                                <span aria-hidden="true">{o.icone}</span>
                                <span>{o.nom}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ),
                  )}
                </nav>
              </div>

              <div class="ml-auto flex shrink-0 items-center gap-1 2xl:ml-0">
                {/*
                  L'indicateur de synchronisation, discret (D-025, point 2).

                  Un point, pas un bandeau, et masqué tant que la veille ne
                  tourne pas : un indicateur qui dit « rien ne se passe » en
                  permanence devient un meuble, et un bandeau coûterait au
                  ruban d'onglets la place que D-009 venait de lui rendre.
                  Le libellé accessible, lui, dit l'état en toutes lettres.
                */}
                <span
                  id="temoin-sync"
                  class="hidden h-11 w-5 items-center justify-center"
                  role="status"
                  aria-live="polite"
                >
                  <span id="pastille-sync" aria-hidden="true" class="block h-2 w-2 rounded-full bg-slate-400"></span>
                  <span id="texte-sync" class="sr-only"></span>
                </span>
                {/*
                   Le centre de notifications, **dans l'en-tête complet
                   seulement** (§ 3.1 du 32).

                   Le menu de garde n'en porte pas, et ce n'est pas un
                   oubli : il est au-dessus des branches, on n'y fait rien,
                   et un compteur d'actions à faire y inviterait à agir
                   depuis un écran qui ne sait rien faire. La même règle
                   que le ruban d'onglets, qui n'y est pas non plus.

                   Il est voisin du témoin de synchronisation, et c'est
                   voulu : les deux disent l'état de ce qui s'est passé
                   ailleurs, l'un en continu, l'autre à la demande.
                */}
                <CentreNotifications />
                <CommutateurTheme />
                {/*
                   « Cet espace » : les écrans qui ne sont d'aucune branche.

                   Profil, Appareils, Stockage, Exporter et Importer ne
                   s'ouvraient que depuis le menu d'accueil, et aucune colonne
                   du pied de page ne les nommait. Ils sont de partout — ils
                   servent Cyclades entier —, donc ils sont ici, au même
                   endroit sur chaque page, en-tête complet **et** léger : la
                   critique relève que le gabarit change d'un écran à l'autre,
                   et c'est le côté droit qui changeait.

                   Les trois écrans de données (Sauvegarde, Stockage,
                   Appareils) y sont voisins : on ne devinait pas lequel
                   ouvrir, et les voir côte à côte est la réponse la moins
                   coûteuse — les fondre en un seul écran aurait été un
                   chantier, pas une correction.
                */}
                <details class="groupe-onglets relative shrink-0">
                  <summary
                    class="cible-tactile-pleine list-none rounded-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
                    title="Cet espace"
                  >
                    <span aria-hidden="true">⚙️</span>
                    <span class="sr-only">Cet espace — réglages et données</span>
                  </summary>
                  <ul class="absolute right-0 z-50 mt-1 min-w-56 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                    {ECRANS_COMMUNS.map((o) => (
                      <li>
                        <a
                          href={`${base}${o.chemin}`}
                          title={o.description ?? o.nom}
                          class="cible-tactile w-full gap-2 rounded-lg px-3 text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                        >
                          <span aria-hidden="true">{o.icone}</span>
                          <span>{o.nom}</span>
                        </a>
                      </li>
                    ))}
                    <li>
                      <a
                        href={`${base}/progression/`}
                        class="cible-tactile w-full gap-2 rounded-lg px-3 text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                      >
                        <span aria-hidden="true">💾</span>
                        <span>Sauvegarde</span>
                      </a>
                    </li>
                    <li class="mt-1 border-t border-slate-200 pt-1 dark:border-slate-700">
                      <button
                        id="bouton-verrouiller"
                        type="button"
                        class="cible-tactile w-full gap-2 rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                      >
                        <span aria-hidden="true">🔒</span>
                        <span>Verrouiller la session</span>
                      </button>
                    </li>
                  </ul>
                </details>
              </div>
            </div>
          </header>
        )
      }

      {
        enteteVoulu === 'leger' && (
          <header
            id="entete-principal"
            class="border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90"
          >
            <div class="bandeau-tricolore"></div>
            <TemoinCoffre />
            <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-3">
              {retourAuMenu ? (
                <a
                  href={`${base}/`}
                  title={`Menu de ${config.titre}`}
                  class="flex h-11 shrink-0 items-center gap-2 rounded-lg px-1 font-semibold text-slate-900 transition hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400"
                >
                  <span class="text-lg" aria-hidden="true">🗂️</span>
                  <span>{config.titre}</span>
                  <span class="sr-only">— revenir au menu</span>
                </a>
              ) : (
                <span class="flex h-11 shrink-0 items-center gap-2 font-semibold text-slate-900 dark:text-white">
                  <span class="text-lg" aria-hidden="true">🗂️</span>
                  <span>{config.titre}</span>
                </span>
              )}
              <div class="flex flex-1 justify-end gap-1">
                <CommutateurTheme />
                <details class="groupe-onglets relative shrink-0">
                  <summary
                    class="cible-tactile-pleine list-none rounded-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
                    title="Cet espace"
                  >
                    <span aria-hidden="true">⚙️</span>
                    <span class="sr-only">Cet espace — réglages et données</span>
                  </summary>
                  <ul class="absolute right-0 z-50 mt-1 min-w-56 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                    {ECRANS_COMMUNS.map((o) => (
                      <li>
                        <a
                          href={`${base}${o.chemin}`}
                          title={o.description ?? o.nom}
                          class="cible-tactile w-full gap-2 rounded-lg px-3 text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                        >
                          <span aria-hidden="true">{o.icone}</span>
                          <span>{o.nom}</span>
                        </a>
                      </li>
                    ))}
                    <li>
                      <a
                        href={`${base}/progression/`}
                        class="cible-tactile w-full gap-2 rounded-lg px-3 text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                      >
                        <span aria-hidden="true">💾</span>
                        <span>Sauvegarde</span>
                      </a>
                    </li>
                    <li class="mt-1 border-t border-slate-200 pt-1 dark:border-slate-700">
                      <button
                        id="bouton-verrouiller"
                        type="button"
                        class="cible-tactile w-full gap-2 rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                      >
                        <span aria-hidden="true">🔒</span>
                        <span>Verrouiller la session</span>
                      </button>
                    </li>
                  </ul>
                </details>
              </div>
            </div>
          </header>
        )
      }

      {/*
         La barre du bas, sur téléphone (N1).

         À 390 px, la barre d'onglets du haut disposait de 8 px pour 550 px de
         contenu : la navigation interne d'une branche était purement
         invisible, et le seul chemin vers un autre écran passait par le pied
         de page, à deux à cinq mille pixels plus bas, parmi trente-huit
         liens.

         Quatre destinations et un « Plus ». Quatre parce qu'à 390 px, cinq
         cibles de 44 px avec leur libellé tiennent et six se touchent. Le
         « Plus » ouvre le reste **groupé**, avec la branche courante en tête
         — un écran qu'on cherche se cherche dans sa branche.

         Elle est en `position: fixed`, donc le contenu reçoit en bas une
         marge de sa hauteur : une barre qui recouvre la dernière ligne d'une
         page est une barre qui cache ce qu'on lisait.
      */}
      {enteteVoulu === 'complet' && (
        <nav
          id="barre-du-bas"
          aria-label="Navigation de la branche"
          class="barre-sure fixed inset-x-0 bottom-0 z-40 flex border-t border-slate-200 bg-white/95 backdrop-blur sm:hidden dark:border-slate-800 dark:bg-slate-900/95"
        >
          {principaux.map((o) => (
            <a
              href={`${base}${o.chemin}`}
              aria-current={actif === o.id ? 'page' : undefined}
              class:list={[
                'flex min-h-14 flex-1 flex-col items-center justify-center gap-0.5 px-1 py-1 text-xs font-medium transition',
                actif === o.id
                  ? 'text-indigo-700 dark:text-indigo-300'
                  : 'text-slate-600 dark:text-slate-300',
              ]}
            >
              <span class="text-lg leading-none" aria-hidden="true">{o.icone}</span>
              <span>{nomCourt(o)}</span>
            </a>
          ))}
          <button
            id="ouvrir-plus"
            type="button"
            aria-expanded="false"
            aria-controls="feuille-plus"
            class="flex min-h-14 flex-1 flex-col items-center justify-center gap-0.5 px-1 py-1 text-xs font-medium text-slate-600 transition dark:text-slate-300"
          >
            <span class="text-lg leading-none" aria-hidden="true">⋯</span>
            <span>Plus</span>
          </button>
        </nav>
      )}

      {enteteVoulu === 'complet' && (
        <div
          id="feuille-plus"
          class="apparition fixed inset-0 z-50 hidden bg-slate-900/40 sm:hidden"
          role="dialog"
          aria-modal="true"
          aria-label="Tous les écrans"
        >
          <div class="feuille-sure absolute inset-x-0 bottom-0 max-h-[80dvh] overflow-y-auto rounded-t-2xl bg-white p-4 dark:bg-slate-900">
            <div class="mb-3 flex items-center justify-between">
              <h2 class="text-base font-semibold text-slate-900 dark:text-white">
                {brancheCourante.libelle}
              </h2>
              <button
                id="fermer-plus"
                type="button"
                class="cible-tactile rounded-lg px-3 text-sm text-slate-600 underline dark:text-slate-300"
              >
                Fermer
              </button>
            </div>
            <ul class="space-y-1">
              {brancheCourante.onglets.map((o) => (
                <li>
                  <a
                    href={`${base}${o.chemin}`}
                    aria-current={actif === o.id ? 'page' : undefined}
                    class:list={[
                      'cible-tactile w-full gap-2 rounded-lg px-3 text-sm transition',
                      actif === o.id
                        ? 'bg-indigo-50 font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
                        : 'text-slate-700 dark:text-slate-200',
                    ]}
                  >
                    <span aria-hidden="true">{o.icone}</span>
                    <span>{o.nom}</span>
                  </a>
                </li>
              ))}
            </ul>
            <h3 class="mt-4 mb-1 etiquette text-slate-500 dark:text-slate-400">Cet espace</h3>
            <ul class="space-y-1">
              {ECRANS_COMMUNS.map((o) => (
                <li>
                  <a
                    href={`${base}${o.chemin}`}
                    class="cible-tactile w-full gap-2 rounded-lg px-3 text-sm text-slate-700 dark:text-slate-200"
                  >
                    <span aria-hidden="true">{o.icone}</span>
                    <span>{o.nom}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <main
        id="contenu-principal"
        tabindex="-1"
        class:list={[
          'mx-auto max-w-6xl px-4 py-8',
          /*
             « contenu-sur » ajoute la poignée d'accueil aux 6 rem qui
             dégagent déjà la barre du bas : sans elle, la dernière ligne
             d'une page se lit sous la poignée.
          */
          enteteVoulu === 'complet' ? 'contenu-sur pb-24 sm:pb-8' : '',
        ]}
      >
        <slot />
      </main>

      {enteteVoulu !== 'aucun' && <PiedDePage portee={porteeDuPied} />}
    </div>

    <script>
      import { quandDeverrouille, verrouiller } from '../lib/auth';
      import { masquerDebordement } from '../lib/defilement';
      import { initGlossaireGlobal } from '../lib/glossaire';
      import { suivreTemps } from '../lib/temps';

      initGlossaireGlobal();

      // Le ruban d'onglets déborde dès les écrans étroits : plutôt qu'une barre
      // de défilement sous les icônes, on estompe le bord encore parcourable.
      const rubanOnglets = document.getElementById('navigation-principale');
      if (rubanOnglets) masquerDebordement(rubanOnglets);

      // Le choix du thème est géré par « components/CommutateurTheme.astro ».

      document.getElementById('bouton-verrouiller')?.addEventListener('click', () => {
        verrouiller();
        document.dispatchEvent(new CustomEvent('revinsp:verrouille'));
        location.reload();
      });

      // Le temps n'est comptabilisé qu'une fois la session ouverte.
      // « quandDeverrouille » et non un écouteur nu : le paquet de cette page
      // peut arriver après l'ouverture de la session (voir lib/auth.ts).
      quandDeverrouille(() => suivreTemps());

      /*
         La veille de synchronisation de l'ordinateur certifié.

         Elle vit dans la mise en page et non dans une page, parce que l'onglet
         qu'on laisse ouvert n'est pas forcément celui des appareils : c'est le
         tableau de bord, ou une fiche. Le module est importé **paresseusement**
         et ne fait rien du tout si l'appareil n'est pas certifié — il n'y a
         donc ni réseau, ni Trystero, ni octet chargé pour les autres.
      */
      quandDeverrouille(async () => {
        const { veiller } = await import('../lib/sync/veille');
        const veille = await veiller();
        if (veille) peindreLeTemoin(veille.etat());
      });

      /*
         Le témoin de synchronisation, discret (D-025, point 2).

         Il ne s'affiche que quand la veille tourne — « en veille », « en
         cours », « échec ». Les trois états d'attente (« non certifié »,
         « sans appairage », « sans mot de passe ») le laissent caché : ce
         sont des réponses à une question que personne n'a posée, et
         l'écran des appareils les dit déjà en toutes lettres.
      */
      const COULEURS: Record<string, string> = {
        'en-veille': 'bg-emerald-500',
        'en-cours': 'bg-indigo-500',
        echec: 'bg-amber-500',
      };
      const MOTS: Record<string, string> = {
        'en-veille': 'Synchronisation en veille.',
        'en-cours': 'Synchronisation en cours.',
        echec: 'Dernière synchronisation en échec ; la veille continue.',
      };

      function peindreLeTemoin(etat: string) {
        const temoin = document.getElementById('temoin-sync');
        const pastille = document.getElementById('pastille-sync');
        const texte = document.getElementById('texte-sync');
        if (!temoin || !pastille || !texte) return;
        const couleur = COULEURS[etat];
        temoin.classList.toggle('hidden', !couleur);
        temoin.classList.toggle('flex', Boolean(couleur));
        if (!couleur) return;
        pastille.className = `block h-2 w-2 rounded-full ${couleur}`;
        texte.textContent = MOTS[etat] ?? '';
        temoin.title = MOTS[etat] ?? '';
      }

      /*
         Le rejeu des plis à l'ouverture du coffre — A-6 option D, signée le
         15 octobre : « un report est rejoué ou signalé, jamais perdu en
         silence ». Le moteur existait et personne ne l'appelait.

         Ici, dans la mise en page, et non dans un écran d'Odyssée : on
         ouvre le coffre où l'on veut — au Corps, à la Psyché, aux
         Finances —, et un rejeu qui n'aurait lieu que sur le tableau de
         bord d'Odyssée tiendrait la promesse une fois sur cinq.

         L'abonnement ne coûte rien : le module ne charge la couche de
         données qu'au moment où le coffre s'ouvre.
      */
      quandDeverrouille(async () => {
        try {
          const { brancherLeRejeu, rejouerMaintenant } = await import(
            '../lib/odyssee/rejeu-au-coffre'
          );
          brancherLeRejeu();
          /*
             Et une fois tout de suite : le coffre peut déjà être ouvert
             quand la page se charge — mémorisé sur l'appareil, ou ouvert
             sur l'écran précédent. S'abonner sans rejouer laisserait les
             plis attendre la prochaine fermeture-réouverture.
          */
          const { coffreOuvert } = await import('../lib/coffre');
          if (coffreOuvert()) await rejouerMaintenant();
        } catch {
          /* Un rejeu qui échoue ne doit pas emporter la barre. */
        }
      });

      /*
         La pastille de la revue, sur l'onglet Odyssée.

         Après le déverrouillage, parce que les revues tenues vivent dans la
         base chiffrée : avant, on ne sait pas, et un point qui s'allume
         faute de savoir vaut moins que pas de point du tout.

         `revueASignaler` reprend les deux règles de l'accueil — la fenêtre
         de la revue due, le rappel des manquées. Elle les reprend plutôt
         que de les refaire : deux calculs de la même chose finissent par se
         contredire, et c'est la barre qui aurait tort.
      */
      quandDeverrouille(async () => {
        const pastille = document.getElementById('pastille-revue');
        if (!pastille) return;
        try {
          const { revueASignaler } = await import('../lib/odyssee-jour');
          if (await revueASignaler()) pastille.classList.replace('hidden', 'inline-flex');
        } catch {
          /* La barre ne tombe pas parce qu'un point n'a pas pu se peindre. */
        }
      });

      /*
         Le cache hors ligne (D-025, point 1).

         Deux gestes seulement : enregistrer le worker, et lui dire à quelle
         publication on appartient. C'est cette annonce qui l'autorise à
         cacher quoi que ce soit, et qui efface le cache de la publication
         précédente — voir l'en-tête de « public/sw.js ».
      */
      quandDeverrouille(async () => {
        const [{ enregistrerServiceWorker }, { annoncerLaPublication }, { chargerParametresCle }] =
          await Promise.all([
            import('../lib/sync/notification'),
            import('../lib/hors-ligne'),
            import('../lib/contenu'),
          ]);
        try {
          await enregistrerServiceWorker(import.meta.env.BASE_URL);
          const { version } = await chargerParametresCle();
          if (version) await annoncerLaPublication(version);
        } catch {
          /* Hors ligne, worker refusé : le site marche sans cache. */
        }
      });

      /*
         Le journal d'usage.

         Dans la mise en page, parce qu'une session est « l'application a été
         ouverte » et non « telle page a été vue » — c'est tout le point du
         module, qui n'enregistre d'ailleurs aucune page.

         Après ouverture de la session, comme le suivi du temps : quelqu'un
         qui arrive sur l'écran de mot de passe et s'en va n'a pas utilisé
         Cyclades, et ce journal sert précisément à distinguer une absence
         réelle d'un silence de saisie. Le compter fausserait les deux.
      */
      quandDeverrouille(async () => {
        const { enregistrerLUsage } = await import('../lib/odyssee/donnees-usage');
        await enregistrerLUsage();
      });
    </script>
  </body>
</html>

<script>
  /*
     Trois gestes que le navigateur ne donne pas seul.

     1. Un `<details>` ouvert reste ouvert quand on en ouvre un autre : deux
        panneaux superposés. On ferme donc les frères à l'ouverture.
     2. Un clic ailleurs ne le ferme pas. Un menu qu'il faut recliquer pour
        refermer est un menu qu'on laisse ouvert par mégarde.
     3. La feuille « Plus » du téléphone : ouverture, fermeture, et la touche
        d'échappement, qui est ce qu'on essaie d'abord.
  */
  const groupes = () => [...document.querySelectorAll<HTMLDetailsElement>('.groupe-onglets')];

  for (const d of groupes()) {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      for (const autre of groupes()) if (autre !== d) autre.open = false;
    });
  }

  document.addEventListener('click', (e) => {
    const dans = (e.target as HTMLElement | null)?.closest('.groupe-onglets');
    for (const d of groupes()) if (d !== dans) d.open = false;
  });

  const feuille = document.getElementById('feuille-plus');
  const ouvrir = document.getElementById('ouvrir-plus');
  const fermer = document.getElementById('fermer-plus');

  const basculerFeuille = (ouverte: boolean) => {
    feuille?.classList.toggle('hidden', !ouverte);
    ouvrir?.setAttribute('aria-expanded', String(ouverte));
    if (ouverte) (feuille?.querySelector('a') as HTMLElement | null)?.focus();
    else ouvrir?.focus();
  };

  ouvrir?.addEventListener('click', () => basculerFeuille(true));
  fermer?.addEventListener('click', () => basculerFeuille(false));
  feuille?.addEventListener('click', (e) => {
    if (e.target === feuille) basculerFeuille(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (feuille && !feuille.classList.contains('hidden')) basculerFeuille(false);
    for (const d of groupes()) d.open = false;
  });
</script>
