---
/**
 * Le témoin du coffre, dans l'en-tête de toutes les pages.
 *
 * **Pourquoi il est ici et non sur les écrans du coffre.** L'interdit 6 du
 * prompt 35 veut un bouton « Fermer le coffre » visible *partout où le coffre
 * est ouvert*. Or le coffre, une fois ouvert, l'est pour tout l'onglet : on
 * peut donc être sur l'accueil, les révisions ou le sport avec le coffre
 * ouvert et aucun moyen de le refermer. Le relevé du 14 octobre l'a montré
 * autrement : sur les dix pages sous coffre, **six** n'offraient aucun bouton
 * de fermeture. Un composant dans l'en-tête règle les deux d'un coup, et
 * surtout il n'oblige pas la onzième page à y penser.
 *
 * **Deux libellés qui ne promettent pas la même chose.** « Fermer le coffre »
 * ferme pour la session et laisse la mémorisation ; « Oublier sur cet
 * appareil » efface la mémorisation et ferme. Les confondre ferait croire
 * effacé ce qui ne l'est pas, et c'est exactement le genre de demi-vérité que
 * le coffre ne peut pas se permettre.
 */
---

<div
  id="temoin-coffre"
  class="hidden border-b border-amber-300 bg-amber-50 dark:border-amber-800/60 dark:bg-amber-950/40"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-1.5">
    <span class="flex items-center gap-1.5 text-xs font-medium text-amber-900 dark:text-amber-100">
      <span aria-hidden="true">🔓</span>
      <span id="temoin-coffre-libelle">Coffre ouvert</span>
    </span>
    <span class="grow"></span>
    <button
      id="temoin-coffre-fermer"
      type="button"
      class="min-h-8 rounded px-2 text-xs font-medium text-amber-900 underline underline-offset-2 transition hover:bg-amber-100 dark:text-amber-100 dark:hover:bg-amber-900/40"
      >Fermer le coffre</button
    >
    <button
      id="temoin-coffre-oublier"
      type="button"
      class="hidden min-h-8 rounded px-2 text-xs font-medium text-amber-900 underline underline-offset-2 transition hover:bg-amber-100 dark:text-amber-100 dark:hover:bg-amber-900/40"
      >Oublier sur cet appareil</button
    >
  </div>
</div>

<script>
  import { fermerLeCoffre, modeDuCoffre, oublierLAppareil, reprendreLeCoffre, surCoffre } from '../lib/coffre';

  const temoin = document.getElementById('temoin-coffre');
  const libelle = document.getElementById('temoin-coffre-libelle');
  const oublier = document.getElementById('temoin-coffre-oublier');

  if (temoin && libelle && oublier) {
    const peindre = (ouvert: boolean) => {
      temoin.classList.toggle('hidden', !ouvert);
      if (!ouvert) return;
      const mode = modeDuCoffre();
      libelle.textContent =
        mode === 'appareil' ? 'Coffre ouvert (mémorisé sur cet appareil)' : 'Coffre ouvert (session)';
      oublier.classList.toggle('hidden', mode !== 'appareil');
    };

    surCoffre(peindre);
    document.getElementById('temoin-coffre-fermer')?.addEventListener('click', () => fermerLeCoffre());
    oublier.addEventListener('click', () => oublierLAppareil());

    /*
       Le témoin doit être juste dès la première peinture, y compris sur une
       page qui n'ouvre pas le coffre elle-même : sans cette reprise, il
       resterait caché alors que le coffre est ouvert pour l'onglet, et
       l'interdit 6 ne serait tenu que sur les pages du coffre.
    */
    void reprendreLeCoffre().then(peindre);
  }
</script>
