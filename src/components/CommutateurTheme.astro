---
/**
 * Commutateur de thème — clair / sombre / système.
 *
 * Même principe que sur les sites de l'État (info.gouv.fr) : trois options
 * explicites, la dernière suivant la préférence du système d'exploitation.
 *
 * Deux valeurs distinctes circulent, et il est important de ne pas les
 * confondre :
 *
 *   • le CHOIX      — « clair », « sombre » ou « systeme », conservé dans
 *                     localStorage sous la clé « revinsp.theme » et reflété
 *                     par l'attribut « data-theme-choix » sur <html> ;
 *   • le THÈME RENDU — « clair » ou « sombre », porté par « data-theme »,
 *                     c'est lui seul que le CSS regarde.
 *
 * Le choix par défaut, en l'absence de valeur enregistrée, est « sombre » :
 * l'expérience existante ne change pas tant que rien n'est choisi.
 *
 * ## Depuis le 42 : la bascule jour/nuit passe devant
 *
 * Quand la bascule automatique est active — et elle l'est par défaut —, le
 * mode ne vient plus d'ici mais de l'heure. Le menu le dit, et choisir un
 * mode **arrête la bascule**. C'est un choix de conception, et il mérite
 * d'être défendu : les trois autres conduites possibles étaient pires.
 * Griser les options aurait laissé un menu mort sans dire pourquoi ;
 * appliquer le mode jusqu'à la prochaine bascule l'aurait fait disparaître
 * tout seul une heure plus tard ; et arrêter la bascule en silence aurait
 * changé un réglage que la personne n'a pas touché. Ici, le menu annonce la
 * conséquence avant le geste.
 *
 * La palette, elle, ne se choisit pas ici : elle est dans la section
 * « Affichage » des paramètres, avec ses quatorze aperçus.
 *
 * ## Le chemin du retour (décision du 18 octobre, 19 h 52)
 *
 * Annoncer qu'un geste arrête la bascule ne suffit pas : il faut dire où on la
 * remet. La note porte donc le chemin, et ce chemin est un **lien** plutôt
 * qu'un itinéraire à lire — la section « Affichage » a une ancre, autant s'en
 * servir. Le lien est au fil d'une phrase : il prend « cible-minimale » (24 px,
 * le plancher de WCAG 2.5.8) et non « cible-tactile », que `essais:mobile`
 * interdit justement là (M4, D-041).
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="relative">
  <button
    id="bouton-theme"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="menu-theme"
    title="Choisir le thème"
    aria-label="Choisir le thème d'affichage"
    class="flex h-11 w-11 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-indigo-600 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-indigo-400"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3v18" stroke-linecap="round"></path>
      <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
    </svg>
  </button>

  <div
    id="menu-theme"
    role="group"
    aria-label="Thème d'affichage"
    hidden
    class="apparition apparition-glisse absolute right-0 z-50 mt-2 w-52 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg dark:border-slate-700 dark:bg-slate-900"
  >
    <p class="px-2 py-1.5 text-xs font-bold tracking-wide text-slate-500 uppercase dark:text-slate-400">
      Thème d'affichage
    </p>
    <p id="note-bascule" hidden class="px-2 pb-1.5 text-xs text-slate-500 dark:text-slate-400">
      Clair le jour, sombre la nuit : choisir un mode ici arrête cette bascule. Vous pourrez la
      réactiver dans la <a
        href={`${base}/parametres/#affichage`}
        class="cible-minimale underline decoration-slate-400 underline-offset-2"
        >section « Affichage » des paramètres</a
      >.
    </p>
    {
      [
        { valeur: 'clair', libelle: 'Clair', detail: 'Palette institutionnelle' },
        { valeur: 'sombre', libelle: 'Sombre', detail: 'Confort en soirée' },
        { valeur: 'systeme', libelle: 'Système', detail: 'Suit votre appareil' },
      ].map((option) => (
        <button
          type="button"
          data-choix-theme={option.valeur}
          aria-pressed="false"
          class="group flex w-full items-start gap-2 rounded-md px-2 py-2 text-left text-sm transition hover:bg-slate-100 aria-pressed:bg-indigo-50 aria-pressed:text-indigo-700 dark:hover:bg-slate-800 dark:aria-pressed:bg-indigo-950 dark:aria-pressed:text-indigo-300"
        >
          <span
            aria-hidden="true"
            class="pastille-theme mt-0.5 h-4 w-4 shrink-0 rounded-full border-2 border-slate-400 group-aria-pressed:border-indigo-600 dark:border-slate-500 dark:group-aria-pressed:border-indigo-400"
          />
          <span class="min-w-0">
            <span class="block font-medium">{option.libelle}</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">{option.detail}</span>
          </span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import {
    appliquer,
    ecrireBascule,
    ecrireChoixDeMode,
    lireBascule,
    lireChoixDeMode,
    modeVoulu,
    surveillerLHeure,
    type Choix,
  } from '../lib/theme';

  const bouton = document.getElementById('bouton-theme');
  const menu = document.getElementById('menu-theme');
  const note = document.getElementById('note-bascule');
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choix-theme]'));

  /** Reflète l'état courant sur les options et la note. */
  function refleter() {
    const bascule = lireBascule();
    if (note) note.hidden = !bascule;
    const actif = bascule ? modeVoulu() : lireChoixDeMode();
    for (const option of options) {
      option.setAttribute('aria-pressed', String(!bascule && option.dataset.choixTheme === actif));
    }
  }

  function ouvrir(ouvert: boolean) {
    menu!.hidden = !ouvert;
    bouton!.setAttribute('aria-expanded', String(ouvert));
  }

  bouton?.addEventListener('click', (evenement) => {
    evenement.stopPropagation();
    refleter();
    ouvrir(Boolean(menu!.hidden));
  });

  for (const option of options) {
    option.addEventListener('click', () => {
      /*
         L'ordre compte : on arrête la bascule AVANT d'écrire le choix, sinon
         `ecrireChoixDeMode` appliquerait un mode que la bascule écraserait
         dans la foulée, et le clic n'aurait rien fait de visible.
      */
      if (lireBascule()) ecrireBascule(false);
      ecrireChoixDeMode(option.dataset.choixTheme as Choix);
      refleter();
      ouvrir(false);
      bouton?.focus();
    });
  }

  document.addEventListener('click', (evenement) => {
    if (!menu!.hidden && !menu!.contains(evenement.target as Node)) ouvrir(false);
  });

  document.addEventListener('keydown', (evenement) => {
    if (evenement.key === 'Escape' && !menu!.hidden) {
      ouvrir(false);
      bouton?.focus();
    }
  });

  /* La bascule de l'heure, et le mode « système », sont surveillés par le
     module : ici on ne fait que suivre ce qu'il applique. */
  surveillerLHeure();
  document.addEventListener('revinsp:theme', refleter);
  appliquer();
  refleter();
</script>

<style>
  /*
     A9 — LA PASTILLE N'ANIME PLUS SON ÉPAISSEUR DE BORDURE.

     Elle passait de 2 px à 5 px de bordure, en « transition-all ». Animer une
     épaisseur de bordure, c'est animer la boîte : le navigateur recalcule la
     mise en page à chaque image, exactement ce que l'interdit n° 4 proscrit
     pour la largeur. Le défaut était invisible — la pastille fait 16 px —,
     mais c'est le même mécanisme.

     Une ombre intérieure donne le même anneau épais sans toucher à la boîte :
     elle se peint, elle ne se mesure pas. La bordure, elle, ne change plus que
     de couleur.
  */
  .pastille-theme {
    box-shadow: inset 0 0 0 0 transparent;
    transition:
      box-shadow var(--duree-courte) var(--courbe-sortie),
      border-color var(--duree-courte) var(--courbe-sortie);
  }
  .group[aria-pressed='true'] .pastille-theme {
    box-shadow: inset 0 0 0 3px var(--color-indigo-600);
  }
  :root.dark .group[aria-pressed='true'] .pastille-theme,
  .dark .group[aria-pressed='true'] .pastille-theme {
    box-shadow: inset 0 0 0 3px var(--color-indigo-400);
  }
</style>
