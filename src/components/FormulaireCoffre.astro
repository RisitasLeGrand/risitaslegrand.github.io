---
/**
 * Le formulaire d'ouverture du coffre, partagé.
 *
 * Il était recopié dans neuf pages, à la virgule près sauf la phrase
 * d'explication. C'est cette duplication qui a produit l'écart relevé le
 * 14 octobre : six pages sur dix sans bouton de fermeture. Un bloc recopié
 * n'évolue jamais partout.
 *
 * Les identifiants restent ceux d'avant — `coffre-ferme`, `mdp-coffre`,
 * `ouvrir-coffre`, `erreur-coffre` — pour que les scripts des neuf pages
 * continuent de fonctionner sans être réécrits.
 */
interface Props {
  /** Ce que cet écran garde, en une phrase. Propre à la page. */
  raison?: string;
  /**
   * Sans cadre ni titre.
   *
   * `corps.astro` loge le champ **à l'intérieur** d'une carte existante : lui
   * poser une seconde carte ferait un cadre dans un cadre. La variante garde
   * les mêmes identifiants et les mêmes cases, et ne change que l'habillage —
   * c'est la présentation qui diffère d'un écran à l'autre, pas la promesse.
   */
  nu?: boolean;
}
import { base } from '../lib/ui';

const { raison, nu = false } = Astro.props;
const cadre = nu
  ? 'mt-4 hidden'
  : 'hidden rounded-2xl border-2 border-slate-300 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900';
---

{/*
   A7 DU 58 — LE SIGNAL « LA CLÉ QUI LES OUVRE A DISPARU ».

   Il est ici, dans le formulaire partagé, et nulle part ailleurs : les neuf
   écrans sous coffre passent par ce bloc, donc le signal paraît partout d'un
   coup. Le recopier aurait reproduit l'écart du 14 octobre — six pages sur
   dix sans bouton de fermeture, parce qu'un bloc recopié n'évolue jamais
   partout.

   Il reste caché dans le cas normal, et il ne s'affiche que sur le constat
   mesuré : des enregistrements scellés en base, aucune enveloppe, aucun sel.
   Les trois conditions ensemble, parce qu'aucune ne suffit — un sel absent
   sur une base vierge est le cas de tous les premiers jours.
*/}
<section
  id="coffre-sans-cle"
  class="hidden rounded-2xl border-2 border-amber-400 bg-amber-50 p-4 dark:border-amber-700 dark:bg-amber-950/40"
>
  <h2 class="text-lg font-semibold text-amber-900 dark:text-amber-100">
    La clé de vos données chiffrées a disparu
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-amber-900 dark:text-amber-100">
    Des données chiffrées sont présentes sur cet appareil, mais la clé qui les
    ouvre a disparu. Elles ne peuvent plus être lues ici, et <strong>aucun mot
    de passe ne les rouvrira</strong> — ce n'est pas un mot de passe oublié,
    c'est la clé elle-même qui n'est plus là. Restaurez une sauvegarde pour les
    retrouver.
  </p>
  <p id="coffre-sans-cle-compte" class="mt-2 text-sm text-amber-900 dark:text-amber-100"></p>
  <div class="mt-3 flex flex-wrap gap-2">
    <a
      href={`${base}/progression/#restaurer`}
      class="cible-tactile rounded-lg bg-amber-700 px-4 py-2 text-sm font-medium text-white transition hover:bg-amber-800"
      >Restaurer une sauvegarde</a
    >
    {/*
       Repartir à zéro est possible, mais jamais en silence : le bouton le
       nomme, et la confirmation cite le message ci-dessus avec le nombre
       d'enregistrements qui partiraient.
    */}
    <button
      id="coffre-recreer"
      type="button"
      class="cible-tactile rounded-lg border border-amber-500 px-4 py-2 text-sm font-medium text-amber-900 transition hover:bg-amber-100 dark:text-amber-100 dark:hover:bg-amber-900/40"
      >Repartir d'un coffre neuf</button
    >
  </div>
  <p id="coffre-sans-cle-message" class="mt-3 hidden text-sm"></p>
</section>

<section id="coffre-ferme" class={cadre}>
  {!nu && <h2 class="text-lg font-semibold text-slate-900 dark:text-white">🔒 Ouvrir le coffre</h2>}
  {raison && <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{raison}</p>}
  <label class="block text-sm">
    <span class="block text-slate-700 dark:text-slate-200">Mot de passe</span>
    <input
      id="mdp-coffre"
      type="password"
      autocomplete="current-password"
      class="mt-1 min-h-11 w-full max-w-sm rounded-lg border border-slate-300 bg-white px-3 text-sm dark:border-slate-700 dark:bg-slate-950"
    />
  </label>

  <label class="mt-3 flex items-start gap-2 text-sm">
    <input id="coffre-session" type="checkbox" checked class="mt-1 h-4 w-4 shrink-0 rounded border-slate-300" />
    <span class="text-slate-700 dark:text-slate-200">
      Garder le coffre ouvert pendant cette session
      <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
        Le coffre reste ouvert tant que cet onglet l’est, d’une page à l’autre et
        après un rechargement. Fermer l’onglet le referme.
      </span>
    </span>
  </label>

  <label id="ligne-coffre-appareil" class="mt-3 flex items-start gap-2 text-sm">
    <input id="coffre-appareil" type="checkbox" class="mt-1 h-4 w-4 shrink-0 rounded border-slate-300" />
    <span class="text-slate-700 dark:text-slate-200">
      Mémoriser le coffre sur cet appareil
      <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
        Le coffre se rouvrira sans mot de passe, même après avoir fermé le
        navigateur. <strong>Quiconque utilise cet appareil et ce navigateur
        pourra alors ouvrir le coffre sans le connaître.</strong> Révocable par
        « Oublier sur cet appareil ».
      </span>
    </span>
  </label>

  <button
    id="ouvrir-coffre"
    type="button"
    class="mt-3 min-h-11 rounded-lg bg-slate-800 px-4 text-sm font-medium text-white transition hover:bg-slate-900 dark:bg-slate-200 dark:text-slate-900"
    >Ouvrir</button
  >
  <p id="erreur-coffre" class="mt-2 hidden text-sm text-rose-700 dark:text-rose-300"></p>
  {/*
     Le coffre est celui des deux mots de passe dont la perte est
     irrémédiable : la clé des données n'existe qu'enveloppée sous lui. Le
     lien doit donc être ici, et pas seulement sur l'écran d'entrée.
  */}
  <p class="mt-2 text-xs">
    <a
      href={`${base}/mot-de-passe-perdu/`}
      class="cible-tactile text-slate-500 underline underline-offset-2 transition hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
      >Mot de passe perdu ?</a
    >
  </p>
</section>

<script>
  /*
     A7 — LE CONSTAT EST FAIT À CHAQUE OUVERTURE DE PAGE SOUS COFFRE.

     Pas au premier déverrouillage seulement : la clé peut disparaître entre
     deux visites, et c'est même le cas le plus probable — un nettoyage de
     site, un effacement trop large. Le constat coûte une lecture par magasin
     scellé, et il s'arrête au premier enregistrement trouvé.
  */
  void (async () => {
    const bloc = document.getElementById('coffre-sans-cle');
    if (!bloc) return;
    const { laCleDuCoffreADisparu, recreerLeCoffre, combienDeScellesIllisibles } = await import(
      '../lib/coffre'
    );
    if (!(await laCleDuCoffreADisparu())) return;

    bloc.classList.remove('hidden');
    /*
       Le formulaire d'ouverture disparaît : proposer un mot de passe qui ne
       peut rien ouvrir serait la cruauté de cet écran, et c'est exactement ce
       que faisait la version d'avant.
    */
    document.getElementById('coffre-ferme')?.classList.add('hidden');

    const combien = await combienDeScellesIllisibles();
    const compte = document.getElementById('coffre-sans-cle-compte');
    if (compte) {
      compte.textContent =
        `${combien.toLocaleString('fr-FR')} enregistrement(s) chiffré(s) sont dans ce cas.`;
    }

    document.getElementById('coffre-recreer')?.addEventListener('click', () => {
      void (async () => {
        const { confirmer, demanderUnTexte } = await import('../lib/boite');
        const certain = await confirmer({
          titre: 'Repartir d’un coffre neuf ?',
          texte:
            'Les données chiffrées présentes sur cet appareil ne peuvent plus être lues : ' +
            `la clé qui les ouvre a disparu. Repartir d’un coffre neuf retire ces ` +
            `${combien.toLocaleString('fr-FR')} enregistrement(s), définitivement. ` +
            'Si vous avez une sauvegarde, restaurez-la plutôt : elle contient la clé.',
          action: 'Repartir d’un coffre neuf',
          annuler: 'Annuler',
          destructrice: true,
        });
        if (!certain) return;
        const mdp = await demanderUnTexte({
          titre: 'Mot de passe du nouveau coffre',
          texte: 'Il protégera les données que vous enregistrerez à partir de maintenant.',
          etiquette: 'Mot de passe',
          action: 'Créer le coffre',
          attributs: { type: 'password', autocomplete: 'new-password' },
        });
        if (!mdp) return;
        const message = document.getElementById('coffre-sans-cle-message');
        try {
          const retires = await recreerLeCoffre(mdp);
          if (message) {
            message.textContent =
              `Coffre neuf créé. ${retires.toLocaleString('fr-FR')} enregistrement(s) ` +
              'illisibles ont été retirés.';
            message.classList.remove('hidden');
          }
          location.reload();
        } catch (e) {
          if (message) {
            message.textContent = (e as Error).message;
            message.classList.remove('hidden');
          }
        }
      })();
    });
  })();

  /*
     La seconde case ne paraît qu'une fois la première cochée : mémoriser sans
     garder ouvert n'aurait aucun sens, et proposer les deux de front
     inviterait à cocher la plus engageante sans y penser.
  */
  const session = document.getElementById('coffre-session') as HTMLInputElement | null;
  const ligne = document.getElementById('ligne-coffre-appareil');
  const appareil = document.getElementById('coffre-appareil') as HTMLInputElement | null;
  if (session && ligne && appareil) {
    const ajuster = () => {
      ligne.classList.toggle('hidden', !session.checked);
      if (!session.checked) appareil.checked = false;
    };
    ajuster();
    session.addEventListener('change', ajuster);
  }
</script>
