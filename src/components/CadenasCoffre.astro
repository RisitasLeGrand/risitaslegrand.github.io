---
/**
 * Le cadenas compact, dans la rangée d'actions de l'en-tête.
 *
 * **Pourquoi il existe.** Le bandeau ambre prend 57 px, soit 7,7 % d'un
 * écran de téléphone, et Alexis a demandé à pouvoir le fermer. Mais
 * l'interdit 6 du prompt 35 veut « Fermer le coffre » atteignable *partout
 * où le coffre est ouvert*, et il n'est pas négociable : on ne peut donc pas
 * se contenter de masquer le bandeau, il faut que le geste survive ailleurs.
 *
 * Ce cadenas est cet ailleurs. Il est présent dès que le coffre est ouvert,
 * **que le bandeau soit affiché ou non**, et il porte les mêmes gestes :
 * fermer, oublier l'appareil, et revoir le bandeau.
 *
 * **Pourquoi un menu et non trois boutons.** Trois boutons dans une rangée
 * qui porte déjà la cloche, le thème et le menu, à 360 px, c'est la rangée
 * qui déborde. Le menu tient en une cible de 44 px et ne coûte un appui de
 * plus qu'à qui veut autre chose que « voir que le coffre est ouvert ».
 */
import { base } from '../lib/ui';
import Icone from './Icone.astro';
---

<div id="cadenas-coffre" class="relative hidden">
  <button
    id="cadenas-coffre-bouton"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Coffre ouvert"
    title="Coffre ouvert"
    class="cible-tactile-pleine rounded-lg px-2 text-amber-700 transition hover:bg-amber-50 dark:text-amber-300 dark:hover:bg-amber-950/40"
  >
    <Icone nom="coffre-ouvert" taille={18} />
  </button>

  <div
    id="cadenas-coffre-menu"
    role="menu"
    aria-label="Coffre"
    class="absolute right-0 z-50 mt-1 hidden w-60 rounded-xl border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900"
  >
    <button
      id="cadenas-fermer"
      type="button"
      role="menuitem"
      class="cible-tactile w-full rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >Fermer le coffre</button
    >
    <button
      id="cadenas-oublier"
      type="button"
      role="menuitem"
      class="cible-tactile hidden w-full rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >Oublier sur cet appareil</button
    >
    <button
      id="cadenas-afficher-bandeau"
      type="button"
      role="menuitem"
      class="cible-tactile hidden w-full rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >Afficher le bandeau</button
    >
    {/*
       Le miroir du précédent, et il est arrivé avec M5 : sous 640 px, le
       bandeau n'affiche plus que « Fermer le coffre » et « Masquer », faute
       de largeur pour cinq libellés sur une rangée. « Masquer indéfiniment »
       doit donc exister ailleurs, sinon le réglage deviendrait inatteignable
       sur l'appareil qui en a le plus besoin.
    */}
    <button
      id="cadenas-masquer-toujours"
      type="button"
      role="menuitem"
      class="cible-tactile hidden w-full rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >Masquer le bandeau indéfiniment</button
    >
    {/*
       La bascule vit dans le menu du cadenas, et non dans « Stockage », parce
       que c'est un geste DU COFFRE : on y arrive en pensant au coffre, pas en
       pensant à la place disque. Elle est séparée des trois autres par un
       filet, parce qu'elle ne se range pas avec elles — les trois premières se
       défont, celle-ci rechiffre.
    */}
    <hr class="my-1 border-slate-200 dark:border-slate-700" />
    <a
      id="cadenas-bascule"
      href={`${base}/coffre/bascule/`}
      role="menuitem"
      class="cible-tactile w-full rounded-lg px-3 text-left text-sm text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >Mot de passe du coffre…</a
    >
  </div>
</div>

<script>
  import {
    brancherLeVerrouAutomatique,
    delaiDuVerrouAutomatique,
    fermerLeCoffre,
    modeDuCoffre,
    oublierLAppareil,
    reprendreLeCoffre,
    surCoffre,
  } from '../lib/coffre';
  import {
    afficherLeBandeau,
    bandeauVoulu,
    masquerIndefiniment,
    surBandeau,
  } from '../lib/coffre-bandeau';
  import { calqueFerme, calqueOuvert } from '../lib/calques';

  /*
     Le verrou automatique se branche ici parce que ce composant est monté
     dans les DEUX en-têtes, donc sur toute page où le coffre peut être
     ouvert. Le brancher dans la mise en page aurait marché aussi ; le mettre
     à côté du cadenas garde ensemble les deux façons de refermer le coffre,
     celle qu'on choisit et celle qui arrive toute seule.

     Le délai est lu avant de brancher, et non après : brancher d'abord
     poserait le verrou à quinze minutes pendant le temps de la lecture, et
     une personne qui l'a désactivé verrait son coffre se fermer quand même
     si elle rechargeait au mauvais moment.
  */
  delaiDuVerrouAutomatique().then((delai) => brancherLeVerrouAutomatique(delai));

  const zone = document.getElementById('cadenas-coffre');
  const bouton = document.getElementById('cadenas-coffre-bouton');
  const menu = document.getElementById('cadenas-coffre-menu');
  const oublier = document.getElementById('cadenas-oublier');
  const afficher = document.getElementById('cadenas-afficher-bandeau');
  const masquerToujours = document.getElementById('cadenas-masquer-toujours');

  if (zone && bouton && menu && oublier && afficher && masquerToujours) {
    const fermerLeMenu = () => {
      menu.classList.add('hidden');
      bouton.setAttribute('aria-expanded', 'false');
      calqueFerme('cadenas');
    };

    const peindre = (ouvert: boolean) => {
      zone.classList.toggle('hidden', !ouvert);
      if (!ouvert) {
        fermerLeMenu();
        return;
      }
      oublier.classList.toggle('hidden', modeDuCoffre() !== 'appareil');
      /*
         « Afficher le bandeau » n'a de sens que s'il est masqué. Le proposer
         toujours ferait un menu dont une entrée sur trois ne fait rien.
      */
      afficher.classList.toggle('hidden', bandeauVoulu());
      masquerToujours.classList.toggle('hidden', !bandeauVoulu());
    };

    surCoffre(peindre);
    surBandeau(() => peindre(!zone.classList.contains('hidden')));
    void reprendreLeCoffre().then(peindre);

    bouton.addEventListener('click', () => {
      const ouvert = menu.classList.toggle('hidden') === false;
      bouton.setAttribute('aria-expanded', String(ouvert));
      /* M5 : le retour arrière referme le menu plutôt que de quitter l'écran. */
      if (ouvert) calqueOuvert('cadenas', fermerLeMenu);
      else calqueFerme('cadenas');
    });

    document.getElementById('cadenas-fermer')?.addEventListener('click', () => {
      fermerLeMenu();
      void fermerLeCoffre();
    });
    oublier.addEventListener('click', () => {
      fermerLeMenu();
      void oublierLAppareil();
    });
    afficher.addEventListener('click', () => {
      afficherLeBandeau();
      fermerLeMenu();
    });
    masquerToujours.addEventListener('click', () => {
      masquerIndefiniment();
      fermerLeMenu();
    });

    /* Échap referme, et rend le focus au bouton : le laisser tomber sur BODY
       perd la place de qui navigue au clavier. */
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || menu.classList.contains('hidden')) return;
      fermerLeMenu();
      bouton.focus();
    });

    document.addEventListener('click', (e) => {
      if (!zone.contains(e.target as Node)) fermerLeMenu();
    });
  }
</script>
