---
/**
 * Pied de page structuré en colonnes de liens thématiques.
 *
 * La structure est celle des sites de l'administration (service-public.gouv.fr) ;
 * le CONTENU, lui, est celui d'un site personnel. On n'y reprend donc ni le
 * bloc-marque de l'État, ni les mentions propres à un service public — ce site
 * n'en est pas un, et la mention finale le dit explicitement.
 *
 * ## Le pied dit où l'on est, pas tout ce qui existe
 *
 * Il a connu deux états, et c'est le second qu'on corrige ici.
 *
 * 1. Les colonnes étaient **écrites en dur** et listaient les écrans de
 *    Révisions sur toutes les pages, y compris celles d'Odyssée et de Sport.
 * 2. Elles sont venues du **registre des branches** — le codage en dur a
 *    disparu, mais le pied est resté **le même partout** : une seule valeur
 *    distincte sur les cinquante pages. Sur le menu, qui est au-dessus des
 *    branches, il déroulait leurs trente onglets ; sur une page d'Odyssée, il
 *    proposait les douze onglets de Révisions que la barre venait justement
 *    de cesser d'afficher. Le défaut d'origine avait changé de forme, pas de
 *    nature.
 *
 * Désormais le pied est **contextuel**, et sa portée est celle de l'en-tête :
 *
 * - **Au-dessus des branches** (le menu, le profil, l'export, l'import —
 *   c'est-à-dire les pages à en-tête léger) : les trois branches, et rien de
 *   leur intérieur. On n'y entre pas par un onglet pris au hasard.
 * - **Dans une branche** : ses onglets et ses écrans sans onglet, puis le
 *   retour au menu et les autres branches.
 *
 * ## Ce que cela retire, et où c'est reparti
 *
 * Rien ne devient inatteignable : les onglets des autres branches sont à deux
 * clics — la branche, puis l'onglet — au lieu d'un, et la colonne
 * « Cyclades » les nomme sur chaque page. En échange, six écrans qui
 * n'étaient dans aucun pied (« Appareils », « À rapprocher », « Mes règles »,
 * « Qui lit mon budget », « Exporter », « Importer ») y sont enfin, auprès de
 * ce à quoi ils appartiennent.
 */
import config from '../../site.config.mjs';
import {
  branchesDisponibles,
  ECRANS_COMMUNS,
  type Branche,
  type Onglet,
} from '../lib/branches';

interface Props {
  /**
   * L'identifiant de la branche où l'on se trouve, ou `menu` pour les pages
   * qui sont au-dessus des branches.
   *
   * C'est la mise en page qui le dit, et non un calcul refait ici sur le
   * chemin : elle a déjà tranché la même question pour choisir l'en-tête, et
   * deux réponses à une seule question finiraient par diverger. Un pied qui
   * annoncerait Révisions sous un en-tête de menu serait exactement
   * l'incohérence qu'on corrige.
   */
  portee: string;

  /**
   * Y a-t-il une barre du bas fixe sur cet écran ?
   *
   * La question vient de la mise en page, qui l'a déjà tranchée pour choisir
   * l'en-tête. Le pied ne la recalcule pas : `portee` ne suffirait pas, un
   * écran à en-tête léger pouvant appartenir à une branche.
   *
   * Mesuré le 18 octobre à 360 × 740, avant correction : le dépliant
   * « Mentions » occupait 676 à 720 px, la barre du bas commençait à 683, et
   * `elementFromPoint` rendait la barre — le dépliant était INATTEIGNABLE.
   * Le défaut existait déjà : les mentions en texte passaient dessous. Il
   * devenait plus grave en portant une commande.
   */
  barreDuBas?: boolean;
}

const { portee, barreDuBas = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lien = (o: Onglet) => ({
  libelle: o.nom,
  href: `${base}${o.chemin}`,
  /* Les parcours servis voyagent en attribut : c'est le client qui tranche. */
  parcours: o.parcours ? o.parcours.join(' ') : null,
});

const branches = branchesDisponibles();
const courante: Branche | undefined = branches.find((b) => b.id === portee);
const autres = branches.filter((b) => b.id !== courante?.id);

const colonneBranches = {
  titre: courante ? 'Cyclades' : 'Les branches',
  liens: [
    ...(courante ? [{ libelle: `Menu de ${config.titre}`, href: `${base}/` }] : []),
    /*
       Le libellé seul, sans l'icône.

       Il portait « ${b.icone} ${b.libelle} », ce qui marchait tant que l'icône
       était un émoji. Depuis qu'elle est un NOM de tracé, l'interpoler
       afficherait « revisions Révisions ». Et ce pied est une liste de liens
       construite en données : on n'y place pas un composant. L'icône n'y
       manque pas — un pied de page se lit, il ne se parcourt pas à la vitesse
       d'un ruban.
    */
    ...autres.map((b) => ({ libelle: b.libelle, href: `${base}${b.racine}` })),
  ],
};

/*
   Le pied s'est allégé (N6).

   Il portait trente-huit liens sur quatre colonnes, soit sept cents pixels
   sur ordinateur et mille sur téléphone, **sur chaque page** — y compris
   pendant une épreuve blanche. Il doublait la barre d'onglets, et servait de
   seule navigation sur téléphone parce que la barre y était invisible.

   La barre du bas répare ce dernier point : le pied n'a plus à porter le plan
   du site. Il garde les **annexes** de la branche — les écrans sans onglet,
   qui n'apparaissent nulle part ailleurs —, les autres branches, et « Cet
   espace ». Les onglets, eux, sont dans la barre, en haut et en bas.
*/
/*
   UN LIEN PROPRE À CERTAINS PARCOURS NE PEUT PAS ÊTRE FILTRÉ ICI.

   Ce composant est rendu à la CONSTRUCTION ; le parcours courant vit dans
   « localStorage » et n'existe que dans le navigateur. Le lien est donc écrit
   pour tout le monde, avec les parcours qu'il sert en attribut, et le script
   du bas le cache quand le parcours ouvert ne le sert pas — puis le rouvre si
   l'on change de parcours, sans recharger la page.

   L'alternative — rendre quatre pieds de page et choisir au chargement —
   coûterait quatre fois le poids pour une ligne de différence.
*/
const colonnes = [
  ...(courante && (courante.annexes ?? []).length
    ? [{ titre: courante.libelle, liens: (courante.annexes ?? []).map(lien) }]
    : []),
  colonneBranches,
  { titre: 'Cet espace', liens: ECRANS_COMMUNS.map(lien) },
];
---

<!--
  LE PIED EST DISCRET — consigne d'Alexis du 18 octobre, relayée pendant M7 :
  « Le pied de page doit être discret. »

  ## Ce qu'il était, mesuré le 18 octobre à 360 × 740

  1 190 px de haut : un bandeau tricolore, un panneau opaque posé sur le fond
  de la page, trois colonnes à titres capitales grasses, treize liens, puis
  trois paragraphes de mentions. Plus haut qu'un écran et demi, pour ce qui
  est le dernier recours et non la destination.

  ## Ce qu'il est devenu, et pourquoi chaque choix

  - **Plus de bandeau tricolore ni de fond opaque.** Les deux attiraient
    l'œil, et le second posait un rectangle clair en bas de chaque page. Il
    ne reste qu'un filet d'un pixel ; le fond de la page passe au travers.
  - **Les liens tiennent en lignes qui s'enroulent**, précédées d'une
    étiquette menue, au lieu de colonnes à titres. À treize liens, une
    colonne par thème coûtait plus de hauteur que les liens eux-mêmes.
  - **Le texte est menu et de teinte secondaire**, pris sur les jetons :
    `slate` est redéfini dans `tokens.css`, donc ces classes suivront les
    thèmes à venir sans retouche — ce que la règle générale d'Alexis exige.
  - **Les mentions se replient.** Trois paragraphes de clause juridique
    n'ont rien à faire sous chaque écran dépliés ; un `<details>` les garde
    à un geste, et **rien ne disparaît** : même texte, même place.
  - **Les cibles gardent leurs 44 px** sous pointeur grossier, par
    `cible-tactile`. Mesuré : treize liens sur treize à 44 px avant comme
    après. L'étiquette de groupe n'est pas un lien et n'en a pas besoin.

  Aucun lien, aucune route n'est retiré : l'inventaire des treize `href` est
  identique avant et après, et il est comparé fichier contre fichier.
-->
<footer class="mt-10 border-t border-slate-200 dark:border-slate-800">
  <div
    class:list={[
      'mx-auto max-w-6xl px-4 py-5',
      /* La barre du bas recouvrait la dernière ligne du pied, dépliant
         compris. Le contenu principal se dégage déjà ainsi (`contenu-sur`) ;
         le pied le fait désormais aussi, et seulement là où la barre existe. */
      barreDuBas ? 'contenu-sur' : '',
    ]}
  >
    {
      colonnes.map((colonne) => (
        <nav aria-label={colonne.titre} class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-0.5 last:mb-0">
          <h2 class="shrink-0 text-xs text-slate-400 dark:text-slate-500">{colonne.titre}</h2>
          {colonne.liens.map((lienDeColonne) => (
            <a
              href={lienDeColonne.href}
              data-parcours={'parcours' in lienDeColonne ? lienDeColonne.parcours : null}
              class="cible-tactile text-xs text-slate-500 underline-offset-4 transition hover:text-indigo-600 hover:underline dark:text-slate-400 dark:hover:text-indigo-400"
            >
              {lienDeColonne.libelle}
            </a>
          ))}
        </nav>
      ))
    }

    <p class="mt-3 text-xs text-slate-400 dark:text-slate-500">
      <strong class="font-medium text-slate-500 dark:text-slate-400">{config.titre}</strong> — espace
      de révision personnel, chiffré, sans compte ni mesure d'audience.
    </p>

    <script>
      /*
         LES LIENS PROPRES À UN PARCOURS, CACHÉS QUAND IL N'EST PAS OUVERT.

         Le pied est rendu à la construction ; le parcours courant vit dans
         « localStorage ». Ce script est donc la seule place où le tri peut se
         faire — et il se refait à chaque changement de parcours, sans
         recharger la page, parce que l'en-tête permet d'en changer sans
         quitter l'écran.

         Un lien sans attribut n'est jamais touché : l'absence de restriction
         veut dire « pour tout le monde », et un script qui cacherait par
         défaut viderait le pied au premier défaut de lecture.
      */
      const CLE = 'revinsp.parcours';
      const DEFAUT = 'insp';
      const trier = () => {
        let ouvert = DEFAUT;
        try {
          ouvert = localStorage.getItem(CLE) ?? DEFAUT;
        } catch {
          /* Navigation privée, cookies bloqués : le parcours par défaut. */
        }
        /* « querySelectorAll » rend des « Element » : on dit lesquels, sinon
           « hidden » n'existe pas pour le vérificateur de types. */
        for (const a of document.querySelectorAll<HTMLAnchorElement>('footer a[data-parcours]')) {
          const servis = (a.getAttribute('data-parcours') ?? '').split(' ').filter(Boolean);
          const sert = servis.length === 0 || servis.includes(ouvert);
          a.hidden = !sert;
        }
      };
      trier();
      document.addEventListener('cyclades:parcours', trier);
    </script>

    <details class="mt-1">
      <summary class="cible-tactile cursor-pointer text-xs text-slate-400 underline-offset-4 hover:underline dark:text-slate-500">
        Mentions
      </summary>
      <p class="mt-2 text-xs leading-relaxed text-slate-400 dark:text-slate-500">
        Site personnel, <strong>sans lien avec l'administration</strong> et sans caractère de
        service public. L'identité visuelle s'inspire de la charte graphique de l'État ; ni la
        typographie Marianne, ni le bloc-marque (logo et mention « République Française »), ni la
        présentation officielle de la devise ne sont repris — ces éléments sont réservés aux
        services de l'État.
      </p>
      <p class="mt-2 text-xs leading-relaxed text-slate-400 dark:text-slate-500">
        Polices <strong>Public Sans</strong> et <strong>Spectral</strong>, sous licence SIL Open
        Font License, servies depuis ce site : aucune requête n'est adressée à un service tiers.
      </p>
    </details>
  </div>
</footer>
