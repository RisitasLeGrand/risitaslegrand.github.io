---
/**
 * Pied de page structuré en colonnes de liens thématiques.
 *
 * La structure est celle des sites de l'administration (service-public.gouv.fr) ;
 * le CONTENU, lui, est celui d'un site personnel. On n'y reprend donc ni le
 * bloc-marque de l'État, ni les mentions propres à un service public — ce site
 * n'en est pas un, et la mention finale le dit explicitement.
 *
 * ## Le pied dit où l'on est, pas tout ce qui existe
 *
 * Il a connu deux états, et c'est le second qu'on corrige ici.
 *
 * 1. Les colonnes étaient **écrites en dur** et listaient les écrans de
 *    Révisions sur toutes les pages, y compris celles d'Odyssée et de Sport.
 * 2. Elles sont venues du **registre des branches** — le codage en dur a
 *    disparu, mais le pied est resté **le même partout** : une seule valeur
 *    distincte sur les cinquante pages. Sur le menu, qui est au-dessus des
 *    branches, il déroulait leurs trente onglets ; sur une page d'Odyssée, il
 *    proposait les douze onglets de Révisions que la barre venait justement
 *    de cesser d'afficher. Le défaut d'origine avait changé de forme, pas de
 *    nature.
 *
 * Désormais le pied est **contextuel**, et sa portée est celle de l'en-tête :
 *
 * - **Au-dessus des branches** (le menu, le profil, l'export, l'import —
 *   c'est-à-dire les pages à en-tête léger) : les trois branches, et rien de
 *   leur intérieur. On n'y entre pas par un onglet pris au hasard.
 * - **Dans une branche** : ses onglets et ses écrans sans onglet, puis le
 *   retour au menu et les autres branches.
 *
 * ## Ce que cela retire, et où c'est reparti
 *
 * Rien ne devient inatteignable : les onglets des autres branches sont à deux
 * clics — la branche, puis l'onglet — au lieu d'un, et la colonne
 * « Cyclades » les nomme sur chaque page. En échange, six écrans qui
 * n'étaient dans aucun pied (« Appareils », « À rapprocher », « Mes règles »,
 * « Qui lit mon budget », « Exporter », « Importer ») y sont enfin, auprès de
 * ce à quoi ils appartiennent.
 */
import config from '../../site.config.mjs';
import {
  branchesDisponibles,
  ECRANS_COMMUNS,
  type Branche,
  type Onglet,
} from '../lib/branches';

interface Props {
  /**
   * L'identifiant de la branche où l'on se trouve, ou `menu` pour les pages
   * qui sont au-dessus des branches.
   *
   * C'est la mise en page qui le dit, et non un calcul refait ici sur le
   * chemin : elle a déjà tranché la même question pour choisir l'en-tête, et
   * deux réponses à une seule question finiraient par diverger. Un pied qui
   * annoncerait Révisions sous un en-tête de menu serait exactement
   * l'incohérence qu'on corrige.
   */
  portee: string;
}

const { portee } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lien = (o: Onglet) => ({ libelle: o.nom, href: `${base}${o.chemin}` });

const branches = branchesDisponibles();
const courante: Branche | undefined = branches.find((b) => b.id === portee);
const autres = branches.filter((b) => b.id !== courante?.id);

const colonneBranches = {
  titre: courante ? 'Cyclades' : 'Les branches',
  liens: [
    ...(courante ? [{ libelle: `Menu de ${config.titre}`, href: `${base}/` }] : []),
    ...autres.map((b) => ({ libelle: `${b.icone} ${b.libelle}`, href: `${base}${b.racine}` })),
  ],
};

/*
   Le pied s'est allégé (N6).

   Il portait trente-huit liens sur quatre colonnes, soit sept cents pixels
   sur ordinateur et mille sur téléphone, **sur chaque page** — y compris
   pendant une épreuve blanche. Il doublait la barre d'onglets, et servait de
   seule navigation sur téléphone parce que la barre y était invisible.

   La barre du bas répare ce dernier point : le pied n'a plus à porter le plan
   du site. Il garde les **annexes** de la branche — les écrans sans onglet,
   qui n'apparaissent nulle part ailleurs —, les autres branches, et « Cet
   espace ». Les onglets, eux, sont dans la barre, en haut et en bas.
*/
const colonnes = [
  ...(courante && (courante.annexes ?? []).length
    ? [{ titre: courante.libelle, liens: (courante.annexes ?? []).map(lien) }]
    : []),
  colonneBranches,
  { titre: 'Cet espace', liens: ECRANS_COMMUNS.map(lien) },
];
---

<footer class="mt-16 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
  <div class="bandeau-tricolore"></div>

  <div class="mx-auto max-w-6xl px-4 py-10">
    <div
      class:list={[
        'grid gap-8 sm:grid-cols-2',
        colonnes.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
      ]}
    >
      {
        colonnes.map((colonne) => (
          <nav aria-label={colonne.titre}>
            <h2 class="text-sm font-bold tracking-wide text-slate-900 uppercase dark:text-white">
              {colonne.titre}
            </h2>
            <ul class="mt-2 space-y-0.5">
              {colonne.liens.map((lienDeColonne) => (
                <li>
                  <a
                    href={lienDeColonne.href}
                    class="cible-tactile text-sm text-slate-600 underline-offset-4 transition hover:text-indigo-600 hover:underline dark:text-slate-300 dark:hover:text-indigo-400"
                  >
                    {lienDeColonne.libelle}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
      <p class="police-complement text-sm text-slate-600 dark:text-slate-300">
        <strong class="font-semibold text-slate-900 dark:text-white">{config.titre}</strong> — espace
        de révision personnel, chiffré, sans compte ni mesure d'audience.
      </p>
      <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        Site personnel, <strong>sans lien avec l'administration</strong> et sans caractère de
        service public. L'identité visuelle s'inspire de la charte graphique de l'État ; ni la
        typographie Marianne, ni le bloc-marque (logo et mention « République Française »), ni la
        présentation officielle de la devise ne sont repris — ces éléments sont réservés aux
        services de l'État.
      </p>
      <p class="mt-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        Polices <strong>Public Sans</strong> et <strong>Spectral</strong>, sous licence SIL Open
        Font License, servies depuis ce site : aucune requête n'est adressée à un service tiers.
      </p>
    </div>
  </div>
</footer>
