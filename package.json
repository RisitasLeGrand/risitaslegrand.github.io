{
  "name": "revinsp",
  "version": "1.0.0",
  "description": "Espace de révision personnel, chiffré, hébergé sur GitHub Pages.",
  "scripts": {
    "init:contenu": "node scripts/init-contenu.mjs",
    "contenu": "node scripts/build-content.mjs",
    "dev": "npm run contenu && astro dev",
    "build": "npm run contenu && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "hash": "node scripts/hash.mjs",
    "verifier": "astro check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RisitasLeGrand/revinsp.git"
  },
  "bugs": {
    "url": "https://github.com/RisitasLeGrand/revinsp/issues"
  },
  "homepage": "https://github.com/RisitasLeGrand/revinsp#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "idb": "^8.0.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module"
}
