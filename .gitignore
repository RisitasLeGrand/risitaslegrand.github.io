# --- CONTENU EN CLAIR : NE JAMAIS COMMITER ---
# Les fiches, le glossaire et le mot de passe restent sur la machine locale.
content/
.env.local
.env

# --- Données générées par le build (contenu chiffré, régénérable) ---
public/data/
# Copie locale des exemples d'actualités (npm run actualites:local).
# La source versionnée est « actualites-data/ » à la racine.
public/actualites-data/

# Outillage local de la synthèse vocale (modèle de voix, ≈ 65 Mo) :
# réinstallable par « npm run podcasts:installer ».
outils/

# Rapports d'audit : ils décrivent des faiblesses éventuelles et des captures
# de données synthétiques. Ils restent sur la machine locale.
audit/

# --- Dépendances et artefacts de build ---
node_modules/
dist/
.astro/
# Application Syllogismes (Angular) : sources versionnées, build et
# dépendances régénérables par « npm run syllogismes:build ».
apps/syllogismes/node_modules/
apps/syllogismes/dist/

# --- Divers ---
.DS_Store
*.log
npm-debug.log*
.cache/

# Les fascicules sources : même règle que « content/ » — ils ne sortent jamais
# de la machine. Le dépôt de publication est public.
sources/

# Le témoin local du mot de passe de construction. Il ne quitte jamais la
# machine qui construit : publié ou commité, il rendrait le mot de passe
# attaquable hors ligne.
.temoin-mot-de-passe.local.json
